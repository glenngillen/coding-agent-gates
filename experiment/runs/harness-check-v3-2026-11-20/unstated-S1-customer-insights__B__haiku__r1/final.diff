src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 from orders.domain.orders import Order
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
16         self._orders = orders
17         self._customers = customers
18 
19     def _lifetime_value(self, orders: list[Order]) -> tuple[int, int]:
20         """(order_count, lifetime_value_cents) over the orders that are not cancelled."""
21         active = [order for order in orders if order.status != "cancelled"]
22         return len(active), sum(self._orders.summarize(order).total_cents for order in active)
23 
24     def handle_order_history(self, customer_id: str) -> Response:
25         """A customer's orders, newest first, with totals as reported by the order summary."""
26         try:
27             orders = self._orders.list_for_customer(customer_id)
28         except CustomerNotFound:
29             return not_found("customer")
30         # list_for_customer returns creation order; newest first is the reverse.
31         entries: list[dict[str, Any]] = []
32         for order in reversed(orders):
33             summary = self._orders.summarize(order)
34             entries.append({"order_id": order.order_id, "status": order.status,
35                             "total_cents": summary.total_cents})
36         return Response(200, {"customer_id": customer_id, "orders": entries})
37 
38     def handle_lifetime_value(self, customer_id: str) -> Response:
39         """Non-cancelled order count and the sum of their totals, as in the order history."""
40         try:
41             orders = self._orders.list_for_customer(customer_id)
42         except CustomerNotFound:
43             return not_found("customer")
44         order_count, lifetime_value_cents = self._lifetime_value(orders)
45         return Response(200, {"customer_id": customer_id, "order_count": order_count,
46                               "lifetime_value_cents": lifetime_value_cents})
47 
48     def handle_customers_without_orders(self) -> Response:
49         """Registered customers with no orders that are not cancelled, in registration order."""
50         customers = []
51         for customer in self._customers.list_all():
52             order_count, _ = self._lifetime_value(self._orders.list_for_customer(customer.customer_id))
53             if order_count == 0:
54                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
55                                   "email": customer.email})
56         return Response(200, {"customers": customers})
57 
58     def handle_top_customers(self, limit: Any) -> Response:
59         """Customers ranked by lifetime value (highest first, then customer_id), excluding zero."""
60         try:
61             limit = require_positive_int(limit, "limit")
62         except InvalidRequest as exc:
63             return bad_request(exc)
64         ranked = []
65         for customer in self._customers.list_all():
66             _, value = self._lifetime_value(self._orders.list_for_customer(customer.customer_id))
67             if value > 0:
68                 ranked.append((value, customer))
69         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
70         return Response(200, {"customers": [
71             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": value}
72             for value, customer in ranked[:limit]]})
