 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def _lifetime_value(self, orders: list) -> tuple[int, int]:
17         """Number of non-cancelled orders and their total, at summary totals."""
18         totals = [self._service.summarize(o).total_cents for o in orders if o.status != "cancelled"]
19         return len(totals), sum(totals)
20 
21     def handle_order_history(self, customer_id: str) -> Response:
22         """A customer's orders, newest first, with totals as reported by the order summary."""
23         try:
24             orders = self._service.list_for_customer(customer_id)
25         except CustomerNotFound:
26             return not_found("customer")
27         history: list[dict[str, Any]] = [
28             {"order_id": summary.order.order_id,
29              "status": summary.order.status,
30              "total_cents": summary.total_cents}
31             for summary in (self._service.summarize(o) for o in reversed(orders))
32         ]
33         return Response(200, {"customer_id": customer_id, "orders": history})
34 
35     def handle_lifetime_value(self, customer_id: str) -> Response:
36         """Count and total of a customer's orders that are not cancelled, at summary totals."""
37         try:
38             orders = self._service.list_for_customer(customer_id)
39         except CustomerNotFound:
40             return not_found("customer")
41         count, total = self._lifetime_value(orders)
42         return Response(200, {"customer_id": customer_id, "order_count": count,
43                               "lifetime_value_cents": total})
44 
45     def handle_customers_without_orders(self) -> Response:
46         """Registered customers with no orders that are not cancelled, in registration order."""
47         customers = [
48             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
49             for c in self._service.list_customers()
50             if self._lifetime_value(self._service.list_for_customer(c.customer_id))[0] == 0
51         ]
52         return Response(200, {"customers": customers})
53 
54     def handle_top_customers(self, limit: Any) -> Response:
55         """Customers by lifetime value, highest first; zero-value customers are omitted."""
56         try:
57             limit = require_positive_int(limit, "limit")
58         except InvalidRequest as exc:
59             return bad_request(exc)
60         ranked = []
61         for customer in self._service.list_customers():
62             _, total = self._lifetime_value(self._service.list_for_customer(customer.customer_id))
63             if total > 0:
64                 ranked.append((total, customer))
65         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
66         return Response(200, {"customers": [
67             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
68             for total, c in ranked[:limit]
69         ]})
