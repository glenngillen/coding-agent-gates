 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found
 8 from orders.domain.orders import Order
 9 
10 
11 class CustomerInsightsController:
12     def __init__(self, service: OrderService) -> None:
13         self._service = service
14 
15     def handle_order_history(self, customer_id: str) -> Response:
16         """A customer's orders, newest first, including cancelled ones."""
17         try:
18             orders = self._service.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         entries = []
22         for order in reversed(orders):  # repository returns creation order
23             summary = self._service.summarize(order)
24             entries.append({"order_id": order.order_id, "status": order.status,
25                             "total_cents": summary.total_cents})
26         return Response(200, {"customer_id": customer_id, "orders": entries})
27 
28     def handle_lifetime_value(self, customer_id: str) -> Response:
29         """Count and total of a customer's non-cancelled orders."""
30         try:
31             orders = self._service.list_for_customer(customer_id)
32         except CustomerNotFound:
33             return not_found("customer")
34         count, total = self._lifetime(orders)
35         return Response(200, {"customer_id": customer_id, "order_count": count,
36                               "lifetime_value_cents": total})
37 
38     def handle_top_customers(self, limit: int) -> Response:
39         """Customers ranked by lifetime value (highest first, then customer_id)."""
40         if type(limit) is not int or limit < 1:
41             return bad_request(InvalidRequest("limit must be a positive integer"))
42         ranked = []
43         for customer in self._service.list_customers():
44             _, total = self._lifetime(self._service.list_for_customer(customer.customer_id))
45             if total > 0:
46                 ranked.append({"customer_id": customer.customer_id, "name": customer.name,
47                                "lifetime_value_cents": total})
48         ranked.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
49         return Response(200, {"customers": ranked[:limit]})
50 
51     def handle_customers_without_orders(self) -> Response:
52         """Customers with no non-cancelled orders, in registration order."""
53         entries = []
54         for customer in self._service.list_customers():
55             count, _ = self._lifetime(self._service.list_for_customer(customer.customer_id))
56             if count == 0:
57                 entries.append({"customer_id": customer.customer_id, "name": customer.name,
58                                 "email": customer.email})
59         return Response(200, {"customers": entries})
60 
61     def _lifetime(self, orders: list[Order]) -> tuple[int, int]:
62         """(count, total_cents) over the non-cancelled orders."""
63         active = [o for o in orders if o.status != "cancelled"]
64         return len(active), sum(self._service.summarize(o).total_cents for o in active)
