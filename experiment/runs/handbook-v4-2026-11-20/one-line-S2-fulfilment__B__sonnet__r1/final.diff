26 def test_low_stock_sorted_and_strict(shop):
27     shop.catalog.handle_add_product({"sku": "AAA", "name": "Aaa", "unit_price_cents": 1, "on_hand": 5})
28     r = shop.fulfilment.handle_low_stock(100)
29     assert r.status == 200
30     assert [(p["sku"], p["on_hand"]) for p in r.body["products"]] == [
31         ("AAA", 5), ("LAMP", 5), ("BOOK", 50)]  # PEN (100) is not strictly below 100
32     assert r.body["products"][0] == {"sku": "AAA", "name": "Aaa", "on_hand": 5}
33     assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
34     assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
