 1 def place(shop, *items):
 2     return shop.orders.handle_create({"customer_id": "c1", "items": [
 3         {"sku": s, "quantity": q} for s, q in items]}).body["order_id"]
 4 
 5 
 6 def test_packing_slip(shop):
 7     oid = place(shop, ("PEN", 2), ("BOOK", 1))
 8     r = shop.fulfilment.handle_packing_slip(oid)
 9     assert r.status == 200
10     assert r.body == {"order_id": oid, "customer_name": "Ada", "lines": [
