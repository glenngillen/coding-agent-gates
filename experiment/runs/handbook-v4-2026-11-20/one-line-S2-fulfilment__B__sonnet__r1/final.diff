 1 """Warehouse fulfilment: packing slips."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.catalog import Product
 7 from orders.domain.fulfilment import (LOW_STOCK_THRESHOLD, FulfilmentSummary, PackingSlip,
 8                                       PackingSlipLine)
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 from orders.infrastructure.stock import InMemoryStockRepository
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def summary(self) -> FulfilmentSummary:
24         """Open (not cancelled) orders, units to pick across them, and low-stock product count."""
25         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
26         units = sum(item.quantity for o in open_orders for item in o.items)
27         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_THRESHOLD)))
28 
29     def restock(self, sku: str, quantity: int) -> int:
30         """Add ``quantity`` units to the product's stock and return the new level."""
31         if self._catalog.get(sku) is None:
32             raise ProductNotFound(sku)
33         on_hand = self._stock.get(sku) + quantity
34         self._stock.set(sku, on_hand)
35         return on_hand
36 
37     def low_stock(self, threshold: int) -> list[tuple[Product, int]]:
38         """Active products with stock strictly below ``threshold``, lowest stock then SKU first."""
39         found = [(p, self._stock.get(p.sku)) for p in self._catalog.list_all() if p.active]
40         found = [(p, on_hand) for p, on_hand in found if on_hand < threshold]
41         return sorted(found, key=lambda pair: (pair[1], pair[0].sku))
42 
43     def packing_slip(self, order_id: str) -> PackingSlip:
44         order = self._orders.get(order_id)
45         if order is None:
46             raise OrderNotFound(order_id)
47         if order.status == "cancelled":
48             raise Conflict(f"order {order_id} is cancelled")
49         customer = self._customers.get(order.customer_id)
50         lines = []
51         for item in order.items:
52             product = self._catalog.get(item.sku)
53             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
54         return PackingSlip(order_id, customer.name if customer else "", tuple(lines))
