 1 """Warehouse fulfilment: packing slips."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 LOW_STOCK_LEVEL = 5  # the warehouse's low-stock line: fewer than this many units on hand
15 
16 
17 @dataclass(frozen=True)
18 class PackingSlipLine:
19     sku: str
20     name: str
21     quantity: int
22 
23 
24 @dataclass(frozen=True)
25 class PackingSlip:
26     order_id: str
27     customer_name: str
28     lines: tuple[PackingSlipLine, ...]
29 
30 
31 @dataclass(frozen=True)
32 class LowStockProduct:
33     sku: str
34     name: str
35     on_hand: int
36 
37 
38 @dataclass(frozen=True)
39 class FulfilmentSummary:
40     open_orders: int
41     units_to_pick: int
42     low_stock_products: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._stock = stock
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52 
53     def packing_slip(self, order_id: str) -> PackingSlip:
54         order = self._orders.get(order_id)
55         if order is None:
56             raise OrderNotFound(order_id)
57         if order.status == "cancelled":
58             raise Conflict(f"order {order_id} is cancelled")
59         customer = self._customers.get(order.customer_id)
60         lines = []
61         for item in order.items:
62             product = self._catalog.get(item.sku)
63             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
64         return PackingSlip(order.order_id, customer.name if customer else "", tuple(lines))
65 
66     def summary(self) -> FulfilmentSummary:
67         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
68         units = sum(item.quantity for o in open_orders for item in o.items)
69         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LEVEL)))
70 
71     def restock(self, sku: str, quantity: int) -> int:
72         """Add ``quantity`` units to a product's stock and return the new level."""
73         if self._catalog.get(sku) is None:
74             raise ProductNotFound(sku)
75         level = self._stock.get(sku) + quantity
76         self._stock.set(sku, level)
77         return level
78 
79     def low_stock(self, threshold: int) -> list[LowStockProduct]:
80         """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
81         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
82                  for p in self._catalog.list_all() if p.active]
83         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
