 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, orders: OrderService) -> None:
14         self._orders = orders
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """A customer's orders, newest first, with the same totals as the order summary."""
18         try:
19             summaries = self._orders.order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         orders: list[dict[str, Any]] = [
23             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
24             for s in summaries
25         ]
26         return Response(200, {"customer_id": customer_id, "orders": orders})
27 
28     def handle_lifetime_value(self, customer_id: str) -> Response:
29         """Count and total of the customer's orders that are not cancelled, at order-summary totals."""
30         try:
31             summaries = self._orders.active_order_summaries(customer_id)
32         except CustomerNotFound:
33             return not_found("customer")
34         return Response(200, {
35             "customer_id": customer_id,
36             "order_count": len(summaries),
37             "lifetime_value_cents": sum(s.total_cents for s in summaries),
38         })
39 
40     def handle_customers_without_orders(self) -> Response:
41         """Registered customers with no orders that are not cancelled, in registration order."""
42         return Response(200, {"customers": [
43             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
44             for c in self._orders.customers_without_active_orders()
45         ]})
46 
47     def handle_top_customers(self, limit: Any) -> Response:
48         """Leaderboard of customers by lifetime value, highest first; zero-value customers are left out."""
49         try:
50             limit = require_positive_int(limit, "limit")
51         except InvalidRequest as exc:
52             return bad_request(exc)
53         ranked = self._orders.top_customers(limit)
54         return Response(200, {"customers": [
55             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": value}
56             for customer, value in ranked
57         ]})
