17 @dataclass(frozen=True)
18 class PackingSlipLine:
19     sku: str
20     name: str
21     quantity: int
22 
23 
24 @dataclass(frozen=True)
25 class PackingSlip:
26     order_id: str
27     customer_name: str
28     lines: tuple[PackingSlipLine, ...]
