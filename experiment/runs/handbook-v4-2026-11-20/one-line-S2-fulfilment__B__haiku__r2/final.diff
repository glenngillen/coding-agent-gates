38 class FulfilmentService:
39     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
40                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
41         self._orders = orders
42         self._customers = customers
43         self._catalog = catalog
44         self._stock = stock
45 
46     def restock(self, sku: str, quantity: int) -> int:
47         """Add ``quantity`` units to a product's stock; returns the new level.
48 
49         Stock is shared with order placement, so the units are orderable immediately.
50         """
51         if self._catalog.get(sku) is None:
52             raise ProductNotFound(sku)
53         new_level = self._stock.get(sku) + quantity
54         self._stock.set(sku, new_level)
55         return new_level
56 
57     def fulfilment_summary(self) -> tuple[int, int, int]:
58         """Return ``(open_orders, units_to_pick, low_stock_products)``.
59 
60         Open orders are those not cancelled; low stock uses the warehouse's fixed line of 5 units.
61         """
62         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
63         units = sum(item.quantity for o in open_orders for item in o.items)
64         return len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE))
65 
66     def low_stock(self, threshold: int) -> list[LowStockProduct]:
67         """Active products whose stock on hand is strictly below ``threshold``, lowest first."""
68         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
69                  for p in self._catalog.list_all() if p.active and self._stock.get(p.sku) < threshold]
70         return sorted(found, key=lambda p: (p.on_hand, p.sku))
71 
72     def packing_slip(self, order_id: str) -> PackingSlip:
73         order = self._orders.get(order_id)
74         if order is None:
75             raise OrderNotFound(order_id)
76         if order.status == "cancelled":
77             raise Conflict(f"order {order_id} is cancelled")
78         customer = self._customers.get(order.customer_id)
79         if customer is None:
80             raise CustomerNotFound(order.customer_id)
81         lines = []
82         for item in order.items:
83             product = self._catalog.get(item.sku)
84             if product is None:
85                 raise ProductNotFound(item.sku)
86             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
87         return PackingSlip(order.order_id, customer.name, tuple(lines))
