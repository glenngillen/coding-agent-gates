 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService, LowStockProduct, PackingSlip
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
14     return {
15         "order_id": slip.order_id,
16         "customer_name": slip.customer_name,
17         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
18                   for line in slip.lines],
19     }
20 
21 
22 def low_stock_body(products: list[LowStockProduct]) -> dict[str, Any]:
23     return {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand} for p in products]}
24 
25 
26 class FulfilmentController:
27     def __init__(self, service: FulfilmentService) -> None:
28         self._service = service
29 
30     def handle_packing_slip(self, order_id: str) -> Response:
31         try:
32             slip = self._service.packing_slip(order_id)
33         except OrderNotFound:
34             return not_found("order")
35         except Conflict as exc:
36             return conflict(exc)
37         except CustomerNotFound:
38             return not_found("customer")
39         except ProductNotFound:
40             return not_found("product")
41         return Response(200, packing_slip_body(slip))
42 
43     def handle_low_stock(self, threshold: Any) -> Response:
44         try:
45             threshold = require_non_negative_int(threshold, "threshold")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         return Response(200, low_stock_body(self._service.low_stock(threshold)))
49 
50     def handle_fulfilment_summary(self) -> Response:
51         open_orders, units, low_stock = self._service.fulfilment_summary()
52         return Response(200, {"open_orders": open_orders, "units_to_pick": units,
53                               "low_stock_products": low_stock})
54 
55     def handle_restock(self, request: dict[str, Any]) -> Response:
56         try:
57             sku = require_str(request, "sku")
58             quantity = require_positive_int(request.get("quantity"), "quantity")
59         except InvalidRequest as exc:
60             return bad_request(exc)
61         try:
62             on_hand = self._service.restock(sku, quantity)
63         except ProductNotFound:
64             return not_found("product")
65         return Response(200, {"sku": sku, "on_hand": on_hand})
