 1 """Warehouse fulfilment: packing slips for orders that are ready to pack."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_LINE_UNITS = 5
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def packing_slip(self, order_id: str) -> PackingSlip:
24         """Build the packing slip for an order that has not been cancelled."""
25         order = self._orders.get(order_id)
26         if order is None:
27             raise OrderNotFound(order_id)
28         if order.status == "cancelled":
29             raise Conflict(f"order {order_id} is cancelled")
30         customer = self._customers.get(order.customer_id)
31         customer_name = customer.name if customer is not None else order.customer_id
32         lines = []
33         for item in order.items:
34             product = self._catalog.get(item.sku)
35             lines.append(PackingSlipLine(item.sku, product.name if product is not None else item.sku,
36                                          item.quantity))
37         return PackingSlip(order.order_id, customer_name, tuple(lines))
38 
39     def restock(self, sku: str, quantity: int) -> int:
40         """Add units to a product's stock and return the new level."""
41         if self._catalog.get(sku) is None:
42             raise ProductNotFound(sku)
43         on_hand = self._stock.get(sku) + quantity
44         self._stock.set(sku, on_hand)
45         return on_hand
46 
47     def summary(self) -> FulfilmentSummary:
48         """Summarise open orders, units to pick and products below the low-stock line."""
49         open_orders = [order for order in self._orders.list_all() if order.status != "cancelled"]
50         units_to_pick = sum(item.quantity for order in open_orders for item in order.items)
51         return FulfilmentSummary(len(open_orders), units_to_pick,
52                                  len(self.low_stock(LOW_STOCK_LINE_UNITS)))
53 
54     def low_stock(self, threshold: int) -> list[LowStockProduct]:
55         """List active products with stock strictly below the threshold, lowest first."""
56         low = []
57         for product in self._catalog.list_all():
58             on_hand = self._stock.get(product.sku)
59             if product.active and on_hand < threshold:
60                 low.append(LowStockProduct(product.sku, product.name, on_hand))
61         return sorted(low, key=lambda entry: (entry.on_hand, entry.sku))
