 1 """Fulfilment workflows: building packing slips for warehouse staff."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.catalog_service import CatalogService
 6 from orders.application.customer_service import CustomerService
 7 from orders.application.errors import Conflict
 8 from orders.application.order_service import OrderService
 9 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
10 
11 LOW_STOCK_LINE_UNITS = 5
12 
13 
14 class FulfilmentService:
15     def __init__(self, orders: OrderService, customers: CustomerService, catalog: CatalogService) -> None:
16         self._orders = orders
17         self._customers = customers
18         self._catalog = catalog
19 
20     def packing_slip(self, order_id: str) -> PackingSlip:
21         """Build the packing slip for a placed order; cancelled orders are not packed."""
22         order = self._orders.get_order(order_id)
23         if order.status == "cancelled":
24             raise Conflict(f"order {order_id} is cancelled")
25         customer = self._customers.get(order.customer_id)
26         lines = tuple(
27             PackingSlipLine(item.sku, self._catalog.get_product(item.sku).name, item.quantity)
28             for item in order.items
29         )
30         return PackingSlip(order.order_id, customer.name, lines)
31 
32     def low_stock(self, threshold: int) -> list[LowStockProduct]:
33         """List active products with fewer than ``threshold`` units on hand, lowest stock first."""
34         products = [LowStockProduct(p.sku, p.name, self._catalog.on_hand(p.sku))
35                     for p in self._catalog.list_active()]
36         below = [p for p in products if p.on_hand < threshold]
37         return sorted(below, key=lambda p: (p.on_hand, p.sku))
38 
39     def summary(self) -> FulfilmentSummary:
40         """Counts for the warehouse dashboard: open orders, units to pick and low-stock products."""
41         open_orders = self._orders.list_open()
42         units = sum(item.quantity for order in open_orders for item in order.items)
43         low_stock = self.low_stock(LOW_STOCK_LINE_UNITS)
44         return FulfilmentSummary(len(open_orders), units, len(low_stock))
45 
46     def restock(self, sku: str, quantity: int) -> int:
47         """Receive ``quantity`` units of a product; they are orderable immediately."""
48         return self._catalog.restock(sku, quantity)
