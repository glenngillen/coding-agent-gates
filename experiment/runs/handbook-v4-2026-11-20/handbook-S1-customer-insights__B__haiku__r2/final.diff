.. 68     def list_summaries_for_customer(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Return the customer's order summaries, newest first."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(order) for order in reversed(orders)]
.. 72 
.. 73     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 74         """Count the customer's non-cancelled orders and sum their totals."""
.. 75         active = [s for s in self.list_summaries_for_customer(customer_id)
.. 76                   if s.order.status != "cancelled"]
.. 77         return LifetimeValue(len(active), sum(s.total_cents for s in active))
.. 78 
.. 79     def customers_without_orders(self) -> list[Customer]:
.. 80         """Return the registered customers with no orders that are not cancelled, in registration order."""
.. 81         return [c for c in self._customers.list_all()
.. 82                 if self.lifetime_value(c.customer_id).order_count == 0]
.. 83 
.. 84     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 85         """Rank customers by lifetime value, highest first, leaving out those worth nothing."""
.. 86         ranked = []
.. 87         for customer in self._customers.list_all():
.. 88             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
.. 89             if value > 0:
.. 90                 ranked.append((customer, value))
.. 91         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 92         return ranked[:limit]
