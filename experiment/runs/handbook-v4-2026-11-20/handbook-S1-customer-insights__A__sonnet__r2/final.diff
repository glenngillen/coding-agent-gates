.. 72     def lifetime_value_for_customer(self, customer_id: str) -> tuple[int, int]:
.. 73         """Return the count and total cents of a customer's non-cancelled orders."""
.. 74         totals = [s.total_cents for s in self.history_for_customer(customer_id)
.. 75                   if s.order.status != "cancelled"]
.. 76         return len(totals), sum(totals)
.. 77 
.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 79         """Return up to ``limit`` customers with spend, highest first then by id, omitting zero."""
.. 80         ranked = []
.. 81         for customer in self._customers.list_all():
.. 82             _, lifetime_value_cents = self.lifetime_value_for_customer(customer.customer_id)
.. 83             if lifetime_value_cents > 0:
.. 84                 ranked.append((customer, lifetime_value_cents))
.. 85         ranked.sort(key=lambda entry: (-entry[1], entry[0].customer_id))
.. 86         return ranked[:limit]
.. 87 
