 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 class FulfilmentService:
36     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
37                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
38         self._orders = orders
39         self._customers = customers
40         self._catalog = catalog
41         self._stock = stock
42 
43     def low_stock(self, threshold: int) -> list[LowStockProduct]:
44         """Active products whose stock on hand is strictly below ``threshold``."""
45         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
46                  for p in self._catalog.list_all() if p.active]
47         found = [p for p in found if p.on_hand < threshold]
48         return sorted(found, key=lambda p: (p.on_hand, p.sku))
49 
50     def restock(self, sku: str, quantity: int) -> int:
51         """Add ``quantity`` units to a product's stock and return the new level."""
52         if self._catalog.get(sku) is None:
53             raise ProductNotFound(sku)
54         new_level = self._stock.get(sku) + quantity
55         self._stock.set(sku, new_level)
56         return new_level
57 
58     def fulfilment_summary(self, low_stock_line: int = 5) -> tuple[int, int, int]:
59         """Return ``(open_orders, units_to_pick, low_stock_products)`` for the dashboard."""
60         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
61         units = sum(item.quantity for order in open_orders for item in order.items)
62         low = len(self.low_stock(low_stock_line))
63         return len(open_orders), units, low
64 
65     def packing_slip(self, order_id: str) -> PackingSlip:
66         order = self._orders.get(order_id)
67         if order is None:
68             raise OrderNotFound(order_id)
69         if order.status == "cancelled":
70             raise Conflict(f"order {order_id} is cancelled")
71         customer = self._customers.get(order.customer_id)
72         if customer is None:
73             raise CustomerNotFound(order.customer_id)
74         lines = []
75         for item in order.items:
76             product = self._catalog.get(item.sku)
77             if product is None:
78                 raise ValueError(f"order {order_id} references unknown product {item.sku}")
79             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
80         return PackingSlip(order.order_id, customer.name, tuple(lines))
