 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except CustomerNotFound:
23             return not_found("customer")
24         except Conflict as exc:
25             return conflict(exc)
26         return Response(200, {
27             "order_id": slip.order_id,
28             "customer_name": slip.customer_name,
29             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
30                       for line in slip.lines],
31         })
32 
33     def handle_low_stock(self, threshold: Any) -> Response:
34         try:
35             limit = require_non_negative_int(threshold, "threshold")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         products = self._service.low_stock(limit)
39         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
40                                            for p in products]})
41 
42     def handle_restock(self, request: Any) -> Response:
43         try:
44             sku = require_str(request, "sku")
45             quantity = require_positive_int(request.get("quantity"), "quantity")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         try:
49             on_hand = self._service.restock(sku, quantity)
50         except ProductNotFound:
51             return not_found("product")
52         return Response(200, {"sku": sku, "on_hand": on_hand})
53 
54     def handle_fulfilment_summary(self) -> Response:
55         open_orders, units, low_stock = self._service.fulfilment_summary()
56         return Response(200, {"open_orders": open_orders, "units_to_pick": units,
57                               "low_stock_products": low_stock})
