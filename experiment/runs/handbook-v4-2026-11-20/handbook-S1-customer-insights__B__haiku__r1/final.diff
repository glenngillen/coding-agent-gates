 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.domain.orders import OrderSummary
11 
12 
13 def history_entry(summary: OrderSummary) -> dict[str, Any]:
14     return {"order_id": summary.order.order_id, "status": summary.order.status,
15             "total_cents": summary.total_cents}
16 
17 
18 class CustomerInsightsController:
19     def __init__(self, service: OrderService) -> None:
20         self._service = service
21 
22     def handle_order_history(self, customer_id: str) -> Response:
23         try:
24             summaries = self._service.order_history(customer_id)
25         except CustomerNotFound:
26             return not_found("customer")
27         return Response(200, {"customer_id": customer_id,
28                               "orders": [history_entry(s) for s in summaries]})
29 
30     def handle_lifetime_value(self, customer_id: str) -> Response:
31         try:
32             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {"customer_id": customer_id, "order_count": order_count,
36                               "lifetime_value_cents": lifetime_value_cents})
37 
38     def handle_top_customers(self, limit: Any) -> Response:
39         try:
40             limit = require_positive_int(limit, "limit")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         ranked = self._service.top_customers(limit)
44         return Response(200, {"customers": [
45             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": value}
46             for customer, value in ranked]})
47 
48     def handle_customers_without_orders(self) -> Response:
49         customers = self._service.customers_without_orders()
50         return Response(200, {"customers": [
51             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
