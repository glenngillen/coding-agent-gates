.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries of every order for a customer, newest first, including cancelled orders."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(order) for order in reversed(orders)]
.. 72 
.. 73     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 74         """Count and summed total of a customer's orders that are not cancelled."""
.. 75         totals = [s.total_cents for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return len(totals), sum(totals)
.. 77 
.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 79         """Up to ``limit`` customers with a non-zero lifetime value, highest value first, then by id."""
.. 80         ranked = []
.. 81         for customer in self._customers.list_all():
.. 82             _, value = self.lifetime_value(customer.customer_id)
.. 83             if value > 0:
.. 84                 ranked.append((customer, value))
.. 85         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 86         return ranked[:limit]
.. 87 
.. 88     def customers_without_orders(self) -> list[Customer]:
.. 89         """Registered customers with no order that is not cancelled, in registration order."""
.. 90         active = {o.customer_id for o in self._orders.list_all() if o.status != "cancelled"}
.. 91         return [c for c in self._customers.list_all() if c.customer_id not in active]
