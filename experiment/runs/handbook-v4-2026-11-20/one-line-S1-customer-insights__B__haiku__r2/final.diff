 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 from orders.domain.orders import OrderSummary
12 
13 
14 def history_entry(summary: OrderSummary) -> dict[str, Any]:
15     return {"order_id": summary.order.order_id, "status": summary.order.status,
16             "total_cents": summary.total_cents}
17 
18 
19 class CustomerInsightsController:
20     def __init__(self, service: OrderService, customers: CustomerService) -> None:
21         self._service = service
22         self._customers = customers
23 
24     def handle_order_history(self, customer_id: str) -> Response:
25         try:
26             summaries = self._service.order_history(customer_id)
27         except CustomerNotFound:
28             return not_found("customer")
29         return Response(200, {"customer_id": customer_id,
30                               "orders": [history_entry(s) for s in summaries]})
31 
32     def handle_lifetime_value(self, customer_id: str) -> Response:
33         try:
34             summaries = self._service.active_order_summaries(customer_id)
35         except CustomerNotFound:
36             return not_found("customer")
37         return Response(200, {"customer_id": customer_id,
38                               "order_count": len(summaries),
39                               "lifetime_value_cents": sum(s.total_cents for s in summaries)})
40 
41     def handle_top_customers(self, limit: Any) -> Response:
42         try:
43             limit = require_positive_int(limit, "limit")
44         except InvalidRequest as exc:
45             return bad_request(exc)
46         ranked = []
47         for customer in self._customers.list_all():
48             value = sum(s.total_cents for s in self._service.active_order_summaries(customer.customer_id))
49             if value > 0:
50                 ranked.append((value, customer))
51         ranked.sort(key=lambda entry: (-entry[0], entry[1].customer_id))
52         return Response(200, {"customers": [
53             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
54             for value, c in ranked[:limit]]})
55 
56     def handle_customers_without_orders(self) -> Response:
57         """Registered customers with no orders that are not cancelled, in registration order."""
58         return Response(200, {"customers": [
59             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
60             for c in self._customers.list_all()
61             if not self._service.active_order_summaries(c.customer_id)]})
