 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: CustomerService) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the same totals as the order summary."""
20         try:
21             orders = self._service.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         entries = []
25         for order in reversed(orders):  # repository returns creation order
26             summary = self._service.summarize(order)
27             entries.append({"order_id": order.order_id, "status": order.status,
28                             "total_cents": summary.total_cents})
29         return Response(200, {"customer_id": customer_id, "orders": entries})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         """Count and total value of a customer's non-cancelled orders."""
33         try:
34             count, total = self._service.lifetime_value(customer_id)
35         except CustomerNotFound:
36             return not_found("customer")
37         return Response(200, {"customer_id": customer_id, "order_count": count,
38                               "lifetime_value_cents": total})
39 
40     def handle_customers_without_orders(self) -> Response:
41         """Customers with no non-cancelled orders, in registration order."""
42         idle = []
43         for customer in self._customers.list_all():
44             count, _ = self._service.lifetime_value(customer.customer_id)
45             if count == 0:
46                 idle.append({"customer_id": customer.customer_id, "name": customer.name,
47                              "email": customer.email})
48         return Response(200, {"customers": idle})
49 
50     def handle_top_customers(self, limit: Any) -> Response:
51         """Customers ranked by lifetime value (highest first, then customer_id), zero excluded."""
52         try:
53             limit = require_positive_int(limit, "limit")
54         except InvalidRequest as exc:
55             return bad_request(exc)
56         ranked = []
57         for customer in self._customers.list_all():
58             _, value = self._service.lifetime_value(customer.customer_id)
59             if value > 0:
60                 ranked.append({"customer_id": customer.customer_id, "name": customer.name,
61                                "lifetime_value_cents": value})
62         ranked.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
63         return Response(200, {"customers": ranked[:limit]})
