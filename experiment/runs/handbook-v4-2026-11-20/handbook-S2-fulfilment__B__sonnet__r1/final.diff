 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         """Return the packing slip for an order."""
19         try:
20             slip = self._service.packing_slip(order_id)
21         except OrderNotFound:
22             return not_found("order")
23         except Conflict as exc:
24             return conflict(exc)
25         return Response(200, {
26             "order_id": slip.order_id,
27             "customer_name": slip.customer_name,
28             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
29                       for line in slip.lines],
30         })
31 
32     def handle_fulfilment_summary(self) -> Response:
33         """Return the warehouse dashboard counts."""
34         summary = self._service.summary()
35         return Response(200, {"open_orders": summary.open_orders, "units_to_pick": summary.units_to_pick,
36                               "low_stock_products": summary.low_stock_products})
37 
38     def handle_restock(self, request: dict[str, Any]) -> Response:
39         """Add units to a product's stock."""
40         try:
41             sku = require_str(request, "sku")
42             quantity = require_positive_int(request.get("quantity"), "quantity")
43         except InvalidRequest as exc:
44             return bad_request(exc)
45         try:
46             on_hand = self._service.restock(sku, quantity)
47         except ProductNotFound:
48             return not_found("product")
49         return Response(200, {"sku": sku, "on_hand": on_hand})
50 
51     def handle_low_stock(self, threshold: Any) -> Response:
52         """Return active products with stock below the threshold."""
53         try:
54             limit = require_non_negative_int(threshold, "threshold")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         products = self._service.low_stock(limit)
58         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
59                                            for p in products]})
