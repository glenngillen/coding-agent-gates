13 
14 LOW_STOCK_LINE = 5  # units on hand below which a product counts as low stock
15 
16 
17 @dataclass(frozen=True)
18 class PackingLine:
19     sku: str
20     name: str
21     quantity: int
22 
23 
24 @dataclass(frozen=True)
25 class PackingSlip:
26     order_id: str
27     customer_name: str
28     lines: tuple[PackingLine, ...]
29 
30 
31 @dataclass(frozen=True)
32 class LowStockLine:
33     sku: str
34     name: str
35     on_hand: int
36 
37 
38 class FulfilmentService:
39     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
40                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
41         self._orders = orders
42         self._customers = customers
43         self._catalog = catalog
44         self._stock = stock
45 
46     def fulfilment_summary(self) -> dict[str, int]:
47         """Open (not cancelled) order count, units across them, and active products under the low-stock line."""
48         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
49         return {
50             "open_orders": len(open_orders),
51             "units_to_pick": sum(item.quantity for o in open_orders for item in o.items),
52             "low_stock_products": len(self.low_stock(LOW_STOCK_LINE)),
53         }
54 
55     def restock(self, sku: str, quantity: int) -> int:
56         """Add ``quantity`` units to a product's stock and return the new level.
57 
58         Stock is shared with the order service, so the units are orderable immediately.
59         """
60         if self._catalog.get(sku) is None:
61             raise ProductNotFound(sku)
62         new_level = self._stock.get(sku) + quantity
63         self._stock.set(sku, new_level)
64         return new_level
65 
66     def low_stock(self, threshold: int) -> list[LowStockLine]:
67         """Active products with stock on hand strictly below ``threshold``, lowest first, then by SKU."""
68         lines = [LowStockLine(p.sku, p.name, self._stock.get(p.sku))
69                  for p in self._catalog.list_all() if p.active]
70         lines = [line for line in lines if line.on_hand < threshold]
71         return sorted(lines, key=lambda line: (line.on_hand, line.sku))
72 
73     def packing_slip(self, order_id: str) -> PackingSlip:
74         """Build the packing slip for a placed order.
75 
76         Raises ``OrderNotFound`` for an unknown order and ``Conflict`` for a cancelled one.
77         """
78         order = self._orders.get(order_id)
79         if order is None:
80             raise OrderNotFound(order_id)
81         if order.status == "cancelled":
82             raise Conflict(f"order {order_id} is cancelled")
83         customer = self._customers.get(order.customer_id)
84         if customer is None:
85             raise CustomerNotFound(order.customer_id)
86         lines = []
87         for item in order.items:
88             product = self._catalog.get(item.sku)
89             if product is None:
90                 raise ProductNotFound(item.sku)
91             lines.append(PackingLine(item.sku, product.name, item.quantity))
92         return PackingSlip(order.order_id, customer.name, tuple(lines))
