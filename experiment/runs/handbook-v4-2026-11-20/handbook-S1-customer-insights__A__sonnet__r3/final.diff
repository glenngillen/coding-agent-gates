.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 79         """Return up to limit customers with a non-zero lifetime value, highest first."""
.. 80         ranked = []
.. 81         for customer in self._customers.list_all():
.. 82             _, value_cents = self.lifetime_value(customer.customer_id)
.. 83             if value_cents > 0:
.. 84                 ranked.append((customer, value_cents))
.. 85         ranked.sort(key=lambda entry: (-entry[1], entry[0].customer_id))
.. 86         return ranked[:limit]
