11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_lifetime_value(self, customer_id: str) -> Response:
17         """Count and discounted total of a customer's non-cancelled orders."""
18         try:
19             count, value = self._service.lifetime_value(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         return Response(200, {"customer_id": customer_id, "order_count": count,
23                               "lifetime_value_cents": value})
24 
25     def handle_customers_without_orders(self) -> Response:
26         """Registered customers with no non-cancelled orders, in registration order."""
27         return Response(200, {"customers": [
28             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
29             for c in self._service.customers_without_orders()]})
30 
31     def handle_top_customers(self, limit: Any) -> Response:
32         """Leaderboard of customers by lifetime value, highest first."""
33         try:
34             limit = require_positive_int(limit, "limit")
35         except InvalidRequest as exc:
36             return bad_request(exc)
37         return Response(200, {"customers": [
38             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
39             for c, value in self._service.top_customers(limit)]})
40 
41     def handle_order_history(self, customer_id: str) -> Response:
42         """A customer's orders, newest first, with discounted totals."""
43         try:
44             summaries = self._service.history_for_customer(customer_id)
45         except CustomerNotFound:
46             return not_found("customer")
47         return Response(200, {"customer_id": customer_id, "orders": [
48             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
49             for s in summaries]})
