 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """A customer's orders, newest first, with the totals the order summary reports."""
18         try:
19             summaries = self._service.order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         return Response(200, {
23             "customer_id": customer_id,
24             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
25                         "total_cents": s.total_cents} for s in summaries],
26         })
27 
28     def handle_lifetime_value(self, customer_id: str) -> Response:
29         """Count of a customer's non-cancelled orders and the sum of their totals."""
30         try:
31             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
32         except CustomerNotFound:
33             return not_found("customer")
34         return Response(200, {"customer_id": customer_id, "order_count": order_count,
35                               "lifetime_value_cents": lifetime_value_cents})
36 
37     def handle_top_customers(self, limit: Any) -> Response:
38         """Customers with the highest lifetime value, at most ``limit`` of them."""
39         try:
40             limit = require_positive_int(limit, "limit")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         rows = self._service.top_customers(limit)
44         return Response(200, {"customers": [
45             {"customer_id": customer_id, "name": name, "lifetime_value_cents": value}
46             for customer_id, name, value in rows
47         ]})
48 
49     def handle_customers_without_orders(self) -> Response:
50         """Registered customers with no orders that are not cancelled, in registration order."""
51         customers = self._service.customers_without_orders()
52         return Response(200, {"customers": [
53             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers
54         ]})
