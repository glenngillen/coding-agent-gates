 1 """Fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import LowStockProduct, PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity} for line in slip.lines],
19     }
20 
21 
22 def low_stock_body(product: LowStockProduct) -> dict[str, Any]:
23     return {"sku": product.sku, "name": product.name, "on_hand": product.on_hand}
24 
25 
26 class FulfilmentController:
27     def __init__(self, service: FulfilmentService) -> None:
28         self._service = service
29 
30     def handle_packing_slip(self, order_id: str) -> Response:
31         try:
32             slip = self._service.packing_slip(order_id)
33         except OrderNotFound:
34             return not_found("order")
35         except Conflict as exc:
36             return conflict(exc)
37         except CustomerNotFound:
38             return not_found("customer")
39         except ProductNotFound:
40             return not_found("product")
41         return Response(200, packing_slip_body(slip))
42 
43     def handle_low_stock(self, threshold: Any) -> Response:
44         try:
45             limit = require_non_negative_int(threshold, "threshold")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         products = self._service.low_stock(limit)
49         return Response(200, {"products": [low_stock_body(p) for p in products]})
50 
51     def handle_fulfilment_summary(self) -> Response:
52         summary = self._service.summary()
53         return Response(200, {"open_orders": summary.open_orders,
54                               "units_to_pick": summary.units_to_pick,
55                               "low_stock_products": summary.low_stock_products})
56 
57     def handle_restock(self, request: dict[str, Any]) -> Response:
58         try:
59             sku = require_str(request, "sku")
60             quantity = require_positive_int(request.get("quantity"), "quantity")
61         except InvalidRequest as exc:
62             return bad_request(exc)
63         try:
64             on_hand = self._service.restock(sku, quantity)
65         except ProductNotFound:
66             return not_found("product")
67         return Response(200, {"sku": sku, "on_hand": on_hand})
