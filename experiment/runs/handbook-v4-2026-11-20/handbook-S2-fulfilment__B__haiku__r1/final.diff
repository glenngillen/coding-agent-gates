 1 """Packing slips for warehouse fulfilment."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_THRESHOLD = 5
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def summary(self) -> FulfilmentSummary:
24         """Count open (not cancelled) orders, their units, and active products low on stock."""
25         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
26         units = sum(item.quantity for order in open_orders for item in order.items)
27         low = len(self.low_stock(LOW_STOCK_THRESHOLD))
28         return FulfilmentSummary(len(open_orders), units, low)
29 
30     def restock(self, sku: str, quantity: int) -> int:
31         """Add units to a product's stock on hand and return the new level."""
32         if self._catalog.get(sku) is None:
33             raise ProductNotFound(sku)
34         new_level = self._stock.get(sku) + quantity
35         self._stock.set(sku, new_level)
36         return new_level
37 
38     def low_stock(self, threshold: int) -> list[LowStockProduct]:
39         """List active products with on-hand stock strictly below the threshold, lowest first."""
40         low = []
41         for product in self._catalog.list_all():
42             if not product.active:
43                 continue
44             on_hand = self._stock.get(product.sku)
45             if on_hand < threshold:
46                 low.append(LowStockProduct(product.sku, product.name, on_hand))
47         return sorted(low, key=lambda p: (p.on_hand, p.sku))
48 
49     def packing_slip(self, order_id: str) -> PackingSlip:
50         """Build the packing slip for a placed order, lines in the order's item order."""
51         order = self._orders.get(order_id)
52         if order is None:
53             raise OrderNotFound(order_id)
54         if order.status == "cancelled":
55             raise Conflict("order is cancelled")
56         customer = self._customers.get(order.customer_id)
57         if customer is None:
58             raise CustomerNotFound(order.customer_id)
59         lines = []
60         for item in order.items:
61             product = self._catalog.get(item.sku)
62             if product is None:
63                 raise ProductNotFound(item.sku)
64             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
65         return PackingSlip(order.order_id, customer.name, tuple(lines))
