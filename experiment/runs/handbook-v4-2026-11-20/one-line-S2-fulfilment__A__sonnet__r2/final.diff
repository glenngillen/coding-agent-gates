 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as exc:
23             return conflict(exc)
24         return Response(200, {
25             "order_id": slip.order_id,
26             "customer_name": slip.customer_name,
27             "lines": [{"sku": l.sku, "name": l.name, "quantity": l.quantity} for l in slip.lines],
28         })
29 
30     def handle_low_stock(self, threshold: Any) -> Response:
31         try:
32             limit = require_non_negative_int(threshold, "threshold")
33         except InvalidRequest as exc:
34             return bad_request(exc)
35         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
36                                            for p in self._service.low_stock(limit)]})
37 
38     def handle_fulfilment_summary(self) -> Response:
39         summary = self._service.summary()
40         return Response(200, {"open_orders": summary.open_orders,
41                               "units_to_pick": summary.units_to_pick,
42                               "low_stock_products": summary.low_stock_products})
43 
44     def handle_restock(self, request: dict[str, Any]) -> Response:
45         try:
46             sku = require_str(request, "sku")
47             quantity = require_positive_int(request.get("quantity"), "quantity")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         try:
51             on_hand = self._service.restock(sku, quantity)
52         except ProductNotFound:
53             return not_found("product")
54         return Response(200, {"sku": sku, "on_hand": on_hand})
