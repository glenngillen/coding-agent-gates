 1 """Fulfilment: packing slips for orders that are ready to pick."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_THRESHOLD = 5  # units on hand; the warehouse's low-stock line
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def packing_slip(self, order_id: str) -> PackingSlip:
24         """Build the packing slip for a placed order; cancelled orders are not packed."""
25         order = self._orders.get_order(order_id)
26         if order.status == "cancelled":
27             raise Conflict(f"order {order_id} is cancelled")
28         customer = self._customers.get(order.customer_id)
29         if customer is None:
30             raise CustomerNotFound(order.customer_id)
31         lines = []
32         for item in order.items:
33             product = self._catalog.get(item.sku)
34             if product is None:
35                 raise ProductNotFound(item.sku)
36             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
37         return PackingSlip(order.order_id, customer.name, tuple(lines))
38 
39     def low_stock(self, threshold: int) -> list[LowStockProduct]:
40         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
41         below = []
42         for product in self._catalog.list_all():
43             if not product.active:
44                 continue
45             on_hand = self._stock.get(product.sku)
46             if on_hand < threshold:
47                 below.append(LowStockProduct(product.sku, product.name, on_hand))
48         return sorted(below, key=lambda p: (p.on_hand, p.sku))
49 
50     def summary(self) -> FulfilmentSummary:
51         """Open order count, units to pick across open orders, and products at the low-stock line."""
52         open_orders = self._orders.open_orders()
53         units = sum(item.quantity for order in open_orders for item in order.items)
54         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_THRESHOLD)))
55 
56     def restock(self, sku: str, quantity: int) -> int:
57         """Add ``quantity`` units to a catalogue product and return the new level."""
58         if self._catalog.get(sku) is None:
59             raise ProductNotFound(sku)
60         new_level = self._stock.get(sku) + quantity
61         self._stock.set(sku, new_level)
62         return new_level
