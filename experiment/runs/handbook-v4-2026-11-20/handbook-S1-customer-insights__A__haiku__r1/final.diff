13 def history_entry(summary: OrderSummary) -> dict[str, Any]:
14     return {"order_id": summary.order.order_id, "status": summary.order.status,
15             "total_cents": summary.total_cents}
16 
17 
18 class CustomerInsightsController:
19     def __init__(self, service: OrderService) -> None:
20         self._service = service
21 
22     def handle_order_history(self, customer_id: str) -> Response:
23         try:
24             summaries = self._service.order_history(customer_id)
25         except CustomerNotFound:
26             return not_found("customer")
27         return Response(200, {"customer_id": customer_id,
28                               "orders": [history_entry(s) for s in summaries]})
29 
30     def handle_lifetime_value(self, customer_id: str) -> Response:
31         try:
32             value = self._service.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {"customer_id": customer_id, "order_count": value.order_count,
36                               "lifetime_value_cents": value.lifetime_value_cents})
37 
38     def handle_top_customers(self, limit: Any) -> Response:
39         try:
40             count = require_positive_int(limit, "limit")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         ranked = self._service.top_customers(count)
44         return Response(200, {"customers": [
45             {"customer_id": customer.customer_id, "name": customer.name,
46              "lifetime_value_cents": value.lifetime_value_cents}
47             for customer, value in ranked]})
48 
49     def handle_customers_without_orders(self) -> Response:
50         customers = self._service.customers_without_orders()
51         return Response(200, {"customers": [
52             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
