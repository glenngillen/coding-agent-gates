..  72     def lifetime_value(self, customer_id: str) -> CustomerLifetimeValue:
..  73         """Number and total of a customer's orders that are not cancelled."""
..  74         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
..  75         return CustomerLifetimeValue(len(active), sum(s.total_cents for s in active))
