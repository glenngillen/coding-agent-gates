..  77     def top_customers(self, limit: int) -> list[tuple[Customer, CustomerLifetimeValue]]:
..  78         """Customers with a positive lifetime value, highest first, ties by customer id."""
..  79         values: dict[str, CustomerLifetimeValue] = {}
..  80         for order in self._orders.list_all():
..  81             if order.status == "cancelled":
..  82                 continue
..  83             prior = values.get(order.customer_id, CustomerLifetimeValue(0, 0))
..  84             values[order.customer_id] = CustomerLifetimeValue(
..  85                 prior.order_count + 1, prior.lifetime_value_cents + self.summarize(order).total_cents)
..  86         customers = {c.customer_id: c for c in self._customers.list_all()}
..  87         ranked = [(customers[cid], value) for cid, value in values.items()
..  88                   if value.lifetime_value_cents > 0]
..  89         ranked.sort(key=lambda pair: (-pair[1].lifetime_value_cents, pair[0].customer_id))
..  90         return ranked[:limit]
