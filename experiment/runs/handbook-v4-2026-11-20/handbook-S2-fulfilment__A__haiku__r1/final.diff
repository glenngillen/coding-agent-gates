 1 """Fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import PackingSlip, StockLevel
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity} for line in slip.lines],
19     }
20 
21 
22 def stock_level_body(level: StockLevel) -> dict[str, Any]:
23     return {"sku": level.sku, "name": level.name, "on_hand": level.on_hand}
24 
25 
26 class FulfilmentController:
27     def __init__(self, service: FulfilmentService) -> None:
28         self._service = service
29 
30     def handle_packing_slip(self, order_id: str) -> Response:
31         try:
32             slip = self._service.packing_slip(order_id)
33         except OrderNotFound:
34             return not_found("order")
35         except CustomerNotFound:
36             return not_found("customer")
37         except ProductNotFound:
38             return not_found("product")
39         except Conflict as exc:
40             return conflict(exc)
41         return Response(200, packing_slip_body(slip))
42 
43     def handle_fulfilment_summary(self) -> Response:
44         summary = self._service.summary()
45         return Response(200, {
46             "open_orders": summary.open_orders,
47             "units_to_pick": summary.units_to_pick,
48             "low_stock_products": summary.low_stock_products,
49         })
50 
51     def handle_restock(self, request: dict[str, Any]) -> Response:
52         try:
53             sku = require_str(request, "sku")
54             quantity = require_positive_int(request.get("quantity"), "quantity")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         try:
58             on_hand = self._service.restock(sku, quantity)
59         except ProductNotFound:
60             return not_found("product")
61         return Response(200, {"sku": sku, "on_hand": on_hand})
62 
63     def handle_low_stock(self, threshold: Any) -> Response:
64         try:
65             limit = require_non_negative_int(threshold, "threshold")
66         except InvalidRequest as exc:
67             return bad_request(exc)
68         levels = self._service.low_stock(limit)
69         return Response(200, {"products": [stock_level_body(level) for level in levels]})
