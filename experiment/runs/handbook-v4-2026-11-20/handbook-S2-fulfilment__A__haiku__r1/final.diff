 1 """Warehouse fulfilment: packing slips for orders that are still to be shipped."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_LINE = 5
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def summary(self) -> FulfilmentSummary:
24         """Open order count, units across open orders, and products below the low-stock line."""
25         open_orders = [order for order in self._orders.list_all() if order.status != "cancelled"]
26         return FulfilmentSummary(
27             open_orders=len(open_orders),
28             units_to_pick=sum(item.quantity for order in open_orders for item in order.items),
29             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
30         )
31 
32     def restock(self, sku: str, quantity: int) -> int:
33         """Add ``quantity`` units to a product's stock and return the new level."""
34         if self._catalog.get(sku) is None:
35             raise ProductNotFound(sku)
36         new_level = self._stock.get(sku) + quantity
37         self._stock.set(sku, new_level)
38         return new_level
39 
40     def low_stock(self, threshold: int) -> list[StockLevel]:
41         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
42         levels = self._stock.all_levels()
43         below = [
44             StockLevel(product.sku, product.name, levels.get(product.sku, 0))
45             for product in self._catalog.list_all()
46             if product.active and levels.get(product.sku, 0) < threshold
47         ]
48         return sorted(below, key=lambda level: (level.on_hand, level.sku))
49 
50     def packing_slip(self, order_id: str) -> PackingSlip:
51         """Build the packing slip for an order, with lines in the order's item order."""
52         order = self._orders.get(order_id)
53         if order is None:
54             raise OrderNotFound(order_id)
55         if order.status == "cancelled":
56             raise Conflict("order is cancelled")
57         customer = self._customers.get(order.customer_id)
58         if customer is None:
59             raise CustomerNotFound(order.customer_id)
60         lines = []
61         for item in order.items:
62             product = self._catalog.get(item.sku)
63             if product is None:
64                 raise ProductNotFound(item.sku)
65             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
66         return PackingSlip(order.order_id, customer.name, tuple(lines))
