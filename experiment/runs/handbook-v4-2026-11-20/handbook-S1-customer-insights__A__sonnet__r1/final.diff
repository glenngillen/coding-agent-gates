 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """List a customer's orders, newest first, with discounted totals."""
18         try:
19             history = self._service.order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         orders = [{"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
23                   for s in history]
24         return Response(200, {"customer_id": customer_id, "orders": orders})
25 
26     def handle_top_customers(self, limit: Any) -> Response:
27         """List the highest-spending customers, at most ``limit`` of them."""
28         try:
29             limit = require_positive_int(limit, "limit")
30         except InvalidRequest as exc:
31             return bad_request(exc)
32         customers = [{"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value_cents}
33                      for c, value_cents in self._service.top_customers(limit)]
34         return Response(200, {"customers": customers})
35 
36     def handle_customers_without_orders(self) -> Response:
37         """List customers who have no non-cancelled orders, in registration order."""
38         customers = [{"customer_id": c.customer_id, "name": c.name, "email": c.email}
39                      for c in self._service.customers_without_orders()]
40         return Response(200, {"customers": customers})
41 
42     def handle_lifetime_value(self, customer_id: str) -> Response:
43         """Report a customer's non-cancelled order count and total spend."""
44         try:
45             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
46         except CustomerNotFound:
47             return not_found("customer")
48         return Response(200, {"customer_id": customer_id, "order_count": order_count,
49                               "lifetime_value_cents": lifetime_value_cents})
