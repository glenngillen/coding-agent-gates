 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
10                                      require_positive_int)
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService) -> None:
15         self._service = service
16 
17     def handle_order_history(self, customer_id: str) -> Response:
18         """A customer's orders, newest first, with discounted totals."""
19         try:
20             summaries = self._service.order_history(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         return Response(200, {
24             "customer_id": customer_id,
25             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
26                         "total_cents": s.total_cents} for s in summaries],
27         })
28 
29     def handle_lifetime_value(self, customer_id: str) -> Response:
30         """Count and total of a customer's non-cancelled orders."""
31         try:
32             order_count, value = self._service.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {
36             "customer_id": customer_id,
37             "order_count": order_count,
38             "lifetime_value_cents": value,
39         })
40 
41     def handle_customers_without_orders(self) -> Response:
42         """Registered customers with no non-cancelled orders, in registration order."""
43         return Response(200, {"customers": [
44             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
45             for c in self._service.customers_without_orders()
46         ]})
47 
48     def handle_top_customers(self, limit: Any) -> Response:
49         """Leaderboard of customers by lifetime value, highest first."""
50         try:
51             limit = require_positive_int(limit, "limit")
52         except InvalidRequest as exc:
53             return bad_request(exc)
54         return Response(200, {"customers": [
55             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
56             for c, value in self._service.top_customers(limit)
57         ]})
