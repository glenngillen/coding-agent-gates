.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries of all of a customer's orders (cancelled included), newest first."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(order) for order in reversed(orders)]
.. 72 
.. 73     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 74         """``(order_count, total_cents)`` over a customer's non-cancelled orders."""
.. 75         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return len(active), sum(s.total_cents for s in active)
.. 77 
.. 78     def customers_without_orders(self) -> list[Customer]:
.. 79         """Customers with no non-cancelled orders, in registration order."""
.. 80         return [c for c in self._customers.list_all()
.. 81                 if self.lifetime_value(c.customer_id)[0] == 0]
.. 82 
.. 83     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 84         """Customers with non-zero lifetime value, best first (ties by customer_id)."""
.. 85         ranked = []
.. 86         for customer in self._customers.list_all():
.. 87             _, value = self.lifetime_value(customer.customer_id)
.. 88             if value > 0:
.. 89                 ranked.append((customer, value))
.. 90         ranked.sort(key=lambda entry: (-entry[1], entry[0].customer_id))
.. 91         return ranked[:limit]
