 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.domain.orders import OrderSummary
11 
12 
13 def history_entry(summary: OrderSummary) -> dict[str, Any]:
14     return {"order_id": summary.order.order_id, "status": summary.order.status,
15             "total_cents": summary.total_cents}
16 
17 
18 class CustomerInsightsController:
19     def __init__(self, service: OrderService) -> None:
20         self._service = service
21 
22     def handle_order_history(self, customer_id: str) -> Response:
23         """A customer's orders, newest first, with the totals the order summary reports."""
24         try:
25             summaries = self._service.order_history(customer_id)
26         except CustomerNotFound:
27             return not_found("customer")
28         return Response(200, {"customer_id": customer_id,
29                               "orders": [history_entry(s) for s in summaries]})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         """How many live (not cancelled) orders a customer has and what they add up to."""
33         try:
34             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
35         except CustomerNotFound:
36             return not_found("customer")
37         return Response(200, {"customer_id": customer_id, "order_count": order_count,
38                               "lifetime_value_cents": lifetime_value_cents})
39 
40     def handle_customers_without_orders(self) -> Response:
41         """Registered customers with no live (not cancelled) orders, in registration order."""
42         customers = self._service.customers_without_orders()
43         return Response(200, {"customers": [
44             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
45 
46     def handle_top_customers(self, limit: Any) -> Response:
47         """Leaderboard of customers by lifetime value, highest first, excluding zero-value customers."""
48         try:
49             count = require_positive_int(limit, "limit")
50         except InvalidRequest as exc:
51             return bad_request(exc)
52         ranked = self._service.top_customers(count)
53         return Response(200, {"customers": [
54             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": cents}
55             for customer, cents in ranked]})
