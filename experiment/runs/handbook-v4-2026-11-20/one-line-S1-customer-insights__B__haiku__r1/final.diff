 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         try:
20             summaries = self._orders.order_history(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         order_entries: list[dict[str, Any]] = [
24             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
25             for s in summaries
26         ]
27         return Response(200, {"customer_id": customer_id, "orders": order_entries})
28 
29     def handle_lifetime_value(self, customer_id: str) -> Response:
30         """Non-cancelled order count and the sum of their totals (discounts included)."""
31         try:
32             order_count, value = self._lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {
36             "customer_id": customer_id,
37             "order_count": order_count,
38             "lifetime_value_cents": value,
39         })
40 
41     def handle_top_customers(self, limit: Any) -> Response:
42         """Customers ranked by lifetime value, highest first; zero-value customers are omitted."""
43         try:
44             limit = require_positive_int(limit, "limit")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         ranked = []
48         for customer in self._customers.list_all():
49             _, value = self._lifetime_value(customer.customer_id)
50             if value > 0:
51                 ranked.append((value, customer))
52         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
53         return Response(200, {"customers": [
54             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
55             for value, c in ranked[:limit]
56         ]})
57 
58     def handle_customers_without_orders(self) -> Response:
59         """Registered customers with no orders that are not cancelled, in registration order."""
60         customers = [
61             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
62             for c in self._customers.list_all()
63             if self._lifetime_value(c.customer_id)[0] == 0
64         ]
65         return Response(200, {"customers": customers})
66 
67     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
68         """Return (non-cancelled order count, sum of their totals). Raises CustomerNotFound."""
69         summaries = self._orders.order_history(customer_id)
70         active = [s for s in summaries if s.order.status != "cancelled"]
71         return len(active), sum(s.total_cents for s in active)
