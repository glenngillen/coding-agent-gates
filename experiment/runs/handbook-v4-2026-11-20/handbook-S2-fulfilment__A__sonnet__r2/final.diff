 1 """Warehouse fulfilment: packing slips for orders that are still to be shipped."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_LINE_UNITS = 5
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def summary(self) -> FulfilmentSummary:
24         """Summarise open orders, units to pick and products below the warehouse low-stock line."""
25         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
26         units_to_pick = sum(item.quantity for order in open_orders for item in order.items)
27         return FulfilmentSummary(len(open_orders), units_to_pick, len(self.low_stock(LOW_STOCK_LINE_UNITS)))
28 
29     def restock(self, sku: str, quantity: int) -> int:
30         """Add units to a product's stock and return the new level."""
31         if self._catalog.get(sku) is None:
32             raise ProductNotFound(sku)
33         on_hand = self._stock.get(sku) + quantity
34         self._stock.set(sku, on_hand)
35         return on_hand
36 
37     def low_stock(self, threshold: int) -> list[LowStockProduct]:
38         """List active products with stock below the threshold, lowest stock first then by sku."""
39         products = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
40                     for p in self._catalog.list_all() if p.active]
41         low = [p for p in products if p.on_hand < threshold]
42         return sorted(low, key=lambda p: (p.on_hand, p.sku))
43 
44     def packing_slip(self, order_id: str) -> PackingSlip:
45         """Build the packing slip for an order that has not been cancelled."""
46         order = self._orders.get(order_id)
47         if order is None:
48             raise OrderNotFound(order_id)
49         if order.status == "cancelled":
50             raise Conflict(f"order {order_id} is cancelled")
51         customer = self._customers.get(order.customer_id)
52         customer_name = customer.name if customer is not None else order.customer_id
53         lines = []
54         for item in order.items:
55             product = self._catalog.get(item.sku)
56             lines.append(PackingSlipLine(item.sku, product.name if product is not None else item.sku,
57                                          item.quantity))
58         return PackingSlip(order.order_id, customer_name, tuple(lines))
