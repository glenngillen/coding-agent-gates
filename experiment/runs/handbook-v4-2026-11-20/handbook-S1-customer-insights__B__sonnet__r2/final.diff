 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """List a customer's orders, newest first, with their summary totals."""
18         try:
19             summaries = self._service.order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         orders = [{"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
23                   for s in summaries]
24         return Response(200, {"customer_id": customer_id, "orders": orders})
25 
26     def handle_customers_without_orders(self) -> Response:
27         """List customers who have no non-cancelled orders, in registration order."""
28         customers = self._service.customers_without_orders()
29         return Response(200, {"customers": [
30             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
31 
32     def handle_top_customers(self, limit: Any) -> Response:
33         """Rank customers by lifetime value, returning at most ``limit`` entries."""
34         try:
35             limit = require_positive_int(limit, "limit")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         ranked = self._service.top_customers(limit)
39         return Response(200, {"customers": [
40             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
41             for c, value in ranked]})
42 
43     def handle_lifetime_value(self, customer_id: str) -> Response:
44         """Report how many non-cancelled orders a customer has and what they total."""
45         try:
46             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
47         except CustomerNotFound:
48             return not_found("customer")
49         return Response(200, {"customer_id": customer_id, "order_count": order_count,
50                               "lifetime_value_cents": lifetime_value_cents})
