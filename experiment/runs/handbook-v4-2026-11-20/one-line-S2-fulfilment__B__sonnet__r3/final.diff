src/orders/controllers/fulfilment.py --- Python
 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as exc:
23             return conflict(exc)
24         return Response(200, {
25             "order_id": slip.order_id,
26             "customer_name": slip.customer_name,
27             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
28                       for line in slip.lines],
29         })
30 
31     def handle_fulfilment_summary(self) -> Response:
32         summary = self._service.summary()
33         return Response(200, {"open_orders": summary.open_orders,
34                               "units_to_pick": summary.units_to_pick,
35                               "low_stock_products": summary.low_stock_products})
36 
37     def handle_restock(self, request: dict[str, Any]) -> Response:
38         try:
39             sku = require_str(request, "sku")
40             quantity = require_positive_int(request.get("quantity"), "quantity")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         try:
44             on_hand = self._service.restock(sku, quantity)
45         except ProductNotFound:
46             return not_found("product")
47         return Response(200, {"sku": sku, "on_hand": on_hand})
48 
49     def handle_low_stock(self, threshold: Any) -> Response:
50         try:
51             limit = require_non_negative_int(threshold, "threshold")
52         except InvalidRequest as exc:
53             return bad_request(exc)
54         items = self._service.low_stock(limit)
55         return Response(200, {"products": [{"sku": i.sku, "name": i.name, "on_hand": i.on_hand}
56                                            for i in items]})
57 

