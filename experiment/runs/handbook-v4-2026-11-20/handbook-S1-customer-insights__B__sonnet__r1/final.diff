.. 73     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 74         """Return the count and total cents of a customer's orders that are not cancelled."""
.. 75         summaries = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return len(summaries), sum(s.total_cents for s in summaries)
