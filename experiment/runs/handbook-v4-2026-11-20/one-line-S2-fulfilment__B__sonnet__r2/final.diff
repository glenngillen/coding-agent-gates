45 class FulfilmentService:
46     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def packing_slip(self, order_id: str) -> PackingSlip:
54         order = self._orders.get_order(order_id)
55         if order.status == "cancelled":
56             raise Conflict(f"order {order_id} is cancelled")
57         customer = self._customers.get(order.customer_id)
58         lines = []
59         for item in order.items:
60             product = self._catalog.get(item.sku)
61             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
62         return PackingSlip(order_id, customer.name if customer else "", tuple(lines))
63 
64     def summary(self) -> FulfilmentSummary:
65         open_orders = self._orders.list_open()
66         units = sum(item.quantity for order in open_orders for item in order.items)
67         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
68 
69     def restock(self, sku: str, quantity: int) -> int:
70         """Add ``quantity`` units to the product's stock and return the new level."""
71         if self._catalog.get(sku) is None:
72             raise ProductNotFound(sku)
73         level = self._stock.get(sku) + quantity
74         self._stock.set(sku, level)
75         return level
76 
77     def low_stock(self, threshold: int) -> list[LowStockProduct]:
78         """Active products with stock strictly below ``threshold``, lowest stock first."""
79         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
80                  for p in self._catalog.list_all() if p.active]
81         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
