 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import (Conflict, CustomerNotFound, OrderNotFound,
 8                                        ProductNotFound)
 9 from orders.application.fulfilment_service import FulfilmentService
10 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
11                                      require_non_negative_int, require_positive_int, require_str)
12 
13 
14 class FulfilmentController:
15     def __init__(self, service: FulfilmentService) -> None:
16         self._service = service
17 
18     def handle_packing_slip(self, order_id: str) -> Response:
19         try:
20             slip = self._service.packing_slip(order_id)
21         except OrderNotFound:
22             return not_found("order")
23         except Conflict as exc:
24             return conflict(exc)
25         except CustomerNotFound:
26             return not_found("customer")
27         except ProductNotFound:
28             return not_found("product")
29         body: dict[str, Any] = {
30             "order_id": slip.order_id,
31             "customer_name": slip.customer_name,
32             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
33                       for line in slip.lines],
34         }
35         return Response(200, body)
36 
37     def handle_fulfilment_summary(self) -> Response:
38         summary = self._service.summary()
39         return Response(200, {"open_orders": summary.open_orders,
40                               "units_to_pick": summary.units_to_pick,
41                               "low_stock_products": summary.low_stock_products})
42 
43     def handle_restock(self, request: Any) -> Response:
44         if not isinstance(request, dict):
45             return bad_request(InvalidRequest("request must be an object"))
46         try:
47             sku = require_str(request, "sku")
48             quantity = require_positive_int(request.get("quantity"), "quantity")
49         except InvalidRequest as exc:
50             return bad_request(exc)
51         try:
52             on_hand = self._service.restock(sku, quantity)
53         except ProductNotFound:
54             return not_found("product")
55         return Response(200, {"sku": sku, "on_hand": on_hand})
56 
57     def handle_low_stock(self, threshold: Any) -> Response:
58         try:
59             threshold = require_non_negative_int(threshold, "threshold")
60         except InvalidRequest as exc:
61             return bad_request(exc)
62         levels = self._service.low_stock(threshold)
63         return Response(200, {"products": [
64             {"sku": level.product.sku, "name": level.product.name, "on_hand": level.on_hand}
65             for level in levels]})
