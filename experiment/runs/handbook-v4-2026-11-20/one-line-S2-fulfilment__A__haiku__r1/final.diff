43 LOW_STOCK_LINE = 5  # the warehouse's low-stock threshold
44 
45 
46 class FulfilmentService:
47     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
48                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52         self._stock = stock
53 
54     def summary(self) -> FulfilmentSummary:
55         """Dashboard figures: open orders, units to pick across them, and low-stock products."""
56         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
57         return FulfilmentSummary(
58             open_orders=len(open_orders),
59             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
60             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
61         )
62 
63     def restock(self, sku: str, quantity: int) -> int:
64         """Add ``quantity`` units to a product's stock and return the new on-hand level."""
65         self._product_name(sku)  # raises ProductNotFound for unknown SKUs
66         new_level = self._stock.get(sku) + quantity
67         self._stock.set(sku, new_level)
68         return new_level
69 
70     def low_stock(self, threshold: int) -> list[StockLevel]:
71         """Active products with on-hand stock strictly below ``threshold``, lowest first, then by SKU."""
72         levels = [StockLevel(p, self._stock.get(p.sku)) for p in self._catalog.list_all() if p.active]
73         below = [level for level in levels if level.on_hand < threshold]
74         return sorted(below, key=lambda level: (level.on_hand, level.product.sku))
75 
76     def packing_slip(self, order_id: str) -> PackingSlip:
77         order = self._get_order(order_id)
78         if order.status == "cancelled":
79             raise Conflict(f"order {order_id} is cancelled")
80         customer = self._customers.get(order.customer_id)
81         if customer is None:
82             raise CustomerNotFound(order.customer_id)
83         lines = tuple(PackingLine(item.sku, self._product_name(item.sku), item.quantity)
84                       for item in order.items)
85         return PackingSlip(order.order_id, customer.name, lines)
86 
87     def _get_order(self, order_id: str) -> Order:
88         order = self._orders.get(order_id)
89         if order is None:
90             raise OrderNotFound(order_id)
91         return order
92 
93     def _product_name(self, sku: str) -> str:
94         product = self._catalog.get(sku)
95         if product is None:
96             raise ProductNotFound(sku)
97         return product.name
