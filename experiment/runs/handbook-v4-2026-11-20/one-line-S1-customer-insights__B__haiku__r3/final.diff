 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the same totals as the order summary."""
20         try:
21             summaries = self._orders.summaries_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         orders: list[dict[str, Any]] = [
25             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
26             for s in summaries
27         ]
28         return Response(200, {"customer_id": customer_id, "orders": orders})
29 
30     def handle_lifetime_value(self, customer_id: str) -> Response:
31         """Count and total of a customer's orders, excluding cancelled ones."""
32         try:
33             count, total = self._lifetime_value(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         return Response(200, {"customer_id": customer_id, "order_count": count,
37                               "lifetime_value_cents": total})
38 
39     def handle_top_customers(self, limit: Any) -> Response:
40         """Customers with the highest lifetime value (zero-value customers left out)."""
41         try:
42             limit = require_positive_int(limit, "limit")
43         except InvalidRequest as exc:
44             return bad_request(exc)
45         ranked = []
46         for customer in self._customers.list_all():
47             _, total = self._lifetime_value(customer.customer_id)
48             if total > 0:
49                 ranked.append((total, customer))
50         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
51         return Response(200, {"customers": [
52             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
53             for total, c in ranked[:limit]
54         ]})
55 
56     def handle_customers_without_orders(self) -> Response:
57         """Registered customers with no orders that are not cancelled, in registration order."""
58         customers = []
59         for customer in self._customers.list_all():
60             count, _ = self._lifetime_value(customer.customer_id)
61             if count == 0:
62                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
63                                   "email": customer.email})
64         return Response(200, {"customers": customers})
65 
66     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
67         """(number of non-cancelled orders, sum of their totals). Raises CustomerNotFound."""
68         summaries = self._orders.summaries_for_customer(customer_id)
69         active = [s for s in summaries if s.order.status != "cancelled"]
70         return len(active), sum(s.total_cents for s in active)
