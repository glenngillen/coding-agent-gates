src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the discounted total of each."""
20         try:
21             orders = self._orders.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         entries: list[dict[str, Any]] = [
25             {"order_id": order.order_id, "status": order.status,
26              "total_cents": self._orders.summarize(order).total_cents}
27             for order in reversed(orders)  # service returns creation order; ids increase with it
28         ]
29         return Response(200, {"customer_id": customer_id, "orders": entries})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         """Count and total of a customer's orders, excluding cancelled ones."""
33         try:
34             count, total = self._lifetime_value(customer_id)
35         except CustomerNotFound:
36             return not_found("customer")
37         return Response(200, {"customer_id": customer_id, "order_count": count,
38                               "lifetime_value_cents": total})
39 
40     def handle_top_customers(self, limit: Any) -> Response:
41         """Customers ranked by lifetime value, highest first (ties by customer_id).
42 
43         Customers with a lifetime value of zero are left out.
44         """
45         try:
46             limit = require_positive_int(limit, "limit")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         ranked = []
50         for customer in self._customers.list_all():
51             _, total = self._lifetime_value(customer.customer_id)
52             if total > 0:
53                 ranked.append((total, customer))
54         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
55         entries = [{"customer_id": customer.customer_id, "name": customer.name,
56                     "lifetime_value_cents": total}
57                    for total, customer in ranked[:limit]]
58         return Response(200, {"customers": entries})
59 
60     def handle_customers_without_orders(self) -> Response:
61         """Registered customers with no orders that are not cancelled, in registration order."""
62         entries = [{"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
63                    for customer in self._customers.list_all()
64                    if self._lifetime_value(customer.customer_id)[0] == 0]
65         return Response(200, {"customers": entries})
66 
67     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
68         """(number of non-cancelled orders, sum of their discounted totals).
69 
70         Raises CustomerNotFound for unknown customers.
71         """
72         orders = self._orders.list_for_customer(customer_id)
73         active = [order for order in orders if order.status != "cancelled"]
74         return len(active), sum(self._orders.summarize(order).total_cents for order in active)
