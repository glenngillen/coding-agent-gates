.. 73     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 74         """``(order_count, total_cents)`` over the customer's non-cancelled orders."""
.. 75         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return len(active), sum(s.total_cents for s in active)
.. 77 
.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 79         """Customers with non-zero lifetime value, highest first then by id, at most ``limit``."""
.. 80         ranked = []
.. 81         for customer in self._customers.list_all():
.. 82             _, value = self.lifetime_value(customer.customer_id)
.. 83             if value > 0:
.. 84                 ranked.append((customer, value))
.. 85         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 86         return ranked[:limit]
