38 class FulfilmentService:
39     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
40                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
41         self._orders = orders
42         self._customers = customers
43         self._catalog = catalog
44         self._stock = stock
45 
46     def restock(self, sku: str, quantity: int) -> int:
47         """Add ``quantity`` units to a known product's stock and return the new level."""
48         if self._catalog.get(sku) is None:
49             raise ProductNotFound(sku)
50         new_level = self._stock.get(sku) + quantity
51         self._stock.set(sku, new_level)
52         return new_level
53 
54     def fulfilment_summary(self) -> tuple[int, int, int]:
55         """Return ``(open_orders, units_to_pick, low_stock_products)``.
56 
57         Open orders are those not cancelled; units are summed over those orders.
58         Low stock uses the warehouse's 5-unit line.
59         """
60         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
61         units = sum(item.quantity for o in open_orders for item in o.items)
62         return len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE))
63 
64     def low_stock(self, threshold: int) -> list[LowStockProduct]:
65         """Active products with fewer than ``threshold`` units on hand, lowest first, then by SKU."""
66         products = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
67                     for p in self._catalog.list_all() if p.active]
68         low = [p for p in products if p.on_hand < threshold]
69         return sorted(low, key=lambda p: (p.on_hand, p.sku))
70 
71     def packing_slip(self, order_id: str) -> PackingSlip:
72         """Build the packing slip for a placed order.
73 
74         Raises OrderNotFound for an unknown order and Conflict for a cancelled one.
75         """
76         order = self._orders.get(order_id)
77         if order is None:
78             raise OrderNotFound(order_id)
79         if order.status == "cancelled":
80             raise Conflict(f"order {order_id} is cancelled")
81         customer = self._customers.get(order.customer_id)
82         if customer is None:
83             raise CustomerNotFound(order.customer_id)
84         lines = []
85         for item in order.items:
86             product = self._catalog.get(item.sku)
87             if product is None:
88                 raise ProductNotFound(item.sku)
89             lines.append(PackingLine(item.sku, product.name, item.quantity))
90         return PackingSlip(order.order_id, customer.name, tuple(lines))
