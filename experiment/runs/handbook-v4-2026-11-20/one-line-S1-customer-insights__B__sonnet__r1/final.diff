 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from typing import Any
 8 
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_lifetime_value(self, customer_id: str) -> Response:
17         """Count and total of the customer's orders that are not cancelled."""
18         try:
19             count, total = self._service.lifetime_value(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         return Response(200, {
23             "customer_id": customer_id,
24             "order_count": count,
25             "lifetime_value_cents": total,
26         })
27 
28     def handle_customers_without_orders(self) -> Response:
29         """Customers with no non-cancelled orders, in registration order."""
30         return Response(200, {"customers": [
31             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
32             for c in self._service.customers_without_active_orders()]})
33 
34     def handle_top_customers(self, limit: Any) -> Response:
35         """Customers ranked by lifetime value (highest first, then id), zero excluded."""
36         try:
37             limit = require_positive_int(limit, "limit")
38         except InvalidRequest as exc:
39             return bad_request(exc)
40         ranked = sorted(((c, v) for c, v in self._service.lifetime_values() if v > 0),
41                         key=lambda cv: (-cv[1], cv[0].customer_id))
42         return Response(200, {"customers": [
43             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": v}
44             for c, v in ranked[:limit]]})
45 
46     def handle_order_history(self, customer_id: str) -> Response:
47         """A customer's orders, newest first, with discounted totals."""
48         try:
49             summaries = self._service.order_history(customer_id)
50         except CustomerNotFound:
51             return not_found("customer")
52         return Response(200, {
53             "customer_id": customer_id,
54             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
55                         "total_cents": s.total_cents} for s in summaries],
56         })
