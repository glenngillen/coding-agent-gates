 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
 8 
 9 
10 class CustomerInsightsController:
11     def __init__(self, service: OrderService) -> None:
12         self._service = service
13 
14     def handle_order_history(self, customer_id: str) -> Response:
15         """Return a customer's orders, newest first, with discounted totals."""
16         try:
17             summaries = self._service.order_history(customer_id)
18         except CustomerNotFound:
19             return not_found("customer")
20         orders = [{"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
21                   for s in summaries]
22         return Response(200, {"customer_id": customer_id, "orders": orders})
23 
24     def handle_top_customers(self, limit: int) -> Response:
25         """Return the customers with the highest lifetime value, at most ``limit``."""
26         try:
27             limit = require_positive_int(limit, "limit")
28         except InvalidRequest as exc:
29             return bad_request(exc)
30         customers = [{"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value_cents}
31                      for c, value_cents in self._service.top_customers(limit)]
32         return Response(200, {"customers": customers})
33 
34     def handle_customers_without_orders(self) -> Response:
35         """Return registered customers who have no orders that are not cancelled."""
36         customers = [{"customer_id": c.customer_id, "name": c.name, "email": c.email}
37                      for c in self._service.customers_without_orders()]
38         return Response(200, {"customers": customers})
39 
40     def handle_lifetime_value(self, customer_id: str) -> Response:
41         """Return a customer's non-cancelled order count and their combined total."""
42         try:
43             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
44         except CustomerNotFound:
45             return not_found("customer")
46         return Response(200, {"customer_id": customer_id, "order_count": order_count,
47                               "lifetime_value_cents": lifetime_value_cents})
