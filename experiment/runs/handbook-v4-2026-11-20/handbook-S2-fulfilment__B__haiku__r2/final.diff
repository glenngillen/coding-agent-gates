src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders that are still to be shipped."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # The warehouse's low-stock line: products with fewer units than this on hand are low.
13 LOW_STOCK_THRESHOLD = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def get_summary(self) -> FulfilmentSummary:
25         """Count open (not cancelled) orders, their units to pick, and low-stock products."""
26         open_orders = [order for order in self._orders.list_all() if order.status != "cancelled"]
27         units = sum(item.quantity for order in open_orders for item in order.items)
28         low_stock = len(self.get_low_stock(LOW_STOCK_THRESHOLD))
29         return FulfilmentSummary(len(open_orders), units, low_stock)
30 
31     def restock(self, sku: str, quantity: int) -> int:
32         """Add ``quantity`` units to a product's stock and return the new level."""
33         if self._catalog.get(sku) is None:
34             raise ProductNotFound(sku)
35         new_level = self._stock.get(sku) + quantity
36         self._stock.set(sku, new_level)
37         return new_level
38 
39     def get_low_stock(self, threshold: int) -> list[StockLevel]:
40         """List active products with stock strictly below ``threshold``, lowest stock first."""
41         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
42                   for p in self._catalog.list_all() if p.active]
43         return sorted((level for level in levels if level.on_hand < threshold),
44                       key=lambda level: (level.on_hand, level.sku))
45 
46     def get_packing_slip(self, order_id: str) -> PackingSlip:
47         """Build the packing slip for a placed order, with lines in the order's item order."""
48         order = self._orders.get(order_id)
49         if order is None:
50             raise OrderNotFound(order_id)
51         if order.status == "cancelled":
52             raise Conflict("order is cancelled")
53         customer = self._customers.get(order.customer_id)
54         if customer is None:
55             raise CustomerNotFound(order.customer_id)
56         lines = []
57         for item in order.items:
58             product = self._catalog.get(item.sku)
59             if product is None:
60                 raise ProductNotFound(item.sku)
61             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
62         return PackingSlip(order.order_id, customer.name, tuple(lines))
