src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity} for line in slip.lines],
19     }
20 
21 
22 class FulfilmentController:
23     def __init__(self, service: FulfilmentService) -> None:
24         self._service = service
25 
26     def handle_restock(self, request: dict[str, Any]) -> Response:
27         try:
28             sku = require_str(request, "sku")
29             quantity = require_positive_int(request.get("quantity"), "quantity")
30         except InvalidRequest as exc:
31             return bad_request(exc)
32         try:
33             on_hand = self._service.restock(sku, quantity)
34         except ProductNotFound:
35             return not_found("product")
36         return Response(200, {"sku": sku, "on_hand": on_hand})
37 
38     def handle_fulfilment_summary(self) -> Response:
39         summary = self._service.get_summary()
40         return Response(200, {"open_orders": summary.open_orders,
41                               "units_to_pick": summary.units_to_pick,
42                               "low_stock_products": summary.low_stock_products})
43 
44     def handle_low_stock(self, threshold: Any) -> Response:
45         try:
46             limit = require_non_negative_int(threshold, "threshold")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         levels = self._service.get_low_stock(limit)
50         return Response(200, {"products": [{"sku": level.sku, "name": level.name, "on_hand": level.on_hand}
51                                            for level in levels]})
52 
53     def handle_packing_slip(self, order_id: str) -> Response:
54         try:
55             slip = self._service.get_packing_slip(order_id)
56         except OrderNotFound:
57             return not_found("order")
58         except Conflict as exc:
59             return conflict(exc)
60         except CustomerNotFound:
61             return not_found("customer")
62         except ProductNotFound:
63             return not_found("product")
64         return Response(200, packing_slip_body(slip))
