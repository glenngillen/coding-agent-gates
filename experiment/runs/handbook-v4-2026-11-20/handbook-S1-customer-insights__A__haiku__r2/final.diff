24 def contact_entry(customer: Customer) -> dict[str, Any]:
25     return {"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
26 
27 
28 class CustomerInsightsController:
29     def __init__(self, orders: OrderService) -> None:
30         self._orders = orders
31 
32     def handle_order_history(self, customer_id: str) -> Response:
33         """Every order for a customer, newest first, with its total after discount."""
34         try:
35             summaries = self._orders.order_history(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         return Response(200, {"customer_id": customer_id,
39                               "orders": [history_entry(s) for s in summaries]})
40 
41     def handle_lifetime_value(self, customer_id: str) -> Response:
42         """Count and total of a customer's orders, leaving out cancelled ones."""
43         try:
44             order_count, lifetime_value_cents = self._orders.lifetime_value(customer_id)
45         except CustomerNotFound:
46             return not_found("customer")
47         return Response(200, {"customer_id": customer_id, "order_count": order_count,
48                               "lifetime_value_cents": lifetime_value_cents})
49 
50     def handle_top_customers(self, limit: Any) -> Response:
51         """Customers with the highest lifetime value, at most ``limit`` of them."""
52         try:
53             count = require_positive_int(limit, "limit")
54         except InvalidRequest as exc:
55             return bad_request(exc)
56         ranked = self._orders.top_customers(count)
57         return Response(200, {"customers": [leaderboard_entry(c, value) for c, value in ranked]})
58 
59     def handle_customers_without_orders(self) -> Response:
60         """Registered customers who have no orders that are not cancelled, in registration order."""
61         customers = self._orders.customers_without_orders()
62         return Response(200, {"customers": [contact_entry(c) for c in customers]})
