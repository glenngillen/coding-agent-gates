14 def history_entry(summary: OrderSummary) -> dict[str, Any]:
15     return {"order_id": summary.order.order_id, "status": summary.order.status,
16             "total_cents": summary.total_cents}
17 
18 
19 def leaderboard_entry(customer: Customer, lifetime_value_cents: int) -> dict[str, Any]:
20     return {"customer_id": customer.customer_id, "name": customer.name,
21             "lifetime_value_cents": lifetime_value_cents}
22 
