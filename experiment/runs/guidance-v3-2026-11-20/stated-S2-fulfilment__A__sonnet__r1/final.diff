 1 """Warehouse fulfilment: packing slips for orders that are still to be shipped."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockItem, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 
13 LOW_STOCK_LINE = 5  # the warehouse's low-stock line: fewer units than this is "low"
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def restock(self, sku: str, quantity: int) -> int:
25         """Add ``quantity`` units to a product's stock and return the new level."""
26         if self._catalog.get(sku) is None:
27             raise ProductNotFound(sku)
28         level = self._stock.get(sku) + quantity
29         self._stock.set(sku, level)
30         return level
31 
32     def summary(self) -> FulfilmentSummary:
33         """Dashboard figures: open orders, units to pick, and products below the low-stock line."""
34         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
35         units = sum(item.quantity for o in open_orders for item in o.items)
36         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
37 
38     def low_stock(self, threshold: int) -> list[LowStockItem]:
39         """Active products with stock strictly below ``threshold``, lowest stock then SKU first."""
40         items = [LowStockItem(p.sku, p.name, self._stock.get(p.sku))
41                  for p in self._catalog.list_all() if p.active]
42         return sorted((i for i in items if i.on_hand < threshold), key=lambda i: (i.on_hand, i.sku))
43 
44     def packing_slip(self, order_id: str) -> PackingSlip:
45         order = self._orders.get(order_id)
46         if order is None:
47             raise OrderNotFound(order_id)
48         if order.status == "cancelled":
49             raise Conflict(f"order {order_id} is cancelled")
50         customer = self._customers.get(order.customer_id)
51         customer_name = customer.name if customer is not None else ""
52         lines = []
53         for item in order.items:
54             product = self._catalog.get(item.sku)
55             lines.append(PackingSlipLine(item.sku, product.name if product is not None else item.sku,
56                                          item.quantity))
57         return PackingSlip(order.order_id, customer_name, tuple(lines))
