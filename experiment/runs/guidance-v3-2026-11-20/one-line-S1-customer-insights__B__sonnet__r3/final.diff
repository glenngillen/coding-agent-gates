.. 72     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 73         """``(order_count, total_cents)`` over a customer's non-cancelled orders."""
.. 74         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 75         return len(active), sum(s.total_cents for s in active)
