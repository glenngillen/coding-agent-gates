 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_lifetime_value(self, customer_id: str) -> Response:
17         """Count and discounted total of a customer's non-cancelled orders."""
18         try:
19             count, value = self._service.lifetime_value(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         return Response(200, {
23             "customer_id": customer_id,
24             "order_count": count,
25             "lifetime_value_cents": value,
26         })
27 
28     def handle_customers_without_orders(self) -> Response:
29         """Customers who have no non-cancelled orders, in registration order."""
30         return Response(200, {"customers": [
31             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
32             for c in self._service.customers_without_orders()]})
33 
34     def handle_top_customers(self, limit: Any) -> Response:
35         """Leaderboard of customers by lifetime value, highest first."""
36         try:
37             limit = require_positive_int(limit, "limit")
38         except InvalidRequest as exc:
39             return bad_request(exc)
40         return Response(200, {"customers": [
41             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
42             for c, value in self._service.top_customers(limit)]})
43 
44     def handle_order_history(self, customer_id: str) -> Response:
45         """A customer's orders, newest first, with discounted totals."""
46         try:
47             summaries = self._service.order_history(customer_id)
48         except CustomerNotFound:
49             return not_found("customer")
50         return Response(200, {
51             "customer_id": customer_id,
52             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
53                         "total_cents": s.total_cents} for s in summaries],
54         })
