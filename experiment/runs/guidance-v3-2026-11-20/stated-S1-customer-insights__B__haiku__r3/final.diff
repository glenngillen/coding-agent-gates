src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_insights import CustomerInsightsService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: CustomerInsightsService) -> None:
14         self._service = service
15 
16     def handle_top_customers(self, limit: Any) -> Response:
17         try:
18             limit = require_positive_int(limit, "limit")
19         except InvalidRequest as exc:
20             return bad_request(exc)
21         customers = [{"customer_id": c.customer_id, "name": c.name,
22                       "lifetime_value_cents": c.lifetime_value_cents}
23                      for c in self._service.top_customers(limit)]
24         return Response(200, {"customers": customers})
25 
26     def handle_customers_without_orders(self) -> Response:
27         customers = [{"customer_id": c.customer_id, "name": c.name, "email": c.email}
28                      for c in self._service.customers_without_orders()]
29         return Response(200, {"customers": customers})
30 
31     def handle_order_history(self, customer_id: str) -> Response:
32         try:
33             summaries = self._service.order_history(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         orders: list[dict[str, Any]] = [
37             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
38             for s in summaries
39         ]
40         return Response(200, {"customer_id": customer_id, "orders": orders})
41 
42     def handle_lifetime_value(self, customer_id: str) -> Response:
43         try:
44             value = self._service.lifetime_value(customer_id)
45         except CustomerNotFound:
46             return not_found("customer")
47         return Response(200, {"customer_id": value.customer_id, "order_count": value.order_count,
48                               "lifetime_value_cents": value.lifetime_value_cents})
49 

