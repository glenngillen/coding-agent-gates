 1 """Customer-level views for the account team, built on order summaries."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.order_service import OrderService
 8 from orders.domain.customers import Customer
 9 from orders.domain.orders import OrderSummary
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 
13 @dataclass(frozen=True)
14 class LifetimeValue:
15     customer_id: str
16     order_count: int
17     lifetime_value_cents: int
18 
19 
20 @dataclass(frozen=True)
21 class TopCustomer:
22     customer_id: str
23     name: str
24     lifetime_value_cents: int
25 
26 
27 class CustomerInsightsService:
28     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository) -> None:
29         self._orders = orders
30         self._customers = customers
31 
32     def top_customers(self, limit: int) -> list[TopCustomer]:
33         """Customers with a non-zero lifetime value, highest first, ties broken by customer_id.
34 
35         At most ``limit`` entries are returned.
36         """
37         ranked = []
38         for customer in self._customers.list_all():
39             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
40             if value > 0:
41                 ranked.append(TopCustomer(customer.customer_id, customer.name, value))
42         ranked.sort(key=lambda c: (-c.lifetime_value_cents, c.customer_id))
43         return ranked[:limit]
44 
45     def customers_without_orders(self) -> list[Customer]:
46         """Registered customers with no orders that are not cancelled, in registration order."""
47         return [c for c in self._customers.list_all()
48                 if self.lifetime_value(c.customer_id).order_count == 0]
49 
50     def order_history(self, customer_id: str) -> list[OrderSummary]:
51         """Every order for the customer, newest first, priced as ``get_order_summary`` prices it.
52 
53         Raises ``CustomerNotFound`` if the customer does not exist.
54         """
55         orders = self._orders.list_for_customer(customer_id)
56         return [self._orders.summarize(order) for order in reversed(orders)]
57 
58     def lifetime_value(self, customer_id: str) -> LifetimeValue:
59         """Count and total of the customer's orders that are not cancelled.
60 
61         Totals include discounts, as in ``order_history``.
62         Raises ``CustomerNotFound`` if the customer does not exist.
63         """
64         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
65         return LifetimeValue(customer_id, len(active), sum(s.total_cents for s in active))
