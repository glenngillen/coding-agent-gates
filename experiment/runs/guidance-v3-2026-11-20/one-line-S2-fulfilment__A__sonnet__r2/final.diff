28 LOW_STOCK_THRESHOLD = 5  # the warehouse's low-stock line
29 
30 
31 @dataclass(frozen=True)
32 class FulfilmentSummary:
33     open_orders: int
34     units_to_pick: int
35     low_stock_products: int
36 
37 
38 @dataclass(frozen=True)
39 class LowStockProduct:
40     sku: str
41     name: str
42     on_hand: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def summary(self) -> FulfilmentSummary:
54         """Open (not cancelled) orders, units to pick across them, and low-stock product count."""
55         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
56         units = sum(item.quantity for o in open_orders for item in o.items)
57         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_THRESHOLD)))
58 
59     def restock(self, sku: str, quantity: int) -> int:
60         """Add ``quantity`` units to a product's stock and return the new level."""
61         if self._catalog.get(sku) is None:
62             raise ProductNotFound(sku)
63         level = self._stock.get(sku) + quantity
64         self._stock.set(sku, level)
65         return level
66 
67     def low_stock(self, threshold: int) -> list[LowStockProduct]:
68         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
69         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
70                  for p in self._catalog.list_all() if p.active]
71         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
72 
73     def packing_slip(self, order_id: str) -> PackingSlip:
74         order = self._orders.get(order_id)
75         if order is None:
76             raise OrderNotFound(order_id)
77         if order.status == "cancelled":
78             raise Conflict(f"order {order_id} is cancelled")
79         customer = self._customers.get(order.customer_id)
80         if customer is None:
81             raise CustomerNotFound(order.customer_id)
82         lines = []
83         for item in order.items:
84             product = self._catalog.get(item.sku)
85             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
86         return PackingSlip(order.order_id, customer.name, tuple(lines))
