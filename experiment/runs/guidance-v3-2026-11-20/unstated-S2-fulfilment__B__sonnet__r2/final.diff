 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         """What the warehouse needs to pack an order."""
19         try:
20             slip = self._service.packing_slip(order_id)
21         except OrderNotFound:
22             return not_found("order")
23         except Conflict as exc:
24             return conflict(exc)
25         return Response(200, {
26             "order_id": slip.order_id,
27             "customer_name": slip.customer_name,
28             "lines": [{"sku": l.sku, "name": l.name, "quantity": l.quantity} for l in slip.lines],
29         })
30 
31     def handle_restock(self, request: dict[str, Any]) -> Response:
32         """Add received units to a product's stock."""
33         try:
34             sku = require_str(request, "sku")
35             quantity = require_positive_int(request.get("quantity"), "quantity")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         try:
39             on_hand = self._service.restock(sku, quantity)
40         except ProductNotFound:
41             return not_found("product")
42         return Response(200, {"sku": sku, "on_hand": on_hand})
43 
44     def handle_fulfilment_summary(self) -> Response:
45         """Headline numbers for the warehouse dashboard."""
46         summary = self._service.summary()
47         return Response(200, {"open_orders": summary.open_orders,
48                               "units_to_pick": summary.units_to_pick,
49                               "low_stock_products": summary.low_stock_products})
50 
51     def handle_low_stock(self, threshold: int) -> Response:
52         """Active products with stock on hand strictly below ``threshold``."""
53         try:
54             threshold = require_non_negative_int(threshold, "threshold")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         products = self._service.low_stock(threshold)
58         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
59                                            for p in products]})
