28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 LOW_STOCK_LEVEL = 5  # the warehouse's low-stock line: fewer than this many units on hand
36 
37 
38 @dataclass(frozen=True)
39 class FulfilmentSummary:
40     open_orders: int
41     units_to_pick: int
42     low_stock_products: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def restock(self, sku: str, quantity: int) -> int:
54         """Add ``quantity`` units to a known product's stock and return the new level."""
55         if self._catalog.get(sku) is None:
56             raise ProductNotFound(sku)
57         on_hand = self._stock.get(sku) + quantity
58         self._stock.set(sku, on_hand)
59         return on_hand
60 
61     def summary(self) -> FulfilmentSummary:
62         """Dashboard figures: open orders, units to pick, and products below the low-stock line."""
63         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
64         return FulfilmentSummary(
65             open_orders=len(open_orders),
66             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
67             low_stock_products=len(self.low_stock(LOW_STOCK_LEVEL)),
68         )
69 
70     def low_stock(self, threshold: int) -> list[LowStockProduct]:
71         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
72         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
73                  for p in self._catalog.list_all() if p.active]
74         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
75 
76     def packing_slip(self, order_id: str) -> PackingSlip:
77         order = self._orders.get(order_id)
78         if order is None:
79             raise OrderNotFound(order_id)
80         if order.status == "cancelled":
81             raise Conflict(f"order {order_id} is cancelled")
82         customer = self._customers.get(order.customer_id)
83         lines = []
84         for item in order.items:
85             product = self._catalog.get(item.sku)
86             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
87         return PackingSlip(order.order_id, customer.name if customer else None, tuple(lines))
