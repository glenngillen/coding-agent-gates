13 class CustomerInsightsController:
14     def __init__(self, service: OrderService) -> None:
15         self._service = service
16 
17     def handle_lifetime_value(self, customer_id: str) -> Response:
18         try:
19             order_count, total_cents = self._service.lifetime_value(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         return Response(200, {"customer_id": customer_id, "order_count": order_count,
23                               "lifetime_value_cents": total_cents})
24 
25     def handle_top_customers(self, limit: Any) -> Response:
26         try:
27             limit = require_positive_int(limit, "limit")
28         except InvalidRequest as exc:
29             return bad_request(exc)
30         top = self._service.top_customers(limit)
31         return Response(200, {"customers": [
32             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
33             for c, value in top]})
34 
35     def handle_customers_without_orders(self) -> Response:
36         return Response(200, {"customers": [
37             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
38             for c in self._service.customers_without_orders()]})
39 
40     def handle_order_history(self, customer_id: str) -> Response:
41         try:
42             history = self._service.order_history(customer_id)
43         except CustomerNotFound:
44             return not_found("customer")
45         return Response(200, {
46             "customer_id": customer_id,
47             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
48                         "total_cents": s.total_cents} for s in history],
