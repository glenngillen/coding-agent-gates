..  78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
..  79         """Up to ``limit`` ``(customer, lifetime_value_cents)`` pairs, highest value first.
..  80 
..  81         Ties break by customer id; customers with a lifetime value of 0 are left out.
..  82         """
..  83         ranked = []
..  84         for customer in self._customers.list_all():
..  85             _, value = self.lifetime_value(customer.customer_id)
..  86             if value > 0:
..  87                 ranked.append((customer, value))
..  88         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
..  89         return ranked[:limit]
..  90 
..  91     def customers_without_orders(self) -> list[Customer]:
..  92         """Customers with no non-cancelled orders, in registration order."""
..  93         return [c for c in self._customers.list_all()
..  94                 if self.lifetime_value(c.customer_id)[0] == 0]
