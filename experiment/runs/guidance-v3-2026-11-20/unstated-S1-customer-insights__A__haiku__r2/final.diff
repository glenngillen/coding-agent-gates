 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.domain.customers import Customer
11 from orders.infrastructure.customers import InMemoryCustomerRepository
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository) -> None:
16         self._service = service
17         self._customers = customers
18 
19     def handle_order_history(self, customer_id: str) -> Response:
20         """A customer's orders, newest first, with the totals the order summary reports."""
21         try:
22             orders = self._service.list_for_customer(customer_id)
23         except CustomerNotFound:
24             return not_found("customer")
25         history: list[dict[str, Any]] = []
26         # list_for_customer returns creation order, so reverse it for newest first.
27         for order in reversed(orders):
28             summary = self._service.summarize(order)
29             history.append({"order_id": order.order_id, "status": order.status,
30                             "total_cents": summary.total_cents})
31         return Response(200, {"customer_id": customer_id, "orders": history})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         """Non-cancelled order count and the sum of their totals, as the order history reports them."""
35         try:
36             orders = self._service.list_for_customer(customer_id)
37         except CustomerNotFound:
38             return not_found("customer")
39         count, value = self._lifetime_value(customer_id)
40         return Response(200, {"customer_id": customer_id, "order_count": count,
41                               "lifetime_value_cents": value})
42 
43     def handle_top_customers(self, limit: Any) -> Response:
44         """Customers ranked by lifetime value (highest first, ties by customer_id), excluding zero values."""
45         try:
46             limit = require_positive_int(limit, "limit")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         ranked: list[tuple[int, str, Customer]] = []
50         for customer in self._customers.list_all():
51             _, value = self._lifetime_value(customer.customer_id)
52             if value > 0:
53                 ranked.append((value, customer.customer_id, customer))
54         ranked.sort(key=lambda entry: (-entry[0], entry[1]))
55         return Response(200, {"customers": [
56             {"customer_id": cid, "name": customer.name, "lifetime_value_cents": value}
57             for value, cid, customer in ranked[:limit]
58         ]})
59 
60     def handle_customers_without_orders(self) -> Response:
61         """Registered customers with no orders that are not cancelled, in registration order."""
62         # The repository keeps customers in insertion order, which is registration order.
63         customers = [
64             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
65             for c in self._customers.list_all()
66             if self._lifetime_value(c.customer_id)[0] == 0
67         ]
68         return Response(200, {"customers": customers})
69 
70     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
71         """(number of non-cancelled orders, sum of their totals) for an existing customer."""
72         active = [o for o in self._service.list_for_customer(customer_id) if o.status != "cancelled"]
73         return len(active), sum(self._service.summarize(o).total_cents for o in active)
