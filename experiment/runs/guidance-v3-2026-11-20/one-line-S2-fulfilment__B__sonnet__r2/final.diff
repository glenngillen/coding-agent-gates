 1 """Warehouse fulfilment: packing slips for orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 LOW_STOCK_LINE = 5  # the warehouse's low-stock line, in units
36 
37 
38 @dataclass(frozen=True)
39 class FulfilmentSummary:
40     open_orders: int
41     units_to_pick: int
42     low_stock_products: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def summary(self) -> FulfilmentSummary:
54         """Open (not cancelled) orders, units on them, and products below the low-stock line."""
55         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
56         units = sum(item.quantity for o in open_orders for item in o.items)
57         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
58 
59     def restock(self, sku: str, quantity: int) -> int:
60         """Add ``quantity`` units to a product's stock and return the new level."""
61         if self._catalog.get(sku) is None:
62             raise ProductNotFound(sku)
63         on_hand = self._stock.get(sku) + quantity
64         self._stock.set(sku, on_hand)
65         return on_hand
66 
67     def low_stock(self, threshold: int) -> list[LowStockProduct]:
68         """Active products with stock strictly below ``threshold``, lowest stock first."""
69         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
70                  for p in self._catalog.list_all() if p.active]
71         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
72 
73     def packing_slip(self, order_id: str) -> PackingSlip:
74         order = self._orders.get(order_id)
75         if order is None:
76             raise OrderNotFound(order_id)
77         if order.status == "cancelled":
78             raise Conflict(f"order {order_id} is cancelled")
79         customer = self._customers.get(order.customer_id)
80         lines = []
81         for item in order.items:
82             product = self._catalog.get(item.sku)
83             lines.append(PackingSlipLine(item.sku, product.name if product is not None else item.sku,
84                                          item.quantity))
85         return PackingSlip(order_id=order.order_id,
86                            customer_name=customer.name if customer is not None else "",
87                            lines=tuple(lines))
