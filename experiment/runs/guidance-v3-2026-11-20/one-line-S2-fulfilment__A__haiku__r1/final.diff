14 # Units on hand below which a product counts as low stock.
15 LOW_STOCK_LINE = 5
16 
17 
18 @dataclass(frozen=True)
19 class LowStockLine:
20     product: Product
21     on_hand: int
22 
23 
24 @dataclass(frozen=True)
25 class PackingSlipLine:
26     sku: str
27     name: str
28     quantity: int
29 
30 
31 @dataclass(frozen=True)
32 class PackingSlip:
33     order_id: str
34     customer_name: str
35     lines: tuple[PackingSlipLine, ...]
36 
37 
38 class FulfilmentService:
39     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
40                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
41         self._orders = orders
42         self._customers = customers
43         self._catalog = catalog
44         self._stock = stock
45 
46     def dashboard_counts(self) -> tuple[int, int, int]:
47         """(open orders, units to pick across open orders, active products below the low-stock line)."""
48         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
49         units = sum(item.quantity for o in open_orders for item in o.items)
50         return len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE))
51 
52     def restock(self, sku: str, quantity: int) -> int:
53         """Add ``quantity`` units to a product's stock; returns the new on-hand level."""
54         if self._catalog.get(sku) is None:
55             raise ProductNotFound(sku)
56         new_level = self._stock.get(sku) + quantity
57         self._stock.set(sku, new_level)
58         return new_level
59 
60     def low_stock(self, threshold: int) -> list[LowStockLine]:
61         """Active products with on-hand stock strictly below ``threshold``, lowest stock first."""
62         lines = [LowStockLine(p, self._stock.get(p.sku)) for p in self._catalog.list_all() if p.active]
63         lines = [line for line in lines if line.on_hand < threshold]
64         return sorted(lines, key=lambda line: (line.on_hand, line.product.sku))
65 
66     def packing_slip(self, order_id: str) -> PackingSlip:
67         """Build the packing slip for a placed order, lines in the order's item order."""
68         order = self._orders.get(order_id)
69         if order is None:
70             raise OrderNotFound(order_id)
71         if order.status == "cancelled":
72             raise Conflict(f"order {order_id} is cancelled")
73         customer = self._customers.get(order.customer_id)
74         if customer is None:
75             raise CustomerNotFound(order.customer_id)
76         lines = []
77         for item in order.items:
78             product = self._catalog.get(item.sku)
79             if product is None:
80                 raise ProductNotFound(item.sku)
81             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
82         return PackingSlip(order.order_id, customer.name, tuple(lines))
