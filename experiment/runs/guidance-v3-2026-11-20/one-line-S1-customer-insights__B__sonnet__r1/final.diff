.. 77     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 78         """Customers with non-zero lifetime value, highest first then by id, at most ``limit``."""
.. 79         ranked = [(c, self.lifetime_value(c.customer_id)[1]) for c in self._customers.list_all()]
