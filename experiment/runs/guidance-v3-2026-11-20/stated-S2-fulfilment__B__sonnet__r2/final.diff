 1 """Warehouse fulfilment: packing slips."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.catalog_service import CatalogService
 6 from orders.application.customer_service import CustomerService
 7 from orders.application.errors import Conflict
 8 from orders.application.order_service import OrderService
 9 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
10 
11 # The warehouse's low-stock line: fewer than this many units on hand counts as low.
12 LOW_STOCK_THRESHOLD = 5
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: OrderService, customers: CustomerService, catalog: CatalogService) -> None:
17         self._orders = orders
18         self._customers = customers
19         self._catalog = catalog
20 
21     def packing_slip(self, order_id: str) -> PackingSlip:
22         order = self._orders.get_order(order_id)
23         if order.status == "cancelled":
24             raise Conflict(f"order {order_id} is cancelled")
25         customer = self._customers.get(order.customer_id)
26         lines = tuple(PackingSlipLine(i.sku, self._catalog.get_product(i.sku).name, i.quantity)
27                       for i in order.items)
28         return PackingSlip(order.order_id, customer.name, lines)
29 
30     def summary(self) -> FulfilmentSummary:
31         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
32         units = sum(item.quantity for o in open_orders for item in o.items)
33         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_THRESHOLD)))
34 
35     def restock(self, sku: str, quantity: int) -> int:
36         return self._catalog.restock(sku, quantity)
37 
38     def low_stock(self, threshold: int) -> list[LowStockProduct]:
39         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
40         found = [LowStockProduct(p.sku, p.name, self._catalog.on_hand(p.sku))
41                  for p in self._catalog.list_active()]
42         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
