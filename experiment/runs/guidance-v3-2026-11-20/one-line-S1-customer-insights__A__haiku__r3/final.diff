 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the totals the order summary reports."""
20         try:
21             summaries = self._orders.order_history(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         orders: list[dict[str, Any]] = [
25             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
26             for s in summaries
27         ]
28         return Response(200, {"customer_id": customer_id, "orders": orders})
29 
30     def _lifetime(self, customer_id: str) -> tuple[int, int]:
31         """(order_count, lifetime_value_cents) over the customer's non-cancelled orders.
32 
33         Raises CustomerNotFound for unknown customers.
34         """
35         summaries = self._orders.order_history(customer_id)
36         active = [s for s in summaries if s.order.status != "cancelled"]
37         return len(active), sum(s.total_cents for s in active)
38 
39     def handle_lifetime_value(self, customer_id: str) -> Response:
40         """Count and total of a customer's orders, leaving out cancelled ones."""
41         try:
42             count, value = self._lifetime(customer_id)
43         except CustomerNotFound:
44             return not_found("customer")
45         return Response(200, {
46             "customer_id": customer_id,
47             "order_count": count,
48             "lifetime_value_cents": value,
49         })
50 
51     def handle_top_customers(self, limit: Any) -> Response:
52         """Customers ranked by lifetime value, highest first, excluding zero-value customers."""
53         try:
54             limit = require_positive_int(limit, "limit")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         ranked = []
58         for customer in self._customers.list_all():
59             _, value = self._lifetime(customer.customer_id)
60             if value > 0:
61                 ranked.append((value, customer))
62         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
63         return Response(200, {"customers": [
64             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
65             for value, c in ranked[:limit]
66         ]})
67 
68     def handle_customers_without_orders(self) -> Response:
69         """Registered customers with no orders that are not cancelled, in registration order."""
70         customers = [
71             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
72             for c in self._customers.list_all()
73             if self._lifetime(c.customer_id)[0] == 0
74         ]
75         return Response(200, {"customers": customers})
