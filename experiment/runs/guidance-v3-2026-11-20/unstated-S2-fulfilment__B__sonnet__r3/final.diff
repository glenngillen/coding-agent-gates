 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.application.fulfilment_service import FulfilmentService
 7 from typing import Any
 8 
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_fulfilment_summary(self) -> Response:
18         """Headline numbers for the warehouse dashboard."""
19         summary = self._service.summary()
20         return Response(200, {"open_orders": summary.open_orders,
21                               "units_to_pick": summary.units_to_pick,
22                               "low_stock_products": summary.low_stock_products})
23 
24     def handle_restock(self, request: dict[str, Any]) -> Response:
25         """Add received units to a product's stock."""
26         try:
27             sku = require_str(request, "sku")
28             quantity = require_positive_int(request.get("quantity"), "quantity")
29         except InvalidRequest as exc:
30             return bad_request(exc)
31         try:
32             on_hand = self._service.restock(sku, quantity)
33         except ProductNotFound:
34             return not_found("product")
35         return Response(200, {"sku": sku, "on_hand": on_hand})
36 
37     def handle_low_stock(self, threshold: Any) -> Response:
38         """Active products whose stock on hand is below ``threshold``."""
39         try:
40             limit = require_non_negative_int(threshold, "threshold")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         products = self._service.low_stock(limit)
44         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
45                                            for p in products]})
46 
47     def handle_packing_slip(self, order_id: str) -> Response:
48         """What the warehouse needs to pack an order."""
49         try:
50             slip = self._service.packing_slip(order_id)
51         except OrderNotFound:
52             return not_found("order")
53         except Conflict as exc:
54             return conflict(exc)
55         return Response(200, {
56             "order_id": slip.order_id,
57             "customer_name": slip.customer_name,
58             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
59                       for line in slip.lines],
60         })
