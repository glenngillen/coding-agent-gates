 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: CustomerService) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the same totals ``handle_get`` reports."""
20         try:
21             orders = self._service.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         history: list[dict[str, Any]] = [
25             {"order_id": summary.order.order_id,
26              "status": summary.order.status,
27              "total_cents": summary.total_cents}
28             for summary in (self._service.summarize(order) for order in reversed(orders))
29         ]
30         return Response(200, {"customer_id": customer_id, "orders": history})
31 
32     def handle_lifetime_value(self, customer_id: str) -> Response:
33         """Count and total of a customer's orders that are not cancelled, at the history totals."""
34         try:
35             count, total = self._lifetime_value(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         return Response(200, {"customer_id": customer_id,
39                               "order_count": count,
40                               "lifetime_value_cents": total})
41 
42     def handle_top_customers(self, limit: Any) -> Response:
43         """Customers ranked by lifetime value, highest first, excluding zero-value customers."""
44         if type(limit) is not int or limit < 1:
45             return bad_request(InvalidRequest("limit must be a positive integer"))
46         ranked = []
47         for customer in self._customers.list_all():
48             _, total = self._lifetime_value(customer.customer_id)
49             if total > 0:
50                 ranked.append((total, customer.customer_id, customer.name))
51         ranked.sort(key=lambda row: (-row[0], row[1]))
52         return Response(200, {"customers": [
53             {"customer_id": cid, "name": name, "lifetime_value_cents": total}
54             for total, cid, name in ranked[:limit]
55         ]})
56 
57     def handle_customers_without_orders(self) -> Response:
58         """Registered customers with no orders other than cancelled ones, in registration order."""
59         customers = [
60             {"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
61             for customer in self._customers.list_all()
62             if self._lifetime_value(customer.customer_id)[0] == 0
63         ]
64         return Response(200, {"customers": customers})
65 
66     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
67         """(number of non-cancelled orders, sum of their totals). Raises CustomerNotFound."""
68         orders = self._service.list_for_customer(customer_id)
69         active = [order for order in orders if order.status != "cancelled"]
70         return len(active), sum(self._service.summarize(order).total_cents for order in active)
