 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
10                                      require_positive_int)
11 from orders.domain.orders import OrderSummary
12 
13 
14 def history_entry(summary: OrderSummary) -> dict[str, Any]:
15     return {"order_id": summary.order.order_id, "status": summary.order.status,
16             "total_cents": summary.total_cents}
17 
18 
19 class CustomerInsightsController:
20     def __init__(self, service: OrderService) -> None:
21         self._service = service
22 
23     def handle_order_history(self, customer_id: str) -> Response:
24         try:
25             summaries = self._service.order_history(customer_id)
26         except CustomerNotFound:
27             return not_found("customer")
28         return Response(200, {"customer_id": customer_id,
29                               "orders": [history_entry(s) for s in summaries]})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         return Response(200, {"customer_id": customer_id, "order_count": order_count,
37                               "lifetime_value_cents": lifetime_value_cents})
38 
39     def handle_customers_without_orders(self) -> Response:
40         return Response(200, {"customers": [
41             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
42             for c in self._service.customers_without_orders()]})
43 
44     def handle_top_customers(self, limit: Any) -> Response:
45         try:
46             limit = require_positive_int(limit, "limit")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         ranked = self._service.top_customers(limit)
50         return Response(200, {"customers": [
51             {"customer_id": customer.customer_id, "name": customer.name,
52              "lifetime_value_cents": value}
53             for customer, value in ranked]})
