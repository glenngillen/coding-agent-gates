.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries (with discounts applied) for a customer's orders, newest first."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(order) for order in reversed(orders)]
.. 72 
.. 73     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 74         """``(order_count, lifetime_value_cents)`` over a customer's non-cancelled orders."""
.. 75         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return len(active), sum(s.total_cents for s in active)
.. 77 
.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 79         """Up to ``limit`` customers with a non-zero lifetime value, highest first (ties by id)."""
.. 80         ranked = []
.. 81         for customer in self._customers.list_all():
.. 82             _, value = self.lifetime_value(customer.customer_id)
.. 83             if value > 0:
.. 84                 ranked.append((customer, value))
.. 85         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 86         return ranked[:limit]
.. 87 
.. 88     def customers_without_orders(self) -> list[Customer]:
.. 89         """Registered customers with no orders that are not cancelled, in registration order."""
.. 90         return [c for c in self._customers.list_all()
.. 91                 if self.lifetime_value(c.customer_id)[0] == 0]
