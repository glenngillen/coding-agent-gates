11 def test_summary_counts_open_orders_units_and_low_stock(shop):
12     # shop: BOOK 50, LAMP 5, PEN 100 on hand.
13     order(shop, "c1", ("BOOK", 2), ("PEN", 1))
14     order(shop, "c2", ("LAMP", 4))  # LAMP drops to 1 on hand
15     cancelled = order(shop, "c2", ("PEN", 5)).body["order_id"]
16     shop.orders.handle_cancel(cancelled)  # cancelled: not counted, stock restored
17     shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 800, "on_hand": 4})
18     shop.catalog.handle_add_product({"sku": "MUG", "name": "Mug", "unit_price_cents": 900, "on_hand": 5})
19     assert shop.fulfilment.handle_fulfilment_summary().body == {
20         "open_orders": 2,
21         "units_to_pick": 2 + 1 + 4,
22         "low_stock_products": 2,  # LAMP (1) and CUP (4); MUG at exactly 5 is not low
23     }
