 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.infrastructure.catalog import InMemoryProductCatalog
12 from orders.infrastructure.customers import InMemoryCustomerRepository
13 from orders.infrastructure.repository import InMemoryOrderRepository
14 from orders.infrastructure.stock import InMemoryStockRepository
15 
16 LOW_STOCK_LINE = 5
17 
18 
19 class FulfilmentController:
20     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository,
21                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository,
22                  orders: InMemoryOrderRepository) -> None:
23         self._service = service
24         self._customers = customers
25         self._catalog = catalog
26         self._stock = stock
27         self._orders = orders
28 
29     def handle_packing_slip(self, order_id: str) -> Response:
30         try:
31             order = self._service.get_order(order_id)
32         except OrderNotFound:
33             return not_found("order")
34         if order.status == "cancelled":
35             return conflict(Conflict(f"order {order_id} is cancelled"))
36         customer = self._customers.get(order.customer_id)
37         lines: list[dict[str, Any]] = []
38         for item in order.items:
39             product = self._catalog.get(item.sku)
40             lines.append({"sku": item.sku,
41                           "name": product.name if product is not None else None,
42                           "quantity": item.quantity})
43         return Response(200, {
44             "order_id": order.order_id,
45             "customer_name": customer.name if customer is not None else None,
46             "lines": lines,
47         })
48 
49     def handle_low_stock(self, threshold: Any) -> Response:
50         try:
51             limit = require_non_negative_int(threshold, "threshold")
52         except InvalidRequest as exc:
53             return bad_request(exc)
54         low = []
55         for product in self._catalog.list_all():
56             if not product.active:
57                 continue
58             on_hand = self._stock.get(product.sku)
59             if on_hand < limit:
60                 low.append((on_hand, product))
61         low.sort(key=lambda entry: (entry[0], entry[1].sku))
62         return Response(200, {"products": [
63             {"sku": product.sku, "name": product.name, "on_hand": on_hand}
64             for on_hand, product in low
65         ]})
66 
67     def handle_fulfilment_summary(self) -> Response:
68         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
69         units_to_pick = sum(item.quantity for order in open_orders for item in order.items)
70         low_stock = sum(1 for product in self._catalog.list_all()
71                         if product.active and self._stock.get(product.sku) < LOW_STOCK_LINE)
72         return Response(200, {
73             "open_orders": len(open_orders),
74             "units_to_pick": units_to_pick,
75             "low_stock_products": low_stock,
76         })
77 
78     def handle_restock(self, request: dict[str, Any]) -> Response:
79         try:
80             sku = require_str(request, "sku")
81             quantity = require_positive_int(request.get("quantity"), "quantity")
82         except InvalidRequest as exc:
83             return bad_request(exc)
84         if self._catalog.get(sku) is None:
85             return not_found("product")
86         on_hand = self._stock.get(sku) + quantity
87         self._stock.set(sku, on_hand)
88         return Response(200, {"sku": sku, "on_hand": on_hand})
