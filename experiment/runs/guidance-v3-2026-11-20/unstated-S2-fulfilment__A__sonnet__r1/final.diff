 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
 8                                      require_non_negative_int, require_positive_int, require_str)
 9 from orders.infrastructure.stock import InMemoryStockRepository
10 from orders.infrastructure.catalog import InMemoryProductCatalog
11 from orders.infrastructure.customers import InMemoryCustomerRepository
12 from orders.infrastructure.repository import InMemoryOrderRepository
13 
14 
15 LOW_STOCK_THRESHOLD = 5  # the warehouse's low-stock line
16 
17 
18 class FulfilmentController:
19     def __init__(
20         self,
21         orders: InMemoryOrderRepository,
22         customers: InMemoryCustomerRepository,
23         catalog: InMemoryProductCatalog,
24         stock: InMemoryStockRepository,
25     ) -> None:
26         self._orders = orders
27         self._customers = customers
28         self._catalog = catalog
29         self._stock = stock
30 
31     def handle_restock(self, request: dict[str, Any]) -> Response:
32         """Add received units to a product's stock."""
33         try:
34             sku = require_str(request, "sku")
35             quantity = require_positive_int(request.get("quantity"), "quantity")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         if self._catalog.get(sku) is None:
39             return not_found("product")
40         on_hand = self._stock.get(sku) + quantity
41         self._stock.set(sku, on_hand)
42         return Response(200, {"sku": sku, "on_hand": on_hand})
43 
44     def handle_low_stock(self, threshold: Any) -> Response:
45         """Active products with stock strictly below the threshold, lowest first."""
46         try:
47             limit = require_non_negative_int(threshold, "threshold")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         rows = [
51             {"sku": p.sku, "name": p.name, "on_hand": self._stock.get(p.sku)}
52             for p in self._catalog.list_all()
53             if p.active
54         ]
55         low = [r for r in rows if r["on_hand"] < limit]
56         low.sort(key=lambda r: (r["on_hand"], r["sku"]))
57         return Response(200, {"products": low})
58 
59     def handle_fulfilment_summary(self) -> Response:
60         """Dashboard numbers: open orders, units to pick, low-stock products."""
61         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
62         units = sum(item.quantity for o in open_orders for item in o.items)
63         low = self.handle_low_stock(LOW_STOCK_THRESHOLD).body["products"]
64         return Response(200, {
65             "open_orders": len(open_orders),
66             "units_to_pick": units,
67             "low_stock_products": len(low),
68         })
69 
70     def handle_packing_slip(self, order_id: str) -> Response:
71         """What the warehouse needs to pack an order."""
72         order = self._orders.get(order_id)
73         if order is None:
74             return not_found("order")
75         if order.status == "cancelled":
76             return conflict(ValueError("order is cancelled"))
77         customer = self._customers.get(order.customer_id)
78         lines = []
79         for item in order.items:
80             product = self._catalog.get(item.sku)
81             lines.append({
82                 "sku": item.sku,
83                 "name": product.name if product else item.sku,
84                 "quantity": item.quantity,
85             })
86         return Response(200, {
87             "order_id": order.order_id,
88             "customer_name": customer.name if customer else None,
89             "lines": lines,
90         })
