 97 def test_fulfilment_summary_counts(shop):
 98     _place(shop, "c1", ("BOOK", 2), ("PEN", 1))
 99     _place(shop, "c2", ("BOOK", 4))
100     cancelled = _place(shop, "c2", ("PEN", 7)).body["order_id"]
101     shop.orders.handle_cancel(cancelled)
102     # LAMP has 5 on hand (not below the line); drop it to 4 and PEN to exactly 5
103     _place(shop, "c1", ("LAMP", 1), ("PEN", 94))
104     resp = shop.fulfilment.handle_fulfilment_summary()
105     assert resp.status == 200
106     # open orders: 3 plus the last one = 3; units 3 + 4 + 95 = 102; low: LAMP(4)
