 1 """Warehouse fulfilment: packing slips."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import (LOW_STOCK_LINE, FulfilmentSummary, LowStockItem, PackingSlip,
 7                                          PackingSlipLine)
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 class FulfilmentService:
15     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
16                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
17         self._orders = orders
18         self._customers = customers
19         self._catalog = catalog
20         self._stock = stock
21 
22     def summary(self) -> FulfilmentSummary:
23         """Dashboard figures: open orders, units to pick and products below the low-stock line."""
24         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
25         units = sum(item.quantity for o in open_orders for item in o.items)
26         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
27 
28     def restock(self, sku: str, quantity: int) -> int:
29         """Add ``quantity`` units to a product's stock and return the new level."""
30         if self._catalog.get(sku) is None:
31             raise ProductNotFound(sku)
32         on_hand = self._stock.get(sku) + quantity
33         self._stock.set(sku, on_hand)
34         return on_hand
35 
36     def low_stock(self, threshold: int) -> list[LowStockItem]:
37         """Active products with stock strictly below ``threshold``, lowest first then by SKU."""
38         items = [LowStockItem(p.sku, p.name, self._stock.get(p.sku))
39                  for p in self._catalog.list_all() if p.active]
40         return sorted((i for i in items if i.on_hand < threshold), key=lambda i: (i.on_hand, i.sku))
41 
42     def packing_slip(self, order_id: str) -> PackingSlip:
43         order = self._orders.get(order_id)
44         if order is None:
45             raise OrderNotFound(order_id)
46         if order.status == "cancelled":
47             raise Conflict(f"order {order_id} is cancelled")
48         customer = self._customers.get(order.customer_id)
49         lines = []
50         for item in order.items:
51             product = self._catalog.get(item.sku)
52             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
53         return PackingSlip(order.order_id, customer.name if customer else "", tuple(lines))
