 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
11                                      require_positive_int)
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, service: OrderService, customers: CustomerService) -> None:
16         self._service = service
17         self._customers = customers
18 
19     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
20         """Return (order_count, lifetime_value_cents), excluding cancelled orders."""
21         orders = self._service.list_for_customer(customer_id)
22         active = [o for o in orders if o.status != "cancelled"]
23         return len(active), sum(self._service.summarize(o).total_cents for o in active)
24 
25     def handle_order_history(self, customer_id: str) -> Response:
26         """Every order for a customer, newest first, with the same totals as the order summary."""
27         try:
28             orders = self._service.list_for_customer(customer_id)
29         except CustomerNotFound:
30             return not_found("customer")
31         history: list[dict[str, Any]] = []
32         for order in reversed(orders):  # creation order -> newest first
33             summary = self._service.summarize(order)
34             history.append({"order_id": order.order_id, "status": order.status,
35                             "total_cents": summary.total_cents})
36         return Response(200, {"customer_id": customer_id, "orders": history})
37 
38     def handle_lifetime_value(self, customer_id: str) -> Response:
39         """Count and total of a customer's orders, excluding cancelled ones."""
40         try:
41             count, lifetime_value = self._lifetime_value(customer_id)
42         except CustomerNotFound:
43             return not_found("customer")
44         return Response(200, {"customer_id": customer_id, "order_count": count,
45                               "lifetime_value_cents": lifetime_value})
46 
47     def handle_customers_without_orders(self) -> Response:
48         """Registered customers with no orders that are not cancelled, in registration order."""
49         idle = []
50         for customer in self._customers.list_all():
51             count, _ = self._lifetime_value(customer.customer_id)
52             if count == 0:
53                 idle.append({"customer_id": customer.customer_id, "name": customer.name,
54                              "email": customer.email})
55         return Response(200, {"customers": idle})
56 
57     def handle_top_customers(self, limit: Any) -> Response:
58         """Customers with the highest lifetime value, skipping those with none."""
59         try:
60             limit = require_positive_int(limit, "limit")
61         except InvalidRequest as exc:
62             return bad_request(exc)
63         ranked = []
64         for customer in self._customers.list_all():
65             _, value = self._lifetime_value(customer.customer_id)
66             if value > 0:
67                 ranked.append((value, customer))
68         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
69         return Response(200, {"customers": [
70             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
71             for value, c in ranked[:limit]]})
