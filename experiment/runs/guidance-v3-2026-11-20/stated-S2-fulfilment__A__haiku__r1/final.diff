 1 """Warehouse fulfilment: packing slips for placed orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.domain.fulfilment import PackingSlip, PackingSlipLine, StockLevel
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 LOW_STOCK_LINE = 5
14 """Warehouse low-stock line: products with fewer units on hand than this are low stock."""
15 
16 
17 class FulfilmentService:
18     def __init__(self, orders: OrderService, order_repo: InMemoryOrderRepository,
19                  customers: InMemoryCustomerRepository, catalog: InMemoryProductCatalog,
20                  stock: InMemoryStockRepository) -> None:
21         self._orders = orders
22         self._order_repo = order_repo
23         self._customers = customers
24         self._catalog = catalog
25         self._stock = stock
26 
27     def fulfilment_summary(self) -> tuple[int, int, int]:
28         """``(open_orders, units_to_pick, low_stock_products)``.
29 
30         Open orders are those not cancelled; units counts their quantities.
31         Low-stock products are active products below ``LOW_STOCK_LINE``.
32         """
33         open_orders = [o for o in self._order_repo.list_all() if o.status != "cancelled"]
34         units = sum(item.quantity for order in open_orders for item in order.items)
35         low = len(self.low_stock(LOW_STOCK_LINE))
36         return len(open_orders), units, low
37 
38     def restock(self, sku: str, quantity: int) -> int:
39         """Add ``quantity`` units to a product's stock and return the new level.
40 
41         Stock is shared with order placement, so restocked units are orderable immediately.
42         Raises ``ProductNotFound`` for unknown SKUs.
43         """
44         if self._catalog.get(sku) is None:
45             raise ProductNotFound(sku)
46         new_level = self._stock.get(sku) + quantity
47         self._stock.set(sku, new_level)
48         return new_level
49 
50     def low_stock(self, threshold: int) -> list[StockLevel]:
51         """Active products whose stock on hand is strictly below ``threshold``.
52 
53         Sorted by stock on hand (lowest first), then by SKU.
54         """
55         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
56                   for p in self._catalog.list_all() if p.active]
57         low = [level for level in levels if level.on_hand < threshold]
58         return sorted(low, key=lambda level: (level.on_hand, level.sku))
59 
60     def packing_slip(self, order_id: str) -> PackingSlip:
61         """Packing slip for an order. Cancelled orders are not packed.
62 
63         Raises ``OrderNotFound`` for unknown orders and ``Conflict`` for cancelled ones.
64         """
65         order = self._orders.get_order(order_id)
66         if order.status == "cancelled":
67             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
68         customer = self._customers.get(order.customer_id)
69         if customer is None:
70             raise CustomerNotFound(order.customer_id)
71         lines = []
72         for item in order.items:
73             product = self._catalog.get(item.sku)
74             if product is None:
75                 raise ProductNotFound(item.sku)
76             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
77         return PackingSlip(order.order_id, customer.name, tuple(lines))
