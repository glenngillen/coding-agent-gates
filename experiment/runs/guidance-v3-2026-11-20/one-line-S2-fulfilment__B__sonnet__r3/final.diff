28 LOW_STOCK_THRESHOLD = 5  # the warehouse's low-stock line
29 
30 
31 @dataclass(frozen=True)
32 class FulfilmentSummary:
33     open_orders: int
34     units_to_pick: int
35     low_stock_products: int
36 
37 
38 @dataclass(frozen=True)
39 class LowStockProduct:
40     sku: str
41     name: str
42     on_hand: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def low_stock(self, threshold: int) -> list[LowStockProduct]:
54         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
55         found = []
56         for product in self._catalog.list_all():
57             on_hand = self._stock.get(product.sku)
58             if product.active and on_hand < threshold:
59                 found.append(LowStockProduct(product.sku, product.name, on_hand))
60         return sorted(found, key=lambda p: (p.on_hand, p.sku))
61 
62     def summary(self) -> FulfilmentSummary:
63         """Open (not cancelled) orders, units to pick across them, and products below the low-stock line."""
64         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
65         units = sum(item.quantity for o in open_orders for item in o.items)
66         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_THRESHOLD)))
67 
68     def restock(self, sku: str, quantity: int) -> int:
69         """Add ``quantity`` units to the product's stock and return the new level."""
70         if self._catalog.get(sku) is None:
71             raise ProductNotFound(sku)
72         new_level = self._stock.get(sku) + quantity
73         self._stock.set(sku, new_level)
74         return new_level
75 
76     def packing_slip(self, order_id: str) -> PackingSlip:
77         order = self._orders.get(order_id)
78         if order is None:
79             raise OrderNotFound(order_id)
80         if order.status == "cancelled":
81             raise Conflict(f"order {order_id} is cancelled")
82         customer = self._customers.get(order.customer_id)
83         lines = []
84         for item in order.items:
85             product = self._catalog.get(item.sku)
86             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
87         return PackingSlip(order.order_id, customer.name if customer else "", tuple(lines))
