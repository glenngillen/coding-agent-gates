 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_low_stock(self, threshold: Any) -> Response:
18         try:
19             limit = require_non_negative_int(threshold, "threshold")
20         except InvalidRequest as exc:
21             return bad_request(exc)
22         products = self._service.low_stock(limit)
23         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
24                                            for p in products]})
25 
26     def handle_fulfilment_summary(self) -> Response:
27         summary = self._service.summary()
28         return Response(200, {"open_orders": summary.open_orders,
29                               "units_to_pick": summary.units_to_pick,
30                               "low_stock_products": summary.low_stock_products})
31 
32     def handle_restock(self, request: dict[str, Any]) -> Response:
33         try:
34             sku = require_str(request, "sku")
35             quantity = require_positive_int(request.get("quantity"), "quantity")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         try:
39             on_hand = self._service.restock(sku, quantity)
40         except ProductNotFound:
41             return not_found("product")
42         return Response(200, {"sku": sku, "on_hand": on_hand})
43 
44     def handle_packing_slip(self, order_id: str) -> Response:
45         try:
46             slip = self._service.packing_slip(order_id)
47         except OrderNotFound:
48             return not_found("order")
49         except Conflict as exc:
50             return conflict(exc)
51         return Response(200, {
52             "order_id": slip.order_id,
53             "customer_name": slip.customer_name,
54             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
55                       for line in slip.lines],
56         })
