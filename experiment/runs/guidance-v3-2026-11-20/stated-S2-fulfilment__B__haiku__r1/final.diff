src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders waiting to be packed."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_LINE = 5  # units on hand below which a product counts as low stock
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def low_stock(self, threshold: int) -> list[StockLevel]:
24         """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
25         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
26                   for p in self._catalog.list_all() if p.active]
27         return sorted((level for level in levels if level.on_hand < threshold),
28                       key=lambda level: (level.on_hand, level.sku))
29 
30     def summary(self) -> FulfilmentSummary:
31         """Dashboard figures: open (not cancelled) orders, units across them, low-stock products."""
32         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
33         units = sum(item.quantity for order in open_orders for item in order.items)
34         return FulfilmentSummary(
35             open_orders=len(open_orders),
36             units_to_pick=units,
37             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
38         )
39 
40     def restock(self, sku: str, quantity: int) -> int:
41         """Add ``quantity`` units to a product's stock and return the new level."""
42         if self._catalog.get(sku) is None:
43             raise ProductNotFound(sku)
44         on_hand = self._stock.get(sku) + quantity
45         self._stock.set(sku, on_hand)
46         return on_hand
47 
48     def packing_slip(self, order_id: str) -> PackingSlip:
49         """Packing slip for an order, lines in the order's item order.
50 
51         Cancelled orders are never packed, so they have no packing slip.
52         """
53         order = self._orders.get(order_id)
54         if order is None:
55             raise OrderNotFound(order_id)
56         if order.status == "cancelled":
57             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
58         customer = self._customers.get(order.customer_id)
59         if customer is None:
60             raise CustomerNotFound(order.customer_id)
61         lines = []
62         for item in order.items:
63             product = self._catalog.get(item.sku)
64             if product is None:
65                 raise ProductNotFound(item.sku)
66             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
67         return PackingSlip(order.order_id, customer.name, tuple(lines))
