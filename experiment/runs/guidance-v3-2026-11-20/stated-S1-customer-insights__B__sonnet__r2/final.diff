17     def handle_top_customers(self, limit: Any) -> Response:
18         try:
19             limit = require_positive_int(limit, "limit")
20         except InvalidRequest as exc:
21             return bad_request(exc)
22         return Response(200, {"customers": [
23             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
24             for c, value in self._service.top_customers(limit)]})
25 
26     def handle_customers_without_orders(self) -> Response:
27         return Response(200, {"customers": [
28             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
29             for c in self._service.customers_without_orders()]})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             order_count, total_cents = self._service.lifetime_value(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         return Response(200, {"customer_id": customer_id, "order_count": order_count,
37                               "lifetime_value_cents": total_cents})
38 
39     def handle_order_history(self, customer_id: str) -> Response:
40         try:
41             summaries = self._service.history_for_customer(customer_id)
42         except CustomerNotFound:
43             return not_found("customer")
44         return Response(200, {
45             "customer_id": customer_id,
46             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
47                         "total_cents": s.total_cents} for s in summaries],
