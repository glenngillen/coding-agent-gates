 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound
 8 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 9 from orders.application.fulfilment_service import FulfilmentService, PackingSlip
10 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
11                                      require_non_negative_int, require_positive_int, require_str)
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
19                   for line in slip.lines],
20     }
21 
22 
23 class FulfilmentController:
24     def __init__(self, service: FulfilmentService) -> None:
25         self._service = service
26 
27     def handle_packing_slip(self, order_id: str) -> Response:
28         try:
29             slip = self._service.packing_slip(order_id)
30         except OrderNotFound:
31             return not_found("order")
32         except Conflict as exc:
33             return conflict(exc)
34         return Response(200, packing_slip_body(slip))
35 
36     def handle_low_stock(self, threshold: Any) -> Response:
37         try:
38             limit = require_non_negative_int(threshold, "threshold")
39         except InvalidRequest as exc:
40             return bad_request(exc)
41         products = self._service.low_stock(limit)
42         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
43                                            for p in products]})
44 
45     def handle_fulfilment_summary(self) -> Response:
46         summary = self._service.summary()
47         return Response(200, {"open_orders": summary.open_orders,
48                               "units_to_pick": summary.units_to_pick,
49                               "low_stock_products": summary.low_stock_products})
50 
51     def handle_restock(self, request: dict[str, Any]) -> Response:
52         try:
53             sku = require_str(request, "sku")
54             quantity = require_positive_int(request.get("quantity"), "quantity")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         try:
58             on_hand = self._service.restock(sku, quantity)
59         except ProductNotFound:
60             return not_found("product")
61         return Response(200, {"sku": sku, "on_hand": on_hand})
