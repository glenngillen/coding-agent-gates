14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 LOW_STOCK_LINE = 5
36 
37 
38 @dataclass(frozen=True)
39 class FulfilmentSummary:
40     open_orders: int
41     units_to_pick: int
42     low_stock_products: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def summary(self) -> FulfilmentSummary:
54         """Dashboard counts: open (not cancelled) orders, units across them, and low-stock products."""
55         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
56         return FulfilmentSummary(
57             open_orders=len(open_orders),
58             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
59             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
60         )
61 
62     def restock(self, sku: str, quantity: int) -> int:
63         """Add ``quantity`` units to a product's stock and return the new level."""
64         if self._catalog.get(sku) is None:
65             raise ProductNotFound(sku)
66         new_level = self._stock.get(sku) + quantity
67         self._stock.set(sku, new_level)
68         return new_level
69 
70     def low_stock(self, threshold: int) -> list[LowStockProduct]:
71         """Active products with stock on hand strictly below ``threshold``, lowest first, then by SKU."""
72         found = []
73         for product in self._catalog.list_all():
74             if not product.active:
75                 continue
76             on_hand = self._stock.get(product.sku)
77             if on_hand < threshold:
78                 found.append(LowStockProduct(product.sku, product.name, on_hand))
79         return sorted(found, key=lambda p: (p.on_hand, p.sku))
80 
81     def packing_slip(self, order_id: str) -> PackingSlip:
82         order = self._orders.get(order_id)
83         if order is None:
84             raise OrderNotFound(order_id)
85         if order.status == "cancelled":
86             raise Conflict(f"order {order_id} is cancelled")
87         customer = self._customers.get(order.customer_id)
88         if customer is None:
89             raise CustomerNotFound(order.customer_id)
90         lines = []
91         for item in order.items:
92             product = self._catalog.get(item.sku)
93             if product is None:
94                 raise ProductNotFound(item.sku)
95             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
96         return PackingSlip(order.order_id, customer.name, tuple(lines))
