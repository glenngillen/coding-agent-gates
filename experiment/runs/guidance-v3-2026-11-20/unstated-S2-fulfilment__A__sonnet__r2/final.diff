 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
 8                                      require_non_negative_int, require_positive_int, require_str)
 9 from orders.infrastructure.stock import InMemoryStockRepository
10 from orders.infrastructure.catalog import InMemoryProductCatalog
11 from orders.infrastructure.customers import InMemoryCustomerRepository
12 from orders.infrastructure.repository import InMemoryOrderRepository
13 
14 
15 LOW_STOCK_LINE = 5  # the warehouse's low-stock threshold, in units
16 
17 
18 class FulfilmentController:
19     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
20                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
21         self._orders = orders
22         self._customers = customers
23         self._catalog = catalog
24         self._stock = stock
25 
26     def handle_fulfilment_summary(self) -> Response:
27         """Dashboard numbers: open orders, units to pick, and products under the low-stock line."""
28         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
29         units = sum(item.quantity for o in open_orders for item in o.items)
30         low = sum(1 for p in self._catalog.list_all()
31                   if p.active and self._stock.get(p.sku) < LOW_STOCK_LINE)
32         return Response(200, {"open_orders": len(open_orders), "units_to_pick": units,
33                               "low_stock_products": low})
34 
35     def handle_restock(self, request: dict[str, Any]) -> Response:
36         """Add received units to a product's stock."""
37         try:
38             sku = require_str(request, "sku")
39             quantity = require_positive_int(request.get("quantity"), "quantity")
40         except InvalidRequest as exc:
41             return bad_request(exc)
42         if self._catalog.get(sku) is None:
43             return not_found("product")
44         on_hand = self._stock.get(sku) + quantity
45         self._stock.set(sku, on_hand)
46         return Response(200, {"sku": sku, "on_hand": on_hand})
47 
48     def handle_low_stock(self, threshold: Any) -> Response:
49         """Active products with stock strictly below the threshold, lowest first."""
50         try:
51             require_non_negative_int(threshold, "threshold")
52         except InvalidRequest as exc:
53             return bad_request(exc)
54         low = [{"sku": p.sku, "name": p.name, "on_hand": self._stock.get(p.sku)}
55                for p in self._catalog.list_all() if p.active]
56         low = [p for p in low if p["on_hand"] < threshold]
57         low.sort(key=lambda p: (p["on_hand"], p["sku"]))
58         return Response(200, {"products": low})
59 
60     def handle_packing_slip(self, order_id: str) -> Response:
61         """What the warehouse needs to pack an order."""
62         order = self._orders.get(order_id)
63         if order is None:
64             return not_found("order")
65         if order.status == "cancelled":
66             return conflict(ValueError("order is cancelled"))
67         customer = self._customers.get(order.customer_id)
68         lines = []
69         for item in order.items:
70             product = self._catalog.get(item.sku)
71             lines.append({"sku": item.sku, "name": product.name if product else item.sku,
72                           "quantity": item.quantity})
73         return Response(200, {"order_id": order.order_id,
74                               "customer_name": customer.name if customer else "",
75                               "lines": lines})
