.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries of all of a customer's orders (including cancelled), newest first."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(o) for o in reversed(orders)]
.. 72 
.. 73     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 74         """``(order_count, total_cents)`` over the customer's non-cancelled orders."""
.. 75         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return len(active), sum(s.total_cents for s in active)
.. 77 
.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 79         """Up to ``limit`` ``(customer, lifetime_value_cents)`` pairs, highest value first
.. 80         (ties by customer_id); customers with a lifetime value of 0 are left out."""
.. 81         ranked = []
.. 82         for customer in self._customers.list_all():
.. 83             _, value = self.lifetime_value(customer.customer_id)
.. 84             if value > 0:
.. 85                 ranked.append((customer, value))
.. 86         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 87         return ranked[:limit]
.. 88 
.. 89     def customers_without_orders(self) -> list[Customer]:
.. 90         """Customers with no non-cancelled orders, in registration order."""
.. 91         return [c for c in self._customers.list_all()
.. 92                 if self.lifetime_value(c.customer_id)[0] == 0]
