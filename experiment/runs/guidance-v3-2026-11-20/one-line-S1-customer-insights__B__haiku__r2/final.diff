src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the totals the order summary reports."""
20         try:
21             orders = self._orders.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         history = []
25         # Order ids are issued in creation order, so reversing gives newest first.
26         for order in reversed(orders):
27             summary = self._orders.summarize(order)
28             history.append({"order_id": order.order_id, "status": order.status,
29                             "total_cents": summary.total_cents})
30         return Response(200, {"customer_id": customer_id, "orders": history})
31 
32     def _lifetime(self, customer_id: str) -> tuple[int, int]:
33         """(order_count, lifetime_value_cents) over the customer's non-cancelled orders."""
34         active = [o for o in self._orders.list_for_customer(customer_id) if o.status != "cancelled"]
35         return len(active), sum(self._orders.summarize(o).total_cents for o in active)
36 
37     def handle_lifetime_value(self, customer_id: str) -> Response:
38         """Number of non-cancelled orders and the sum of their totals, as in the order history."""
39         try:
40             order_count, lifetime_value = self._lifetime(customer_id)
41         except CustomerNotFound:
42             return not_found("customer")
43         return Response(200, {"customer_id": customer_id, "order_count": order_count,
44                               "lifetime_value_cents": lifetime_value})
45 
46     def handle_customers_without_orders(self) -> Response:
47         """Registered customers with no non-cancelled orders, in registration order."""
48         customers = [c for c in self._customers.list_all()
49                      if self._lifetime(c.customer_id)[0] == 0]
50         return Response(200, {"customers": [
51             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
52 
53     def handle_top_customers(self, limit: Any) -> Response:
54         """Customers ranked by lifetime value, highest first (ties by customer_id), excluding zero-value ones."""
55         try:
56             limit = require_positive_int(limit, "limit")
57         except InvalidRequest as exc:
58             return bad_request(exc)
59         ranked = []
60         for customer in self._customers.list_all():
61             _, value = self._lifetime(customer.customer_id)
62             if value > 0:
63                 ranked.append((value, customer))
64         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
65         return Response(200, {"customers": [
66             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
67             for value, c in ranked[:limit]]})
