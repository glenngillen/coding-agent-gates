 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.catalog_service import CatalogService
 8 from orders.application.customer_service import CustomerService
 9 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
10 from orders.application.order_service import OrderService
11 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
12                                      require_non_negative_int, require_positive_int, require_str)
13 
14 # Warehouse low-stock line: products with fewer units than this on hand are flagged.
15 LOW_STOCK_LINE = 5
16 
17 
18 class FulfilmentController:
19     def __init__(self, orders: OrderService, customers: CustomerService, catalog: CatalogService) -> None:
20         self._orders = orders
21         self._customers = customers
22         self._catalog = catalog
23 
24     def handle_packing_slip(self, order_id: str) -> Response:
25         try:
26             order = self._orders.get_order(order_id)
27         except OrderNotFound:
28             return not_found("order")
29         if order.status == "cancelled":
30             return conflict(Conflict(f"order {order_id} is cancelled"))
31         try:
32             customer = self._customers.get(order.customer_id)
33             lines: list[dict[str, Any]] = []
34             for item in order.items:
35                 product = self._catalog.get_product(item.sku)
36                 lines.append({"sku": item.sku, "name": product.name, "quantity": item.quantity})
37         except (CustomerNotFound, ProductNotFound) as exc:
38             # Both are guaranteed by place_order; reaching here means the data is inconsistent.
39             raise RuntimeError(f"order {order_id} references missing data: {exc}") from exc
40         return Response(200, {"order_id": order.order_id, "customer_name": customer.name, "lines": lines})
41 
42     def handle_low_stock(self, threshold: Any) -> Response:
43         """Active products whose stock on hand is strictly below ``threshold``, lowest stock first."""
44         try:
45             limit = require_non_negative_int(threshold, "threshold")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         rows = []
49         for product in self._catalog.list_active():
50             on_hand = self._catalog.on_hand(product.sku)
51             if on_hand < limit:
52                 rows.append({"sku": product.sku, "name": product.name, "on_hand": on_hand})
53         rows.sort(key=lambda row: (row["on_hand"], row["sku"]))
54         return Response(200, {"products": rows})
55 
56     def handle_restock(self, request: dict[str, Any]) -> Response:
57         """Add units to a product's stock. Validation runs before any change is made."""
58         try:
59             sku = require_str(request, "sku")
60             quantity = require_positive_int(request.get("quantity"), "quantity")
61         except InvalidRequest as exc:
62             return bad_request(exc)
63         try:
64             on_hand = self._catalog.restock(sku, quantity)
65         except ProductNotFound:
66             return not_found("product")
67         return Response(200, {"sku": sku, "on_hand": on_hand})
68 
69     def handle_fulfilment_summary(self) -> Response:
70         """Dashboard counts: open orders, units to pick across them, and products below the low-stock line."""
71         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
72         units_to_pick = sum(item.quantity for order in open_orders for item in order.items)
73         low_stock = self.handle_low_stock(LOW_STOCK_LINE).body["products"]
74         return Response(200, {
75             "open_orders": len(open_orders),
76             "units_to_pick": units_to_pick,
77             "low_stock_products": len(low_stock),
78         })
