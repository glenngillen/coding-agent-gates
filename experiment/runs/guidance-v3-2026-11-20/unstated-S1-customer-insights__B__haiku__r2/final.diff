 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.domain.orders import Order
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService) -> None:
15         self._service = service
16 
17     def handle_order_history(self, customer_id: str) -> Response:
18         """A customer's orders, newest first, with totals including any discount."""
19         try:
20             orders = self._service.list_for_customer(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         history: list[dict[str, Any]] = []
24         for order in reversed(orders):  # repository returns creation order
25             summary = self._service.summarize(order)
26             history.append({"order_id": order.order_id, "status": order.status,
27                             "total_cents": summary.total_cents})
28         return Response(200, {"customer_id": customer_id, "orders": history})
29 
30     def handle_lifetime_value(self, customer_id: str) -> Response:
31         """Count and total of a customer's orders that are not cancelled."""
32         try:
33             orders = self._service.list_for_customer(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         count, total = self._active_totals(orders)
37         return Response(200, {"customer_id": customer_id, "order_count": count,
38                               "lifetime_value_cents": total})
39 
40     def handle_top_customers(self, limit: Any) -> Response:
41         """Customers ranked by lifetime value (highest first, then customer_id), zero-value excluded."""
42         try:
43             limit = require_positive_int(limit, "limit")
44         except InvalidRequest as exc:
45             return bad_request(exc)
46         ranked = []
47         for customer in self._service.list_customers():
48             _, total = self._active_totals(self._service.list_for_customer(customer.customer_id))
49             if total > 0:
50                 ranked.append((total, customer))
51         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
52         return Response(200, {"customers": [
53             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": total}
54             for total, customer in ranked[:limit]]})
55 
56     def handle_customers_without_orders(self) -> Response:
57         """Registered customers with no orders that are not cancelled, in registration order."""
58         customers = []
59         for customer in self._service.list_customers():
60             count, _ = self._active_totals(self._service.list_for_customer(customer.customer_id))
61             if count == 0:
62                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
63                                   "email": customer.email})
64         return Response(200, {"customers": customers})
65 
66     def _active_totals(self, orders: list[Order]) -> tuple[int, int]:
67         """Number of non-cancelled orders and the sum of their totals."""
68         active = [order for order in orders if order.status != "cancelled"]
69         return len(active), sum(self._service.summarize(order).total_cents for order in active)
