 74 def test_top_customers_ranking_zero_omitted_and_limit(shop):
 75     shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
 76     shop.customers.handle_register({"customer_id": "c3", "name": "Cy", "email": "cy@example.com"})
 77     shop.customers.handle_register({"customer_id": "c4", "name": "Di", "email": "di@example.com"})
 78     order(shop, "c1", ("BOOK", 1))          # 2500
 79     order(shop, "c3", ("BOOK", 1))          # 2500 (tie with c1 -> by id)
 80     order(shop, "c2", ("BOOK", 10))         # gold discount applies, still highest
 81     cancelled = order(shop, "c4", ("BOOK", 1)).body["order_id"]
 82     shop.orders.handle_cancel(cancelled)    # c4 has value 0; c0 has no orders
 83     resp = shop.insights.handle_top_customers(10)
 84     assert resp.status == 200
 85     assert [c["customer_id"] for c in resp.body["customers"]] == ["c2", "c1", "c3"]
 86     assert resp.body["customers"][1] == {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 2_500}
 87     top = shop.insights.handle_lifetime_value("c2").body["lifetime_value_cents"]
 88     assert resp.body["customers"][0]["lifetime_value_cents"] == top
 89     limited = shop.insights.handle_top_customers(2).body["customers"]
 90     assert [c["customer_id"] for c in limited] == ["c2", "c1"]
