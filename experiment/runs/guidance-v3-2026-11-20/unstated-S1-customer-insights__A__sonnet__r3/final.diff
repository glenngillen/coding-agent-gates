 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def _totals(self, customer_id: str) -> list[int]:
19         """Totals of the customer's non-cancelled orders; raises CustomerNotFound."""
20         return [self._service.summarize(o).total_cents
21                 for o in self._service.list_for_customer(customer_id) if o.status != "cancelled"]
22 
23     def handle_order_history(self, customer_id: str) -> Response:
24         """A customer's orders, newest first, with discounted totals."""
25         try:
26             orders = self._service.list_for_customer(customer_id)
27         except CustomerNotFound:
28             return not_found("customer")
29         # list_for_customer is in creation order, so reverse for newest first.
30         entries = []
31         for order in reversed(orders):
32             summary = self._service.summarize(order)
33             entries.append({"order_id": order.order_id, "status": order.status,
34                             "total_cents": summary.total_cents})
35         return Response(200, {"customer_id": customer_id, "orders": entries})
36 
37     def handle_lifetime_value(self, customer_id: str) -> Response:
38         """Count and summed (discounted) totals of a customer's non-cancelled orders."""
39         try:
40             totals = self._totals(customer_id)
41         except CustomerNotFound:
42             return not_found("customer")
43         return Response(200, {"customer_id": customer_id, "order_count": len(totals),
44                               "lifetime_value_cents": sum(totals)})
45 
46     def handle_customers_without_orders(self) -> Response:
47         """Customers with no non-cancelled orders, in registration order."""
48         customers = [{"customer_id": c.customer_id, "name": c.name, "email": c.email}
49                      for c in self._customers.list_all() if not self._totals(c.customer_id)]
50         return Response(200, {"customers": customers})
51 
52     def handle_top_customers(self, limit: Any) -> Response:
53         """Customers ranked by lifetime value (highest first, then customer_id), zeros omitted."""
54         try:
55             limit = require_positive_int(limit, "limit")
56         except InvalidRequest as exc:
57             return bad_request(exc)
58         ranked = []
59         for customer in self._customers.list_all():
60             value = sum(self._totals(customer.customer_id))
61             if value > 0:
62                 ranked.append({"customer_id": customer.customer_id, "name": customer.name,
63                                "lifetime_value_cents": value})
64         ranked.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
65         return Response(200, {"customers": ranked[:limit]})
