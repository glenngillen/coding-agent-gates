 18 def test_orders_are_newest_first_and_include_cancelled(shop):
 19     first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
 20     second = order(shop, "c1", ("PEN", 2)).body["order_id"]
 21     third = order(shop, "c1", ("LAMP", 1)).body["order_id"]
 22     shop.orders.handle_cancel(second)
