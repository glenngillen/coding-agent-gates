 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
19         """(order count, total) over a customer's non-cancelled orders. Raises CustomerNotFound."""
20         orders = self._service.list_for_customer(customer_id)
21         active = [o for o in orders if o.status != "cancelled"]
22         return len(active), sum(self._service.summarize(o).total_cents for o in active)
23 
24     def handle_order_history(self, customer_id: str) -> Response:
25         """A customer's orders, newest first, with the totals the order summary reports."""
26         try:
27             orders = self._service.list_for_customer(customer_id)
28         except CustomerNotFound:
29             return not_found("customer")
30         # list_for_customer returns creation order, so reverse it for newest first.
31         entries: list[dict[str, Any]] = [
32             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
33             for s in (self._service.summarize(o) for o in reversed(orders))
34         ]
35         return Response(200, {"customer_id": customer_id, "orders": entries})
36 
37     def handle_lifetime_value(self, customer_id: str) -> Response:
38         """Count and total of a customer's orders, leaving out cancelled ones."""
39         try:
40             count, total = self._lifetime_value(customer_id)
41         except CustomerNotFound:
42             return not_found("customer")
43         return Response(200, {"customer_id": customer_id, "order_count": count,
44                               "lifetime_value_cents": total})
45 
46     def handle_customers_without_orders(self) -> Response:
47         """Registered customers with no orders other than cancelled ones, in registration order."""
48         customers = [
49             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
50             for c in self._customers.list_all()
51             if self._lifetime_value(c.customer_id)[0] == 0
52         ]
53         return Response(200, {"customers": customers})
54 
55     def handle_top_customers(self, limit: Any) -> Response:
56         """Customers ranked by lifetime value, highest first, leaving out those at zero."""
57         try:
58             limit = require_positive_int(limit, "limit")
59         except InvalidRequest as exc:
60             return bad_request(exc)
61         ranked = []
62         for customer in self._customers.list_all():
63             _, total = self._lifetime_value(customer.customer_id)
64             if total > 0:
65                 ranked.append((total, customer))
66         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
67         return Response(200, {"customers": [
68             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
69             for total, c in ranked[:limit]
70         ]})
