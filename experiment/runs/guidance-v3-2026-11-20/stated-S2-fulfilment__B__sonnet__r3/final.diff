14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 LOW_STOCK_LINE = 5  # the warehouse's low-stock line: fewer than this many units on hand
36 
37 
38 @dataclass(frozen=True)
39 class FulfilmentSummary:
40     open_orders: int
41     units_to_pick: int
42     low_stock_products: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._stock = stock
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52 
53     def packing_slip(self, order_id: str) -> PackingSlip:
54         from orders.application.errors import OrderNotFound
55 
56         order = self._orders.get(order_id)
57         if order is None:
58             raise OrderNotFound(order_id)
59         if order.status == "cancelled":
60             raise Conflict(f"order {order_id} is cancelled")
61         customer = self._customers.get(order.customer_id)
62         customer_name = customer.name if customer is not None else ""
63         lines = []
64         for item in order.items:
65             product = self._catalog.get(item.sku)
66             lines.append(PackingSlipLine(item.sku, product.name if product is not None else item.sku,
67                                          item.quantity))
68         return PackingSlip(order.order_id, customer_name, tuple(lines))
69 
70     def restock(self, sku: str, quantity: int) -> int:
71         """Add ``quantity`` units to a known product's stock and return the new level."""
72         if self._catalog.get(sku) is None:
73             raise ProductNotFound(sku)
74         level = self._stock.get(sku) + quantity
75         self._stock.set(sku, level)
76         return level
77 
78     def summary(self) -> FulfilmentSummary:
79         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
80         units = sum(item.quantity for o in open_orders for item in o.items)
81         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
82 
83     def low_stock(self, threshold: int) -> list[LowStockProduct]:
84         """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
85         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
86                  for p in self._catalog.list_all() if p.active]
87         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
