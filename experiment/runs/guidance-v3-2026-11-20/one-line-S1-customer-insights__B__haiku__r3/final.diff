src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 from orders.domain.orders import OrderSummary
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
16         self._orders = orders
17         self._customers = customers
18 
19     def _active_summaries(self, customer_id: str) -> list[OrderSummary]:
20         """A customer's non-cancelled order summaries, newest first. Raises CustomerNotFound."""
21         return [s for s in self._orders.order_history(customer_id) if s.order.status != "cancelled"]
22 
23     def _lifetime_value_cents(self, customer_id: str) -> int:
24         return sum(s.total_cents for s in self._active_summaries(customer_id))
25 
26     def handle_order_history(self, customer_id: str) -> Response:
27         """A customer's orders, newest first, with the same totals the order summary reports."""
28         try:
29             summaries = self._orders.order_history(customer_id)
30         except CustomerNotFound:
31             return not_found("customer")
32         orders: list[dict[str, Any]] = [
33             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
34             for s in summaries
35         ]
36         return Response(200, {"customer_id": customer_id, "orders": orders})
37 
38     def handle_lifetime_value(self, customer_id: str) -> Response:
39         """Number of non-cancelled orders and the sum of their totals, in cents."""
40         try:
41             active = self._active_summaries(customer_id)
42         except CustomerNotFound:
43             return not_found("customer")
44         return Response(200, {
45             "customer_id": customer_id,
46             "order_count": len(active),
47             "lifetime_value_cents": sum(s.total_cents for s in active),
48         })
49 
50     def handle_top_customers(self, limit: Any) -> Response:
51         """Customers with the highest lifetime value (ties broken by customer_id), omitting zeros."""
52         try:
53             limit = require_positive_int(limit, "limit")
54         except InvalidRequest as exc:
55             return bad_request(exc)
56         ranked = []
57         for customer in self._customers.list_all():
58             value = self._lifetime_value_cents(customer.customer_id)
59             if value > 0:
60                 ranked.append((value, customer))
61         ranked.sort(key=lambda entry: (-entry[0], entry[1].customer_id))
62         return Response(200, {"customers": [
63             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
64             for value, c in ranked[:limit]
65         ]})
66 
67     def handle_customers_without_orders(self) -> Response:
68         """Registered customers with no non-cancelled orders, in registration order."""
69         customers = [
70             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
71             for c in self._customers.list_all()
72             if not self._active_summaries(c.customer_id)
73         ]
74         return Response(200, {"customers": customers})
