.. 68     def history_for_customer(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries (with discounts applied) for every order of a customer, newest first."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(order) for order in reversed(orders)]
.. 72 
.. 73     def lifetime_value_for_customer(self, customer_id: str) -> CustomerLifetimeValue:
.. 74         """Count and total of a customer's orders, excluding cancelled ones."""
.. 75         active = [s for s in self.history_for_customer(customer_id) if s.order.status != "cancelled"]
.. 76         return CustomerLifetimeValue(customer_id, len(active), sum(s.total_cents for s in active))
.. 77 
.. 78     def customers_without_orders(self) -> list[Customer]:
.. 79         """Registered customers with no orders that are not cancelled, in registration order."""
.. 80         return [c for c in self._customers.list_all()
.. 81                 if self.lifetime_value_for_customer(c.customer_id).order_count == 0]
.. 82 
.. 83     def top_customers_by_lifetime_value(self, limit: int) -> list[tuple[Customer, CustomerLifetimeValue]]:
.. 84         """Up to ``limit`` customers with a non-zero lifetime value, highest first (ties by id)."""
.. 85         ranked = []
.. 86         for customer in self._customers.list_all():
.. 87             value = self.lifetime_value_for_customer(customer.customer_id)
.. 88             if value.lifetime_value_cents > 0:
.. 89                 ranked.append((customer, value))
.. 90         ranked.sort(key=lambda pair: (-pair[1].lifetime_value_cents, pair[0].customer_id))
.. 91         return ranked[:limit]
