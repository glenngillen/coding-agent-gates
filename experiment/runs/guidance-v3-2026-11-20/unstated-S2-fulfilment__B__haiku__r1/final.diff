 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService, PackingSlip
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 def packing_slip_body(slip: PackingSlip) -> dict:
14     return {
15         "order_id": slip.order_id,
16         "customer_name": slip.customer_name,
17         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
18                   for line in slip.lines],
19     }
20 
21 
22 class FulfilmentController:
23     def __init__(self, service: FulfilmentService) -> None:
24         self._service = service
25 
26     def handle_packing_slip(self, order_id: str) -> Response:
27         try:
28             slip = self._service.packing_slip(order_id)
29         except OrderNotFound:
30             return not_found("order")
31         except Conflict as exc:
32             return conflict(exc)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, packing_slip_body(slip))
36 
37     def handle_low_stock(self, threshold: Any) -> Response:
38         try:
39             limit = require_non_negative_int(threshold, "threshold")
40         except InvalidRequest as exc:
41             return bad_request(exc)
42         products = [{"sku": entry.product.sku, "name": entry.product.name, "on_hand": entry.on_hand}
43                     for entry in self._service.low_stock(limit)]
44         return Response(200, {"products": products})
45 
46     def handle_fulfilment_summary(self) -> Response:
47         summary = self._service.summary()
48         return Response(200, {"open_orders": summary.open_orders,
49                               "units_to_pick": summary.units_to_pick,
50                               "low_stock_products": summary.low_stock_products})
51 
52     def handle_restock(self, request: dict[str, Any]) -> Response:
53         try:
54             sku = require_str(request, "sku")
55             quantity = require_positive_int(request.get("quantity"), "quantity")
56         except InvalidRequest as exc:
57             return bad_request(exc)
58         try:
59             on_hand = self._service.restock(sku, quantity)
60         except ProductNotFound:
61             return not_found("product")
62         return Response(200, {"sku": sku, "on_hand": on_hand})
