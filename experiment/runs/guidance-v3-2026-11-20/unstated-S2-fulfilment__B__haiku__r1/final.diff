46 class FulfilmentService:
47     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
48                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52         self._stock = stock
53 
54     def summary(self) -> FulfilmentSummary:
55         """Counts for the warehouse dashboard: open orders, units across them, and low-stock products."""
56         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
57         units = sum(item.quantity for order in open_orders for item in order.items)
58         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
59 
60     def restock(self, sku: str, quantity: int) -> int:
61         """Add ``quantity`` units to a product's stock and return the new on-hand level."""
62         if self._catalog.get(sku) is None:
63             raise ProductNotFound(sku)
64         new_level = self._stock.get(sku) + quantity
65         self._stock.set(sku, new_level)
66         return new_level
67 
68     def low_stock(self, threshold: int) -> list[LowStockProduct]:
69         """Active products with on-hand stock strictly below ``threshold``, lowest first, then by SKU."""
70         found = [LowStockProduct(p, self._stock.get(p.sku))
71                  for p in self._catalog.list_all() if p.active]
72         found = [entry for entry in found if entry.on_hand < threshold]
73         return sorted(found, key=lambda entry: (entry.on_hand, entry.product.sku))
74 
75     def packing_slip(self, order_id: str) -> PackingSlip:
76         """Packing slip for a non-cancelled order, lines in the order's item order."""
77         order: Order | None = self._orders.get(order_id)
78         if order is None:
79             raise OrderNotFound(order_id)
80         if order.status == "cancelled":
81             raise Conflict(f"order {order_id} is cancelled")
82         customer = self._customers.get(order.customer_id)
83         if customer is None:
84             raise CustomerNotFound(order.customer_id)
85         lines = tuple(PackingSlipLine(item.sku, self._catalog.get(item.sku).name, item.quantity)
86                       for item in order.items)
87         return PackingSlip(order.order_id, customer.name, lines)
