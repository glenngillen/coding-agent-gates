   37     def restock(self, sku: str, quantity: int) -> int:
   38         """Add ``quantity`` units to a known product's stock and return the new level."""
   39         self.get_product(sku)
   40         new_level = self._stock.get(sku) + quantity
   41         self._stock.set(sku, new_level)
   42         return new_level
   43 
   44     def low_stock(self, threshold: int) -> list[tuple[Product, int]]:
   45         """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
   46         rows = [(p, self._stock.get(p.sku)) for p in self.list_active()]
   47         return sorted((r for r in rows if r[1] < threshold), key=lambda r: (r[1], r[0].sku))

