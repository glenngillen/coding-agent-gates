 7 from orders.application.catalog_service import CatalogService
 8 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
11                                      require_non_negative_int, require_positive_int, require_str)
12 
13 
14 LOW_STOCK_LINE = 5  # units on hand below which a product counts as low stock
15 
16 
17 class FulfilmentController:
18     def __init__(self, service: OrderService, catalog: CatalogService) -> None:
19         self._service = service
20         self._catalog = catalog
21 
22     def handle_fulfilment_summary(self) -> Response:
23         open_orders, units_to_pick = self._service.open_order_totals()
24         return Response(200, {
25             "open_orders": open_orders,
26             "units_to_pick": units_to_pick,
27             "low_stock_products": len(self._catalog.low_stock(LOW_STOCK_LINE)),
28         })
29 
30     def handle_packing_slip(self, order_id: str) -> Response:
31         try:
32             slip = self._service.get_packing_slip(order_id)
33         except OrderNotFound:
34             return not_found("order")
35         except Conflict as exc:
36             return conflict(exc)
37         except CustomerNotFound:
38             return not_found("customer")
39         except ProductNotFound:
40             return not_found("product")
41         return Response(200, {
42             "order_id": slip.order.order_id,
43             "customer_name": slip.customer_name,
44             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
45                       for line in slip.lines],
46         })
47 
48     def handle_low_stock(self, threshold: Any) -> Response:
49         try:
50             limit = require_non_negative_int(threshold, "threshold")
51         except InvalidRequest as exc:
52             return bad_request(exc)
53         return Response(200, {"products": [
54             {"sku": product.sku, "name": product.name, "on_hand": on_hand}
55             for product, on_hand in self._catalog.low_stock(limit)
56         ]})
57 
58     def handle_restock(self, request: dict[str, Any]) -> Response:
59         try:
60             sku = require_str(request, "sku")
61             quantity = require_positive_int(request.get("quantity"), "quantity")
62         except InvalidRequest as exc:
63             return bad_request(exc)
64         try:
65             on_hand = self._catalog.restock(sku, quantity)
66         except ProductNotFound:
67             return not_found("product")
68         return Response(200, {"sku": sku, "on_hand": on_hand})
