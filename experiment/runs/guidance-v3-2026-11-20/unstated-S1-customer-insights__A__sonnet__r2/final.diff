 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
 8                                      require_positive_int)
 9 from orders.domain.orders import Order
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def _lifetime_value(self, orders: list[Order]) -> tuple[int, int]:
19         """(count, total cents) over the non-cancelled orders."""
20         active = [o for o in orders if o.status != "cancelled"]
21         return len(active), sum(self._service.summarize(o).total_cents for o in active)
22 
23     def handle_customers_without_orders(self) -> Response:
24         """Customers with no non-cancelled orders, in registration order."""
25         idle = []
26         for customer in self._customers.list_all():
27             count, _ = self._lifetime_value(self._service.list_for_customer(customer.customer_id))
28             if count == 0:
29                 idle.append({"customer_id": customer.customer_id, "name": customer.name,
30                              "email": customer.email})
31         return Response(200, {"customers": idle})
32 
33     def handle_top_customers(self, limit: int) -> Response:
34         """Customers ranked by lifetime value, highest first, then customer_id."""
35         try:
36             limit = require_positive_int(limit, "limit")
37         except InvalidRequest as exc:
38             return bad_request(exc)
39         ranked = []
40         for customer in self._customers.list_all():
41             _, value = self._lifetime_value(self._service.list_for_customer(customer.customer_id))
42             if value > 0:
43                 ranked.append((customer.customer_id, customer.name, value))
44         ranked.sort(key=lambda r: (-r[2], r[0]))
45         return Response(200, {"customers": [
46             {"customer_id": cid, "name": name, "lifetime_value_cents": value}
47             for cid, name, value in ranked[:limit]]})
48 
49     def handle_order_history(self, customer_id: str) -> Response:
50         """A customer's orders, newest first, with discounted totals."""
51         try:
52             orders = self._service.list_for_customer(customer_id)
53         except CustomerNotFound:
54             return not_found("customer")
55         entries = []
56         # The repository returns creation order, so reverse for newest first.
57         for order in reversed(orders):
58             summary = self._service.summarize(order)
59             entries.append({"order_id": order.order_id, "status": order.status,
60                             "total_cents": summary.total_cents})
61         return Response(200, {"customer_id": customer_id, "orders": entries})
62 
63     def handle_lifetime_value(self, customer_id: str) -> Response:
64         """Count and discounted total of a customer's non-cancelled orders."""
65         try:
66             orders = self._service.list_for_customer(customer_id)
67         except CustomerNotFound:
68             return not_found("customer")
69         count, total = self._lifetime_value(orders)
70         return Response(200, {"customer_id": customer_id, "order_count": count,
71                               "lifetime_value_cents": total})
