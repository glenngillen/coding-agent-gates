 18 def test_history_newest_first_with_discounts_and_cancelled(shop):
 19     first = order(shop, "c1", ("BOOK", 1)).body["order_id"]       # 2500, no discount
 20     second = order(shop, "c1", ("LAMP", 2)).body["order_id"]      # 12000 -> 10800
 21     third = order(shop, "c1", ("PEN", 1)).body["order_id"]
 22     order(shop, "c2", ("BOOK", 1))
 23     shop.orders.handle_cancel(third)
 24     body = shop.insights.handle_order_history("c1").body
 25     assert body["customer_id"] == "c1"
 26     assert body["orders"] == [
 27         {"order_id": third, "status": "cancelled", "total_cents": 300},
 28         {"order_id": second, "status": "placed", "total_cents": 10_800},
 29         {"order_id": first, "status": "placed", "total_cents": 2_500},
 30     ]
 31     for entry in body["orders"]:
 32         assert entry["total_cents"] == shop.orders.handle_get(entry["order_id"]).body["total_cents"]
