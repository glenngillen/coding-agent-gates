 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_top_customers(self, limit: Any) -> Response:
17         try:
18             limit = require_positive_int(limit, "limit")
19         except InvalidRequest as exc:
20             return bad_request(exc)
21         return Response(200, {"customers": [
22             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
23             for c, value in self._service.top_customers(limit)]})
24 
25     def handle_customers_without_orders(self) -> Response:
26         return Response(200, {"customers": [
27             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
28             for c in self._service.customers_without_orders()]})
29 
30     def handle_lifetime_value(self, customer_id: str) -> Response:
31         try:
32             count, total = self._service.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {"customer_id": customer_id, "order_count": count,
36                               "lifetime_value_cents": total})
37 
38     def handle_order_history(self, customer_id: str) -> Response:
39         try:
40             history = self._service.order_history(customer_id)
41         except CustomerNotFound:
42             return not_found("customer")
43         return Response(200, {
44             "customer_id": customer_id,
45             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
46                         "total_cents": s.total_cents} for s in history],
47         })
