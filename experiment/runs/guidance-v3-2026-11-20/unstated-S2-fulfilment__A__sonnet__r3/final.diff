 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
 8                                      require_non_negative_int, require_positive_int, require_str)
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 from orders.infrastructure.stock import InMemoryStockRepository
13 
14 # The warehouse's low-stock line: fewer than this many units on hand is "low".
15 LOW_STOCK_LEVEL = 5
16 
17 
18 class FulfilmentController:
19     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
20                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
21         self._orders = orders
22         self._customers = customers
23         self._catalog = catalog
24         self._stock = stock
25 
26     def handle_packing_slip(self, order_id: str) -> Response:
27         """What the warehouse needs to pack an order."""
28         order = self._orders.get(order_id)
29         if order is None:
30             return not_found("order")
31         if order.status == "cancelled":
32             return conflict(ValueError("order is cancelled"))
33         customer = self._customers.get(order.customer_id)
34         lines = []
35         for item in order.items:
36             product = self._catalog.get(item.sku)
37             lines.append({"sku": item.sku, "name": product.name if product else item.sku,
38                           "quantity": item.quantity})
39         return Response(200, {"order_id": order.order_id,
40                               "customer_name": customer.name if customer else None,
41                               "lines": lines})
42 
43     def handle_low_stock(self, threshold: object) -> Response:
44         """Active products whose stock on hand is strictly below the threshold."""
45         try:
46             limit = require_non_negative_int(threshold, "threshold")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         return Response(200, {"products": self._low_stock(limit)})
50 
51     def _low_stock(self, limit: int) -> list[dict[str, Any]]:
52         low = [{"sku": p.sku, "name": p.name, "on_hand": self._stock.get(p.sku)}
53                for p in self._catalog.list_all() if p.active]
54         low = [entry for entry in low if entry["on_hand"] < limit]
55         low.sort(key=lambda entry: (entry["on_hand"], entry["sku"]))
56         return low
57 
58     def handle_fulfilment_summary(self) -> Response:
59         """Headline numbers for the warehouse dashboard."""
60         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
61         return Response(200, {
62             "open_orders": len(open_orders),
63             "units_to_pick": sum(item.quantity for o in open_orders for item in o.items),
64             "low_stock_products": len(self._low_stock(LOW_STOCK_LEVEL)),
65         })
66 
67     def handle_restock(self, request: dict[str, Any]) -> Response:
68         """Add received units to a product's stock."""
69         try:
70             sku = require_str(request, "sku")
71             quantity = require_positive_int(request.get("quantity"), "quantity")
72         except InvalidRequest as exc:
73             return bad_request(exc)
74         if self._catalog.get(sku) is None:
75             return not_found("product")
76         on_hand = self._stock.get(sku) + quantity
77         self._stock.set(sku, on_hand)
78         return Response(200, {"sku": sku, "on_hand": on_hand})
