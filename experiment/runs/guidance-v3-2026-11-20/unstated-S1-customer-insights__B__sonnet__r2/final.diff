 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_top_customers(self, limit: Any) -> Response:
17         """Customers ranked by lifetime value, highest first, zero-value omitted."""
18         try:
19             limit = require_positive_int(limit, "limit")
20         except InvalidRequest as exc:
21             return bad_request(exc)
22         ranked = self._service.top_customers()[:limit]
23         return Response(200, {"customers": [
24             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
25             for c, value in ranked]})
26 
27     def handle_customers_without_orders(self) -> Response:
28         """Customers with no non-cancelled orders, in registration order."""
29         return Response(200, {"customers": [
30             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
31             for c in self._service.customers_without_active_orders()]})
32 
33     def handle_order_history(self, customer_id: str) -> Response:
34         """A customer's orders, newest first, with discounted totals."""
35         try:
36             orders = self._service.list_for_customer(customer_id)
37         except CustomerNotFound:
38             return not_found("customer")
39         # list_for_customer is in creation order; reverse for newest first.
40         entries = []
41         for order in reversed(orders):
42             summary = self._service.summarize(order)
43             entries.append({"order_id": order.order_id, "status": order.status,
44                             "total_cents": summary.total_cents})
45         return Response(200, {"customer_id": customer_id, "orders": entries})
46 
47     def handle_lifetime_value(self, customer_id: str) -> Response:
48         """Count and total of a customer's non-cancelled orders."""
49         try:
50             count, total = self._service.lifetime_value(customer_id)
51         except CustomerNotFound:
52             return not_found("customer")
53         return Response(200, {"customer_id": customer_id, "order_count": count,
54                               "lifetime_value_cents": total})
