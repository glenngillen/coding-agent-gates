18 class CustomerInsightsController:
19     def __init__(self, service: OrderService) -> None:
20         self._service = service
21 
22     def handle_order_history(self, customer_id: str) -> Response:
23         try:
24             summaries = self._service.order_history(customer_id)
25         except CustomerNotFound:
26             return not_found("customer")
27         return Response(200, {"customer_id": customer_id,
28                               "orders": [history_entry(s) for s in summaries]})
29 
30     def handle_lifetime_value(self, customer_id: str) -> Response:
31         try:
32             order_count, total_cents = self._service.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {"customer_id": customer_id, "order_count": order_count,
36                               "lifetime_value_cents": total_cents})
37 
38     def handle_customers_without_orders(self) -> Response:
39         return Response(200, {"customers": [
40             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
41             for c in self._service.customers_without_orders()]})
42 
43     def handle_top_customers(self, limit: Any) -> Response:
44         try:
45             limit = require_positive_int(limit, "limit")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         ranked = self._service.top_customers(limit)
49         return Response(200, {"customers": [
50             {"customer_id": customer.customer_id, "name": customer.name,
51              "lifetime_value_cents": total_cents}
52             for customer, total_cents in ranked]})
