src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: CustomerService) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def _history(self, customer_id: str) -> list[dict[str, Any]]:
19         """A customer's orders, newest first, with the same totals ``handle_get`` reports.
20 
21         Raises ``CustomerNotFound`` for an unknown customer.
22         """
23         orders = self._service.list_for_customer(customer_id)
24         history: list[dict[str, Any]] = []
25         for order in reversed(orders):  # the repository returns creation order
26             summary = self._service.summarize(order)
27             history.append({"order_id": order.order_id, "status": order.status,
28                             "total_cents": summary.total_cents})
29         return history
30 
31     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
32         """``(order_count, lifetime_value_cents)``: non-cancelled orders and their total.
33 
34         Raises ``CustomerNotFound`` for an unknown customer.
35         """
36         counted = [entry for entry in self._history(customer_id) if entry["status"] != "cancelled"]
37         return len(counted), sum(entry["total_cents"] for entry in counted)
38 
39     def handle_order_history(self, customer_id: str) -> Response:
40         try:
41             history = self._history(customer_id)
42         except CustomerNotFound:
43             return not_found("customer")
44         return Response(200, {"customer_id": customer_id, "orders": history})
45 
46     def handle_lifetime_value(self, customer_id: str) -> Response:
47         """Number of non-cancelled orders and the sum of their totals."""
48         try:
49             order_count, value = self._lifetime_value(customer_id)
50         except CustomerNotFound:
51             return not_found("customer")
52         return Response(200, {"customer_id": customer_id, "order_count": order_count,
53                               "lifetime_value_cents": value})
54 
55     def handle_customers_without_orders(self) -> Response:
56         """Registered customers with no orders that are not cancelled, in registration order."""
57         customers = [
58             {"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
59             for customer in self._customers.list_all()
60             if self._lifetime_value(customer.customer_id)[0] == 0
61         ]
62         return Response(200, {"customers": customers})
63 
64     def handle_top_customers(self, limit: Any) -> Response:
65         """Customers with the highest lifetime value, skipping those at zero."""
66         try:
67             limit = require_positive_int(limit, "limit")
68         except InvalidRequest as exc:
69             return bad_request(exc)
70         ranked = []
71         for customer in self._customers.list_all():
72             _, value = self._lifetime_value(customer.customer_id)
73             if value > 0:
74                 ranked.append((value, customer))
75         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
76         return Response(200, {"customers": [
77             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": value}
78             for value, customer in ranked[:limit]
79         ]})
