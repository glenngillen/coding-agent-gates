.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """A customer's orders with totals, newest first, cancelled orders included."""
.. 70         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 71 
.. 72     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 73         """``(order_count, lifetime_value_cents)`` over a customer's non-cancelled orders."""
.. 74         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 75         return len(active), sum(s.total_cents for s in active)
.. 76 
.. 77     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 78         """Up to ``limit`` customers with a non-zero lifetime value, highest first, ties by id."""
.. 79         ranked = []
.. 80         for customer in self._customers.list_all():
.. 81             _, value = self.lifetime_value(customer.customer_id)
.. 82             if value > 0:
.. 83                 ranked.append((customer, value))
.. 84         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 85         return ranked[:limit]
.. 86 
.. 87     def customers_without_orders(self) -> list[Customer]:
.. 88         """Registered customers with no non-cancelled orders, in registration order."""
.. 89         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
