 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
10                                      require_positive_int)
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService) -> None:
15         self._service = service
16 
17     def handle_lifetime_value(self, customer_id: str) -> Response:
18         """Count and total of the customer's non-cancelled orders."""
19         try:
20             count, value = self._service.lifetime_value(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         return Response(200, {"customer_id": customer_id, "order_count": count,
24                               "lifetime_value_cents": value})
25 
26     def handle_top_customers(self, limit: Any) -> Response:
27         """Leaderboard of customers by lifetime value."""
28         try:
29             limit = require_positive_int(limit, "limit")
30         except InvalidRequest as exc:
31             return bad_request(exc)
32         return Response(200, {"customers": [
33             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
34             for c, value in self._service.top_customers(limit)]})
35 
36     def handle_customers_without_orders(self) -> Response:
37         """Customers with no active (non-cancelled) orders, in registration order."""
38         return Response(200, {"customers": [
39             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
40             for c in self._service.customers_without_orders()]})
41 
42     def handle_order_history(self, customer_id: str) -> Response:
43         """A customer's orders, newest first, with discounted totals."""
44         try:
45             summaries = self._service.order_history(customer_id)
46         except CustomerNotFound:
47             return not_found("customer")
48         return Response(200, {"customer_id": customer_id, "orders": [
49             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
50             for s in summaries]})
