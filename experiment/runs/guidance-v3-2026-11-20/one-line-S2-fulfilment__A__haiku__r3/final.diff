 1 """Warehouse fulfilment: packing slips for orders that are still to be packed."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 class FulfilmentService:
36     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
37                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
38         self._orders = orders
39         self._customers = customers
40         self._catalog = catalog
41         self._stock = stock
42 
43     def fulfilment_summary(self, low_stock_line: int = 5) -> tuple[int, int, int]:
44         """Return ``(open_orders, units_to_pick, low_stock_products)`` for the dashboard."""
45         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
46         units_to_pick = sum(item.quantity for order in open_orders for item in order.items)
47         low_stock_products = len(self.low_stock(low_stock_line))
48         return len(open_orders), units_to_pick, low_stock_products
49 
50     def restock(self, sku: str, quantity: int) -> int:
51         """Add ``quantity`` units to a product's stock and return the new level."""
52         if self._catalog.get(sku) is None:
53             raise ProductNotFound(sku)
54         new_level = self._stock.get(sku) + quantity
55         self._stock.set(sku, new_level)
56         return new_level
57 
58     def low_stock(self, threshold: int) -> list[LowStockProduct]:
59         """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
60         products = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
61                     for p in self._catalog.list_all() if p.active]
62         return sorted((p for p in products if p.on_hand < threshold),
63                       key=lambda p: (p.on_hand, p.sku))
64 
65     def packing_slip(self, order_id: str) -> PackingSlip:
66         """Build the packing slip for an order; lines keep the order's item order."""
67         order = self._orders.get(order_id)
68         if order is None:
69             raise OrderNotFound(order_id)
70         if order.status == "cancelled":
71             raise Conflict(f"order {order_id} is cancelled")
72         customer = self._customers.get(order.customer_id)
73         if customer is None:
74             raise CustomerNotFound(order.customer_id)
75         lines = []
76         for item in order.items:
77             product = self._catalog.get(item.sku)
78             if product is None:
79                 raise ProductNotFound(item.sku)
80             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
81         return PackingSlip(order.order_id, customer.name, tuple(lines))
