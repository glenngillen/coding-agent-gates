 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.application.fulfilment_service import FulfilmentService
 7 from typing import Any
 8 
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as exc:
23             return conflict(exc)
24         except CustomerNotFound:
25             return not_found("customer")
26         except ProductNotFound:
27             return not_found("product")
28         return Response(200, {
29             "order_id": slip.order_id,
30             "customer_name": slip.customer_name,
31             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
32                       for line in slip.lines],
33         })
34 
35     def handle_restock(self, request: dict[str, Any]) -> Response:
36         try:
37             sku = require_str(request, "sku")
38             quantity = require_positive_int(request.get("quantity"), "quantity")
39         except InvalidRequest as exc:
40             return bad_request(exc)
41         try:
42             new_level = self._service.restock(sku, quantity)
43         except ProductNotFound:
44             return not_found("product")
45         return Response(200, {"sku": sku, "on_hand": new_level})
46 
47     def handle_fulfilment_summary(self) -> Response:
48         open_orders, units_to_pick, low_stock_products = self._service.fulfilment_summary()
49         return Response(200, {"open_orders": open_orders, "units_to_pick": units_to_pick,
50                               "low_stock_products": low_stock_products})
51 
52     def handle_low_stock(self, threshold: object) -> Response:
53         try:
54             limit = require_non_negative_int(threshold, "threshold")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         return Response(200, {"products": [
58             {"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
59             for p in self._service.low_stock(limit)
60         ]})
