 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_fulfilment_summary(self) -> Response:
18         s = self._service.summary()
19         return Response(200, {"open_orders": s.open_orders, "units_to_pick": s.units_to_pick,
20                               "low_stock_products": s.low_stock_products})
21 
22     def handle_restock(self, request: dict[str, Any]) -> Response:
23         try:
24             sku = require_str(request, "sku")
25             quantity = require_positive_int(request.get("quantity"), "quantity")
26         except InvalidRequest as exc:
27             return bad_request(exc)
28         try:
29             on_hand = self._service.restock(sku, quantity)
30         except ProductNotFound:
31             return not_found("product")
32         return Response(200, {"sku": sku, "on_hand": on_hand})
33 
34     def handle_low_stock(self, threshold: Any) -> Response:
35         try:
36             threshold = require_non_negative_int(threshold, "threshold")
37         except InvalidRequest as exc:
38             return bad_request(exc)
39         products = self._service.low_stock(threshold)
40         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
41                                            for p in products]})
42 
43     def handle_packing_slip(self, order_id: str) -> Response:
44         try:
45             slip = self._service.packing_slip(order_id)
46         except OrderNotFound:
47             return not_found("order")
48         except Conflict as exc:
49             return conflict(exc)
50         return Response(200, {
51             "order_id": slip.order_id,
52             "customer_name": slip.customer_name,
53             "lines": [{"sku": l.sku, "name": l.name, "quantity": l.quantity} for l in slip.lines],
54         })
