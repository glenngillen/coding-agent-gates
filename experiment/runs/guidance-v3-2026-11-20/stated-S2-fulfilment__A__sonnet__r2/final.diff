14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 LOW_STOCK_LEVEL = 5  # the warehouse's low-stock line
29 
30 
31 @dataclass(frozen=True)
32 class FulfilmentSummary:
33     open_orders: int
34     units_to_pick: int
35     low_stock_products: int
36 
37 
38 @dataclass(frozen=True)
39 class LowStockProduct:
40     sku: str
41     name: str
42     on_hand: int
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def summary(self) -> FulfilmentSummary:
54         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
55         units = sum(item.quantity for o in open_orders for item in o.items)
56         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LEVEL)))
57 
58     def restock(self, sku: str, quantity: int) -> int:
59         """Add ``quantity`` units to a product's stock and return the new level."""
60         if self._catalog.get(sku) is None:
61             raise ProductNotFound(sku)
62         level = self._stock.get(sku) + quantity
63         self._stock.set(sku, level)
64         return level
65 
66     def low_stock(self, threshold: int) -> list[LowStockProduct]:
67         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
68         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
69                  for p in self._catalog.list_all() if p.active]
70         found = [p for p in found if p.on_hand < threshold]
71         return sorted(found, key=lambda p: (p.on_hand, p.sku))
72 
73     def packing_slip(self, order_id: str) -> PackingSlip:
74         order = self._orders.get(order_id)
75         if order is None:
76             raise OrderNotFound(order_id)
77         if order.status == "cancelled":
78             raise Conflict(f"order {order_id} is cancelled")
79         customer = self._customers.get(order.customer_id)
80         lines = []
81         for item in order.items:
82             product = self._catalog.get(item.sku)
83             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
84         return PackingSlip(order.order_id, customer.name if customer else "", tuple(lines))
