src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with totals as reported by the order summary."""
20         try:
21             orders = self._orders.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         # list_for_customer returns creation order; order ids increase with creation.
25         entries: list[dict[str, Any]] = [
26             {"order_id": order.order_id,
27              "status": order.status,
28              "total_cents": self._orders.summarize(order).total_cents}
29             for order in reversed(orders)
30         ]
31         return Response(200, {"customer_id": customer_id, "orders": entries})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         """Count and total of a customer's orders, excluding cancelled ones."""
35         try:
36             order_count, lifetime_value_cents = self._lifetime_value(customer_id)
37         except CustomerNotFound:
38             return not_found("customer")
39         return Response(200, {"customer_id": customer_id, "order_count": order_count,
40                               "lifetime_value_cents": lifetime_value_cents})
41 
42     def handle_top_customers(self, limit: Any) -> Response:
43         """Customers with the highest lifetime value, excluding those with none."""
44         try:
45             limit = require_positive_int(limit, "limit")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         ranked = []
49         for customer in self._customers.list_all():
50             _, value = self._lifetime_value(customer.customer_id)
51             if value > 0:
52                 ranked.append((value, customer.customer_id, customer.name))
53         ranked.sort(key=lambda row: (-row[0], row[1]))
54         return Response(200, {"customers": [
55             {"customer_id": customer_id, "name": name, "lifetime_value_cents": value}
56             for value, customer_id, name in ranked[:limit]
57         ]})
58 
59     def handle_customers_without_orders(self) -> Response:
60         """Registered customers with no orders other than cancelled ones, in registration order."""
61         customers = [
62             {"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
63             for customer in self._customers.list_all()
64             if self._lifetime_value(customer.customer_id)[0] == 0
65         ]
66         return Response(200, {"customers": customers})
67 
68     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
69         """(number of non-cancelled orders, sum of their totals). Raises CustomerNotFound."""
70         orders = self._orders.list_for_customer(customer_id)
71         active = [order for order in orders if order.status != "cancelled"]
72         return len(active), sum(self._orders.summarize(order).total_cents for order in active)
