41 
42 # The warehouse's low-stock line: fewer than this many units on hand is "low".
43 LOW_STOCK_LINE = 5
44 
45 
46 class FulfilmentService:
47     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
48                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52         self._stock = stock
53 
54     def packing_slip(self, order_id: str) -> PackingSlip:
55         order = self._orders.get(order_id)
56         if order is None:
57             raise OrderNotFound(order_id)
58         if order.status == "cancelled":
59             raise Conflict(f"order {order_id} is cancelled")
60         customer = self._customers.get(order.customer_id)
61         customer_name = customer.name if customer is not None else ""
62         lines = []
63         for item in order.items:
64             product = self._catalog.get(item.sku)
65             lines.append(PackingSlipLine(item.sku, product.name if product is not None else item.sku,
66                                          item.quantity))
67         return PackingSlip(order.order_id, customer_name, tuple(lines))
68 
69     def restock(self, sku: str, quantity: int) -> int:
70         """Add ``quantity`` units to the product's stock and return the new level."""
71         if self._catalog.get(sku) is None:
72             raise ProductNotFound(sku)
73         on_hand = self._stock.get(sku) + quantity
74         self._stock.set(sku, on_hand)
75         return on_hand
76 
77     def summary(self) -> FulfilmentSummary:
78         """Dashboard figures: open orders, units to pick and products below the low-stock line."""
79         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
80         units = sum(item.quantity for o in open_orders for item in o.items)
81         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
82 
83     def low_stock(self, threshold: int) -> list[LowStockProduct]:
84         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
85         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
86                  for p in self._catalog.list_all() if p.active]
87         found = [p for p in found if p.on_hand < threshold]
88         return sorted(found, key=lambda p: (p.on_hand, p.sku))
