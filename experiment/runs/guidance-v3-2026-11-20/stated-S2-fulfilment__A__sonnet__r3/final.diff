14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 @dataclass(frozen=True)
36 class FulfilmentSummary:
37     open_orders: int
38     units_to_pick: int
39     low_stock_products: int
