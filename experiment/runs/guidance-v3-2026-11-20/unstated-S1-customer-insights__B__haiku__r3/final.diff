src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: CustomerService) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the same totals as the order summary."""
20         try:
21             orders = self._service.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         # list_for_customer returns creation order; reverse it for newest first.
25         history: list[dict[str, Any]] = [
26             {"order_id": o.order_id, "status": o.status,
27              "total_cents": self._service.summarize(o).total_cents}
28             for o in reversed(orders)
29         ]
30         return Response(200, {"customer_id": customer_id, "orders": history})
31 
32     def handle_lifetime_value(self, customer_id: str) -> Response:
33         """Non-cancelled order count and the sum of their totals, as in the order history."""
34         try:
35             orders = self._service.list_for_customer(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         active, lifetime_value_cents = self._active_orders_and_value(orders)
39         return Response(200, {"customer_id": customer_id, "order_count": len(active),
40                               "lifetime_value_cents": lifetime_value_cents})
41 
42     def handle_top_customers(self, limit: Any) -> Response:
43         """Customers with the highest lifetime value (non-zero only), highest first, ties by customer_id."""
44         try:
45             limit = require_positive_int(limit, "limit")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         ranked = []
49         for customer in self._customers.list_all():
50             orders = self._service.list_for_customer(customer.customer_id)
51             _, value = self._active_orders_and_value(orders)
52             if value > 0:
53                 ranked.append((value, customer))
54         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
55         return Response(200, {"customers": [
56             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
57             for value, c in ranked[:limit]
58         ]})
59 
60     def handle_customers_without_orders(self) -> Response:
61         """Registered customers with no orders that are not cancelled, in registration order."""
62         customers = []
63         for customer in self._customers.list_all():
64             orders = self._service.list_for_customer(customer.customer_id)
65             if not any(o.status != "cancelled" for o in orders):
66                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
67                                   "email": customer.email})
68         return Response(200, {"customers": customers})
69 
70     def _active_orders_and_value(self, orders: list[Any]) -> tuple[list[Any], int]:
71         active = [o for o in orders if o.status != "cancelled"]
72         return active, sum(self._service.summarize(o).total_cents for o in active)
