   39     def restock(self, sku: str, quantity: int) -> int:
   40         """Add ``quantity`` units to a product's stock and return the new level."""
   41         self.get_product(sku)
   42         new_level = self._stock.get(sku) + quantity
   43         self._stock.set(sku, new_level)
   44         return new_level
   45 
   46     def low_stock_count(self) -> int:
   47         """How many active products are below the warehouse's low-stock line."""
   48         return len(self.low_stock(LOW_STOCK_LINE))
   49 
   50     def low_stock(self, threshold: int) -> list[StockLevel]:
   51         """Active products with fewer than ``threshold`` units on hand, lowest stock first, then by SKU."""
   52         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku)) for p in self.list_active()]
   53         below = [level for level in levels if level.on_hand < threshold]
   54         return sorted(below, key=lambda level: (level.on_hand, level.sku))

