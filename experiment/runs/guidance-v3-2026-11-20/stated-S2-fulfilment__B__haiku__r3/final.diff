24 class FulfilmentController:
25     def __init__(self, service: OrderService, catalog: CatalogService) -> None:
26         self._service = service
27         self._catalog = catalog
28 
29     def handle_packing_slip(self, order_id: str) -> Response:
30         try:
31             slip = self._service.packing_slip(order_id)
32         except OrderNotFound:
33             return not_found("order")
34         except Conflict as exc:
35             return conflict(exc)
36         except CustomerNotFound:
37             return not_found("customer")
38         except ProductNotFound:
39             return not_found("product")
40         return Response(200, packing_slip_body(slip))
41 
42     def handle_low_stock(self, threshold: Any) -> Response:
43         try:
44             limit = require_non_negative_int(threshold, "threshold")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         levels = self._catalog.low_stock(limit)
48         return Response(200, {"products": [{"sku": level.sku, "name": level.name, "on_hand": level.on_hand}
49                                            for level in levels]})
50 
51     def handle_fulfilment_summary(self) -> Response:
52         totals = self._service.open_order_totals()
53         return Response(200, {"open_orders": totals.count, "units_to_pick": totals.units,
54                               "low_stock_products": self._catalog.low_stock_count()})
55 
56     def handle_restock(self, request: dict[str, Any]) -> Response:
57         try:
58             sku = require_str(request, "sku")
59             quantity = require_positive_int(request.get("quantity"), "quantity")
60         except InvalidRequest as exc:
61             return bad_request(exc)
62         try:
63             on_hand = self._catalog.restock(sku, quantity)
64         except ProductNotFound:
65             return not_found("product")
66         return Response(200, {"sku": sku, "on_hand": on_hand})
