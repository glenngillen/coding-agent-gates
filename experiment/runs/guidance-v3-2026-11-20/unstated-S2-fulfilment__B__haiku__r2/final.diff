20 @dataclass(frozen=True)
21 class FulfilmentSummary:
22     open_orders: int
23     units_to_pick: int
24     low_stock_products: int
25 
26 
27 @dataclass(frozen=True)
28 class LowStockProduct:
29     sku: str
30     name: str
31     on_hand: int
32 
33 
34 @dataclass(frozen=True)
35 class PackingLine:
36     sku: str
37     name: str | None
38     quantity: int
39 
40 
41 @dataclass(frozen=True)
42 class PackingSlip:
43     order_id: str
44     customer_name: str | None
45     lines: tuple[PackingLine, ...]
46 
47 
48 class FulfilmentService:
49     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
50                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
51         self._orders = orders
52         self._customers = customers
53         self._catalog = catalog
54         self._stock = stock
55 
56     def summary(self) -> FulfilmentSummary:
57         """Counts for the dashboard: open orders, units across them, and low-stock products."""
58         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
59         return FulfilmentSummary(
60             open_orders=len(open_orders),
61             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
62             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
63         )
64 
65     def restock(self, sku: str, quantity: int) -> int:
66         """Add ``quantity`` units to a product's stock; returns the new on-hand level."""
67         if self._catalog.get(sku) is None:
68             raise ProductNotFound(sku)
69         new_level = self._stock.get(sku) + quantity
70         self._stock.set(sku, new_level)
71         return new_level
72 
73     def low_stock(self, threshold: int) -> list[LowStockProduct]:
74         """Active products with stock strictly below ``threshold``, lowest stock then SKU first."""
75         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
76                  for p in self._catalog.list_all() if p.active]
77         return sorted((p for p in found if p.on_hand < threshold), key=lambda p: (p.on_hand, p.sku))
78 
79     def packing_slip(self, order_id: str) -> PackingSlip:
80         """Packing slip for an order. Raises OrderNotFound, or Conflict if cancelled."""
81         order = self._orders.get(order_id)
82         if order is None:
83             raise OrderNotFound(order_id)
84         if order.status == "cancelled":
85             raise Conflict(f"order {order_id} is cancelled")
86         customer = self._customers.get(order.customer_id)
87         lines = []
88         for item in order.items:
89             product = self._catalog.get(item.sku)
90             lines.append(PackingLine(item.sku, product.name if product is not None else None,
91                                      item.quantity))
92         return PackingSlip(order.order_id, customer.name if customer is not None else None,
93                            tuple(lines))
