 7 
 8 from dataclasses import dataclass
 9 
10 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
11 from orders.infrastructure.catalog import InMemoryProductCatalog
12 from orders.infrastructure.customers import InMemoryCustomerRepository
13 from orders.infrastructure.repository import InMemoryOrderRepository
14 from orders.infrastructure.stock import InMemoryStockRepository
