 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.domain.orders import Order
11 from orders.infrastructure.customers import InMemoryCustomerRepository
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository) -> None:
16         self._service = service
17         self._customers = customers
18 
19     def handle_order_history(self, customer_id: str) -> Response:
20         """A customer's orders, newest first, with discounted totals."""
21         try:
22             orders = self._service.list_for_customer(customer_id)
23         except CustomerNotFound:
24             return not_found("customer")
25         entries = []
26         # The repository returns creation order, so reverse for newest first.
27         for order in reversed(orders):
28             summary = self._service.summarize(order)
29             entries.append({"order_id": order.order_id, "status": order.status,
30                             "total_cents": summary.total_cents})
31         return Response(200, {"customer_id": customer_id, "orders": entries})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         """Count and total of a customer's non-cancelled orders."""
35         try:
36             orders = self._service.list_for_customer(customer_id)
37         except CustomerNotFound:
38             return not_found("customer")
39         count, total = self._lifetime(orders)
40         return Response(200, {"customer_id": customer_id, "order_count": count,
41                               "lifetime_value_cents": total})
42 
43     def handle_top_customers(self, limit: Any) -> Response:
44         """Customers ranked by lifetime value, highest first, ties by customer_id."""
45         try:
46             limit = require_positive_int(limit, "limit")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         ranked = []
50         for customer in self._customers.list_all():
51             _, total = self._lifetime(self._service.list_for_customer(customer.customer_id))
52             if total > 0:
53                 ranked.append({"customer_id": customer.customer_id, "name": customer.name,
54                                "lifetime_value_cents": total})
55         ranked.sort(key=lambda e: (-e["lifetime_value_cents"], e["customer_id"]))
56         return Response(200, {"customers": ranked[:limit]})
57 
58     def handle_customers_without_orders(self) -> Response:
59         """Customers with no non-cancelled orders, in registration order."""
60         idle = []
61         for customer in self._customers.list_all():
62             count, _ = self._lifetime(self._service.list_for_customer(customer.customer_id))
63             if count == 0:
64                 idle.append({"customer_id": customer.customer_id, "name": customer.name,
65                              "email": customer.email})
66         return Response(200, {"customers": idle})
67 
68     def _lifetime(self, orders: list[Order]) -> tuple[int, int]:
69         """(count, total_cents) of the non-cancelled orders."""
70         active = [o for o in orders if o.status != "cancelled"]
71         return len(active), sum(self._service.summarize(o).total_cents for o in active)
