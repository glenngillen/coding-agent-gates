 45 class FulfilmentService:
 46     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
 47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository,
 48                  order_repository: InMemoryOrderRepository) -> None:
 49         self._orders = orders
 50         self._customers = customers
 51         self._catalog = catalog
 52         self._stock = stock
 53         self._order_repository = order_repository
 54 
 55     def summary(self) -> FulfilmentSummary:
 56         """Dashboard figures: open (not cancelled) orders, units across them, and low-stock products."""
 57         open_orders = [o for o in self._order_repository.list_all() if o.status != "cancelled"]
 58         return FulfilmentSummary(
 59             open_orders=len(open_orders),
 60             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
 61             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
 62         )
 63 
 64     def low_stock(self, threshold: int) -> list[LowStockProduct]:
 65         """Active products whose on-hand stock is strictly below ``threshold``.
 66 
 67         Sorted by on-hand quantity (lowest first), then by SKU.
 68         """
 69         products = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
 70                     for p in self._catalog.list_all() if p.active]
 71         below = [p for p in products if p.on_hand < threshold]
 72         return sorted(below, key=lambda p: (p.on_hand, p.sku))
 73 
 74     def restock(self, sku: str, quantity: int) -> int:
 75         """Add ``quantity`` units to a product's stock and return the new on-hand level.
 76 
 77         Stock is shared with order placement, so the units are orderable immediately.
 78         Raises ``ProductNotFound`` for unknown SKUs.
 79         """
 80         if self._catalog.get(sku) is None:
 81             raise ProductNotFound(sku)
 82         new_level = self._stock.get(sku) + quantity
 83         self._stock.set(sku, new_level)
 84         return new_level
 85 
 86     def packing_slip(self, order_id: str) -> PackingSlip:
 87         """Build the packing slip for an order.
 88 
 89         Raises ``OrderNotFound`` for unknown orders and ``Conflict`` for cancelled ones.
 90         """
 91         order = self._orders.get_order(order_id)
 92         if order.status == "cancelled":
 93             raise Conflict(f"order {order_id} is cancelled")
 94         customer = self._customers.get(order.customer_id)
 95         lines = []
 96         for item in order.items:
 97             product = self._catalog.get(item.sku)
 98             name = product.name if product is not None else item.sku
 99             lines.append(PackingLine(item.sku, name, item.quantity))
100         return PackingSlip(order.order_id, customer.name if customer is not None else None, tuple(lines))
