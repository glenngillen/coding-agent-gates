101 def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
102     assert shop.fulfilment.handle_fulfilment_summary().body == {
103         "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0,
104     }
105     shop.orders.handle_create({"customer_id": "c1", "items": [{"sku": "BOOK", "quantity": 2}]})
