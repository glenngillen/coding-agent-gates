 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
 8                                      require_positive_int)
 9 
10 
11 class CustomerInsightsController:
12     def __init__(self, service: OrderService) -> None:
13         self._service = service
14 
15     def handle_order_history(self, customer_id: str) -> Response:
16         """A customer's orders, newest first, with discounted totals."""
17         try:
18             orders = self._service.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         entries = []
22         # Repository order is creation order, so reverse for newest first.
23         for order in reversed(orders):
24             summary = self._service.summarize(order)
25             entries.append({"order_id": order.order_id, "status": order.status,
26                             "total_cents": summary.total_cents})
27         return Response(200, {"customer_id": customer_id, "orders": entries})
28 
29     def handle_lifetime_value(self, customer_id: str) -> Response:
30         """Count and discounted total of a customer's non-cancelled orders."""
31         try:
32             count, total = self._service.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {"customer_id": customer_id, "order_count": count,
36                               "lifetime_value_cents": total})
37 
38     def handle_customers_without_orders(self) -> Response:
39         """Customers with no non-cancelled orders, in registration order."""
40         return Response(200, {"customers": [
41             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
42             for c, count, _ in self._service.lifetime_values() if count == 0]})
43 
44     def handle_top_customers(self, limit: int) -> Response:
45         """Customers ranked by lifetime value, highest first, ties by customer_id."""
46         try:
47             limit = require_positive_int(limit, "limit")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         ranked = [(total, customer) for customer, _, total in self._service.lifetime_values()
51                   if total > 0]
52         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
53         return Response(200, {"customers": [
54             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
55             for total, c in ranked[:limit]]})
