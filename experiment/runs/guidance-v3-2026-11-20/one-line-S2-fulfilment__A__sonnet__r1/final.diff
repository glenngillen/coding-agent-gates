 1 """Warehouse fulfilment: packing slips."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockItem, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 
13 LOW_STOCK_LINE = 5  # the warehouse's low-stock line: fewer than this many units on hand
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def summary(self) -> FulfilmentSummary:
25         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
26         units = sum(item.quantity for o in open_orders for item in o.items)
27         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
28 
29     def restock(self, sku: str, quantity: int) -> int:
30         """Add ``quantity`` units to a product's stock and return the new level."""
31         if self._catalog.get(sku) is None:
32             raise ProductNotFound(sku)
33         level = self._stock.get(sku) + quantity
34         self._stock.set(sku, level)
35         return level
36 
37     def low_stock(self, threshold: int) -> list[LowStockItem]:
38         """Active products with stock strictly below ``threshold``, lowest first then by SKU."""
39         items = [LowStockItem(p.sku, p.name, self._stock.get(p.sku))
40                  for p in self._catalog.list_all() if p.active]
41         return sorted((i for i in items if i.on_hand < threshold), key=lambda i: (i.on_hand, i.sku))
42 
43     def packing_slip(self, order_id: str) -> PackingSlip:
44         order = self._orders.get(order_id)
45         if order is None:
46             raise OrderNotFound(order_id)
47         if order.status == "cancelled":
48             raise Conflict(f"order {order_id} is cancelled")
49         customer = self._customers.get(order.customer_id)
50         lines = []
51         for item in order.items:
52             product = self._catalog.get(item.sku)
53             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
54         return PackingSlip(order.order_id, customer.name if customer else "", tuple(lines))
