.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries (with discounts) for every order of a customer, newest first, cancelled included."""
.. 70         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 71 
.. 72     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 73         """Count and total of a customer's orders, excluding cancelled ones."""
.. 74         counted = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 75         return LifetimeValue(customer_id, len(counted), sum(s.total_cents for s in counted))
.. 76 
.. 77     def customers_without_orders(self) -> list[Customer]:
.. 78         """Registered customers with no orders other than cancelled ones, in registration order."""
.. 79         return [c for c in self._customers.list_all()
.. 80                 if self.lifetime_value(c.customer_id).order_count == 0]
.. 81 
.. 82     def top_customers(self, limit: int) -> list[RankedCustomer]:
.. 83         """Customers with a non-zero lifetime value, highest first, ties by customer id."""
.. 84         ranked = []
.. 85         for customer in self._customers.list_all():
.. 86             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
.. 87             if value > 0:
.. 88                 ranked.append(RankedCustomer(customer.customer_id, customer.name, value))
.. 89         ranked.sort(key=lambda r: (-r.lifetime_value_cents, r.customer_id))
.. 90         return ranked[:limit]
