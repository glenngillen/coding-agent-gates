 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
19                   for line in slip.lines],
20     }
21 
22 
23 class FulfilmentController:
24     def __init__(self, service: FulfilmentService) -> None:
25         self._service = service
26 
27     def handle_packing_slip(self, order_id: str) -> Response:
28         try:
29             slip = self._service.packing_slip(order_id)
30         except OrderNotFound:
31             return not_found("order")
32         except Conflict as exc:
33             return conflict(exc)
34         except CustomerNotFound:
35             return not_found("customer")
36         except ProductNotFound:
37             return not_found("product")
38         return Response(200, packing_slip_body(slip))
39 
40     def handle_low_stock(self, threshold: Any) -> Response:
41         try:
42             limit = require_non_negative_int(threshold, "threshold")
43         except InvalidRequest as exc:
44             return bad_request(exc)
45         rows = self._service.low_stock(limit)
46         return Response(200, {"products": [
47             {"sku": row.sku, "name": row.name, "on_hand": row.on_hand} for row in rows]})
48 
49     def handle_fulfilment_summary(self) -> Response:
50         summary = self._service.summary()
51         return Response(200, {"open_orders": summary.open_orders,
52                               "units_to_pick": summary.units_to_pick,
53                               "low_stock_products": summary.low_stock_products})
54 
55     def handle_restock(self, request: dict[str, Any]) -> Response:
56         try:
57             sku = require_str(request, "sku")
58             quantity = require_positive_int(request.get("quantity"), "quantity")
59         except InvalidRequest as exc:
60             return bad_request(exc)
61         try:
62             on_hand = self._service.restock(sku, quantity)
63         except ProductNotFound:
64             return not_found("product")
65         return Response(200, {"sku": sku, "on_hand": on_hand})
