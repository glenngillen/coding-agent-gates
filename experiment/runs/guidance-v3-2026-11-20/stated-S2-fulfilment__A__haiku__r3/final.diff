 1 """Warehouse fulfilment: packing slips for placed orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 # The warehouse's low-stock line: products with fewer units than this on hand are low.
14 LOW_STOCK_LINE = 5
15 
16 
17 class FulfilmentService:
18     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
19                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository,
20                  order_repository: InMemoryOrderRepository) -> None:
21         self._orders = orders
22         self._customers = customers
23         self._catalog = catalog
24         self._stock = stock
25         self._order_repository = order_repository
26 
27     def summary(self) -> FulfilmentSummary:
28         """Dashboard counts: open (not cancelled) orders, units across them, low-stock products."""
29         open_orders = [o for o in self._order_repository.list_all() if o.status != "cancelled"]
30         return FulfilmentSummary(
31             open_orders=len(open_orders),
32             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
33             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
34         )
35 
36     def low_stock(self, threshold: int) -> list[LowStockProduct]:
37         """Active products with on-hand stock strictly below ``threshold``, lowest first."""
38         rows = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
39                 for p in self._catalog.list_all() if p.active]
40         rows = [row for row in rows if row.on_hand < threshold]
41         return sorted(rows, key=lambda row: (row.on_hand, row.sku))
42 
43     def restock(self, sku: str, quantity: int) -> int:
44         """Add ``quantity`` units to a product's stock. Returns the new on-hand level.
45 
46         Stock is shared with order placement, so the units are orderable straight away.
47         """
48         if self._catalog.get(sku) is None:
49             raise ProductNotFound(sku)
50         new_level = self._stock.get(sku) + quantity
51         self._stock.set(sku, new_level)
52         return new_level
53 
54     def packing_slip(self, order_id: str) -> PackingSlip:
55         """Packing slip for an order. Cancelled orders are not packed."""
56         order = self._orders.get_order(order_id)  # raises OrderNotFound
57         if order.status == "cancelled":
58             raise Conflict(f"order {order_id} is cancelled")
59         customer = self._customers.get(order.customer_id)
60         if customer is None:
61             raise CustomerNotFound(order.customer_id)
62         lines = []
63         for item in order.items:
64             product = self._catalog.get(item.sku)
65             if product is None:
66                 raise ProductNotFound(item.sku)
67             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
68         return PackingSlip(order.order_id, customer.name, tuple(lines))
