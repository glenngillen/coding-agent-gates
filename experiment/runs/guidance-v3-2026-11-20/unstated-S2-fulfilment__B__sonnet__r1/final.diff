14 # The warehouse's low-stock line: fewer than this many units on hand is "low".
15 LOW_STOCK_LINE = 5
16 
17 
18 @dataclass(frozen=True)
19 class PackingSlipLine:
20     sku: str
21     name: str
22     quantity: int
23 
24 
25 @dataclass(frozen=True)
26 class PackingSlip:
27     order_id: str
28     customer_name: str | None
29     lines: tuple[PackingSlipLine, ...]
30 
31 
32 @dataclass(frozen=True)
33 class LowStockProduct:
34     sku: str
35     name: str
36     on_hand: int
37 
38 
39 @dataclass(frozen=True)
40 class FulfilmentSummary:
41     open_orders: int
42     units_to_pick: int
43     low_stock_products: int
44 
45 
46 class FulfilmentService:
47     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
48                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52         self._stock = stock
53 
54     def summary(self) -> FulfilmentSummary:
55         """Dashboard figures: open orders, units to pick, and products under the low-stock line."""
56         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
57         units = sum(item.quantity for o in open_orders for item in o.items)
58         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
59 
60     def low_stock(self, threshold: int) -> list[LowStockProduct]:
61         """Active products with stock strictly below ``threshold``, lowest first, then by SKU."""
62         found = []
63         for product in self._catalog.list_all():
64             on_hand = self._stock.get(product.sku)
65             if product.active and on_hand < threshold:
66                 found.append(LowStockProduct(product.sku, product.name, on_hand))
67         return sorted(found, key=lambda p: (p.on_hand, p.sku))
68 
69     def restock(self, sku: str, quantity: int) -> int:
70         """Add ``quantity`` units to a product's stock and return the new level."""
71         if self._catalog.get(sku) is None:
72             raise ProductNotFound(sku)
73         on_hand = self._stock.get(sku) + quantity
74         self._stock.set(sku, on_hand)
75         return on_hand
76 
77     def packing_slip(self, order_id: str) -> PackingSlip:
78         order = self._orders.get(order_id)
79         if order is None:
80             raise OrderNotFound(order_id)
81         if order.status == "cancelled":
82             raise Conflict(f"order {order_id} is cancelled")
83         customer = self._customers.get(order.customer_id)
84         lines = []
85         for item in order.items:
86             product = self._catalog.get(item.sku)
87             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
88         return PackingSlip(order.order_id, customer.name if customer else None, tuple(lines))
