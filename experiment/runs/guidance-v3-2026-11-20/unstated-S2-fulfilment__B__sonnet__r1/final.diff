 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (
10     InvalidRequest,
11     Response,
12     bad_request,
13     conflict,
14     not_found,
15     require_non_negative_int,
16     require_positive_int,
17     require_str,
18 )
19 
20 
21 class FulfilmentController:
22     def __init__(self, service: FulfilmentService) -> None:
23         self._service = service
24 
25     def handle_low_stock(self, threshold: object) -> Response:
26         """Active products with stock strictly below ``threshold``."""
27         try:
28             limit = require_non_negative_int(threshold, "threshold")
29         except InvalidRequest as exc:
30             return bad_request(exc)
31         return Response(200, {
32             "products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
33                          for p in self._service.low_stock(limit)],
34         })
35 
36     def handle_fulfilment_summary(self) -> Response:
37         """Headline figures for the warehouse dashboard."""
38         summary = self._service.summary()
39         return Response(200, {
40             "open_orders": summary.open_orders,
41             "units_to_pick": summary.units_to_pick,
42             "low_stock_products": summary.low_stock_products,
43         })
44 
45     def handle_restock(self, request: dict[str, Any]) -> Response:
46         """Add units to a product's stock."""
47         try:
48             sku = require_str(request, "sku")
49             quantity = require_positive_int(request.get("quantity"), "quantity")
50         except InvalidRequest as exc:
51             return bad_request(exc)
52         try:
53             on_hand = self._service.restock(sku, quantity)
54         except ProductNotFound:
55             return not_found("product")
56         return Response(200, {"sku": sku, "on_hand": on_hand})
57 
58     def handle_packing_slip(self, order_id: str) -> Response:
59         """What the warehouse needs to pack an order."""
60         try:
61             slip = self._service.packing_slip(order_id)
62         except OrderNotFound:
63             return not_found("order")
64         except Conflict as exc:
65             return conflict(exc)
66         return Response(200, {
67             "order_id": slip.order_id,
68             "customer_name": slip.customer_name,
69             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
70                       for line in slip.lines],
71         })
