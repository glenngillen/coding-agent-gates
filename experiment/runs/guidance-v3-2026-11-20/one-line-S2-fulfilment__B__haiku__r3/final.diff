42 # Warehouse low-stock line: products with fewer units than this on hand are low.
43 LOW_STOCK_LINE = 5
44 
45 
46 class FulfilmentService:
47     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
48                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
49         self._orders = orders
50         self._customers = customers
51         self._catalog = catalog
52         self._stock = stock
53 
54     def summary(self) -> FulfilmentSummary:
55         """Open (not cancelled) orders, units across them, and active products below the low-stock line."""
56         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
57         units = sum(item.quantity for order in open_orders for item in order.items)
58         low = len(self.low_stock(LOW_STOCK_LINE))
59         return FulfilmentSummary(len(open_orders), units, low)
60 
61     def restock(self, sku: str, quantity: int) -> int:
62         """Add ``quantity`` units to a product's stock and return the new on-hand level.
63 
64         The stock repository is the same one order placement checks, so restocked units are orderable immediately.
65         """
66         if self._catalog.get(sku) is None:
67             raise ProductNotFound(sku)
68         new_level = self._stock.get(sku) + quantity
69         self._stock.set(sku, new_level)
70         return new_level
71 
72     def low_stock(self, threshold: int) -> list[LowStockProduct]:
73         """Active products with on-hand stock strictly below ``threshold``, lowest stock first, then SKU."""
74         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
75                  for p in self._catalog.list_all() if p.active]
76         found = [p for p in found if p.on_hand < threshold]
77         return sorted(found, key=lambda p: (p.on_hand, p.sku))
78 
79     def packing_slip(self, order_id: str) -> PackingSlip:
80         """Raises OrderNotFound for unknown orders and Conflict for cancelled ones."""
81         order = self._orders.get_order(order_id)
82         if order.status == "cancelled":
83             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
84         customer = self._customers.get(order.customer_id)
85         lines = []
86         for item in order.items:
87             product = self._catalog.get(item.sku)
88             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
89         return PackingSlip(order.order_id, customer.name, tuple(lines))
