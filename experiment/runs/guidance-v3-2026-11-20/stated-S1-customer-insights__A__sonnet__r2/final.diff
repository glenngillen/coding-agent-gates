22     def handle_top_customers(self, limit: Any) -> Response:
23         try:
24             limit = require_positive_int(limit, "limit")
25         except InvalidRequest as exc:
26             return bad_request(exc)
27         return Response(200, {"customers": [
28             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
29             for c, value in self._orders.top_customers(limit)]})
