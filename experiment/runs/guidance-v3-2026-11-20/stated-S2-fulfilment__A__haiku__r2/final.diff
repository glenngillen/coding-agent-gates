 1 """Warehouse fulfilment: packing slips for orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 
13 # Products with fewer units on hand than this are reported as low on stock.
14 LOW_STOCK_LINE = 5
15 
16 
17 class FulfilmentService:
18     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
19                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
20         self._orders = orders
21         self._customers = customers
22         self._catalog = catalog
23         self._stock = stock
24 
25     def summary(self) -> FulfilmentSummary:
26         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
27         return FulfilmentSummary(
28             open_orders=len(open_orders),
29             units_to_pick=sum(i.quantity for o in open_orders for i in o.items),
30             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
31         )
32 
33     def restock(self, sku: str, quantity: int) -> int:
34         """Add ``quantity`` units to a product's stock and return the new level."""
35         if self._catalog.get(sku) is None:
36             raise ProductNotFound(sku)
37         new_level = self._stock.get(sku) + quantity
38         self._stock.set(sku, new_level)
39         return new_level
40 
41     def low_stock(self, threshold: int) -> list[LowStockProduct]:
42         """Active products whose stock on hand is strictly below ``threshold``, lowest first."""
43         below = [
44             LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
45             for p in self._catalog.list_all()
46             if p.active and self._stock.get(p.sku) < threshold
47         ]
48         return sorted(below, key=lambda p: (p.on_hand, p.sku))
49 
50     def packing_slip(self, order_id: str) -> PackingSlip:
51         order = self._orders.get(order_id)
52         if order is None:
53             raise OrderNotFound(order_id)
54         if order.status == "cancelled":
55             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
56         # Orders are only placed for existing customers and products, and neither
57         # can be removed, so these lookups always succeed.
58         customer = self._customers.get(order.customer_id)
59         lines = tuple(
60             PackingSlipLine(item.sku, self._catalog.get(item.sku).name, item.quantity)
61             for item in order.items
62         )
63         return PackingSlip(order.order_id, customer.name, lines)
