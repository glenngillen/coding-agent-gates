 1 """Warehouse fulfilment: packing slips for orders that are still to be shipped."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.catalog import Product
 7 from orders.domain.orders import FulfilmentSummary, PackingSlip, PackingSlipLine
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 LOW_STOCK_LINE = 5  # the warehouse's low-stock line: fewer than this many units on hand
15 
16 
17 class FulfilmentService:
18     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
19                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
20         self._orders = orders
21         self._customers = customers
22         self._catalog = catalog
23         self._stock = stock
24 
25     def packing_slip(self, order_id: str) -> PackingSlip:
26         order = self._orders.get(order_id)
27         if order is None:
28             raise OrderNotFound(order_id)
29         if order.status == "cancelled":
30             raise Conflict(f"order {order_id} is cancelled")
31         customer = self._customers.get(order.customer_id)
32         lines = []
33         for item in order.items:
34             product = self._catalog.get(item.sku)
35             lines.append(PackingSlipLine(item.sku, product.name if product else item.sku, item.quantity))
36         return PackingSlip(order.order_id, customer.name if customer else "", tuple(lines))
37 
38     def summary(self) -> FulfilmentSummary:
39         """Open (not cancelled) orders, units to pick across them, and products below the low-stock line."""
40         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
41         units = sum(item.quantity for order in open_orders for item in order.items)
42         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
43 
44     def restock(self, sku: str, quantity: int) -> int:
45         """Add ``quantity`` units to a product's stock and return the new level."""
46         if self._catalog.get(sku) is None:
47             raise ProductNotFound(sku)
48         on_hand = self._stock.get(sku) + quantity
49         self._stock.set(sku, on_hand)
50         return on_hand
51 
52     def low_stock(self, threshold: int) -> list[tuple[Product, int]]:
53         """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
54         levels = [(p, self._stock.get(p.sku)) for p in self._catalog.list_all() if p.active]
55         low = [(p, on_hand) for p, on_hand in levels if on_hand < threshold]
56         return sorted(low, key=lambda entry: (entry[1], entry[0].sku))
