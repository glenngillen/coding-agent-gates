src/orders/controllers/fulfilment.py --- Python
 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as exc:
23             return conflict(exc)
24         lines = [{"sku": line.sku, "name": line.name, "quantity": line.quantity} for line in slip.lines]
25         return Response(200, {"order_id": slip.order_id, "customer_name": slip.customer_name,
26                               "lines": lines})
27 
28     def handle_fulfilment_summary(self) -> Response:
29         summary = self._service.summary()
30         return Response(200, {"open_orders": summary.open_orders,
31                               "units_to_pick": summary.units_to_pick,
32                               "low_stock_products": summary.low_stock_products})
33 
34     def handle_restock(self, request: dict[str, Any]) -> Response:
35         try:
36             sku = require_str(request, "sku")
37             quantity = require_positive_int(request.get("quantity"), "quantity")
38         except InvalidRequest as exc:
39             return bad_request(exc)
40         try:
41             on_hand = self._service.restock(sku, quantity)
42         except ProductNotFound:
43             return not_found("product")
44         return Response(200, {"sku": sku, "on_hand": on_hand})
45 
46     def handle_low_stock(self, threshold: int) -> Response:
47         try:
48             threshold = require_non_negative_int(threshold, "threshold")
49         except InvalidRequest as exc:
50             return bad_request(exc)
51         products = [{"sku": p.sku, "name": p.name, "on_hand": on_hand}
52                     for p, on_hand in self._service.low_stock(threshold)]
53         return Response(200, {"products": products})
