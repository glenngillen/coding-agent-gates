src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with totals as reported by the order summary."""
20         try:
21             orders = self._orders.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         # Order ids are issued in creation order, so reversing gives newest first.
25         history: list[dict[str, Any]] = [
26             {"order_id": order.order_id, "status": order.status,
27              "total_cents": self._orders.summarize(order).total_cents}
28             for order in reversed(orders)
29         ]
30         return Response(200, {"customer_id": customer_id, "orders": history})
31 
32     def handle_lifetime_value(self, customer_id: str) -> Response:
33         """Number of non-cancelled orders and the sum of their totals, in cents."""
34         try:
35             order_count, lifetime_value = self._lifetime_value(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         return Response(200, {"customer_id": customer_id, "order_count": order_count,
39                               "lifetime_value_cents": lifetime_value})
40 
41     def handle_top_customers(self, limit: Any) -> Response:
42         """Customers with the highest lifetime value (non-zero only), ties broken by customer_id."""
43         try:
44             limit = require_positive_int(limit, "limit")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         ranked = []
48         for customer in self._customers.list_all():
49             _, lifetime_value = self._lifetime_value(customer.customer_id)
50             if lifetime_value > 0:
51                 ranked.append((lifetime_value, customer))
52         ranked.sort(key=lambda entry: (-entry[0], entry[1].customer_id))
53         return Response(200, {"customers": [
54             {"customer_id": customer.customer_id, "name": customer.name,
55              "lifetime_value_cents": lifetime_value}
56             for lifetime_value, customer in ranked[:limit]
57         ]})
58 
59     def handle_customers_without_orders(self) -> Response:
60         """Registered customers with no orders that are not cancelled, in registration order."""
61         customers = []
62         for customer in self._customers.list_all():
63             order_count, _ = self._lifetime_value(customer.customer_id)
64             if order_count == 0:
65                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
66                                   "email": customer.email})
67         return Response(200, {"customers": customers})
68 
69     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
70         """(count of non-cancelled orders, sum of their totals). Raises CustomerNotFound."""
71         active = [order for order in self._orders.list_for_customer(customer_id)
72                   if order.status != "cancelled"]
73         return len(active), sum(self._orders.summarize(order).total_cents for order in active)
