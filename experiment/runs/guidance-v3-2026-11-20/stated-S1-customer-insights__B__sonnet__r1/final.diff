 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
10                                      require_positive_int)
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService) -> None:
15         self._orders = orders
16 
17     def handle_customers_without_orders(self) -> Response:
18         """Registered customers who have no non-cancelled orders."""
19         return Response(200, {"customers": [
20             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
21             for c in self._orders.customers_without_orders()]})
22 
23     def handle_top_customers(self, limit: Any) -> Response:
24         """Customers ranked by lifetime value, highest first."""
25         try:
26             limit = require_positive_int(limit, "limit")
27         except InvalidRequest as exc:
28             return bad_request(exc)
29         return Response(200, {"customers": [
30             {"customer_id": customer_id, "name": name, "lifetime_value_cents": value}
31             for customer_id, name, value in self._orders.top_customers(limit)]})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         """Count and combined total of a customer's non-cancelled orders."""
35         try:
36             order_count, total_cents = self._orders.lifetime_value(customer_id)
37         except CustomerNotFound:
38             return not_found("customer")
39         return Response(200, {"customer_id": customer_id, "order_count": order_count,
40                               "lifetime_value_cents": total_cents})
41 
42     def handle_order_history(self, customer_id: str) -> Response:
43         """A customer's orders, newest first, with the total the order summary reports."""
44         try:
45             summaries = self._orders.order_history(customer_id)
46         except CustomerNotFound:
47             return not_found("customer")
48         return Response(200, {
49             "customer_id": customer_id,
50             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
51                         "total_cents": s.total_cents} for s in summaries],
52         })
