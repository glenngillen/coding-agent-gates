   37     def restock(self, sku: str, quantity: int) -> int:
   38         """Add ``quantity`` units to a product's stock and return the new level."""
   39         self.get_product(sku)
   40         new_level = self._stock.get(sku) + quantity
   41         self._stock.set(sku, new_level)
   42         return new_level
   43 
   44     def low_stock(self, threshold: int) -> list[tuple[Product, int]]:
   45         """Active products with stock strictly below ``threshold``, lowest stock then SKU first."""
   46         levels = [(p, self._stock.get(p.sku)) for p in self.list_active()]
   47         below = [(p, on_hand) for p, on_hand in levels if on_hand < threshold]
   48         return sorted(below, key=lambda pair: (pair[1], pair[0].sku))

