32 class FulfilmentController:
33     def __init__(self, service: OrderService, catalog: CatalogService) -> None:
34         self._service = service
35         self._catalog = catalog
36 
37     def handle_fulfilment_summary(self) -> Response:
38         open_orders, units_to_pick = self._service.open_order_totals()
39         low_stock = len(self._catalog.low_stock(LOW_STOCK_LINE))
40         return Response(200, {"open_orders": open_orders, "units_to_pick": units_to_pick,
41                               "low_stock_products": low_stock})
42 
43     def handle_packing_slip(self, order_id: str) -> Response:
44         try:
45             slip = self._service.get_packing_slip(order_id)
46         except OrderNotFound:
47             return not_found("order")
48         except Conflict as exc:
49             return conflict(exc)
50         return Response(200, packing_slip_body(slip))
51 
52     def handle_low_stock(self, threshold: Any) -> Response:
53         try:
54             limit = require_non_negative_int(threshold, "threshold")
55         except InvalidRequest as exc:
56             return bad_request(exc)
57         return Response(200, {"products": [low_stock_body(p, on_hand)
58                                            for p, on_hand in self._catalog.low_stock(limit)]})
59 
60     def handle_restock(self, request: dict[str, Any]) -> Response:
61         try:
62             sku = require_str(request, "sku")
63             quantity = require_positive_int(request.get("quantity"), "quantity")
64         except InvalidRequest as exc:
65             return bad_request(exc)
66         try:
67             on_hand = self._catalog.restock(sku, quantity)
68         except ProductNotFound:
69             return not_found("product")
70         return Response(200, {"sku": sku, "on_hand": on_hand})
