src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders that are still to be packed."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingLine, PackingSlip
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # The warehouse's low-stock line: products with fewer units on hand are low.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def restock(self, sku: str, quantity: int) -> int:
25         """Add ``quantity`` units to a product's stock and return the new level.
26 
27         Uses the same stock repository as order placement, so the units are
28         orderable immediately.
29         """
30         if self._catalog.get(sku) is None:
31             raise ProductNotFound(sku)
32         level = self._stock.get(sku) + quantity
33         self._stock.set(sku, level)
34         return level
35 
36     def summary(self) -> FulfilmentSummary:
37         """Dashboard figures: open orders, units to pick, and products at the low-stock line."""
38         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
39         units = sum(item.quantity for order in open_orders for item in order.items)
40         low = len(self.low_stock(LOW_STOCK_LINE))
41         return FulfilmentSummary(len(open_orders), units, low)
42 
43     def low_stock(self, threshold: int) -> list[LowStockProduct]:
44         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
45         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
46                  for p in self._catalog.list_all() if p.active]
47         found = [p for p in found if p.on_hand < threshold]
48         return sorted(found, key=lambda p: (p.on_hand, p.sku))
49 
50     def packing_slip(self, order_id: str) -> PackingSlip:
51         order = self._orders.get(order_id)
52         if order is None:
53             raise OrderNotFound(order_id)
54         if order.status == "cancelled":
55             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
56         customer = self._customers.get(order.customer_id)
57         if customer is None:
58             raise CustomerNotFound(order.customer_id)
59         lines = []
60         for item in order.items:
61             product = self._catalog.get(item.sku)
62             if product is None:
63                 raise ProductNotFound(item.sku)
64             lines.append(PackingLine(item.sku, product.name, item.quantity))
65         return PackingSlip(order.order_id, customer.name, tuple(lines))
