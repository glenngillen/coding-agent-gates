 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import (Conflict, CustomerNotFound, OrderNotFound,
 8                                        ProductNotFound)
 9 from orders.application.fulfilment_service import FulfilmentService
10 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
11                                      require_non_negative_int, require_positive_int, require_str)
12 from orders.domain.fulfilment import PackingSlip
13 
14 
15 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
16     return {
17         "order_id": slip.order_id,
18         "customer_name": slip.customer_name,
19         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
20                   for line in slip.lines],
21     }
22 
23 
24 class FulfilmentController:
25     def __init__(self, service: FulfilmentService) -> None:
26         self._service = service
27 
28     def handle_packing_slip(self, order_id: str) -> Response:
29         try:
30             slip = self._service.packing_slip(order_id)
31         except OrderNotFound:
32             return not_found("order")
33         except CustomerNotFound:
34             return not_found("customer")
35         except ProductNotFound:
36             return not_found("product")
37         except Conflict as exc:
38             return conflict(exc)
39         return Response(200, packing_slip_body(slip))
40 
41     def handle_restock(self, request: dict[str, Any]) -> Response:
42         try:
43             sku = require_str(request, "sku")
44             quantity = require_positive_int(request.get("quantity"), "quantity")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         try:
48             level = self._service.restock(sku, quantity)
49         except ProductNotFound:
50             return not_found("product")
51         return Response(200, {"sku": sku, "on_hand": level})
52 
53     def handle_fulfilment_summary(self) -> Response:
54         summary = self._service.summary()
55         return Response(200, {"open_orders": summary.open_orders,
56                               "units_to_pick": summary.units_to_pick,
57                               "low_stock_products": summary.low_stock_products})
58 
59     def handle_low_stock(self, threshold: Any) -> Response:
60         try:
61             limit = require_non_negative_int(threshold, "threshold")
62         except InvalidRequest as exc:
63             return bad_request(exc)
64         products = self._service.low_stock(limit)
65         return Response(200, {"products": [
66             {"sku": p.sku, "name": p.name, "on_hand": p.on_hand} for p in products]})
