 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
 8 from orders.domain.orders import Order
 9 
10 
11 class CustomerInsightsController:
12     def __init__(self, orders: OrderService) -> None:
13         self._orders = orders
14 
15     def handle_order_history(self, customer_id: str) -> Response:
16         """A customer's orders, newest first, with the same totals as the order summary."""
17         try:
18             orders = self._orders.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         entries = []
22         for order in reversed(orders):  # repository returns creation order
23             summary = self._orders.summarize(order)
24             entries.append({"order_id": order.order_id, "status": order.status,
25                             "total_cents": summary.total_cents})
26         return Response(200, {"customer_id": customer_id, "orders": entries})
27 
28     def handle_lifetime_value(self, customer_id: str) -> Response:
29         """Count and total of the customer's non-cancelled orders."""
30         try:
31             orders = self._orders.list_for_customer(customer_id)
32         except CustomerNotFound:
33             return not_found("customer")
34         count, total = self._lifetime(orders)
35         return Response(200, {"customer_id": customer_id, "order_count": count,
36                               "lifetime_value_cents": total})
37 
38     def handle_top_customers(self, limit: object) -> Response:
39         """Customers ranked by lifetime value (highest first, then customer_id)."""
40         try:
41             limit = require_positive_int(limit, "limit")
42         except InvalidRequest as exc:
43             return bad_request(exc)
44         ranked = []
45         for customer in self._orders.list_customers():
46             _, value = self._lifetime(self._orders.list_for_customer(customer.customer_id))
47             if value > 0:
48                 ranked.append({"customer_id": customer.customer_id, "name": customer.name,
49                                "lifetime_value_cents": value})
50         ranked.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
51         return Response(200, {"customers": ranked[:limit]})
52 
53     def handle_customers_without_orders(self) -> Response:
54         """Customers with no non-cancelled orders, in registration order."""
55         customers = []
56         for customer in self._orders.list_customers():
57             count, _ = self._lifetime(self._orders.list_for_customer(customer.customer_id))
58             if count == 0:
59                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
60                                   "email": customer.email})
61         return Response(200, {"customers": customers})
62 
63     def _lifetime(self, orders: list[Order]) -> tuple[int, int]:
64         active = [o for o in orders if o.status != "cancelled"]
65         return len(active), sum(self._orders.summarize(o).total_cents for o in active)
