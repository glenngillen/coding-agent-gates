45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def summary(self) -> FulfilmentSummary:
54         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
55         return FulfilmentSummary(
56             open_orders=len(open_orders),
57             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
58             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
59         )
60 
61     def restock(self, sku: str, quantity: int) -> int:
62         """Add ``quantity`` units to a product's stock; returns the new level.
63 
64         Orders read the same stock repository, so the units are orderable immediately.
65         """
66         if self._catalog.get(sku) is None:
67             raise ProductNotFound(sku)
68         new_level = self._stock.get(sku) + quantity
69         self._stock.set(sku, new_level)
70         return new_level
71 
72     def low_stock(self, threshold: int) -> list[LowStockProduct]:
73         """Active products with stock on hand strictly below ``threshold``, lowest stock first, then by SKU."""
74         found = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
75                  for p in self._catalog.list_all() if p.active]
76         found = [p for p in found if p.on_hand < threshold]
77         return sorted(found, key=lambda p: (p.on_hand, p.sku))
78 
79     def packing_slip(self, order_id: str) -> PackingSlip:
80         order = self._orders.get(order_id)
81         if order is None:
82             raise OrderNotFound(order_id)
83         if order.status == "cancelled":
84             raise Conflict(f"order {order_id} is cancelled")
85         customer = self._customers.get(order.customer_id)
86         if customer is None:
87             raise CustomerNotFound(order.customer_id)
88         lines = []
89         for item in order.items:
90             product = self._catalog.get(item.sku)
91             if product is None:
92                 raise ProductNotFound(item.sku)
93             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
94         return PackingSlip(order.order_id, customer.name, tuple(lines))
