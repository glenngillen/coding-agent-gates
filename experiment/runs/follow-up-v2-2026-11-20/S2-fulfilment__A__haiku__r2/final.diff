+++ b/src/orders/domain/fulfilment.py
@@ -0,0 +1,33 @@
+"""Fulfilment data: packing slips and stock levels."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class PackingSlipLine:
+    sku: str
+    name: str
+    quantity: int
+
+
+@dataclass(frozen=True)
+class PackingSlip:
+    order_id: str
+    customer_name: str
+    lines: tuple[PackingSlipLine, ...]
+
+
+@dataclass(frozen=True)
+class StockLevel:
+    sku: str
+    name: str
+    on_hand: int
+
+
+@dataclass(frozen=True)
+class FulfilmentSummary:
+    open_orders: int
+    units_to_pick: int
+    low_stock_products: int
