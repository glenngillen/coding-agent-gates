+++ b/src/orders/application/fulfilment_service.py
@@ -0,0 +1,69 @@
+"""Warehouse fulfilment: packing slips and low-stock reporting."""
+
+from __future__ import annotations
+
+from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
+from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
+from orders.infrastructure.catalog import InMemoryProductCatalog
+from orders.infrastructure.customers import InMemoryCustomerRepository
+from orders.infrastructure.repository import InMemoryOrderRepository
+from orders.infrastructure.stock import InMemoryStockRepository
+
+LOW_STOCK_THRESHOLD = 5
+
+
+class FulfilmentService:
+    def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
+                 catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
+        self._orders = orders
+        self._customers = customers
+        self._catalog = catalog
+        self._stock = stock
+
+    def packing_slip(self, order_id: str) -> PackingSlip:
+        """Packing slip for an order that is still to be fulfilled.
+
+        Raises ``OrderNotFound`` for unknown orders and ``Conflict`` for cancelled ones.
+        """
+        order = self._orders.get(order_id)
+        if order is None:
+            raise OrderNotFound(order_id)
+        if order.status == "cancelled":
+            raise Conflict(f"order {order_id} is cancelled")
+        customer = self._customers.get(order.customer_id)
+        if customer is None:
+            raise CustomerNotFound(order.customer_id)
+        lines = tuple(
+            PackingSlipLine(item.sku, self._catalog.get(item.sku).name, item.quantity)
+            for item in order.items
+        )
+        return PackingSlip(order.order_id, customer.name, lines)
+
+    def low_stock(self, threshold: int) -> list[StockLevel]:
+        """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
+        levels = [
+            StockLevel(product.sku, product.name, self._stock.get(product.sku))
+            for product in self._catalog.list_all()
+            if product.active and self._stock.get(product.sku) < threshold
+        ]
+        return sorted(levels, key=lambda level: (level.on_hand, level.sku))
+
+    def restock(self, sku: str, quantity: int) -> int:
+        """Add ``quantity`` units to a product's stock and return the new level.
+
+        Stock is shared with ``OrderService``, so the units can be ordered straight away.
+        """
+        if self._catalog.get(sku) is None:
+            raise ProductNotFound(sku)
+        new_level = self._stock.get(sku) + quantity
+        self._stock.set(sku, new_level)
+        return new_level
+
+    def summary(self) -> FulfilmentSummary:
+        """Dashboard figures: open (not cancelled) orders, units across them, and low-stock products."""
+        open_orders = [order for order in self._orders.list_all() if order.status != "cancelled"]
+        return FulfilmentSummary(
+            open_orders=len(open_orders),
+            units_to_pick=sum(item.quantity for order in open_orders for item in order.items),
+            low_stock_products=len(self.low_stock(LOW_STOCK_THRESHOLD)),
+        )
diff --git a/src/orders/controllers/fulfilment.py b/src/orders/controllers/fulfilment.py
new file mode 100644
index 0000000..163eaec
--- /dev/null
+++ b/src/orders/controllers/fulfilment.py
@@ -0,0 +1,66 @@
+"""Fulfilment endpoints for the warehouse."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
+from orders.application.fulfilment_service import FulfilmentService
+from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
+                                     require_non_negative_int, require_positive_int, require_str)
+from orders.domain.fulfilment import PackingSlip, StockLevel
+
+
+def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
+    return {
+        "order_id": slip.order_id,
+        "customer_name": slip.customer_name,
+        "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
+                  for line in slip.lines],
+    }
+
+
+def stock_level_body(level: StockLevel) -> dict[str, Any]:
+    return {"sku": level.sku, "name": level.name, "on_hand": level.on_hand}
+
+
+class FulfilmentController:
+    def __init__(self, service: FulfilmentService) -> None:
+        self._service = service
+
+    def handle_packing_slip(self, order_id: str) -> Response:
+        try:
+            slip = self._service.packing_slip(order_id)
+        except OrderNotFound:
+            return not_found("order")
+        except CustomerNotFound:
+            return not_found("customer")
+        except Conflict as exc:
+            return conflict(exc)
+        return Response(200, packing_slip_body(slip))
+
+    def handle_low_stock(self, threshold: Any) -> Response:
+        try:
+            limit = require_non_negative_int(threshold, "threshold")
+        except ValueError as exc:
+            return bad_request(exc)
+        levels = self._service.low_stock(limit)
+        return Response(200, {"products": [stock_level_body(level) for level in levels]})
+
+    def handle_restock(self, request: dict[str, Any]) -> Response:
+        try:
+            sku = require_str(request, "sku")
+            quantity = require_positive_int(request.get("quantity"), "quantity")
+        except InvalidRequest as exc:
+            return bad_request(exc)
+        try:
+            on_hand = self._service.restock(sku, quantity)
+        except ProductNotFound:
+            return not_found("product")
+        return Response(200, {"sku": sku, "on_hand": on_hand})
+
+    def handle_fulfilment_summary(self) -> Response:
+        summary = self._service.summary()
+        return Response(200, {"open_orders": summary.open_orders,
+                              "units_to_pick": summary.units_to_pick,
+                              "low_stock_products": summary.low_stock_products})
diff --git a/src/orders/domain/fulfilment.py b/src/orders/domain/fulfilment.py
