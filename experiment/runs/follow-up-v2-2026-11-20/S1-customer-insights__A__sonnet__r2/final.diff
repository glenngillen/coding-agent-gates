diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..7561626
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,106 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_unknown_customer(shop):
+    r = shop.insights.handle_order_history("nope")
+    assert (r.status, r.body) == (404, {"error": "customer not found"})
+
+
+def test_no_orders(shop):
+    r = shop.insights.handle_order_history("c1")
+    assert (r.status, r.body) == (200, {"customer_id": "c1", "orders": []})
+
+
+def test_history_newest_first_with_cancelled(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    second = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    order(shop, "c2", ("BOOK", 1))
+    shop.orders.handle_cancel(first)
+    r = shop.insights.handle_order_history("c1")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c1", "orders": [
+        {"order_id": second, "status": "placed", "total_cents": 600},
+        {"order_id": first, "status": "cancelled", "total_cents": 2_500},
+    ]}
+
+
+def test_total_matches_order_summary_including_discount(shop):
+    oid = order(shop, "c2", ("LAMP", 3)).body["order_id"]
+    expected = shop.orders.handle_get(oid).body["total_cents"]
+    entry = shop.insights.handle_order_history("c2").body["orders"][0]
+    assert entry["total_cents"] == expected
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, "3", 1.5, None):
+        r = shop.insights.handle_top_customers(bad)
+        assert r.status == 400 and "error" in r.body
+
+
+def test_top_customers_ranking_filtering_and_limit(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Idle", "email": "i@example.com"})
+    order(shop, "c1", ("BOOK", 2))             # 5000
+    order(shop, "c0", ("BOOK", 2))             # 5000 (tie, c0 sorts first)
+    order(shop, "c2", ("PEN", 1))
+    cancelled = order(shop, "c3", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)       # c3 stays at 0
+    c2_value = shop.insights.handle_lifetime_value("c2").body["lifetime_value_cents"]
+    body = shop.insights.handle_top_customers(10).body
+    assert body == {"customers": [
+        {"customer_id": "c0", "name": "Zed", "lifetime_value_cents": 5_000},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 5_000},
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": c2_value},
+    ]}
+    assert [c["customer_id"] for c in shop.insights.handle_top_customers(2).body["customers"]] == ["c0", "c1"]
+
+
+def test_customers_without_orders(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Idle", "email": "i@example.com"})
+    order(shop, "c1", ("BOOK", 1))
+    cancelled = order(shop, "c2", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    r = shop.insights.handle_customers_without_orders()
+    assert r.status == 200
+    assert r.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "c0", "name": "Zed", "email": "z@example.com"},
+        {"customer_id": "c3", "name": "Idle", "email": "i@example.com"},
+    ]}
+
+
+def test_customers_without_orders_none_registered(api):
+    assert api.insights.handle_customers_without_orders().body == {"customers": []}
+
+
+def test_top_customers_empty(shop):
+    assert shop.insights.handle_top_customers(5).body == {"customers": []}
+
+
+def test_lifetime_value_unknown_customer(shop):
+    r = shop.insights.handle_lifetime_value("nope")
+    assert (r.status, r.body) == (404, {"error": "customer not found"})
+
+
+def test_lifetime_value_no_orders(shop):
+    r = shop.insights.handle_lifetime_value("c1")
+    assert (r.status, r.body) == (200, {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0})
+
+
+def test_lifetime_value_excludes_cancelled(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c1", ("PEN", 2))
+    cancelled = order(shop, "c1", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    r = shop.insights.handle_lifetime_value("c1")
+    assert r.body == {"customer_id": "c1", "order_count": 2, "lifetime_value_cents": 3_100}
+
+
+def test_lifetime_value_uses_discounted_totals(shop):
+    ids = [order(shop, "c2", ("LAMP", 2)).body["order_id"], order(shop, "c2", ("BOOK", 4)).body["order_id"]]
+    expected = sum(shop.orders.handle_get(i).body["total_cents"] for i in ids)
+    body = shop.insights.handle_lifetime_value("c2").body
+    assert (body["order_count"], body["lifetime_value_cents"]) == (2, expected)
