@@ -0,0 +1,33 @@
+"""Fulfilment data."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class PackingSlipLine:
+    sku: str
+    name: str
+    quantity: int
+
+
+@dataclass(frozen=True)
+class LowStockProduct:
+    sku: str
+    name: str
+    on_hand: int
+
+
+@dataclass(frozen=True)
+class FulfilmentSummary:
+    open_orders: int
+    units_to_pick: int
+    low_stock_products: int
+
+
+@dataclass(frozen=True)
+class PackingSlip:
+    order_id: str
+    customer_name: str
+    lines: tuple[PackingSlipLine, ...]
