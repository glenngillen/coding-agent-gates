diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..2078012
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,120 @@
+from orders.application.fulfilment_service import FulfilmentService
+from orders.domain.catalog import Product
+from orders.infrastructure.catalog import InMemoryProductCatalog
+from orders.infrastructure.customers import InMemoryCustomerRepository
+from orders.infrastructure.repository import InMemoryOrderRepository
+from orders.infrastructure.stock import InMemoryStockRepository
+
+
+def test_low_stock_filters_and_sorts(shop):
+    shop.catalog.handle_add_product({"sku": "AAA", "name": "Aaa", "unit_price_cents": 100, "on_hand": 5})
+    r = shop.fulfilment.handle_low_stock(51)
+    assert r.status == 200
+    assert r.body == {"products": [
+        {"sku": "AAA", "name": "Aaa", "on_hand": 5}, {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+        {"sku": "BOOK", "name": "Book", "on_hand": 50}]}
+
+
+def test_low_stock_strictly_below(shop):
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_excludes_inactive():
+    catalog, stock = InMemoryProductCatalog(), InMemoryStockRepository()
+    catalog.add(Product("A", "A", 100, active=False))
+    catalog.add(Product("B", "B", 100))
+    stock.set("A", 1)
+    stock.set("B", 2)
+    service = FulfilmentService(InMemoryOrderRepository(), InMemoryCustomerRepository(), catalog, stock)
+    assert [p.sku for p in service.low_stock(10)] == ["B"]
+
+
+def test_low_stock_invalid_threshold(shop):
+    for bad in (-1, True, "5", 1.5, None):
+        r = shop.fulfilment.handle_low_stock(bad)
+        assert r.status == 400 and "error" in r.body
+
+
+def _order(shop, sku, quantity):
+    return shop.orders.handle_create({"customer_id": "c1", "items": [{"sku": sku, "quantity": quantity}]})
+
+
+def test_restock_adds_stock_and_is_orderable(shop):
+    r = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 10})
+    assert (r.status, r.body) == (200, {"sku": "LAMP", "on_hand": 15})
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 15
+    assert _order(shop, "LAMP", 15).status == 201
+
+
+def test_restock_makes_out_of_stock_orderable(shop):
+    _order(shop, "LAMP", 5)
+    assert _order(shop, "LAMP", 1).status == 409
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1})
+    assert _order(shop, "LAMP", 1).status == 201
+
+
+def test_restock_unknown_product(shop):
+    r = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 1})
+    assert (r.status, r.body) == (404, {"error": "product not found"})
+
+
+def test_restock_invalid_requests_change_nothing(shop):
+    bad_requests = [
+        {}, {"sku": "", "quantity": 1}, {"sku": 1, "quantity": 1}, {"sku": "PEN"},
+        {"sku": "PEN", "quantity": 0}, {"sku": "PEN", "quantity": -2},
+        {"sku": "PEN", "quantity": True}, {"sku": "PEN", "quantity": "3"},
+        {"sku": "PEN", "quantity": 1.5},
+    ]
+    for bad in bad_requests:
+        r = shop.fulfilment.handle_restock(bad)
+        assert r.status == 400 and "error" in r.body
+    assert shop.catalog.handle_get("PEN").body["on_hand"] == 100
+
+
+def test_summary_empty(api):
+    r = api.fulfilment.handle_fulfilment_summary()
+    assert (r.status, r.body) == (200, {"open_orders": 0, "units_to_pick": 0, "low_stock_products": 0})
+
+
+def test_summary_counts_open_orders_units_and_low_stock(shop):
+    _order(shop, "PEN", 3)
+    _order(shop, "BOOK", 2)
+    cancelled = _order(shop, "PEN", 40).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    shop.catalog.handle_add_product({"sku": "X", "name": "X", "unit_price_cents": 1, "on_hand": 4})
+    shop.catalog.handle_add_product({"sku": "Y", "name": "Y", "unit_price_cents": 1, "on_hand": 5})
+    r = shop.fulfilment.handle_fulfilment_summary()
+    # Low: X (4) only; LAMP has 5 (not below), Y has 5.
+    assert r.body == {"open_orders": 2, "units_to_pick": 5, "low_stock_products": 1}
+
+
+def test_summary_low_stock_boundary_and_inactive(shop):
+    _order(shop, "LAMP", 1)  # LAMP drops to 4
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 1
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1})
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 0
+
+
+def _place(shop, items):
+    return shop.orders.handle_create({"customer_id": "c1", "items": items}).body["order_id"]
+
+
+def test_packing_slip(shop):
+    oid = _place(shop, [{"sku": "PEN", "quantity": 2}, {"sku": "BOOK", "quantity": 1}])
+    r = shop.fulfilment.handle_packing_slip(oid)
+    assert r.status == 200
+    assert r.body == {"order_id": oid, "customer_name": "Ada", "lines": [
+        {"sku": "PEN", "name": "Pen", "quantity": 2}, {"sku": "BOOK", "name": "Book", "quantity": 1}]}
+
+
+def test_packing_slip_unknown(shop):
+    r = shop.fulfilment.handle_packing_slip("nope")
+    assert (r.status, r.body) == (404, {"error": "order not found"})
+
+
+def test_packing_slip_cancelled(shop):
+    oid = _place(shop, [{"sku": "PEN", "quantity": 1}])
+    shop.orders.handle_cancel(oid)
+    r = shop.fulfilment.handle_packing_slip(oid)
+    assert r.status == 409 and "error" in r.body
