diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..108a320
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,98 @@
+from test_orders import order
+
+
+def test_unknown_customer(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_no_orders(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_history_newest_first_with_discount_and_cancelled(shop):
+    first = order(shop, "c1", ("LAMP", 2)).body["order_id"]
+    second = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    order(shop, "c2", ("PEN", 1))
+    shop.orders.handle_cancel(first)
+    body = shop.insights.handle_order_history("c1").body
+    assert body["customer_id"] == "c1"
+    assert body["orders"] == [
+        {"order_id": second, "status": "placed", "total_cents": 2500},
+        {"order_id": first, "status": "cancelled",
+         "total_cents": shop.orders.handle_get(first).body["total_cents"]},
+    ]
+    assert body["orders"][1]["total_cents"] == 10800
+
+
+def test_lifetime_value_unknown_customer(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_no_orders(shop):
+    assert shop.insights.handle_lifetime_value("c1").body == {
+        "customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_and_includes_discount(shop):
+    cancelled = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    lamp = order(shop, "c1", ("LAMP", 2)).body["order_id"]
+    book = order(shop, "c1", ("BOOK", 2)).body["order_id"]
+    order(shop, "c2", ("PEN", 1))
+    shop.orders.handle_cancel(cancelled)
+    expected = sum(shop.orders.handle_get(o).body["total_cents"] for o in (lamp, book))
+    body = shop.insights.handle_lifetime_value("c1").body
+    assert body == {"customer_id": "c1", "order_count": 2, "lifetime_value_cents": expected}
+    assert expected == 10800 + 5000
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, "3", 1.5, None):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400
+        assert "error" in response.body
+
+
+def test_top_customers_ranking_filtering_and_limit(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Idle", "email": "i@example.com"})
+    order(shop, "c1", ("BOOK", 2))                       # 5000
+    order(shop, "c0", ("BOOK", 2))                       # 5000, ties with c1, sorts first
+    order(shop, "c2", ("LAMP", 2))                       # 10200 (gold)
+    cancelled = order(shop, "c3", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)                 # value 0, excluded
+    body = shop.insights.handle_top_customers(10).body
+    assert body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 10200},
+        {"customer_id": "c0", "name": "Zed", "lifetime_value_cents": 5000},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 5000},
+    ]}
+    assert [c["customer_id"] for c in shop.insights.handle_top_customers(2).body["customers"]] == ["c2", "c0"]
+
+
+def test_customers_without_orders(shop):
+    shop.customers.handle_register({"customer_id": "c3", "name": "Idle", "email": "i@example.com"})
+    shop.customers.handle_register({"customer_id": "c4", "name": "Quit", "email": "q@example.com"})
+    order(shop, "c2", ("PEN", 1))
+    cancelled = order(shop, "c4", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    response = shop.insights.handle_customers_without_orders()
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"},
+        {"customer_id": "c3", "name": "Idle", "email": "i@example.com"},
+        {"customer_id": "c4", "name": "Quit", "email": "q@example.com"},
+    ]}
+
+
+def test_customers_without_orders_none_registered(api):
+    assert api.insights.handle_customers_without_orders().body == {"customers": []}
+
+
+def test_top_customers_empty(shop):
+    assert shop.insights.handle_top_customers(5).body == {"customers": []}
