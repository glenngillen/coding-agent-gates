diff --git a/src/orders/controllers/customer_insights.py b/src/orders/controllers/customer_insights.py
new file mode 100644
index 0000000..89c33e2
--- /dev/null
+++ b/src/orders/controllers/customer_insights.py
@@ -0,0 +1,47 @@
+"""Customer insight endpoints for the account team."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from orders.application.errors import CustomerNotFound
+from orders.application.order_service import OrderService
+from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
+
+
+class CustomerInsightsController:
+    def __init__(self, service: OrderService) -> None:
+        self._service = service
+
+    def handle_customers_without_orders(self) -> Response:
+        return Response(200, {"customers": [
+            {"customer_id": c.customer_id, "name": c.name, "email": c.email}
+            for c in self._service.customers_without_orders()]})
+
+    def handle_top_customers(self, limit: Any) -> Response:
+        try:
+            limit = require_positive_int(limit, "limit")
+        except InvalidRequest as exc:
+            return bad_request(exc)
+        return Response(200, {"customers": [
+            {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
+            for c, value in self._service.top_customers(limit)]})
+
+    def handle_lifetime_value(self, customer_id: str) -> Response:
+        try:
+            count, total = self._service.lifetime_value(customer_id)
+        except CustomerNotFound:
+            return not_found("customer")
+        return Response(200, {"customer_id": customer_id, "order_count": count,
+                              "lifetime_value_cents": total})
+
+    def handle_order_history(self, customer_id: str) -> Response:
+        try:
+            summaries = self._service.order_history(customer_id)
+        except CustomerNotFound:
+            return not_found("customer")
+        return Response(200, {
+            "customer_id": customer_id,
+            "orders": [{"order_id": s.order.order_id, "status": s.order.status,
+                        "total_cents": s.total_cents} for s in summaries],
+        })
