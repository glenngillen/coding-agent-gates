diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..33b00dd
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,103 @@
+def place(api, customer_id, items):
+    return api.orders.handle_create({"customer_id": customer_id, "items": items}).body["order_id"]
+
+
+def test_unknown_customer(shop):
+    r = shop.insights.handle_order_history("nope")
+    assert r.status == 404
+    assert r.body == {"error": "customer not found"}
+
+
+def test_no_orders(shop):
+    r = shop.insights.handle_order_history("c1")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c1", "orders": []}
+
+
+def test_history_newest_first_with_cancelled_and_discount_totals(shop):
+    first = place(shop, "c2", [{"sku": "LAMP", "quantity": 2}])
+    second = place(shop, "c2", [{"sku": "BOOK", "quantity": 1}])
+    place(shop, "c1", [{"sku": "PEN", "quantity": 1}])
+    shop.orders.handle_cancel(first)
+    r = shop.insights.handle_order_history("c2")
+    assert r.status == 200
+    assert r.body["customer_id"] == "c2"
+    assert [o["order_id"] for o in r.body["orders"]] == [second, first]
+    assert [o["status"] for o in r.body["orders"]] == ["placed", "cancelled"]
+    for entry in r.body["orders"]:
+        assert entry["total_cents"] == shop.orders.handle_get(entry["order_id"]).body["total_cents"]
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, "3", None, 1.5):
+        r = shop.insights.handle_top_customers(bad)
+        assert r.status == 400
+        assert "error" in r.body
+
+
+def test_top_customers_empty_when_no_value(shop):
+    place(shop, "c1", [{"sku": "PEN", "quantity": 1}])
+    shop.orders.handle_cancel("ord-0001")
+    r = shop.insights.handle_top_customers(5)
+    assert r.status == 200
+    assert r.body == {"customers": []}
+
+
+def test_top_customers_sorted_limited_and_excludes_zero(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Linus", "email": "l@example.com"})
+    place(shop, "c1", [{"sku": "PEN", "quantity": 1}])
+    place(shop, "c3", [{"sku": "PEN", "quantity": 1}])
+    place(shop, "c2", [{"sku": "BOOK", "quantity": 1}])
+    cancelled = place(shop, "c0", [{"sku": "LAMP", "quantity": 1}])
+    shop.orders.handle_cancel(cancelled)
+    value = {c: shop.insights.handle_lifetime_value(c).body["lifetime_value_cents"] for c in ("c1", "c2", "c3")}
+    r = shop.insights.handle_top_customers(10)
+    assert r.status == 200
+    assert r.body["customers"] == [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": value["c2"]},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": value["c1"]},
+        {"customer_id": "c3", "name": "Linus", "lifetime_value_cents": value["c3"]},
+    ]
+    assert shop.insights.handle_top_customers(2).body["customers"] == r.body["customers"][:2]
+
+
+def test_customers_without_orders(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Linus", "email": "l@example.com"})
+    assert shop.insights.handle_customers_without_orders().body["customers"] == [
+        {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"},
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "c0", "name": "Zed", "email": "z@example.com"},
+        {"customer_id": "c3", "name": "Linus", "email": "l@example.com"},
+    ]
+    place(shop, "c2", [{"sku": "PEN", "quantity": 1}])
+    cancelled = place(shop, "c1", [{"sku": "PEN", "quantity": 1}])
+    shop.orders.handle_cancel(cancelled)
+    r = shop.insights.handle_customers_without_orders()
+    assert r.status == 200
+    assert [c["customer_id"] for c in r.body["customers"]] == ["c1", "c0", "c3"]
+
+
+def test_lifetime_value_unknown_customer(shop):
+    r = shop.insights.handle_lifetime_value("nope")
+    assert r.status == 404
+    assert r.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_no_orders(shop):
+    r = shop.insights.handle_lifetime_value("c1")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_and_uses_discounted_totals(shop):
+    first = place(shop, "c2", [{"sku": "LAMP", "quantity": 2}])
+    second = place(shop, "c2", [{"sku": "BOOK", "quantity": 1}])
+    third = place(shop, "c2", [{"sku": "PEN", "quantity": 3}])
+    place(shop, "c1", [{"sku": "PEN", "quantity": 1}])
+    shop.orders.handle_cancel(first)
+    expected = sum(shop.orders.handle_get(i).body["total_cents"] for i in (second, third))
+    r = shop.insights.handle_lifetime_value("c2")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": expected}
