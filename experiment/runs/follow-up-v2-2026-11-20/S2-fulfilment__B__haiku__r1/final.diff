diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..d72402f
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,138 @@
+def place(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order_with_catalogue_names(shop):
+    oid = place(shop, "c1", ("PEN", 3), ("BOOK", 2), ("LAMP", 1)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 3},
+            {"sku": "BOOK", "name": "Book", "quantity": 2},
+            {"sku": "LAMP", "name": "Lamp", "quantity": 1},
+        ],
+    }
+
+
+def test_packing_slip_uses_customer_of_the_order(shop):
+    oid = place(shop, "c2", ("BOOK", 1)).body["order_id"]
+    assert shop.fulfilment.handle_packing_slip(oid).body["customer_name"] == "Grace"
+
+
+def test_packing_slip_unknown_order_is_404(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_cancelled_order_is_409(shop):
+    oid = place(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "cancelled" in response.body["error"]
+
+
+def test_packing_slip_does_not_change_stock(shop):
+    oid = place(shop, "c1", ("LAMP", 2)).body["order_id"]
+    shop.fulfilment.handle_packing_slip(oid)
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 3
+
+
+def test_low_stock_strictly_below_threshold_sorted_by_on_hand_then_sku(shop):
+    # Shop stock: BOOK 50, LAMP 5, PEN 100.
+    assert shop.fulfilment.handle_low_stock(51).body == {"products": [
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+        {"sku": "BOOK", "name": "Book", "on_hand": 50},
+    ]}
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_ties_broken_by_sku(shop):
+    shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 100, "on_hand": 5})
+    body = shop.fulfilment.handle_low_stock(10).body
+    assert [p["sku"] for p in body["products"]] == ["CUP", "LAMP"]
+
+
+def test_low_stock_excludes_inactive_products():
+    from orders.application.fulfilment_service import FulfilmentService
+    from orders.domain.catalog import Product
+    from orders.infrastructure.catalog import InMemoryProductCatalog
+    from orders.infrastructure.stock import InMemoryStockRepository
+
+    catalog, stock = InMemoryProductCatalog(), InMemoryStockRepository()
+    catalog.add(Product("OLD", "Old", 100, active=False))
+    stock.set("OLD", 1)
+    catalog.add(Product("NEW", "New", 100))
+    stock.set("NEW", 1)
+    service = FulfilmentService(None, None, catalog, stock)  # low_stock needs only catalogue and stock
+    assert [p.sku for p in service.low_stock(10)] == ["NEW"]
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, True, False, "5", 2.5, None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400
+        assert "threshold" in response.body["error"]
+
+
+def test_restock_adds_to_stock_and_units_are_orderable(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 10})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 15}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 15
+    # The restocked units can be ordered immediately (LAMP had 5, so 6 failed before).
+    assert place(shop, "c1", ("LAMP", 6)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 9
+
+
+def test_restock_unknown_product_is_404_and_changes_nothing(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 3})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+    assert shop.catalog.handle_get("PEN").body["on_hand"] == 100
+
+
+def test_restock_rejects_invalid_request_without_change(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -2},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP", "quantity": "3"},
+        {"sku": "LAMP", "quantity": 1.5},
+        {"sku": "LAMP"},
+    ]
+    for request in bad_requests:
+        response = shop.fulfilment.handle_restock(request)
+        assert response.status == 400, request
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+    place(shop, "c1", ("BOOK", 2), ("LAMP", 1))      # 3 units
+    place(shop, "c2", ("PEN", 4))                    # 4 units
+    cancelled = place(shop, "c1", ("PEN", 10)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)             # excluded everywhere
+    # LAMP: 5 on hand, 1 ordered -> 4, which is below the line of 5. BOOK 48, PEN 86 are not.
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 2, "units_to_pick": 7, "low_stock_products": 1}
+
+
+def test_fulfilment_summary_low_stock_line_is_strict(shop):
+    # LAMP starts at exactly 5, which is not low stock.
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 0
+    place(shop, "c1", ("LAMP", 1))                                   # LAMP now 4
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 1
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1})  # LAMP back to 5
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 0
