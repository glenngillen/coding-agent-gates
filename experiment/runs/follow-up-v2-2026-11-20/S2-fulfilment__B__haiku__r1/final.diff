@@ -0,0 +1,66 @@
+"""Warehouse fulfilment: packing slips for placed orders."""
+
+from __future__ import annotations
+
+from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
+from orders.application.order_service import OrderService
+from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
+from orders.infrastructure.catalog import InMemoryProductCatalog
+from orders.infrastructure.customers import InMemoryCustomerRepository
+from orders.infrastructure.stock import InMemoryStockRepository
+
+LOW_STOCK_LINE = 5
+
+
+class FulfilmentService:
+    def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
+                 catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
+        self._orders = orders  # OrderService; the order repository is only reached through it
+        self._customers = customers
+        self._catalog = catalog
+        self._stock = stock
+
+    def low_stock(self, threshold: int) -> list[LowStockProduct]:
+        """Active products with on-hand stock strictly below ``threshold``, lowest first."""
+        below = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
+                 for p in self._catalog.list_all() if p.active]
+        below = [p for p in below if p.on_hand < threshold]
+        return sorted(below, key=lambda p: (p.on_hand, p.sku))
+
+    def summary(self) -> FulfilmentSummary:
+        """Dashboard numbers: open orders, units to pick across them, and low-stock products."""
+        open_orders = self._orders.list_open()
+        units = sum(item.quantity for order in open_orders for item in order.items)
+        return FulfilmentSummary(
+            open_orders=len(open_orders),
+            units_to_pick=units,
+            low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
+        )
+
+    def restock(self, sku: str, quantity: int) -> int:
+        """Add ``quantity`` units to a product's stock and return the new level.
+
+        The stock repository is shared with OrderService, so the units are
+        orderable as soon as this returns. Raises ProductNotFound for unknown SKUs.
+        """
+        if self._catalog.get(sku) is None:
+            raise ProductNotFound(sku)
+        new_level = self._stock.get(sku) + quantity
+        self._stock.set(sku, new_level)
+        return new_level
+
+    def packing_slip(self, order_id: str) -> PackingSlip:
+        """Raises OrderNotFound for unknown orders and Conflict for cancelled ones."""
+        order = self._orders.get_order(order_id)
+        if order.status == "cancelled":
+            raise Conflict(f"order {order_id} is cancelled and cannot be packed")
+        customer = self._customers.get(order.customer_id)
+        if customer is None:
+            raise CustomerNotFound(order.customer_id)
+        lines = []
+        for item in order.items:
+            product = self._catalog.get(item.sku)
+            if product is None:
+                raise ProductNotFound(item.sku)
+            lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
+        return PackingSlip(order.order_id, customer.name, tuple(lines))
