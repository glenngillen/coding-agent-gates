diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..0006018
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,37 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order(shop):
+    oid = order(shop, "c1", ("PEN", 2), ("BOOK", 1), ("LAMP", 3)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 2},
+            {"sku": "BOOK", "name": "Book", "quantity": 1},
+            {"sku": "LAMP", "name": "Lamp", "quantity": 3},
+        ],
+    }
+
+
+def test_packing_slip_uses_customer_of_the_order(shop):
+    oid = order(shop, "c2", ("BOOK", 1)).body["order_id"]
+    assert shop.fulfilment.handle_packing_slip(oid).body["customer_name"] == "Grace"
+
+
+def test_packing_slip_unknown_order(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_cancelled_order_is_conflict(shop):
+    oid = order(shop, "c1", ("LAMP", 2)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "cancelled" in response.body["error"]
diff --git a/tests/test_fulfilment_summary.py b/tests/test_fulfilment_summary.py
new file mode 100644
index 0000000..fc9174e
--- /dev/null
+++ b/tests/test_fulfilment_summary.py
@@ -0,0 +1,29 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_summary_counts_open_orders_units_and_low_stock(shop):
+    # shop stock: BOOK 50, LAMP 5, PEN 100
+    order(shop, "c1", ("BOOK", 2), ("PEN", 1))   # 3 units
+    order(shop, "c2", ("LAMP", 1))               # 1 unit; LAMP drops to 4 (low)
+    cancelled = order(shop, "c1", ("PEN", 5)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)         # excluded, and its stock is restored
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 4, "low_stock_products": 1}
+
+
+def test_low_stock_line_is_strictly_below_five(shop):
+    shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 800, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "APP", "name": "Apple", "unit_price_cents": 50, "on_hand": 4})
+    # LAMP is at exactly 5 in the fixture, so it is not low.
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 1,
+    }
+
+
+def test_empty_shop_summary(api):
+    assert api.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0,
+    }
diff --git a/tests/test_low_stock.py b/tests/test_low_stock.py
new file mode 100644
index 0000000..197869b
--- /dev/null
+++ b/tests/test_low_stock.py
@@ -0,0 +1,51 @@
+from orders.application.catalog_service import CatalogService
+from orders.application.customer_service import CustomerService
+from orders.application.fulfilment_service import FulfilmentService
+from orders.application.order_service import OrderService
+from orders.domain.catalog import Product
+from orders.infrastructure.catalog import InMemoryProductCatalog
+from orders.infrastructure.customers import InMemoryCustomerRepository
+from orders.infrastructure.repository import InMemoryOrderRepository
+from orders.infrastructure.stock import InMemoryStockRepository
+
+
+def test_low_stock_is_strictly_below_threshold_sorted_by_on_hand_then_sku(shop):
+    # shop stock: BOOK 50, LAMP 5, PEN 100
+    shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 800, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "APP", "name": "Apple", "unit_price_cents": 50, "on_hand": 2})
+    response = shop.fulfilment.handle_low_stock(5)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "APP", "name": "Apple", "on_hand": 2},
+    ]}
+    response = shop.fulfilment.handle_low_stock(6)
+    assert response.body == {"products": [
+        {"sku": "APP", "name": "Apple", "on_hand": 2},
+        {"sku": "CUP", "name": "Cup", "on_hand": 5},
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+    ]}
+
+
+def test_low_stock_zero_threshold_is_empty(shop):
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_excludes_inactive_products():
+    catalog = InMemoryProductCatalog()
+    stock = InMemoryStockRepository()
+    catalog_service = CatalogService(catalog, stock)
+    order_service = OrderService(InMemoryOrderRepository(), InMemoryCustomerRepository(), catalog, stock)
+    fulfilment = FulfilmentService(order_service, CustomerService(InMemoryCustomerRepository()),
+                                   catalog_service)
+    catalog.add(Product("OLD", "Old", 100, active=False))
+    stock.set("OLD", 0)
+    catalog.add(Product("NEW", "New", 100))
+    stock.set("NEW", 0)
+    assert [level.sku for level in fulfilment.low_stock(1)] == ["NEW"]
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, True, False, 1.5, "3", None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400
+        assert "threshold" in response.body["error"]
diff --git a/tests/test_restock.py b/tests/test_restock.py
new file mode 100644
index 0000000..fba5d20
--- /dev/null
+++ b/tests/test_restock.py
@@ -0,0 +1,43 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_restock_adds_to_stock(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 4})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 9}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 9
+
+
+def test_restocked_units_are_orderable_straight_away(shop):
+    assert order(shop, "c1", ("LAMP", 7)).status == 409
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 2})
+    assert order(shop, "c1", ("LAMP", 7)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 0
+
+
+def test_restock_unknown_product_is_404_and_changes_nothing(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 3})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_restock_rejects_invalid_input_without_change(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -2},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP", "quantity": 1.0},
+        {"sku": "LAMP", "quantity": "3"},
+        {"sku": "LAMP"},
+    ]
+    for request in bad_requests:
+        response = shop.fulfilment.handle_restock(request)
+        assert response.status == 400, request
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
