diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..86bdf98
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,120 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_unknown_customer(shop):
+    resp = shop.insights.handle_order_history("nope")
+    assert resp.status == 404
+    assert resp.body == {"error": "customer not found"}
+
+
+def test_no_orders(shop):
+    resp = shop.insights.handle_order_history("c1")
+    assert resp.status == 200
+    assert resp.body == {"customer_id": "c1", "orders": []}
+
+
+def test_history_newest_first_with_cancelled_and_other_customers_excluded(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    second = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    order(shop, "c2", ("PEN", 1))
+    shop.orders.handle_cancel(first)
+    resp = shop.insights.handle_order_history("c1")
+    assert resp.status == 200
+    assert resp.body == {"customer_id": "c1", "orders": [
+        {"order_id": second, "status": "placed", "total_cents": 600},
+        {"order_id": first, "status": "cancelled", "total_cents": 2_500},
+    ]}
+
+
+def test_total_matches_order_summary_including_discount(shop):
+    ids = [order(shop, "c2", ("LAMP", 2)).body["order_id"], order(shop, "c1", ("LAMP", 2)).body["order_id"]]
+    for cid, oid in (("c2", ids[0]), ("c1", ids[1])):
+        entry = shop.insights.handle_order_history(cid).body["orders"][0]
+        assert entry["total_cents"] == shop.orders.handle_get(oid).body["total_cents"]
+
+
+def test_lifetime_value_unknown_customer(shop):
+    resp = shop.insights.handle_lifetime_value("nope")
+    assert resp.status == 404
+    assert resp.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_no_orders(shop):
+    assert shop.insights.handle_lifetime_value("c1").body == {
+        "customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_and_applies_discount(shop):
+    order(shop, "c2", ("LAMP", 2))
+    order(shop, "c2", ("PEN", 1))
+    cancelled = order(shop, "c2", ("BOOK", 4)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    order(shop, "c1", ("PEN", 1))
+    expected = sum(o["total_cents"] for o in shop.insights.handle_order_history("c2").body["orders"]
+                   if o["status"] != "cancelled")
+    body = shop.insights.handle_lifetime_value("c2").body
+    assert body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": expected}
+
+
+def _register(api, customer_id, name):
+    api.customers.handle_register({"customer_id": customer_id, "name": name,
+                                   "email": f"{customer_id}@example.com"})
+
+
+def test_top_customers_rejects_invalid_limit(shop):
+    for bad in (0, -1, True, False, "3", 2.0, None):
+        resp = shop.insights.handle_top_customers(bad)
+        assert resp.status == 400
+        assert "error" in resp.body
+
+
+def test_top_customers_empty(shop):
+    assert shop.insights.handle_top_customers(5).body == {"customers": []}
+
+
+def test_top_customers_ranking_ties_zero_and_cancelled(shop):
+    _register(shop, "c3", "Alan")
+    _register(shop, "c4", "Edsger")  # only a cancelled order: value 0
+    _register(shop, "c0", "Zero")    # no orders
+    order(shop, "c3", ("PEN", 1))
+    order(shop, "c1", ("PEN", 1))
+    order(shop, "c2", ("BOOK", 2))
+    cancelled = order(shop, "c4", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    c2_value = shop.insights.handle_lifetime_value("c2").body["lifetime_value_cents"]
+    assert c2_value > 300
+    resp = shop.insights.handle_top_customers(10)
+    assert resp.status == 200
+    assert resp.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": c2_value},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 300},
+        {"customer_id": "c3", "name": "Alan", "lifetime_value_cents": 300},
+    ]}
+
+
+def test_customers_without_orders_empty_app(api):
+    assert api.insights.handle_customers_without_orders().body == {"customers": []}
+
+
+def test_customers_without_orders_includes_cancelled_only_in_registration_order(shop):
+    _register(shop, "c0", "Zero")
+    _register(shop, "c3", "Alan")
+    order(shop, "c1", ("PEN", 1))
+    cancelled = order(shop, "c2", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    resp = shop.insights.handle_customers_without_orders()
+    assert resp.status == 200
+    assert resp.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "c0", "name": "Zero", "email": "c0@example.com"},
+        {"customer_id": "c3", "name": "Alan", "email": "c3@example.com"},
+    ]}
+
+
+def test_top_customers_respects_limit(shop):
+    order(shop, "c1", ("PEN", 1))
+    order(shop, "c2", ("BOOK", 2))
+    resp = shop.insights.handle_top_customers(1)
+    assert [c["customer_id"] for c in resp.body["customers"]] == ["c2"]
