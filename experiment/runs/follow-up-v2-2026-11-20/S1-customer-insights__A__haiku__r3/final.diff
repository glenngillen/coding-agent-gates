diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..a9d75be
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,161 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_unknown_customer_is_404(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_customer_with_no_orders_has_empty_history(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_orders_are_newest_first_with_status(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    second = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    third = order(shop, "c1", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(second)
+
+    response = shop.insights.handle_order_history("c1")
+
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": [
+        {"order_id": third, "status": "placed", "total_cents": 6_000},
+        {"order_id": second, "status": "cancelled", "total_cents": 600},
+        {"order_id": first, "status": "placed", "total_cents": 2_500},
+    ]}
+
+
+def test_totals_match_order_summary_including_discount(shop):
+    # Gold customer: 15% off a subtotal of $100.00 or more.
+    big = order(shop, "c2", ("LAMP", 5), ("BOOK", 4)).body["order_id"]
+    small = order(shop, "c2", ("PEN", 1)).body["order_id"]
+
+    history = shop.insights.handle_order_history("c2").body["orders"]
+    by_id = {entry["order_id"]: entry for entry in history}
+
+    assert by_id[big]["total_cents"] == shop.orders.handle_get(big).body["total_cents"]
+    assert by_id[big]["total_cents"] == 40_000 - 6_000
+    assert by_id[small]["total_cents"] == shop.orders.handle_get(small).body["total_cents"] == 300
+
+
+def test_lifetime_value_unknown_customer_is_404(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_with_no_orders_is_zero(shop):
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_orders(shop):
+    order(shop, "c1", ("BOOK", 1))                      # 2_500
+    cancelled = order(shop, "c1", ("PEN", 2)).body["order_id"]  # 600, cancelled
+    shop.orders.handle_cancel(cancelled)
+    order(shop, "c1", ("LAMP", 1))                      # 6_000
+
+    response = shop.insights.handle_lifetime_value("c1")
+
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 2, "lifetime_value_cents": 8_500}
+
+
+def test_lifetime_value_uses_discounted_totals(shop):
+    # Gold customer: 15% off a subtotal of $100.00 or more.
+    order(shop, "c2", ("LAMP", 5), ("BOOK", 4))         # 40_000 - 6_000 = 34_000
+    order(shop, "c2", ("PEN", 1))                       # 300
+
+    response = shop.insights.handle_lifetime_value("c2")
+
+    assert response.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": 34_300}
+
+
+def test_top_customers_rejects_invalid_limit(shop):
+    for bad in (0, -1, True, False, "3", None, 2.0):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400, bad
+        assert "limit" in response.body["error"]
+
+
+def test_top_customers_empty_when_nobody_has_orders(shop):
+    response = shop.insights.handle_top_customers(5)
+    assert response.status == 200
+    assert response.body == {"customers": []}
+
+
+def test_top_customers_ranks_by_lifetime_value_and_skips_zero(shop):
+    order(shop, "c1", ("BOOK", 1))                      # 2_500
+    order(shop, "c2", ("LAMP", 5), ("BOOK", 4))         # 34_000 after gold discount
+    shop.customers.handle_register({"customer_id": "c3", "name": "Linus", "email": "linus@example.com"})
+
+    response = shop.insights.handle_top_customers(10)
+
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 34_000},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 2_500},
+    ]}
+
+
+def test_top_customers_skips_customers_whose_orders_are_all_cancelled(shop):
+    cancelled = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+
+    assert shop.insights.handle_top_customers(10).body == {"customers": []}
+
+
+def test_top_customers_breaks_ties_by_customer_id(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Linus", "email": "linus@example.com"})
+    order(shop, "c1", ("BOOK", 1))                      # 2_500
+    order(shop, "c0", ("BOOK", 1))                      # 2_500
+
+    customers = shop.insights.handle_top_customers(10).body["customers"]
+
+    assert [c["customer_id"] for c in customers] == ["c0", "c1"]
+
+
+def test_top_customers_respects_limit(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("LAMP", 5), ("BOOK", 4))
+
+    customers = shop.insights.handle_top_customers(1).body["customers"]
+
+    assert [c["customer_id"] for c in customers] == ["c2"]
+
+
+def test_customers_without_orders_lists_everyone_when_no_orders(shop):
+    response = shop.insights.handle_customers_without_orders()
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"},
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+    ]}
+
+
+def test_customers_without_orders_counts_cancelled_only_customers_and_keeps_registration_order(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Linus", "email": "linus@example.com"})
+    order(shop, "c2", ("BOOK", 1))                      # c2 has an active order
+    cancelled = order(shop, "c0", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)                # c0 only has a cancelled order
+
+    customers = shop.insights.handle_customers_without_orders().body["customers"]
+
+    # Registration order is c1, c2, c0; c2 is excluded because it has an active order.
+    assert [c["customer_id"] for c in customers] == ["c1", "c0"]
+
+
+def test_history_only_includes_the_requested_customer(shop):
+    mine = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    order(shop, "c2", ("BOOK", 1))
+
+    orders = shop.insights.handle_order_history("c1").body["orders"]
+
+    assert [entry["order_id"] for entry in orders] == [mine]
