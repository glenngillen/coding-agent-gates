+    def order_summaries_for_customer(self, customer_id: str) -> list[OrderSummary]:
+        """Summaries (with the same totals as ``get_order_summary``) for a customer's orders, newest first."""
+        return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
+
+    def customer_lifetime_value(self, customer_id: str) -> tuple[int, int]:
+        """``(order_count, lifetime_value_cents)`` over a customer's orders that are not cancelled."""
+        active = [s for s in self.order_summaries_for_customer(customer_id)
+                  if s.order.status != "cancelled"]
+        return len(active), sum(s.total_cents for s in active)
+
+    def customers_without_active_orders(self) -> list[Customer]:
+        """Registered customers with no orders that are not cancelled, in registration order."""
+        return [customer for customer in self._customers.list_all()
+                if self.customer_lifetime_value(customer.customer_id)[0] == 0]
+
+    def top_customers_by_lifetime_value(self, limit: int) -> list[tuple[Customer, int]]:
+        """Up to ``limit`` customers with a non-zero lifetime value, highest first, ties by customer_id."""
+        ranked = []
+        for customer in self._customers.list_all():
+            _, value = self.customer_lifetime_value(customer.customer_id)
+            if value > 0:
+                ranked.append((customer, value))
+        ranked.sort(key=lambda entry: (-entry[1], entry[0].customer_id))
+        return ranked[:limit]
+
