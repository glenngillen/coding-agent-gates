diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..e12c725
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,117 @@
+def place(api, *items):
+    return api.orders.handle_create({"customer_id": "c1",
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip(shop):
+    oid = place(shop, ("LAMP", 1), ("BOOK", 2)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [{"sku": "LAMP", "name": "Lamp", "quantity": 1},
+                  {"sku": "BOOK", "name": "Book", "quantity": 2}],
+    }
+
+
+def test_packing_slip_unknown_order(shop):
+    response = shop.fulfilment.handle_packing_slip("nope")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_cancelled_order(shop):
+    oid = place(shop, ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "error" in response.body
+
+
+def test_low_stock_filters_and_sorts(shop):
+    shop.catalog.handle_add_product({"sku": "AAA", "name": "Aaa", "unit_price_cents": 100, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "ZERO", "name": "Zero", "unit_price_cents": 100, "on_hand": 0})
+    response = shop.fulfilment.handle_low_stock(6)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "ZERO", "name": "Zero", "on_hand": 0},
+        {"sku": "AAA", "name": "Aaa", "on_hand": 5},
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+    ]}
+
+
+def test_low_stock_is_strictly_below(shop):
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_excludes_inactive_products():
+    from orders.application.fulfilment_service import FulfilmentService
+    from orders.domain.catalog import Product
+    from orders.infrastructure.catalog import InMemoryProductCatalog
+    from orders.infrastructure.customers import InMemoryCustomerRepository
+    from orders.infrastructure.repository import InMemoryOrderRepository
+    from orders.infrastructure.stock import InMemoryStockRepository
+
+    catalog = InMemoryProductCatalog()
+    catalog.add(Product("OLD", "Old", 100, active=False))
+    catalog.add(Product("NEW", "New", 100))
+    service = FulfilmentService(InMemoryOrderRepository(), InMemoryCustomerRepository(), catalog,
+                                InMemoryStockRepository())
+    assert [i.sku for i in service.low_stock(10)] == ["NEW"]
+
+
+def test_restock_adds_stock_and_is_orderable(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 10})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 15}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 15
+    assert place(shop, ("LAMP", 15)).status == 201
+
+
+def test_restock_unknown_product(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 1})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+
+
+def test_restock_rejects_bad_requests_without_change(shop):
+    bad_requests = [{}, {"sku": "", "quantity": 1}, {"sku": 5, "quantity": 1}, {"sku": "LAMP"},
+                    {"sku": "LAMP", "quantity": 0}, {"sku": "LAMP", "quantity": -3},
+                    {"sku": "LAMP", "quantity": True}, {"sku": "LAMP", "quantity": "2"},
+                    {"sku": "LAMP", "quantity": 1.5}]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_summary_empty(shop):
+    # LAMP (5), BOOK (50), PEN (100): none below the line of 5.
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+
+
+def test_summary_counts_open_orders_units_and_low_stock(shop):
+    place(shop, ("BOOK", 2), ("PEN", 3))
+    cancelled = place(shop, ("BOOK", 10)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    place(shop, ("LAMP", 1))  # LAMP drops to 4: below the line
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 6, "low_stock_products": 1}
+
+
+def test_summary_low_stock_line_is_strictly_below_five(shop):
+    shop.catalog.handle_add_product({"sku": "FOUR", "name": "Four", "unit_price_cents": 1, "on_hand": 4})
+    shop.catalog.handle_add_product({"sku": "FIVE", "name": "Five", "unit_price_cents": 1, "on_hand": 5})
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 1
+
+
+def test_low_stock_rejects_bad_threshold(shop):
+    for bad in (-1, True, "5", 2.5, None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400
+        assert "error" in response.body
