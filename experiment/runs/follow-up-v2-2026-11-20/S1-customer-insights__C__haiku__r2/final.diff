diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..35d58f2
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,140 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_unknown_customer_is_404(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_customer_with_no_orders_gets_empty_list(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_history_is_newest_first_and_includes_cancelled(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    second = order(shop, "c2", ("PEN", 1)).body["order_id"]
+    third = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    shop.orders.handle_cancel(third)
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": [
+        {"order_id": third, "status": "cancelled", "total_cents": 600},
+        {"order_id": first, "status": "placed", "total_cents": 2500},
+    ]}
+    assert second not in [o["order_id"] for o in response.body["orders"]]
+
+
+def test_lifetime_value_unknown_customer_is_404(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_with_no_orders_is_zero(shop):
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_orders(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c1", ("LAMP", 2))
+    cancelled = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    order(shop, "c2", ("PEN", 1))
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    # BOOK 2500 + LAMP 12000 - 10% discount (subtotal >= $100) = 10800; cancelled PEN ignored.
+    assert response.body == {"customer_id": "c1", "order_count": 2,
+                             "lifetime_value_cents": 2500 + 10800}
+
+
+def test_lifetime_value_uses_gold_discount_and_matches_history(shop):
+    order(shop, "c2", ("LAMP", 2))
+    order(shop, "c2", ("BOOK", 1))
+    history_total = sum(o["total_cents"] for o in shop.insights.handle_order_history("c2").body["orders"])
+    response = shop.insights.handle_lifetime_value("c2")
+    assert response.body == {"customer_id": "c2", "order_count": 2,
+                             "lifetime_value_cents": history_total}
+    # LAMP 12000 - 15% = 10200; BOOK 2500 has no discount.
+    assert history_total == 10200 + 2500
+
+
+def test_top_customers_ranks_by_lifetime_value_and_skips_zero(shop):
+    api = shop
+    api.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    order(api, "c1", ("BOOK", 1))            # 2500
+    order(api, "c2", ("LAMP", 2))            # 12000 - 15% = 10200
+    cancelled = order(api, "c1", ("PEN", 1)).body["order_id"]
+    api.orders.handle_cancel(cancelled)      # ignored
+    response = api.insights.handle_top_customers(10)
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 10200},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 2500},
+    ]}
+
+
+def test_top_customers_breaks_ties_by_customer_id(shop):
+    api = shop
+    api.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    order(api, "c2", ("PEN", 1))             # 300
+    order(api, "c1", ("PEN", 1))             # 300
+    order(api, "c0", ("PEN", 1))             # 300
+    ids = [c["customer_id"] for c in api.insights.handle_top_customers(10).body["customers"]]
+    assert ids == ["c0", "c1", "c2"]
+
+
+def test_top_customers_respects_limit(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("LAMP", 2))
+    body = shop.insights.handle_top_customers(1).body
+    assert [c["customer_id"] for c in body["customers"]] == ["c2"]
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, False, "3", 2.0, None):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400
+        assert "error" in response.body
+
+
+def test_customers_without_orders_in_registration_order(shop):
+    api = shop
+    order(api, "c1", ("BOOK", 1))                 # has a placed order: excluded
+    order(api, "c2", ("PEN", 1))                  # has a placed order: excluded
+    api.customers.handle_register({"customer_id": "c3", "name": "Linus", "email": "l@example.com"})
+    api.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    cancelled = order(api, "c0", ("PEN", 1)).body["order_id"]
+    api.orders.handle_cancel(cancelled)           # only a cancelled order: still included
+    response = api.insights.handle_customers_without_orders()
+    assert response.status == 200
+    # Registration order (c3 before c0), not sorted by id.
+    assert response.body == {"customers": [
+        {"customer_id": "c3", "name": "Linus", "email": "l@example.com"},
+        {"customer_id": "c0", "name": "Zed", "email": "z@example.com"},
+    ]}
+
+
+def test_customers_without_orders_empty_when_all_have_orders(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("PEN", 1))
+    assert shop.insights.handle_customers_without_orders().body == {"customers": []}
+
+
+def test_totals_match_order_summary_including_discount(shop):
+    standard = order(shop, "c1", ("LAMP", 2)).body["order_id"]
+    gold = order(shop, "c2", ("LAMP", 2)).body["order_id"]
+    standard_entry = shop.insights.handle_order_history("c1").body["orders"][0]
+    gold_entry = shop.insights.handle_order_history("c2").body["orders"][0]
+    assert standard_entry == {"order_id": standard, "status": "placed",
+                              "total_cents": shop.orders.handle_get(standard).body["total_cents"]}
+    assert standard_entry["total_cents"] == 10800
+    assert gold_entry == {"order_id": gold, "status": "placed",
+                          "total_cents": shop.orders.handle_get(gold).body["total_cents"]}
+    assert gold_entry["total_cents"] == 10200
