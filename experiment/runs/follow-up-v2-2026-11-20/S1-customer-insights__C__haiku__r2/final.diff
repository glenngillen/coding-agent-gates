diff --git a/src/orders/controllers/customer_insights.py b/src/orders/controllers/customer_insights.py
new file mode 100644
index 0000000..95acfd0
--- /dev/null
+++ b/src/orders/controllers/customer_insights.py
@@ -0,0 +1,53 @@
+"""Customer insight endpoints for the account team."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from orders.application.errors import CustomerNotFound
+from orders.application.order_service import OrderService
+from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
+
+
+class CustomerInsightsController:
+    def __init__(self, orders: OrderService) -> None:
+        self._orders = orders
+
+    def handle_order_history(self, customer_id: str) -> Response:
+        """A customer's orders, newest first, with the total each order reports in its summary."""
+        try:
+            summaries = self._orders.history_for_customer(customer_id)
+        except CustomerNotFound:
+            return not_found("customer")
+        return Response(200, {
+            "customer_id": customer_id,
+            "orders": [{"order_id": s.order.order_id, "status": s.order.status,
+                        "total_cents": s.total_cents} for s in summaries],
+        })
+
+    def handle_lifetime_value(self, customer_id: str) -> Response:
+        """Number of non-cancelled orders and the sum of their totals."""
+        try:
+            value = self._orders.lifetime_value_for_customer(customer_id)
+        except CustomerNotFound:
+            return not_found("customer")
+        return Response(200, {"customer_id": value.customer_id, "order_count": value.order_count,
+                              "lifetime_value_cents": value.lifetime_value_cents})
+
+    def handle_customers_without_orders(self) -> Response:
+        """Registered customers with no orders that are not cancelled, in registration order."""
+        return Response(200, {"customers": [
+            {"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
+            for customer in self._orders.customers_without_orders()]})
+
+    def handle_top_customers(self, limit: Any) -> Response:
+        """Leaderboard of customers by lifetime value, excluding customers with none."""
+        try:
+            limit = require_positive_int(limit, "limit")
+        except InvalidRequest as exc:
+            return bad_request(exc)
+        ranked = self._orders.top_customers(limit)
+        return Response(200, {"customers": [
+            {"customer_id": customer.customer_id, "name": customer.name,
+             "lifetime_value_cents": value.lifetime_value_cents}
+            for customer, value in ranked]})
