diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..7339937
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,86 @@
+def place(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip(shop):
+    oid = place(shop, "c1", ("PEN", 4), ("BOOK", 1)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [{"sku": "PEN", "name": "Pen", "quantity": 4},
+                  {"sku": "BOOK", "name": "Book", "quantity": 1}],
+    }
+
+
+def test_packing_slip_unknown_order(shop):
+    response = shop.fulfilment.handle_packing_slip("nope")
+    assert (response.status, response.body) == (404, {"error": "order not found"})
+
+
+def test_packing_slip_cancelled_order(shop):
+    oid = place(shop, "c1", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "error" in response.body
+
+
+def test_low_stock_sorted_and_strictly_below(shop):
+    shop.catalog.handle_add_product({"sku": "AAA", "name": "Apple", "unit_price_cents": 100, "on_hand": 5})
+    response = shop.fulfilment.handle_low_stock(50)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "AAA", "name": "Apple", "on_hand": 5},
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+    ]}
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_restock_adds_stock_and_is_orderable(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 10})
+    assert (response.status, response.body) == (200, {"sku": "LAMP", "on_hand": 15})
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 15
+    assert place(shop, "c1", ("LAMP", 15)).status == 201
+
+
+def test_restock_unknown_product(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 1})
+    assert (response.status, response.body) == (404, {"error": "product not found"})
+
+
+def test_restock_rejects_invalid_requests_without_change(shop):
+    bad_requests = [{}, {"sku": "", "quantity": 1}, {"sku": 5, "quantity": 1}, {"sku": "PEN"},
+                    {"sku": "PEN", "quantity": 0}, {"sku": "PEN", "quantity": -3},
+                    {"sku": "PEN", "quantity": True}, {"sku": "PEN", "quantity": "2"},
+                    {"sku": "PEN", "quantity": 1.5}, None]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400
+        assert "error" in response.body
+    assert shop.catalog.handle_get("PEN").body["on_hand"] == 100
+
+
+def test_fulfilment_summary(shop):
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+    place(shop, "c1", ("BOOK", 2), ("PEN", 1))
+    place(shop, "c2", ("LAMP", 1))
+    cancelled = place(shop, "c2", ("PEN", 5)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    # LAMP is at 4 (below the line of 5); BOOK and PEN are well above it.
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 4, "low_stock_products": 1}
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1})  # exactly 5: not low
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 0
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, True, "5", 2.5, None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400
+        assert "error" in response.body
