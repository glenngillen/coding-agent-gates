@@ -0,0 +1,26 @@
+"""Operational report calculations for the back office."""
+
+from __future__ import annotations
+
+from collections import Counter
+
+from orders.infrastructure.repository import InMemoryOrderRepository
+
+
+class ReportsService:
+    def __init__(self, orders: InMemoryOrderRepository) -> None:
+        self._orders = orders
+
+    def order_counts(self) -> dict[str, int]:
+        """How many orders exist in each status, keyed in sorted status order."""
+        counts = Counter(order.status for order in self._orders.list_all())
+        return {status: counts[status] for status in sorted(counts)}
+
+    def units_by_sku(self) -> dict[str, int]:
+        """Units ordered per SKU across all orders that are not cancelled, sorted by SKU."""
+        units: Counter[str] = Counter()
+        for order in self._orders.list_all():
+            if order.status != "cancelled":
+                for item in order.items:
+                    units[item.sku] += item.quantity
+        return {sku: units[sku] for sku in sorted(units)}
