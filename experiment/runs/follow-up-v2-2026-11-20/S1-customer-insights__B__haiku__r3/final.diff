@@ -0,0 +1,36 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_lists_customers_with_no_orders_in_registration_order(shop):
+    # shop registers c1, c2; add more in a known order
+    shop.customers.handle_register({"customer_id": "c9", "name": "Edsger", "email": "e@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Alan", "email": "a@example.com"})
+
+    response = shop.insights.handle_customers_without_orders()
+
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"},
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "c9", "name": "Edsger", "email": "e@example.com"},
+        {"customer_id": "c3", "name": "Alan", "email": "a@example.com"},
+    ]}
+
+
+def test_customer_with_only_cancelled_orders_is_included(shop):
+    order(shop, "c1", ("BOOK", 1))
+    cancelled = order(shop, "c2", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+
+    ids = [c["customer_id"] for c in shop.insights.handle_customers_without_orders().body["customers"]]
+
+    assert ids == ["c2"]
+
+
+def test_customer_with_a_live_order_is_excluded(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("PEN", 1))
+
+    assert shop.insights.handle_customers_without_orders().body == {"customers": []}
diff --git a/tests/test_top_customers.py b/tests/test_top_customers.py
new file mode 100644
index 0000000..881b34a
--- /dev/null
+++ b/tests/test_top_customers.py
@@ -0,0 +1,57 @@
+import pytest
+
+
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+@pytest.fixture
+def leaderboard(shop):
+    # c2 (gold): 4 x BOOK = 10000 less 15% -> 8500
+    order(shop, "c2", ("BOOK", 4))
+    # c1: LAMP = 6000
+    order(shop, "c1", ("LAMP", 1))
+    # c3: PEN x 20 = 6000, a tie with c1 on lifetime value
+    shop.customers.handle_register({"customer_id": "c3", "name": "Edsger", "email": "e@example.com"})
+    order(shop, "c3", ("PEN", 20))
+    # c4: only a cancelled order, so lifetime value 0
+    shop.customers.handle_register({"customer_id": "c4", "name": "Barbara", "email": "b@example.com"})
+    cancelled = order(shop, "c4", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    # c5: registered, no orders at all
+    shop.customers.handle_register({"customer_id": "c5", "name": "Alan", "email": "a@example.com"})
+    return shop
+
+
+def test_top_customers_sorted_by_value_then_id_and_excludes_zero(leaderboard):
+    response = leaderboard.insights.handle_top_customers(10)
+
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 8_500},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 6_000},
+        {"customer_id": "c3", "name": "Edsger", "lifetime_value_cents": 6_000},
+    ]}
+
+
+def test_top_customers_respects_limit(leaderboard):
+    ids = [c["customer_id"] for c in leaderboard.insights.handle_top_customers(2).body["customers"]]
+    assert ids == ["c2", "c1"]
+
+
+def test_top_customers_values_match_lifetime_value(leaderboard):
+    for entry in leaderboard.insights.handle_top_customers(10).body["customers"]:
+        lifetime = leaderboard.insights.handle_lifetime_value(entry["customer_id"]).body
+        assert entry["lifetime_value_cents"] == lifetime["lifetime_value_cents"]
+
+
+def test_top_customers_with_no_orders_is_empty(api):
+    assert api.insights.handle_top_customers(5).body == {"customers": []}
+
+
+@pytest.mark.parametrize("limit", [0, -1, True, False, "3", 2.0, None])
+def test_top_customers_rejects_invalid_limit(leaderboard, limit):
+    response = leaderboard.insights.handle_top_customers(limit)
+    assert response.status == 400
+    assert "limit" in response.body["error"]
