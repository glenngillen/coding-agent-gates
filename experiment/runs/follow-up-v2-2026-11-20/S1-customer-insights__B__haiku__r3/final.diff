diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..0b9f913
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,92 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_order_history_unknown_customer_is_404(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_order_history_for_customer_without_orders_is_empty(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_order_history_is_newest_first_and_includes_cancelled(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    second = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    third = order(shop, "c1", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(second)
+
+    response = shop.insights.handle_order_history("c1")
+
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": [
+        {"order_id": third, "status": "placed", "total_cents": 6_000},
+        {"order_id": second, "status": "cancelled", "total_cents": 600},
+        {"order_id": first, "status": "placed", "total_cents": 2_500},
+    ]}
+
+
+def test_order_history_only_lists_that_customers_orders(shop):
+    mine = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    order(shop, "c2", ("BOOK", 1))
+
+    orders = shop.insights.handle_order_history("c1").body["orders"]
+
+    assert [o["order_id"] for o in orders] == [mine]
+
+
+def test_order_history_totals_match_order_summary_including_discount(shop):
+    # 4 x 2500 = 10000 reaches the discount threshold; gold customer gets 15% off.
+    big = order(shop, "c2", ("BOOK", 4)).body["order_id"]
+    small = order(shop, "c2", ("PEN", 1)).body["order_id"]
+
+    entries = {o["order_id"]: o for o in shop.insights.handle_order_history("c2").body["orders"]}
+
+    assert entries[big]["total_cents"] == shop.orders.handle_get(big).body["total_cents"] == 8_500
+    assert entries[small]["total_cents"] == shop.orders.handle_get(small).body["total_cents"] == 300
+
+
+def test_lifetime_value_unknown_customer_is_404(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_for_customer_without_orders_is_zero(shop):
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_orders(shop):
+    order(shop, "c1", ("BOOK", 1))                              # 2500
+    cancelled = order(shop, "c1", ("PEN", 2)).body["order_id"]  # 600, cancelled
+    order(shop, "c1", ("LAMP", 1))                              # 6000
+    shop.orders.handle_cancel(cancelled)
+
+    response = shop.insights.handle_lifetime_value("c1")
+
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 2, "lifetime_value_cents": 8_500}
+
+
+def test_lifetime_value_uses_discounted_totals(shop):
+    # 4 x 2500 = 10000 reaches the threshold; gold gets 15% off -> 8500. Plus a 300 pen order.
+    order(shop, "c2", ("BOOK", 4))
+    order(shop, "c2", ("PEN", 1))
+
+    response = shop.insights.handle_lifetime_value("c2")
+
+    assert response.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": 8_800}
+
+
+def test_lifetime_value_only_counts_that_customers_orders(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("LAMP", 1))
+
+    assert shop.insights.handle_lifetime_value("c1").body["lifetime_value_cents"] == 2_500
diff --git a/tests/test_customers_without_orders.py b/tests/test_customers_without_orders.py
