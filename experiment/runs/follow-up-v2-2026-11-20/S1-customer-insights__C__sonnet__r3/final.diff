diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..0f82e3a
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,96 @@
+def _order(api, cid, sku, qty=1):
+    return api.orders.handle_create({"customer_id": cid, "items": [{"sku": sku, "quantity": qty}]}).body["order_id"]
+
+
+def test_unknown_customer(shop):
+    r = shop.insights.handle_order_history("nope")
+    assert r.status == 404 and r.body == {"error": "customer not found"}
+
+
+def test_empty_history(shop):
+    r = shop.insights.handle_order_history("c1")
+    assert r.status == 200 and r.body == {"customer_id": "c1", "orders": []}
+
+
+def test_history_newest_first_with_totals_and_cancelled(shop):
+    a = _order(shop, "c2", "BOOK", 2)
+    b = _order(shop, "c2", "LAMP", 3)
+    _order(shop, "c1", "PEN")
+    shop.orders.handle_cancel(a)
+    r = shop.insights.handle_order_history("c2")
+    assert r.status == 200
+    assert [o["order_id"] for o in r.body["orders"]] == [b, a]
+    assert r.body["orders"][1]["status"] == "cancelled"
+    for o in r.body["orders"]:
+        assert o["total_cents"] == shop.orders.handle_get(o["order_id"]).body["total_cents"]
+
+
+import pytest
+
+
+@pytest.mark.parametrize("bad", [0, -1, True, False, "3", 2.0, None])
+def test_top_customers_rejects_bad_limit(shop, bad):
+    r = shop.insights.handle_top_customers(bad)
+    assert r.status == 400 and "error" in r.body
+
+
+def test_top_customers_ranking_limit_and_exclusions(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Linus", "email": "l@example.com"})
+    shop.customers.handle_register({"customer_id": "c4", "name": "NoOrders", "email": "n@example.com"})
+    _order(shop, "c3", "PEN", 2)  # 600
+    _order(shop, "c1", "PEN", 2)  # 600, ties with c3, sorts first by id
+    shop.orders.handle_cancel(_order(shop, "c0", "PEN"))  # only cancelled -> 0, excluded
+    _order(shop, "c2", "LAMP", 2)  # 12000 less 15% gold discount = 10200
+    full = shop.insights.handle_top_customers(10)
+    assert full.status == 200
+    assert full.body["customers"] == [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 10_200},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 600},
+        {"customer_id": "c3", "name": "Linus", "lifetime_value_cents": 600},
+    ]
+    top2 = shop.insights.handle_top_customers(2).body["customers"]
+    assert [c["customer_id"] for c in top2] == ["c2", "c1"]
+
+
+def test_customers_without_orders(shop):
+    shop.customers.handle_register({"customer_id": "c3", "name": "Linus", "email": "l@example.com"})
+    shop.customers.handle_register({"customer_id": "c4", "name": "Edsger", "email": "e@example.com"})
+    _order(shop, "c2", "PEN")
+    shop.orders.handle_cancel(_order(shop, "c3", "PEN"))  # only cancelled: still counts as none
+    r = shop.insights.handle_customers_without_orders()
+    assert r.status == 200
+    assert r.body == {"customers": [
+        {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"},
+        {"customer_id": "c3", "name": "Linus", "email": "l@example.com"},
+        {"customer_id": "c4", "name": "Edsger", "email": "e@example.com"},
+    ]}
+
+
+def test_customers_without_orders_empty(shop):
+    _order(shop, "c1", "PEN")
+    _order(shop, "c2", "PEN")
+    assert shop.insights.handle_customers_without_orders().body == {"customers": []}
+
+
+def test_lifetime_value_unknown_customer(shop):
+    r = shop.insights.handle_lifetime_value("nope")
+    assert r.status == 404 and r.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_no_orders(shop):
+    r = shop.insights.handle_lifetime_value("c1")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_and_uses_discounted_totals(shop):
+    a = _order(shop, "c2", "BOOK", 2)
+    b = _order(shop, "c2", "LAMP", 3)
+    c = _order(shop, "c2", "PEN", 10)
+    _order(shop, "c1", "PEN")
+    shop.orders.handle_cancel(a)
+    expected = sum(shop.orders.handle_get(i).body["total_cents"] for i in (b, c))
+    r = shop.insights.handle_lifetime_value("c2")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": expected}
