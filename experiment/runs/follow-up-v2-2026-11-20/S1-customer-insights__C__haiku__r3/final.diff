diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..6140a5a
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,133 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_unknown_customer_is_404(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_customer_with_no_orders_gets_empty_list(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_orders_are_newest_first_and_only_for_that_customer(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    order(shop, "c2", ("PEN", 1))
+    second = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    body = shop.insights.handle_order_history("c1").body
+    assert [o["order_id"] for o in body["orders"]] == [second, first]
+
+
+def test_total_matches_order_summary_including_discount(shop):
+    big = order(shop, "c2", ("LAMP", 2)).body["order_id"]  # gold: 15% off 12000
+    small = order(shop, "c2", ("PEN", 1)).body["order_id"]
+    body = shop.insights.handle_order_history("c2").body
+    by_id = {o["order_id"]: o for o in body["orders"]}
+    assert by_id[big] == {"order_id": big, "status": "placed", "total_cents": 10200}
+    assert by_id[big]["total_cents"] == shop.orders.handle_get(big).body["total_cents"]
+    assert by_id[small]["total_cents"] == shop.orders.handle_get(small).body["total_cents"] == 300
+
+
+def test_cancelled_orders_are_included_with_status(shop):
+    oid = order(shop, "c1", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    body = shop.insights.handle_order_history("c1").body
+    assert body["orders"] == [{"order_id": oid, "status": "cancelled", "total_cents": 6000}]
+
+
+def test_insights_is_exposed_on_api(api):
+    assert api.insights.handle_order_history("nobody").status == 404
+
+
+def test_lifetime_value_unknown_customer_is_404(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_with_no_orders_is_zero(shop):
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_sums_totals_and_excludes_cancelled(shop):
+    big = order(shop, "c2", ("LAMP", 2)).body["order_id"]  # gold: 12000 - 15% = 10200
+    small = order(shop, "c2", ("PEN", 1)).body["order_id"]  # 300, no discount
+    cancelled = order(shop, "c2", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    response = shop.insights.handle_lifetime_value("c2")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": 10500}
+    total = shop.orders.handle_get(big).body["total_cents"] + shop.orders.handle_get(small).body["total_cents"]
+    assert response.body["lifetime_value_cents"] == total
+
+
+def test_lifetime_value_is_scoped_to_customer(shop):
+    order(shop, "c1", ("PEN", 1))
+    order(shop, "c2", ("PEN", 4))
+    assert shop.insights.handle_lifetime_value("c1").body["lifetime_value_cents"] == 300
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, False, "3", None, 2.0):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400
+        assert "limit" in response.body["error"]
+
+
+def test_top_customers_ranks_by_value_then_id_and_skips_zero(shop):
+    order(shop, "c1", ("LAMP", 1))  # c1: 6000
+    order(shop, "c2", ("PEN", 1))  # c2: 300
+    order(shop, "c2", ("LAMP", 2))  # c2: +10200 (gold discount) -> 10500
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Cy", "email": "c@example.com"})
+    order(shop, "c3", ("PEN", 2))  # c3: 600
+    cancelled = order(shop, "c0", ("PEN", 1)).body["order_id"]  # c0 only has a cancelled order -> 0
+    shop.orders.handle_cancel(cancelled)
+    body = shop.insights.handle_top_customers(10).body
+    assert body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 10500},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 6000},
+        {"customer_id": "c3", "name": "Cy", "lifetime_value_cents": 600},
+    ]}
+
+
+def test_top_customers_breaks_ties_by_customer_id(shop):
+    order(shop, "c2", ("PEN", 1))
+    order(shop, "c1", ("PEN", 1))
+    ids = [c["customer_id"] for c in shop.insights.handle_top_customers(5).body["customers"]]
+    assert ids == ["c1", "c2"]
+
+
+def test_top_customers_limit_truncates(shop):
+    order(shop, "c1", ("LAMP", 1))
+    order(shop, "c2", ("PEN", 1))
+    body = shop.insights.handle_top_customers(1).body
+    assert [c["customer_id"] for c in body["customers"]] == ["c1"]
+
+
+def test_customers_without_orders_in_registration_order(shop):
+    shop.customers.handle_register({"customer_id": "c3", "name": "Cy", "email": "c@example.com"})
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    order(shop, "c1", ("PEN", 1))  # c1 has an active order
+    cancelled = order(shop, "c3", ("PEN", 1)).body["order_id"]  # c3 has only a cancelled order
+    shop.orders.handle_cancel(cancelled)
+    response = shop.insights.handle_customers_without_orders()
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "c3", "name": "Cy", "email": "c@example.com"},
+        {"customer_id": "c0", "name": "Zed", "email": "z@example.com"},
+    ]}
+
+
+def test_customers_without_orders_empty_when_everyone_ordered(shop):
+    order(shop, "c1", ("PEN", 1))
+    order(shop, "c2", ("PEN", 1))
+    assert shop.insights.handle_customers_without_orders().body == {"customers": []}
