diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..9e1965d
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,139 @@
+def place(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order_with_catalogue_names(shop):
+    oid = place(shop, "c1", ("PEN", 4), ("BOOK", 2)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 4},
+            {"sku": "BOOK", "name": "Book", "quantity": 2},
+        ],
+    }
+
+
+def test_packing_slip_names_the_customer_on_the_order(shop):
+    oid = place(shop, "c2", ("LAMP", 1)).body["order_id"]
+    body = shop.fulfilment.handle_packing_slip(oid).body
+    assert body["customer_name"] == "Grace"
+    assert body["lines"] == [{"sku": "LAMP", "name": "Lamp", "quantity": 1}]
+
+
+def test_packing_slip_unknown_order_is_404(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_for_cancelled_order_is_409(shop):
+    oid = place(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "cancelled" in response.body["error"]
+
+
+def test_low_stock_lists_active_products_below_threshold_lowest_first(shop):
+    shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 500, "on_hand": 3})
+    shop.catalog.handle_add_product({"sku": "AAA", "name": "Aaa", "unit_price_cents": 500, "on_hand": 3})
+    response = shop.fulfilment.handle_low_stock(60)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "AAA", "name": "Aaa", "on_hand": 3},
+        {"sku": "CUP", "name": "Cup", "on_hand": 3},
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+        {"sku": "BOOK", "name": "Book", "on_hand": 50},
+    ]}
+
+
+def test_low_stock_threshold_is_strict(shop):
+    body = shop.fulfilment.handle_low_stock(5).body
+    assert body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_reflects_orders_placed(shop):
+    place(shop, "c1", ("LAMP", 3))
+    body = shop.fulfilment.handle_low_stock(3).body
+    assert body == {"products": [{"sku": "LAMP", "name": "Lamp", "on_hand": 2}]}
+
+
+def test_low_stock_excludes_inactive_products(shop):
+    from orders.application.fulfilment_service import FulfilmentService
+    from orders.domain.catalog import Product
+    from orders.infrastructure.catalog import InMemoryProductCatalog
+    from orders.infrastructure.customers import InMemoryCustomerRepository
+    from orders.infrastructure.repository import InMemoryOrderRepository
+    from orders.infrastructure.stock import InMemoryStockRepository
+
+    catalog = InMemoryProductCatalog()
+    stock = InMemoryStockRepository()
+    catalog.add(Product("OLD", "Old", 100, active=False))
+    stock.set("OLD", 0)
+    catalog.add(Product("NEW", "New", 100))
+    stock.set("NEW", 1)
+    service = FulfilmentService(InMemoryOrderRepository(), InMemoryCustomerRepository(), catalog, stock)
+    assert [(p.sku, p.on_hand) for p in service.low_stock(10)] == [("NEW", 1)]
+
+
+def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+    place(shop, "c1", ("BOOK", 2))
+    cancelled = place(shop, "c2", ("PEN", 3)).body["order_id"]
+    place(shop, "c1", ("LAMP", 4))  # leaves LAMP with 1 on hand, below the line
+    shop.orders.handle_cancel(cancelled)
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 6, "low_stock_products": 1}
+
+
+def test_fulfilment_summary_low_stock_line_is_strictly_below_five(shop):
+    shop.catalog.handle_add_product({"sku": "FIVE", "name": "Five", "unit_price_cents": 1, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "FOUR", "name": "Four", "unit_price_cents": 1, "on_hand": 4})
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 1
+
+
+def test_restock_adds_to_stock_and_units_are_orderable(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 4})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 9}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 9
+    assert place(shop, "c1", ("LAMP", 9)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 0
+
+
+def test_restock_rejects_invalid_request_without_change(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -2},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP", "quantity": "3"},
+        {"sku": "LAMP"},
+    ]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_restock_unknown_product_is_404(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 2})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, True, False, "3", 1.5, None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400, bad
+        assert "threshold" in response.body["error"]
