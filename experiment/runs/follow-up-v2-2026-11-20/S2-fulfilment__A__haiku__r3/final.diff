diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..547bfe5
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,121 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order_with_catalogue_names(shop):
+    oid = order(shop, "c2", ("PEN", 4), ("BOOK", 1)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Grace",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 4},
+            {"sku": "BOOK", "name": "Book", "quantity": 1},
+        ],
+    }
+
+
+def test_packing_slip_unknown_order_is_404(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_for_cancelled_order_is_409(shop):
+    oid = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "cancelled" in response.body["error"]
+
+
+def test_low_stock_is_strictly_below_threshold_sorted_by_stock_then_sku(shop):
+    # shop has BOOK=50, LAMP=5, PEN=100. Add two more to exercise ordering and ties.
+    shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 800, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "APP", "name": "Apple", "unit_price_cents": 50, "on_hand": 2})
+
+    response = shop.fulfilment.handle_low_stock(6)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "APP", "name": "Apple", "on_hand": 2},
+        {"sku": "CUP", "name": "Cup", "on_hand": 5},
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+    ]}
+
+
+def test_low_stock_excludes_products_at_threshold(shop):
+    shop.catalog.handle_add_product({"sku": "APP", "name": "Apple", "unit_price_cents": 50, "on_hand": 2})
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": [
+        {"sku": "APP", "name": "Apple", "on_hand": 2},
+    ]}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_reflects_stock_after_orders(shop):
+    order(shop, "c1", ("LAMP", 3))
+    assert shop.fulfilment.handle_low_stock(3).body == {"products": [
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 2},
+    ]}
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, True, "3", 1.5, None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400, bad
+        assert "threshold" in response.body["error"]
+
+
+def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
+    # shop: BOOK=50, LAMP=5 (not low: line is strictly below 5), PEN=100.
+    order(shop, "c1", ("BOOK", 2), ("PEN", 1))        # 3 units, open
+    order(shop, "c2", ("LAMP", 4))                    # 4 units, open -> LAMP drops to 1 (low)
+    cancelled = order(shop, "c1", ("PEN", 10)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)              # cancelled: excluded everywhere
+    shop.catalog.handle_add_product({"sku": "APP", "name": "Apple", "unit_price_cents": 50, "on_hand": 4})
+
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    # open orders: 2; units: 2+1+4 = 7; low stock (<5): LAMP=1, APP=4 -> 2
+    assert response.body == {"open_orders": 2, "units_to_pick": 7, "low_stock_products": 2}
+
+
+def test_fulfilment_summary_empty_shop(api):
+    assert api.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0,
+    }
+
+
+def test_restock_adds_to_stock_and_is_orderable_immediately(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 3})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 8}
+    assert order(shop, "c1", ("LAMP", 8)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 0
+
+
+def test_restock_unknown_product_is_404_and_changes_nothing(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 3})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_restock_rejects_invalid_input_without_change(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -2},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP", "quantity": "2"},
+        {"sku": "LAMP", "quantity": 1.0},
+        {"sku": "LAMP"},
+    ]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
