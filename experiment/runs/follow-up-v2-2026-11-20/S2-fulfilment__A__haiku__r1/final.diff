diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..a96cc60
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,131 @@
+def order(api, customer_id="c1", *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order_with_catalogue_names(shop):
+    oid = order(shop, "c2", ("PEN", 3), ("BOOK", 1), ("LAMP", 2)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Grace",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 3},
+            {"sku": "BOOK", "name": "Book", "quantity": 1},
+            {"sku": "LAMP", "name": "Lamp", "quantity": 2},
+        ],
+    }
+
+
+def test_packing_slip_for_unknown_order_is_404(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_for_cancelled_order_is_409(shop):
+    oid = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "cancelled" in response.body["error"]
+
+
+def test_low_stock_is_strictly_below_threshold_sorted_by_on_hand(shop):
+    # shop: BOOK 50, LAMP 5, PEN 100
+    response = shop.fulfilment.handle_low_stock(60)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+        {"sku": "BOOK", "name": "Book", "on_hand": 50},
+    ]}
+
+
+def test_low_stock_is_strict_at_the_threshold(shop):
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_low_stock_breaks_ties_by_sku(shop):
+    shop.catalog.handle_add_product({"sku": "ZED", "name": "Zed", "unit_price_cents": 100, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "ABC", "name": "Abc", "unit_price_cents": 100, "on_hand": 5})
+    body = shop.fulfilment.handle_low_stock(10).body
+    assert [p["sku"] for p in body["products"]] == ["ABC", "LAMP", "ZED"]
+
+
+def test_low_stock_reflects_orders_and_cancellations(shop):
+    oid = order(shop, "c1", ("LAMP", 4)).body["order_id"]  # LAMP drops to 1
+    assert [p["sku"] for p in shop.fulfilment.handle_low_stock(2).body["products"]] == ["LAMP"]
+    shop.orders.handle_cancel(oid)  # LAMP back to 5
+    assert shop.fulfilment.handle_low_stock(2).body == {"products": []}
+
+
+def test_restock_adds_to_on_hand(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 7})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 12}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 12
+
+
+def test_restocked_units_are_orderable_straight_away(shop):
+    assert order(shop, "c1", ("LAMP", 6)).status == 409
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1})
+    assert order(shop, "c1", ("LAMP", 6)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 0
+
+
+def test_restock_unknown_product_is_404_and_changes_nothing(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 3})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_restock_rejects_invalid_requests_without_change(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -2},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP", "quantity": "3"},
+        {"sku": "LAMP", "quantity": 1.0},
+        {"sku": "LAMP"},
+    ]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
+    # shop: BOOK 50, LAMP 5, PEN 100 -> nothing is below the low-stock line of 5 yet
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+
+    order(shop, "c1", ("BOOK", 2), ("PEN", 3))          # 5 units
+    cancelled = order(shop, "c2", ("LAMP", 1)).body["order_id"]  # 1 unit, then cancelled
+    shop.orders.handle_cancel(cancelled)
+    order(shop, "c1", ("LAMP", 3))                       # 3 units; LAMP drops to 2 -> low stock
+
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 8, "low_stock_products": 1}
+
+
+def test_fulfilment_summary_low_stock_is_strictly_below_five(shop):
+    shop.catalog.handle_add_product({"sku": "FIVE", "name": "Five", "unit_price_cents": 100, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "FOUR", "name": "Four", "unit_price_cents": 100, "on_hand": 4})
+    # LAMP and FIVE sit exactly on the line (5) and do not count; only FOUR is below it.
+    body = shop.fulfilment.handle_fulfilment_summary().body
+    assert body["low_stock_products"] == 1
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, True, False, "3", 2.5, None):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400
+        assert "threshold" in response.body["error"]
