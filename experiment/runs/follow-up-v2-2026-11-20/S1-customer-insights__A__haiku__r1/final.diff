+    def order_history(self, customer_id: str) -> list[OrderSummary]:
+        """Summaries (including totals and discounts) for a customer, newest first.
+
+        Cancelled orders are included.
+        """
+        return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
+
+    def lifetime_value(self, customer_id: str) -> LifetimeValue:
+        """Count and total of a customer's orders, excluding cancelled ones."""
+        active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
