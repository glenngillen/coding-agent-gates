diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..5040b00
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,121 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order_with_catalogue_names(shop):
+    oid = order(shop, "c1", ("PEN", 3), ("BOOK", 1), ("LAMP", 2)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 3},
+            {"sku": "BOOK", "name": "Book", "quantity": 1},
+            {"sku": "LAMP", "name": "Lamp", "quantity": 2},
+        ],
+    }
+
+
+def test_packing_slip_uses_customer_name_for_the_ordering_customer(shop):
+    oid = order(shop, "c2", ("BOOK", 1)).body["order_id"]
+    assert shop.fulfilment.handle_packing_slip(oid).body["customer_name"] == "Grace"
+
+
+def test_packing_slip_unknown_order_is_404(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_cancelled_order_is_409(shop):
+    oid = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert "cancelled" in response.body["error"]
+
+
+def test_packing_slip_does_not_change_stock(shop):
+    oid = order(shop, "c1", ("LAMP", 2)).body["order_id"]
+    shop.fulfilment.handle_packing_slip(oid)
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 3
+
+
+def test_low_stock_strictly_below_threshold_sorted_by_on_hand_then_sku(shop):
+    shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 800, "on_hand": 2})
+    shop.catalog.handle_add_product({"sku": "APP", "name": "Apple", "unit_price_cents": 50, "on_hand": 2})
+    # LAMP has 5 on hand, so it is not below a threshold of 5; PEN (100) and BOOK (50) are not low.
+    response = shop.fulfilment.handle_low_stock(5)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "APP", "name": "Apple", "on_hand": 2},
+        {"sku": "CUP", "name": "Cup", "on_hand": 2},
+    ]}
+
+
+def test_low_stock_zero_threshold_returns_nothing(shop):
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+
+
+def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
+    order(shop, "c1", ("BOOK", 2), ("PEN", 1))
+    order(shop, "c2", ("LAMP", 1))  # leaves LAMP at 4, below the low-stock line
+    cancelled = order(shop, "c2", ("PEN", 5)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 4, "low_stock_products": 1}
+
+
+def test_fulfilment_summary_on_fresh_shop(shop):
+    # Every product starts at or above the line (LAMP is exactly 5, which is not below it).
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+
+
+def test_restock_adds_to_on_hand_and_returns_new_level(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 4})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 9}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 9
+
+
+def test_restocked_units_are_orderable_immediately(shop):
+    assert order(shop, "c1", ("LAMP", 6)).status == 409  # only 5 on hand
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 3})
+    assert order(shop, "c1", ("LAMP", 6)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 2
+
+
+def test_restock_unknown_product_is_404(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 1})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+
+
+def test_restock_invalid_input_is_400_and_changes_nothing(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -2},
+        {"sku": "LAMP", "quantity": "3"},
+        {"sku": "LAMP", "quantity": 1.0},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP"},
+    ]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, "5", None, 2.0, True, False):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400, bad
+        assert "threshold" in response.body["error"]
