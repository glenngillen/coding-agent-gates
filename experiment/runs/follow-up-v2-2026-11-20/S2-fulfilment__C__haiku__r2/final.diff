+"""Warehouse fulfilment: packing slips for placed orders."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from orders.application.catalog_service import CatalogService
+from orders.application.customer_service import CustomerService
+from orders.application.errors import Conflict
+from orders.application.order_service import OrderService
+
+
+@dataclass(frozen=True)
+class PackingSlipLine:
+    sku: str
+    name: str
+    quantity: int
+
+
+@dataclass(frozen=True)
+class PackingSlip:
+    order_id: str
+    customer_name: str
+    lines: tuple[PackingSlipLine, ...]
+
+
+@dataclass(frozen=True)
+class LowStockProduct:
+    sku: str
+    name: str
+    on_hand: int
+
+
+@dataclass(frozen=True)
+class FulfilmentSummary:
+    open_orders: int
+    units_to_pick: int
+    low_stock_products: int
+
+
+# The warehouse's low-stock line: products with fewer units than this on hand are low.
+LOW_STOCK_LINE = 5
+
+
+class FulfilmentService:
+    def __init__(self, orders: OrderService, customers: CustomerService, catalog: CatalogService) -> None:
+        self._orders = orders
+        self._customers = customers
+        self._catalog = catalog
+
+    def packing_slip(self, order_id: str) -> PackingSlip:
+        """Packing slip for an order. Cancelled orders are not packed."""
+        order = self._orders.get_order(order_id)  # raises OrderNotFound
+        if order.status == "cancelled":
+            raise Conflict(f"order {order_id} is cancelled and cannot be packed")
+        customer = self._customers.get(order.customer_id)
+        lines = tuple(
+            PackingSlipLine(item.sku, self._catalog.get_product(item.sku).name, item.quantity)
+            for item in order.items
+        )
+        return PackingSlip(order.order_id, customer.name, lines)
+
+    def summary(self) -> FulfilmentSummary:
+        """Open (not cancelled) orders, units across them, and active products below the low-stock line."""
+        open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
+        units = sum(item.quantity for order in open_orders for item in order.items)
+        low = self.low_stock(LOW_STOCK_LINE)
+        return FulfilmentSummary(len(open_orders), units, len(low))
+
+    def restock(self, sku: str, quantity: int) -> int:
+        """Add units to a product's stock; returns the new on-hand level."""
+        return self._catalog.restock(sku, quantity)  # raises ProductNotFound
+
+    def low_stock(self, threshold: int) -> list[LowStockProduct]:
+        """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
+        rows = []
+        for product in self._catalog.list_active():
+            on_hand = self._catalog.on_hand(product.sku)
+            if on_hand < threshold:
+                rows.append(LowStockProduct(product.sku, product.name, on_hand))
+        return sorted(rows, key=lambda row: (row.on_hand, row.sku))
