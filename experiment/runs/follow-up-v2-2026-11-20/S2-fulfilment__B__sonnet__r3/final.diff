diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..788c149
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,96 @@
+def _place(shop, items):
+    return shop.orders.handle_create({"customer_id": "c1", "items": items}).body["order_id"]
+
+
+def test_packing_slip(shop):
+    oid = _place(shop, [{"sku": "PEN", "quantity": 3}, {"sku": "BOOK", "quantity": 1}])
+    resp = shop.fulfilment.handle_packing_slip(oid)
+    assert resp.status == 200
+    assert resp.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [{"sku": "PEN", "name": "Pen", "quantity": 3},
+                  {"sku": "BOOK", "name": "Book", "quantity": 1}],
+    }
+
+
+def test_packing_slip_unknown_order(shop):
+    resp = shop.fulfilment.handle_packing_slip("nope")
+    assert (resp.status, resp.body) == (404, {"error": "order not found"})
+
+
+def test_low_stock_sorted_and_strict(shop):
+    shop.catalog.handle_add_product({"sku": "AAA", "name": "Aaa", "unit_price_cents": 100, "on_hand": 5})
+    shop.catalog.handle_add_product({"sku": "ZZZ", "name": "Zzz", "unit_price_cents": 100, "on_hand": 5})
+    resp = shop.fulfilment.handle_low_stock(51)
+    assert resp.status == 200
+    assert [p["sku"] for p in resp.body["products"]] == ["AAA", "LAMP", "ZZZ", "BOOK"]
+    assert resp.body["products"][0] == {"sku": "AAA", "name": "Aaa", "on_hand": 5}
+    assert shop.fulfilment.handle_low_stock(0).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+
+
+def test_low_stock_excludes_inactive():
+    from orders.application.fulfilment_service import FulfilmentService
+    from orders.domain.catalog import Product
+    from orders.infrastructure.catalog import InMemoryProductCatalog
+    from orders.infrastructure.stock import InMemoryStockRepository
+    catalog, stock = InMemoryProductCatalog(), InMemoryStockRepository()
+    catalog.add(Product("OLD", "Old", 100, False))
+    catalog.add(Product("NEW", "New", 100))
+    service = FulfilmentService(None, None, catalog, stock)
+    assert [i.sku for i in service.low_stock(10)] == ["NEW"]
+
+
+def test_low_stock_invalid_threshold(shop):
+    for bad in (-1, True, "5", 1.5, None):
+        resp = shop.fulfilment.handle_low_stock(bad)
+        assert resp.status == 400 and "error" in resp.body
+
+
+def test_restock_adds_stock_and_is_orderable(shop):
+    resp = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 10})
+    assert (resp.status, resp.body) == (200, {"sku": "LAMP", "on_hand": 15})
+    assert shop.orders.handle_create(
+        {"customer_id": "c1", "items": [{"sku": "LAMP", "quantity": 15}]}).status == 201
+    assert shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1}).body["on_hand"] == 1
+
+
+def test_restock_unknown_product(shop):
+    resp = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 1})
+    assert (resp.status, resp.body) == (404, {"error": "product not found"})
+
+
+def test_restock_invalid_requests_change_nothing(shop):
+    for bad in ({}, {"sku": "", "quantity": 1}, {"sku": 1, "quantity": 1}, {"sku": "LAMP"},
+                {"sku": "LAMP", "quantity": 0}, {"sku": "LAMP", "quantity": -1},
+                {"sku": "LAMP", "quantity": True}, {"sku": "LAMP", "quantity": "2"}):
+        resp = shop.fulfilment.handle_restock(bad)
+        assert resp.status == 400 and "error" in resp.body
+    assert shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1}).body["on_hand"] == 6
+
+
+def test_fulfilment_summary_empty(api):
+    resp = api.fulfilment.handle_fulfilment_summary()
+    assert (resp.status, resp.body) == (200, {"open_orders": 0, "units_to_pick": 0,
+                                              "low_stock_products": 0})
+
+
+def test_fulfilment_summary(shop):
+    _place(shop, [{"sku": "PEN", "quantity": 3}, {"sku": "BOOK", "quantity": 2}])
+    _place(shop, [{"sku": "PEN", "quantity": 4}])
+    cancelled = _place(shop, [{"sku": "BOOK", "quantity": 10}])
+    shop.orders.handle_cancel(cancelled)
+    # LAMP has 5 on hand (not below the line); take it to 4.
+    _place(shop, [{"sku": "LAMP", "quantity": 1}])
+    resp = shop.fulfilment.handle_fulfilment_summary()
+    assert resp.status == 200
+    assert resp.body == {"open_orders": 3, "units_to_pick": 10, "low_stock_products": 1}
+
+
+def test_packing_slip_cancelled_order(shop):
+    oid = _place(shop, [{"sku": "PEN", "quantity": 1}])
+    shop.orders.handle_cancel(oid)
+    resp = shop.fulfilment.handle_packing_slip(oid)
+    assert resp.status == 409
+    assert "error" in resp.body
