@@ -0,0 +1,55 @@
+"""Fulfilment endpoints for the warehouse."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
+from orders.application.fulfilment_service import FulfilmentService
+from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
+                                     require_non_negative_int, require_positive_int, require_str)
+
+
+class FulfilmentController:
+    def __init__(self, service: FulfilmentService) -> None:
+        self._service = service
+
+    def handle_fulfilment_summary(self) -> Response:
+        summary = self._service.summary()
+        return Response(200, {"open_orders": summary.open_orders,
+                              "units_to_pick": summary.units_to_pick,
+                              "low_stock_products": summary.low_stock_products})
+
+    def handle_restock(self, request: dict[str, Any]) -> Response:
+        try:
+            sku = require_str(request, "sku")
+            quantity = require_positive_int(request.get("quantity"), "quantity")
+        except InvalidRequest as exc:
+            return bad_request(exc)
+        try:
+            on_hand = self._service.restock(sku, quantity)
+        except ProductNotFound:
+            return not_found("product")
+        return Response(200, {"sku": sku, "on_hand": on_hand})
+
+    def handle_low_stock(self, threshold: object) -> Response:
+        try:
+            limit = require_non_negative_int(threshold, "threshold")
+        except InvalidRequest as exc:
+            return bad_request(exc)
+        items = self._service.low_stock(limit)
+        return Response(200, {"products": [{"sku": i.sku, "name": i.name, "on_hand": i.on_hand}
+                                           for i in items]})
+
+    def handle_packing_slip(self, order_id: str) -> Response:
+        try:
+            slip = self._service.packing_slip(order_id)
+        except OrderNotFound:
+            return not_found("order")
+        except Conflict as exc:
+            return conflict(exc)
+        return Response(200, {
+            "order_id": slip.order_id,
+            "customer_name": slip.customer_name,
+            "lines": [{"sku": l.sku, "name": l.name, "quantity": l.quantity} for l in slip.lines],
+        })
