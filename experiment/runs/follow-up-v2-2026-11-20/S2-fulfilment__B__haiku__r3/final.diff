+++ b/src/orders/application/fulfilment_service.py
@@ -0,0 +1,67 @@
+"""Warehouse fulfilment: packing slips for placed orders."""
+
+from __future__ import annotations
+
+from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
+from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
+from orders.infrastructure.catalog import InMemoryProductCatalog
+from orders.infrastructure.customers import InMemoryCustomerRepository
+from orders.infrastructure.repository import InMemoryOrderRepository
+from orders.infrastructure.stock import InMemoryStockRepository
+
+LOW_STOCK_LINE = 5
+"""Units on hand below which a product counts as low stock."""
+
+
+class FulfilmentService:
+    def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
+                 catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
+        self._orders = orders
+        self._customers = customers
+        self._catalog = catalog
+        self._stock = stock
+
+    def low_stock(self, threshold: int) -> list[LowStockProduct]:
+        """Active products with stock strictly below ``threshold``, lowest stock first, then SKU."""
+        rows = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
+                for p in self._catalog.list_all() if p.active]
+        rows = [row for row in rows if row.on_hand < threshold]
+        return sorted(rows, key=lambda row: (row.on_hand, row.sku))
+
+    def summary(self) -> FulfilmentSummary:
+        """Open (not cancelled) orders, units to pick across them, and low-stock product count."""
+        open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
+        units = sum(item.quantity for order in open_orders for item in order.items)
+        return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
+
+    def restock(self, sku: str, quantity: int) -> int:
+        """Add ``quantity`` units to a product's stock; returns the new level.
+
+        Stock is shared with order placement, so the units are orderable immediately.
+        """
+        if self._catalog.get(sku) is None:
+            raise ProductNotFound(sku)
+        new_level = self._stock.get(sku) + quantity
+        self._stock.set(sku, new_level)
+        return new_level
+
+    def packing_slip(self, order_id: str) -> PackingSlip:
+        """Packing slip for an order, lines in the order's item order.
+
+        Cancelled orders are not packed, so they have no packing slip.
+        """
+        order = self._orders.get(order_id)
+        if order is None:
+            raise OrderNotFound(order_id)
+        if order.status == "cancelled":
+            raise Conflict(f"order {order_id} is cancelled")
+        customer = self._customers.get(order.customer_id)
+        if customer is None:
+            raise CustomerNotFound(order.customer_id)
+        lines = []
+        for item in order.items:
+            product = self._catalog.get(item.sku)
+            if product is None:
+                raise ProductNotFound(item.sku)
+            lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
+        return PackingSlip(order.order_id, customer.name, tuple(lines))
