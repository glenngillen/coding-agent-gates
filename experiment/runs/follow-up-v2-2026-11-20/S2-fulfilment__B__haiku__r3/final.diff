diff --git a/tests/test_fulfilment.py b/tests/test_fulfilment.py
new file mode 100644
index 0000000..efc8c78
--- /dev/null
+++ b/tests/test_fulfilment.py
@@ -0,0 +1,137 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_packing_slip_lists_lines_in_item_order_with_catalogue_names(shop):
+    oid = order(shop, "c1", ("PEN", 1), ("BOOK", 2)).body["order_id"]
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 200
+    assert response.body == {
+        "order_id": oid,
+        "customer_name": "Ada",
+        "lines": [
+            {"sku": "PEN", "name": "Pen", "quantity": 1},
+            {"sku": "BOOK", "name": "Book", "quantity": 2},
+        ],
+    }
+
+
+def test_packing_slip_unknown_order_is_404(shop):
+    response = shop.fulfilment.handle_packing_slip("ord-9999")
+    assert response.status == 404
+    assert response.body == {"error": "order not found"}
+
+
+def test_packing_slip_cancelled_order_is_409(shop):
+    oid = order(shop, "c1", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(oid)
+    response = shop.fulfilment.handle_packing_slip(oid)
+    assert response.status == 409
+    assert response.body == {"error": f"order {oid} is cancelled"}
+
+
+def test_low_stock_is_strictly_below_threshold(shop):
+    assert shop.fulfilment.handle_low_stock(5).body == {"products": []}
+    assert shop.fulfilment.handle_low_stock(6).body == {
+        "products": [{"sku": "LAMP", "name": "Lamp", "on_hand": 5}]}
+
+
+def test_low_stock_sorted_by_on_hand_then_sku(shop):
+    shop.catalog.handle_add_product({"sku": "ZIP", "name": "Zip", "unit_price_cents": 100, "on_hand": 5})
+    response = shop.fulfilment.handle_low_stock(1000)
+    assert response.status == 200
+    assert response.body == {"products": [
+        {"sku": "LAMP", "name": "Lamp", "on_hand": 5},
+        {"sku": "ZIP", "name": "Zip", "on_hand": 5},
+        {"sku": "BOOK", "name": "Book", "on_hand": 50},
+        {"sku": "PEN", "name": "Pen", "on_hand": 100},
+    ]}
+
+
+def test_low_stock_reflects_orders_placed(shop):
+    order(shop, "c1", ("BOOK", 48))
+    assert shop.fulfilment.handle_low_stock(3).body == {"products": [
+        {"sku": "BOOK", "name": "Book", "on_hand": 2}]}
+
+
+def test_low_stock_rejects_invalid_threshold(shop):
+    for bad in (-1, "5", 1.5, None, True, False):
+        response = shop.fulfilment.handle_low_stock(bad)
+        assert response.status == 400, bad
+        assert "threshold" in response.body["error"]
+
+
+def test_low_stock_excludes_inactive_products():
+    from orders.application.fulfilment_service import FulfilmentService
+    from orders.domain.catalog import Product
+    from orders.infrastructure.catalog import InMemoryProductCatalog
+    from orders.infrastructure.customers import InMemoryCustomerRepository
+    from orders.infrastructure.repository import InMemoryOrderRepository
+    from orders.infrastructure.stock import InMemoryStockRepository
+
+    catalog, stock = InMemoryProductCatalog(), InMemoryStockRepository()
+    catalog.add(Product("OLD", "Old", 100, active=False))
+    stock.set("OLD", 0)
+    catalog.add(Product("NEW", "New", 100))
+    stock.set("NEW", 1)
+    service = FulfilmentService(InMemoryOrderRepository(), InMemoryCustomerRepository(), catalog, stock)
+    assert [p.sku for p in service.low_stock(10)] == ["NEW"]
+
+
+def test_restock_adds_to_stock_and_returns_new_level(shop):
+    response = shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 7})
+    assert response.status == 200
+    assert response.body == {"sku": "LAMP", "on_hand": 12}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 12
+
+
+def test_restocked_units_are_orderable_immediately(shop):
+    assert order(shop, "c1", ("LAMP", 6)).status == 409
+    shop.fulfilment.handle_restock({"sku": "LAMP", "quantity": 1})
+    assert order(shop, "c1", ("LAMP", 6)).status == 201
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 0
+
+
+def test_restock_rejects_invalid_requests_without_change(shop):
+    bad_requests = [
+        {"sku": "", "quantity": 1},
+        {"sku": 7, "quantity": 1},
+        {"quantity": 1},
+        {"sku": "LAMP", "quantity": 0},
+        {"sku": "LAMP", "quantity": -3},
+        {"sku": "LAMP", "quantity": 2.0},
+        {"sku": "LAMP", "quantity": "2"},
+        {"sku": "LAMP", "quantity": True},
+        {"sku": "LAMP"},
+    ]
+    for bad in bad_requests:
+        response = shop.fulfilment.handle_restock(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
+
+
+def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
+    order(shop, "c1", ("BOOK", 2), ("PEN", 1))
+    order(shop, "c2", ("LAMP", 1))
+    cancelled = order(shop, "c2", ("PEN", 5)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    response = shop.fulfilment.handle_fulfilment_summary()
+    assert response.status == 200
+    assert response.body == {"open_orders": 2, "units_to_pick": 4, "low_stock_products": 1}
+
+
+def test_fulfilment_summary_low_stock_is_below_five_units(shop):
+    # LAMP starts at exactly 5, which is not low stock; the shop's other products are well stocked.
+    assert shop.fulfilment.handle_fulfilment_summary().body == {
+        "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
+    order(shop, "c1", ("LAMP", 1))
+    assert shop.fulfilment.handle_fulfilment_summary().body["low_stock_products"] == 1
+
+
+def test_restock_unknown_product_is_404_without_change(shop):
+    response = shop.fulfilment.handle_restock({"sku": "NOPE", "quantity": 3})
+    assert response.status == 404
+    assert response.body == {"error": "product not found"}
+    assert shop.catalog.handle_get("LAMP").body["on_hand"] == 5
