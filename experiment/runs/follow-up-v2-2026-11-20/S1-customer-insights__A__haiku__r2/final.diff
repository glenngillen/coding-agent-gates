diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..0bce937
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,141 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_unknown_customer_is_not_found(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_customer_with_no_orders_gets_empty_list(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_orders_are_newest_first_and_include_cancelled(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    second = order(shop, "c1", ("PEN", 2)).body["order_id"]
+    third = order(shop, "c1", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(second)
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {
+        "customer_id": "c1",
+        "orders": [
+            {"order_id": third, "status": "placed", "total_cents": 6_000},
+            {"order_id": second, "status": "cancelled", "total_cents": 600},
+            {"order_id": first, "status": "placed", "total_cents": 2_500},
+        ],
+    }
+
+
+def test_only_the_requested_customers_orders_are_listed(shop):
+    mine = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    order(shop, "c2", ("BOOK", 1))
+    response = shop.insights.handle_order_history("c1")
+    assert [o["order_id"] for o in response.body["orders"]] == [mine]
+
+
+def test_totals_include_discount_and_match_order_summary(shop):
+    # Gold customer: 4 x 2500 = 10000 subtotal qualifies, 15% off => 8500.
+    big = order(shop, "c2", ("BOOK", 4)).body["order_id"]
+    # Standard customer: 2 x 2500 = 5000, below threshold => no discount.
+    small = order(shop, "c1", ("BOOK", 2)).body["order_id"]
+
+    history = shop.insights.handle_order_history("c2").body["orders"]
+    assert history == [{"order_id": big, "status": "placed", "total_cents": 8_500}]
+    assert history[0]["total_cents"] == shop.orders.handle_get(big).body["total_cents"]
+
+    history = shop.insights.handle_order_history("c1").body["orders"]
+    assert history[0]["order_id"] == small
+    assert history[0]["total_cents"] == shop.orders.handle_get(small).body["total_cents"] == 5_000
+
+
+def test_lifetime_value_unknown_customer_is_not_found(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_for_customer_with_no_orders(shop):
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_orders_and_includes_discount(shop):
+    # Gold customer: 4 x 2500 = 10000 => 15% off => 8500 (counts).
+    order(shop, "c2", ("BOOK", 4))
+    # Gold customer: 1 x 6000 => below threshold, no discount => 6000 (counts).
+    order(shop, "c2", ("LAMP", 1))
+    # Cancelled order must not count toward count or value.
+    cancelled = order(shop, "c2", ("PEN", 3)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+
+    response = shop.insights.handle_lifetime_value("c2")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": 14_500}
+
+    history = shop.insights.handle_order_history("c2").body["orders"]
+    active_totals = [o["total_cents"] for o in history if o["status"] != "cancelled"]
+    assert response.body["lifetime_value_cents"] == sum(active_totals)
+
+
+def test_top_customers_rejects_invalid_limit(shop):
+    for bad in (0, -1, True, False, "3", None, 1.5):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body, bad
+
+
+def test_top_customers_ranks_by_value_then_id_and_skips_zero(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Idle", "email": "i@example.com"})
+    order(shop, "c1", ("BOOK", 2))   # 5000
+    order(shop, "c0", ("BOOK", 2))   # 5000, ties with c1 -> c0 first by id
+    order(shop, "c2", ("LAMP", 1))   # 6000, highest
+    cancelled = order(shop, "c3", ("BOOK", 1)).body["order_id"]  # only cancelled => excluded
+    shop.orders.handle_cancel(cancelled)
+
+    response = shop.insights.handle_top_customers(10)
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 6_000},
+        {"customer_id": "c0", "name": "Zed", "lifetime_value_cents": 5_000},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 5_000},
+    ]}
+
+
+def test_top_customers_respects_limit(shop):
+    order(shop, "c1", ("BOOK", 2))
+    order(shop, "c2", ("LAMP", 1))
+    response = shop.insights.handle_top_customers(1)
+    assert response.status == 200
+    assert [c["customer_id"] for c in response.body["customers"]] == ["c2"]
+
+
+def test_customers_without_orders_in_registration_order(shop):
+    shop.customers.handle_register({"customer_id": "a9", "name": "Late", "email": "late@example.com"})
+    shop.customers.handle_register({"customer_id": "b1", "name": "Bo", "email": "bo@example.com"})
+    order(shop, "c1", ("BOOK", 1))                        # active => c1 excluded
+    cancelled = order(shop, "c2", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)                  # only cancelled => c2 included
+
+    response = shop.insights.handle_customers_without_orders()
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "a9", "name": "Late", "email": "late@example.com"},
+        {"customer_id": "b1", "name": "Bo", "email": "bo@example.com"},
+    ]}
+
+
+def test_customers_without_orders_counts_zero_price_orders_as_orders(shop):
+    shop.catalog.handle_add_product({"sku": "FREE", "name": "Sample", "unit_price_cents": 0, "on_hand": 10})
+    order(shop, "c1", ("FREE", 1))                        # zero-value but active => still has an order
+
+    response = shop.insights.handle_customers_without_orders()
+    assert [c["customer_id"] for c in response.body["customers"]] == ["c2"]
