+    def order_history(self, customer_id: str) -> list[OrderSummary]:
+        """Summaries for every order a customer has placed, newest first, including cancelled ones."""
+        if self._customers.get(customer_id) is None:
+            raise CustomerNotFound(customer_id)
+        orders = self._orders.list_for_customer(customer_id)
+        return [self.summarize(order) for order in reversed(orders)]
+
+    def lifetime_value(self, customer_id: str) -> tuple[int, int]:
+        """``(order_count, lifetime_value_cents)`` over a customer's orders that are not cancelled."""
+        if self._customers.get(customer_id) is None:
+            raise CustomerNotFound(customer_id)
+        active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
+        return len(active), sum(s.total_cents for s in active)
+
+    def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
+        """Customers with a positive lifetime value, highest first (ties by customer_id), at most ``limit``."""
+        ranked = []
+        for customer in self._customers.list_all():
+            _, value = self.lifetime_value(customer.customer_id)
+            if value > 0:
+                ranked.append((customer, value))
+        ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
+        return ranked[:limit]
+
+    def customers_without_orders(self) -> list[Customer]:
+        """Registered customers with no orders that are not cancelled, in registration order."""
+        return [customer for customer in self._customers.list_all()
+                if self.lifetime_value(customer.customer_id)[0] == 0]
