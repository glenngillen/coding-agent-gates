diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..32532bb
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,110 @@
+def place(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]}).body["order_id"]
+
+
+def test_unknown_customer(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_no_orders(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_history_newest_first_with_discounted_totals_and_cancelled(shop):
+    first = place(shop, "c1", ("LAMP", 2))
+    place(shop, "c2", ("PEN", 1))
+    second = place(shop, "c1", ("BOOK", 1))
+    shop.orders.handle_cancel(second)
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body["customer_id"] == "c1"
+    assert response.body["orders"] == [
+        {"order_id": second, "status": "cancelled",
+         "total_cents": shop.orders.handle_get(second).body["total_cents"]},
+        {"order_id": first, "status": "placed",
+         "total_cents": shop.orders.handle_get(first).body["total_cents"]},
+    ]
+    assert response.body["orders"][1]["total_cents"] == 10800
+
+
+def test_lifetime_value_unknown_customer(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_no_orders(shop):
+    assert shop.insights.handle_lifetime_value("c1").body == {
+        "customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_and_uses_discounted_totals(shop):
+    first = place(shop, "c1", ("LAMP", 2))
+    cancelled = place(shop, "c1", ("BOOK", 1))
+    third = place(shop, "c1", ("PEN", 2))
+    place(shop, "c2", ("PEN", 1))
+    shop.orders.handle_cancel(cancelled)
+    expected = sum(shop.orders.handle_get(o).body["total_cents"] for o in (first, third))
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 2, "lifetime_value_cents": expected}
+    assert expected == 10800 + 600
+
+
+def test_customers_without_orders(shop):
+    shop.customers.handle_register({"customer_id": "c3", "name": "Alan", "email": "a@example.com"})
+    ada = {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"}
+    grace = {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"}
+    alan = {"customer_id": "c3", "name": "Alan", "email": "a@example.com"}
+    assert shop.insights.handle_customers_without_orders().body == {"customers": [ada, grace, alan]}
+    place(shop, "c2", ("PEN", 1))
+    cancelled = place(shop, "c1", ("PEN", 1))
+    response = shop.insights.handle_customers_without_orders()
+    assert response.status == 200
+    assert response.body == {"customers": [alan]}
+    shop.orders.handle_cancel(cancelled)
+    assert shop.insights.handle_customers_without_orders().body == {"customers": [ada, alan]}
+
+
+def test_customers_without_orders_empty_when_no_customers(api):
+    assert api.insights.handle_customers_without_orders().body == {"customers": []}
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, "3", None, 1.5):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400
+        assert "error" in response.body
+
+
+def test_top_customers_empty_when_no_value(shop):
+    assert shop.insights.handle_top_customers(5).body == {"customers": []}
+    cancelled = place(shop, "c1", ("BOOK", 1))
+    shop.orders.handle_cancel(cancelled)
+    assert shop.insights.handle_top_customers(5).body == {"customers": []}
+
+
+def test_top_customers_sorted_limited_and_excludes_zero(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Zed", "email": "z@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Alan", "email": "a@example.com"})
+    place(shop, "c1", ("PEN", 2))
+    place(shop, "c2", ("PEN", 2))
+    place(shop, "c3", ("LAMP", 2))
+    place(shop, "c0", ("PEN", 1))
+    shop.orders.handle_cancel(place(shop, "c0", ("LAMP", 1)))
+    body = shop.insights.handle_top_customers(10).body
+    assert body == {"customers": [
+        {"customer_id": "c3", "name": "Alan", "lifetime_value_cents": 10800},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 600},
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 600},
+        {"customer_id": "c0", "name": "Zed", "lifetime_value_cents": 300},
+    ]}
+    assert shop.insights.handle_top_customers(2).body["customers"] == body["customers"][:2]
+    for entry in body["customers"]:
+        assert entry["lifetime_value_cents"] == shop.insights.handle_lifetime_value(
+            entry["customer_id"]).body["lifetime_value_cents"]
