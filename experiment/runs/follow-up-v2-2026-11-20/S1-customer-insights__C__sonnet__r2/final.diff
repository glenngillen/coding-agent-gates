+    def order_history(self, customer_id: str) -> list[OrderSummary]:
+        """Summaries of all of a customer's orders (including cancelled), newest first."""
+        orders = self.list_for_customer(customer_id)
+        return [self.summarize(o) for o in reversed(orders)]
+
+    def lifetime_value(self, customer_id: str) -> tuple[int, int]:
+        """Return ``(order_count, total_cents)`` over the customer's non-cancelled orders."""
+        active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
+        return len(active), sum(s.total_cents for s in active)
+
+    def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
+        """Up to ``limit`` ``(customer, lifetime_value_cents)`` pairs, highest value first.
+
+        Ties break on customer id; customers with a lifetime value of 0 are left out.
+        """
+        ranked = []
+        for customer in self._customers.list_all():
+            _, value = self.lifetime_value(customer.customer_id)
+            if value > 0:
+                ranked.append((customer, value))
+        ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
+        return ranked[:limit]
+
+    def customers_without_orders(self) -> list[Customer]:
+        """Customers with no non-cancelled orders, in registration order."""
+        return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
