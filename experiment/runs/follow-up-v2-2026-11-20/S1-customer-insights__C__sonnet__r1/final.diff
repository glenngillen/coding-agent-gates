diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..d729b8f
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,93 @@
+def place(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_lifetime_value_unknown_customer(shop):
+    r = shop.insights.handle_lifetime_value("nobody")
+    assert r.status == 404
+    assert r.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_no_orders(shop):
+    r = shop.insights.handle_lifetime_value("c1")
+    assert (r.status, r.body) == (200, {"customer_id": "c1", "order_count": 0,
+                                        "lifetime_value_cents": 0})
+
+
+def test_lifetime_value_excludes_cancelled_and_includes_discount(shop):
+    place(shop, "c2", ("LAMP", 2))
+    cancelled = place(shop, "c2", ("BOOK", 1)).body["order_id"]
+    place(shop, "c2", ("PEN", 1))
+    shop.orders.handle_cancel(cancelled)
+    r = shop.insights.handle_lifetime_value("c2")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": 10200 + 300}
+
+
+def test_top_customers_rejects_bad_limit(shop):
+    for bad in (0, -1, True, "3", None, 1.5):
+        r = shop.insights.handle_top_customers(bad)
+        assert r.status == 400
+        assert "error" in r.body
+
+
+def test_top_customers_empty_when_no_value(shop):
+    assert shop.insights.handle_top_customers(5).body == {"customers": []}
+
+
+def test_top_customers_sorting_filtering_and_limit(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Alan", "email": "a@example.com"})
+    shop.customers.handle_register({"customer_id": "c3", "name": "Zed", "email": "z@example.com"})
+    place(shop, "c1", ("BOOK", 1))                      # 2500
+    place(shop, "c0", ("BOOK", 1))                      # 2500 (tie, c0 sorts first)
+    place(shop, "c2", ("LAMP", 2))                      # 10200 with gold discount
+    cancelled = place(shop, "c3", ("LAMP", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)                # c3 left with 0
+    r = shop.insights.handle_top_customers(10)
+    assert r.status == 200
+    assert r.body["customers"] == [
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 10200},
+        {"customer_id": "c0", "name": "Alan", "lifetime_value_cents": 2500},
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 2500},
+    ]
+    assert [c["customer_id"] for c in shop.insights.handle_top_customers(2).body["customers"]] == ["c2", "c0"]
+
+
+def test_customers_without_orders(shop):
+    shop.customers.handle_register({"customer_id": "c0", "name": "Alan", "email": "a@example.com"})
+    r = shop.insights.handle_customers_without_orders()
+    assert r.status == 200
+    assert [c["customer_id"] for c in r.body["customers"]] == ["c1", "c2", "c0"]
+    assert r.body["customers"][0] == {"customer_id": "c1", "name": "Ada", "email": "ada@example.com"}
+
+    place(shop, "c2", ("BOOK", 1))
+    cancelled = place(shop, "c1", ("BOOK", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    r = shop.insights.handle_customers_without_orders()
+    assert [c["customer_id"] for c in r.body["customers"]] == ["c1", "c0"]
+
+
+def test_unknown_customer(shop):
+    r = shop.insights.handle_order_history("nobody")
+    assert r.status == 404
+    assert r.body == {"error": "customer not found"}
+
+
+def test_no_orders(shop):
+    r = shop.insights.handle_order_history("c1")
+    assert (r.status, r.body) == (200, {"customer_id": "c1", "orders": []})
+
+
+def test_history_newest_first_with_discount_and_cancelled(shop):
+    first = place(shop, "c2", ("LAMP", 2)).body["order_id"]
+    second = place(shop, "c2", ("BOOK", 1)).body["order_id"]
+    place(shop, "c1", ("PEN", 1))
+    shop.orders.handle_cancel(second)
+    r = shop.insights.handle_order_history("c2")
+    assert r.status == 200
+    assert r.body == {"customer_id": "c2", "orders": [
+        {"order_id": second, "status": "cancelled", "total_cents": 2500},
+        {"order_id": first, "status": shop.orders.handle_get(first).body["status"], "total_cents": 10200},
+    ]}
+    assert shop.orders.handle_get(first).body["total_cents"] == 10200
