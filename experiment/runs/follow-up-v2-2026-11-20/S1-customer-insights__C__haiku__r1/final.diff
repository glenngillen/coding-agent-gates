+    def order_history(self, customer_id: str) -> list[OrderSummary]:
+        """Summaries of every order for a customer, newest first, cancelled ones included."""
+        return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
+
+    def lifetime_value(self, customer_id: str) -> tuple[int, int]:
+        """``(order_count, total_cents)`` over a customer's orders that are not cancelled."""
+        counted = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
+        return len(counted), sum(s.total_cents for s in counted)
+
+    def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
+        """Up to ``limit`` customers with a non-zero lifetime value, highest first, ties by id."""
+        ranked = []
+        for customer in self._customers.list_all():
+            _, value = self.lifetime_value(customer.customer_id)
+            if value > 0:
+                ranked.append((customer, value))
+        ranked.sort(key=lambda entry: (-entry[1], entry[0].customer_id))
+        return ranked[:limit]
+
+    def customers_without_orders(self) -> list[Customer]:
+        """Registered customers with no orders that are not cancelled, in registration order."""
+        return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
