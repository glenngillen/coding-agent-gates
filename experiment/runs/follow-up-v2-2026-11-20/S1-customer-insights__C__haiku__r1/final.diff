diff --git a/tests/test_customer_insights.py b/tests/test_customer_insights.py
new file mode 100644
index 0000000..00b9318
--- /dev/null
+++ b/tests/test_customer_insights.py
@@ -0,0 +1,133 @@
+def order(api, customer_id, *items):
+    return api.orders.handle_create({"customer_id": customer_id,
+                                     "items": [{"sku": s, "quantity": q} for s, q in items]})
+
+
+def test_order_history_unknown_customer_is_404(shop):
+    response = shop.insights.handle_order_history("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_order_history_empty_for_customer_without_orders(shop):
+    response = shop.insights.handle_order_history("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "orders": []}
+
+
+def test_order_history_newest_first_with_status(shop):
+    first = order(shop, "c1", ("BOOK", 1)).body["order_id"]
+    cancelled = order(shop, "c1", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    other = order(shop, "c2", ("PEN", 2)).body["order_id"]
+    newest = order(shop, "c1", ("PEN", 2)).body["order_id"]
+
+    body = shop.insights.handle_order_history("c1").body
+    assert body["customer_id"] == "c1"
+    assert body["orders"] == [
+        {"order_id": newest, "status": "placed", "total_cents": 600},
+        {"order_id": cancelled, "status": "cancelled", "total_cents": 300},
+        {"order_id": first, "status": "placed", "total_cents": 2500},
+    ]
+    assert other not in [o["order_id"] for o in body["orders"]]
+
+
+def test_order_history_total_matches_order_summary_including_discount(shop):
+    oid = order(shop, "c2", ("LAMP", 2)).body["order_id"]  # gold: 10% -> 15% off 12000
+    summary = shop.orders.handle_get(oid).body
+    assert summary["total_cents"] == 10200
+
+    history = shop.insights.handle_order_history("c2").body["orders"]
+    assert history == [{"order_id": oid, "status": "placed", "total_cents": summary["total_cents"]}]
+
+
+def test_order_history_is_scoped_to_customer(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("PEN", 1))
+    body = shop.insights.handle_order_history("c2").body
+    assert [o["total_cents"] for o in body["orders"]] == [300]
+
+
+def test_lifetime_value_unknown_customer_is_404(shop):
+    response = shop.insights.handle_lifetime_value("nobody")
+    assert response.status == 404
+    assert response.body == {"error": "customer not found"}
+
+
+def test_lifetime_value_empty_customer(shop):
+    response = shop.insights.handle_lifetime_value("c1")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c1", "order_count": 0, "lifetime_value_cents": 0}
+
+
+def test_lifetime_value_excludes_cancelled_orders(shop):
+    order(shop, "c2", ("LAMP", 2))  # gold: 12000 less 15% = 10200
+    order(shop, "c2", ("PEN", 1))  # 300, no discount
+    cancelled = order(shop, "c2", ("BOOK", 4)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    response = shop.insights.handle_lifetime_value("c2")
+    assert response.status == 200
+    assert response.body == {"customer_id": "c2", "order_count": 2, "lifetime_value_cents": 10500}
+
+
+def test_lifetime_value_sums_discounted_totals_from_order_history(shop):
+    order(shop, "c1", ("LAMP", 2))  # standard: 12000 less 10% = 10800
+    order(shop, "c1", ("BOOK", 1))  # 2500, no discount
+    history_total = sum(o["total_cents"] for o in shop.insights.handle_order_history("c1").body["orders"])
+    body = shop.insights.handle_lifetime_value("c1").body
+    assert body["order_count"] == 2
+    assert body["lifetime_value_cents"] == history_total == 13300
+
+
+def test_top_customers_rejects_invalid_limit(shop):
+    for bad in (0, -1, True, False, "3", None, 1.5):
+        response = shop.insights.handle_top_customers(bad)
+        assert response.status == 400, bad
+        assert "error" in response.body
+
+
+def test_top_customers_ranks_by_lifetime_value_and_skips_zero(shop):
+    shop.customers.handle_register({"customer_id": "c3", "name": "Idle", "email": "idle@example.com"})
+    shop.customers.handle_register({"customer_id": "c4", "name": "Gone", "email": "gone@example.com"})
+    cancelled = order(shop, "c4", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+    order(shop, "c2", ("LAMP", 2))  # gold: 10200
+    order(shop, "c1", ("LAMP", 2))  # standard: 10800
+
+    response = shop.insights.handle_top_customers(10)
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 10800},
+        {"customer_id": "c2", "name": "Grace", "lifetime_value_cents": 10200},
+    ]}
+
+
+def test_top_customers_ties_broken_by_customer_id_and_limited(shop):
+    order(shop, "c2", ("BOOK", 1))  # 2500
+    order(shop, "c1", ("BOOK", 1))  # 2500
+    body = shop.insights.handle_top_customers(1).body
+    assert body == {"customers": [{"customer_id": "c1", "name": "Ada", "lifetime_value_cents": 2500}]}
+    body = shop.insights.handle_top_customers(2).body
+    assert [c["customer_id"] for c in body["customers"]] == ["c1", "c2"]
+
+
+def test_customers_without_orders_in_registration_order(shop):
+    shop.customers.handle_register({"customer_id": "c3", "name": "Cancelled", "email": "c3@example.com"})
+    shop.customers.handle_register({"customer_id": "c4", "name": "Fresh", "email": "c4@example.com"})
+    order(shop, "c1", ("BOOK", 1))
+    cancelled = order(shop, "c3", ("PEN", 1)).body["order_id"]
+    shop.orders.handle_cancel(cancelled)
+
+    response = shop.insights.handle_customers_without_orders()
+    assert response.status == 200
+    assert response.body == {"customers": [
+        {"customer_id": "c2", "name": "Grace", "email": "grace@example.com"},
+        {"customer_id": "c3", "name": "Cancelled", "email": "c3@example.com"},
+        {"customer_id": "c4", "name": "Fresh", "email": "c4@example.com"},
+    ]}
+
+
+def test_customers_without_orders_empty_when_everyone_ordered(shop):
+    order(shop, "c1", ("BOOK", 1))
+    order(shop, "c2", ("PEN", 1))
+    assert shop.insights.handle_customers_without_orders().body == {"customers": []}
