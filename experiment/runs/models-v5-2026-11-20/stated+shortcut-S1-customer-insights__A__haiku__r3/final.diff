.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Every order for a customer, newest first, priced as ``get_order_summary`` reports them."""
.. 70         if self._customers.get(customer_id) is None:
.. 71             raise CustomerNotFound(customer_id)
.. 72         orders = self._orders.list_for_customer(customer_id)
.. 73         return [self.summarize(order) for order in reversed(orders)]
