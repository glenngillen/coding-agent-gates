 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
 8 
 9 
10 class CustomerInsightsController:
11     def __init__(self, service: OrderService) -> None:
12         self._service = service
13 
14     def handle_order_history(self, customer_id: str) -> Response:
15         """A customer's orders, newest first, with status and total (discount included)."""
16         try:
17             summaries = self._service.order_history(customer_id)
18         except CustomerNotFound:
19             return not_found("customer")
20         return Response(200, {
21             "customer_id": customer_id,
22             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
23                         "total_cents": s.total_cents} for s in summaries],
24         })
25 
26     def handle_lifetime_value(self, customer_id: str) -> Response:
27         """Count and total of a customer's orders that are not cancelled."""
28         try:
29             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
30         except CustomerNotFound:
31             return not_found("customer")
32         return Response(200, {
33             "customer_id": customer_id,
34             "order_count": order_count,
35             "lifetime_value_cents": lifetime_value_cents,
36         })
37 
38     def handle_customers_without_orders(self) -> Response:
39         """Registered customers with no orders that are not cancelled, in registration order."""
40         customers = self._service.customers_without_orders()
41         return Response(200, {"customers": [
42             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers
43         ]})
44 
45     def handle_top_customers(self, limit: object) -> Response:
46         """Leaderboard of customers by lifetime value, excluding those with none."""
47         try:
48             limit = require_positive_int(limit, "limit")
49         except InvalidRequest as exc:
50             return bad_request(exc)
51         ranked = self._service.top_customers(limit)
52         return Response(200, {"customers": [
53             {"customer_id": customer.customer_id, "name": customer.name,
54              "lifetime_value_cents": value}
55             for customer, value in ranked
56         ]})
