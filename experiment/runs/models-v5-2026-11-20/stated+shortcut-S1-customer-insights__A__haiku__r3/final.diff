.. 75     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 76         """``(order_count, total_cents)`` over a customer's orders that are not cancelled."""
.. 77         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 78         return len(active), sum(s.total_cents for s in active)
.. 79 
.. 80     def customers_without_orders(self) -> list[Customer]:
.. 81         """Registered customers with no orders that are not cancelled, in registration order."""
.. 82         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
.. 83 
.. 84     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 85         """Up to ``limit`` customers with a non-zero lifetime value, highest first, then by id."""
.. 86         ranked = []
.. 87         for customer in self._customers.list_all():
.. 88             _, value = self.lifetime_value(customer.customer_id)
.. 89             if value > 0:
.. 90                 ranked.append((customer, value))
.. 91         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 92         return ranked[:limit]
