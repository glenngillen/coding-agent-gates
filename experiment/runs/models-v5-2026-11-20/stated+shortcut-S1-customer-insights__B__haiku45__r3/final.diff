src/orders/controllers/customer_insights.py --- Python
 1 """Customer insights for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_insights_service import CustomerInsightsService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, order_service: OrderService, insights_service: CustomerInsightsService) -> None:
15         self._order_service = order_service
16         self._insights_service = insights_service
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         try:
20             orders = self._order_service.list_for_customer(customer_id)
21         except CustomerNotFound:
22             return Response(404, {"error": "customer not found"})
23 
24         order_entries = []
25         for order in reversed(orders):
26             summary = self._order_service.summarize(order)
27             order_entries.append({
28                 "order_id": order.order_id,
29                 "status": order.status,
30                 "total_cents": summary.total_cents,
31             })
32 
33         return Response(200, {
34             "customer_id": customer_id,
35             "orders": order_entries,
36         })
37 
38     def handle_lifetime_value(self, customer_id: str) -> Response:
39         try:
40             lifetime = self._insights_service.get_lifetime_value(customer_id)
41         except CustomerNotFound:
42             return Response(404, {"error": "customer not found"})
43 
44         return Response(200, {
45             "customer_id": customer_id,
46             "order_count": lifetime["order_count"],
47             "lifetime_value_cents": lifetime["lifetime_value_cents"],
48         })
49 
50     def handle_top_customers(self, limit: Any) -> Response:
51         try:
52             validated_limit = require_positive_int(limit, "limit")
53         except InvalidRequest as exc:
54             return bad_request(exc)
55 
56         customers = self._insights_service.get_top_customers(validated_limit)
57         return Response(200, {
58             "customers": customers
59         })
60 
61     def handle_customers_without_orders(self) -> Response:
62         customers = self._insights_service.get_customers_without_orders()
63         return Response(200, {
64             "customers": customers
65         })
66 

