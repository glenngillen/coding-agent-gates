 1 """Customer insights calculations."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.infrastructure.customers import InMemoryCustomerRepository
 8 from orders.infrastructure.repository import InMemoryOrderRepository
 9 
10 
11 class CustomerInsightsService:
12     def __init__(self, customers: InMemoryCustomerRepository, orders: InMemoryOrderRepository,
13                  order_service: OrderService) -> None:
14         self._customers = customers
15         self._orders = orders
16         self._order_service = order_service
17 
18     def get_lifetime_value(self, customer_id: str) -> dict:
19         try:
20             orders = self._order_service.list_for_customer(customer_id)
21         except CustomerNotFound:
22             raise
23 
24         active_orders = [o for o in orders if o.status != "cancelled"]
25         lifetime_value_cents = sum(self._order_service.summarize(o).total_cents for o in active_orders)
26 
27         return {
28             "order_count": len(active_orders),
29             "lifetime_value_cents": lifetime_value_cents,
30         }
31 
32     def get_top_customers(self, limit: int) -> list[dict]:
33         customer_values = []
34         for customer in self._customers.list_all():
35             try:
36                 lifetime = self.get_lifetime_value(customer.customer_id)
37                 if lifetime["lifetime_value_cents"] > 0:
38                     customer_values.append({
39                         "customer_id": customer.customer_id,
40                         "name": customer.name,
41                         "lifetime_value_cents": lifetime["lifetime_value_cents"],
42                     })
43             except CustomerNotFound:
44                 pass
45 
46         customer_values.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
47         return customer_values[:limit]
48 
49     def get_customers_without_orders(self) -> list[dict]:
50         customers_without_orders = []
51         for customer in self._customers.list_all():
52             orders = self._orders.list_for_customer(customer.customer_id)
53             active_orders = [o for o in orders if o.status != "cancelled"]
54             if not active_orders:
55                 customers_without_orders.append({
56                     "customer_id": customer.customer_id,
57                     "name": customer.name,
58                     "email": customer.email,
59                 })
60         return customers_without_orders
