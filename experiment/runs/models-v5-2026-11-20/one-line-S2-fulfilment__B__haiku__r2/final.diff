src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as exc:
23             return conflict(exc)
24         return Response(200, {
25             "order_id": slip.order_id,
26             "customer_name": slip.customer_name,
27             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
28                       for line in slip.lines],
29         })
30 
31     def handle_low_stock(self, threshold: Any) -> Response:
32         try:
33             limit = require_non_negative_int(threshold, "threshold")
34         except InvalidRequest as exc:
35             return bad_request(exc)
36         return Response(200, {"products": [
37             {"sku": product.sku, "name": product.name, "on_hand": on_hand}
38             for product, on_hand in self._service.low_stock(limit)
39         ]})
40 
41     def handle_fulfilment_summary(self) -> Response:
42         open_orders, units, low_stock = self._service.fulfilment_summary()
43         return Response(200, {"open_orders": open_orders, "units_to_pick": units,
44                               "low_stock_products": low_stock})
45 
46     def handle_restock(self, request: dict[str, Any]) -> Response:
47         try:
48             sku = require_str(request, "sku")
49             quantity = require_positive_int(request.get("quantity"), "quantity")
50         except InvalidRequest as exc:
51             return bad_request(exc)
52         try:
53             on_hand = self._service.restock(sku, quantity)
54         except ProductNotFound:
55             return not_found("product")
56         return Response(200, {"sku": sku, "on_hand": on_hand})
