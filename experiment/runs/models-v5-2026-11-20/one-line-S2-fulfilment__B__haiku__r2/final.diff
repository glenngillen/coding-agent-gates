 1 """Warehouse fulfilment: packing slips for orders that are ready to pick and pack."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.domain.catalog import Product
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 from orders.infrastructure.stock import InMemoryStockRepository
13 
14 LOW_STOCK_LINE = 5
15 
16 
17 @dataclass(frozen=True)
18 class PackingLine:
19     sku: str
20     name: str
21     quantity: int
22 
23 
24 @dataclass(frozen=True)
25 class PackingSlip:
26     order_id: str
27     customer_name: str
28     lines: tuple[PackingLine, ...]
29 
30 
31 class FulfilmentService:
32     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
33                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
34         self._orders = orders
35         self._customers = customers
36         self._catalog = catalog
37         self._stock = stock
38 
39     def packing_slip(self, order_id: str) -> PackingSlip:
40         order = self._orders.get(order_id)
41         if order is None:
42             raise OrderNotFound(order_id)
43         if order.status == "cancelled":
44             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
45         customer = self._customers.get(order.customer_id)
46         lines = tuple(PackingLine(item.sku, self._catalog.get(item.sku).name, item.quantity)
47                       for item in order.items)
48         return PackingSlip(order.order_id, customer.name if customer is not None else "", lines)
49 
50     def low_stock(self, threshold: int) -> list[tuple[Product, int]]:
51         """Active products with stock strictly below ``threshold``, lowest stock first, then by SKU."""
52         rows = []
53         for product in self._catalog.list_all():
54             if not product.active:
55                 continue
56             on_hand = self._stock.get(product.sku)
57             if on_hand < threshold:
58                 rows.append((product, on_hand))
59         return sorted(rows, key=lambda row: (row[1], row[0].sku))
60 
61     def fulfilment_summary(self) -> tuple[int, int, int]:
62         """Return ``(open_orders, units_to_pick, low_stock_products)``.
63 
64         Open orders are those not cancelled; low stock is active products with fewer than
65         ``LOW_STOCK_LINE`` units on hand.
66         """
67         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
68         units = sum(item.quantity for order in open_orders for item in order.items)
69         return len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE))
70 
71     def restock(self, sku: str, quantity: int) -> int:
72         """Add ``quantity`` units to a product's stock and return the new on-hand level."""
73         if self._catalog.get(sku) is None:
74             raise ProductNotFound(sku)
75         new_level = self._stock.get(sku) + quantity
76         self._stock.set(sku, new_level)
77         return new_level
