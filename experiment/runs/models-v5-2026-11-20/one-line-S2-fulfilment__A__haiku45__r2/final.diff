  3 from __future__ import annotations
  4 
  5 from typing import Any
  6 
  7 from orders.application.errors import OrderNotFound
  8 from orders.application.order_service import OrderService
  9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_non_negative_int, require_positive_int, require_str
 10 from orders.infrastructure.catalog import InMemoryProductCatalog
 11 from orders.infrastructure.customers import InMemoryCustomerRepository
 12 from orders.infrastructure.repository import InMemoryOrderRepository
 13 from orders.infrastructure.stock import InMemoryStockRepository
 14 
 15 
 16 class FulfilmentController:
 17     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository,
 18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository,
 19                  orders: InMemoryOrderRepository) -> None:
 20         self._service = service
 21         self._customers = customers
 22         self._catalog = catalog
 23         self._stock = stock
 24         self._orders = orders
 25 
 26     def handle_packing_slip(self, order_id: str) -> Response:
 27         try:
 28             order = self._service.get_order(order_id)
 29         except OrderNotFound:
 30             return not_found("order")
 31 
 32         if order.status == "cancelled":
 33             return Response(409, {"error": f"order {order_id} is cancelled"})
 34 
 35         customer = self._customers.get(order.customer_id)
 36         customer_name = customer.name if customer else ""
 37 
 38         lines = []
 39         for item in order.items:
 40             product = self._catalog.get(item.sku)
 41             product_name = product.name if product else ""
 42             lines.append({"sku": item.sku, "name": product_name, "quantity": item.quantity})
 43 
 44         return Response(200, {
 45             "order_id": order.order_id,
 46             "customer_name": customer_name,
 47             "lines": lines,
 48         })
 49 
 50     def handle_low_stock(self, threshold: Any) -> Response:
 51         try:
 52             threshold_int = require_non_negative_int(threshold, "threshold")
 53         except InvalidRequest as exc:
 54             return bad_request(exc)
 55 
 56         stock_levels = self._stock.all_levels()
 57         low_stock_products = []
 58 
 59         for product in self._catalog.list_all():
 60             if product.active and stock_levels.get(product.sku, 0) < threshold_int:
 61                 low_stock_products.append({
 62                     "sku": product.sku,
 63                     "name": product.name,
 64                     "on_hand": stock_levels.get(product.sku, 0),
 65                 })
 66 
 67         low_stock_products.sort(key=lambda p: (p["on_hand"], p["sku"]))
 68 
 69         return Response(200, {"products": low_stock_products})
 70 
 71     def handle_restock(self, request: dict[str, Any]) -> Response:
 72         try:
 73             sku = require_str(request, "sku")
 74             quantity = require_positive_int(request.get("quantity"), "quantity")
 75         except InvalidRequest as exc:
 76             return bad_request(exc)
 77 
 78         product = self._catalog.get(sku)
 79         if product is None:
 80             return not_found("product")
 81 
 82         new_level = self._stock.get(sku) + quantity
 83         self._stock.set(sku, new_level)
 84 
 85         return Response(200, {"sku": sku, "on_hand": new_level})
 86 
 87     def handle_fulfilment_summary(self) -> Response:
 88         orders = self._orders.list_all()
 89         open_orders = sum(1 for order in orders if order.status != "cancelled")
 90         units_to_pick = sum(item.quantity for order in orders if order.status != "cancelled"
 91                             for item in order.items)
 92 
 93         stock_levels = self._stock.all_levels()
 94         low_stock_products = sum(1 for product in self._catalog.list_all()
 95                                  if product.active and stock_levels.get(product.sku, 0) < 5)
 96 
 97         return Response(200, {
 98             "open_orders": open_orders,
 99             "units_to_pick": units_to_pick,
100             "low_stock_products": low_stock_products,
101         })
