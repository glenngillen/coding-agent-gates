 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.insights_service import InsightsService
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, order_service: OrderService, insights_service: InsightsService) -> None:
15         self._order_service = order_service
16         self._insights_service = insights_service
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         try:
20             orders = self._order_service.list_for_customer(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23 
24         # Return orders newest first (reverse of creation order)
25         order_entries = []
26         for order in reversed(orders):
27             summary = self._order_service.summarize(order)
28             order_entries.append({
29                 "order_id": order.order_id,
30                 "status": order.status,
31                 "total_cents": summary.total_cents,
32             })
33 
34         return Response(200, {
35             "customer_id": customer_id,
36             "orders": order_entries,
37         })
38 
39     def handle_lifetime_value(self, customer_id: str) -> Response:
40         try:
41             orders = self._order_service.list_for_customer(customer_id)
42         except CustomerNotFound:
43             return not_found("customer")
44 
45         order_count = 0
46         lifetime_value_cents = 0
47         for order in orders:
48             if order.status != "cancelled":
49                 summary = self._order_service.summarize(order)
50                 order_count += 1
51                 lifetime_value_cents += summary.total_cents
52 
53         return Response(200, {
54             "customer_id": customer_id,
55             "order_count": order_count,
56             "lifetime_value_cents": lifetime_value_cents,
57         })
58 
59     def handle_top_customers(self, limit: Any) -> Response:
60         try:
61             if type(limit) is not int or isinstance(limit, bool) or limit < 1:
62                 raise InvalidRequest("limit must be a positive integer")
63         except InvalidRequest as exc:
64             return bad_request(exc)
65 
66         top_customers = self._insights_service.get_top_customers(limit)
67         return Response(200, {
68             "customers": [
69                 {
70                     "customer_id": c.customer_id,
71                     "name": c.name,
72                     "lifetime_value_cents": c.lifetime_value_cents,
73                 }
74                 for c in top_customers
75             ]
76         })
77 
78     def handle_customers_without_orders(self) -> Response:
79         customers = self._insights_service.get_customers_without_orders()
80         return Response(200, {
81             "customers": [
82                 {
83                     "customer_id": c.customer_id,
84                     "name": c.name,
85                     "email": c.email,
86                 }
87                 for c in customers
88             ]
89         })
