 1 """Customer insights service."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.order_service import OrderService
 9 
10 
11 @dataclass(frozen=True)
12 class CustomerLifetimeValue:
13     customer_id: str
14     name: str
15     lifetime_value_cents: int
16 
17 
18 @dataclass(frozen=True)
19 class CustomerInfo:
20     customer_id: str
21     name: str
22     email: str
23 
24 
25 class InsightsService:
26     def __init__(self, order_service: OrderService, customer_service: CustomerService) -> None:
27         self._order_service = order_service
28         self._customer_service = customer_service
29 
30     def get_lifetime_value(self, customer_id: str) -> int:
31         orders = self._order_service.list_for_customer(customer_id)
32         lifetime_value_cents = 0
33         for order in orders:
34             if order.status != "cancelled":
35                 summary = self._order_service.summarize(order)
36                 lifetime_value_cents += summary.total_cents
37         return lifetime_value_cents
38 
39     def get_top_customers(self, limit: int) -> list[CustomerLifetimeValue]:
40         customers = self._customer_service.list_all()
41 
42         customer_values = []
43         for customer in customers:
44             lifetime_value = self.get_lifetime_value(customer.customer_id)
45             if lifetime_value > 0:
46                 customer_values.append(CustomerLifetimeValue(
47                     customer.customer_id,
48                     customer.name,
49                     lifetime_value
50                 ))
51 
52         # Sort by lifetime_value descending, then by customer_id
53         customer_values.sort(key=lambda c: (-c.lifetime_value_cents, c.customer_id))
54 
55         return customer_values[:limit]
56 
57     def get_customers_without_orders(self) -> list[CustomerInfo]:
58         customers = self._customer_service.list_all()
59 
60         result = []
61         for customer in customers:
62             orders = self._order_service.list_for_customer(customer.customer_id)
63             has_non_cancelled_order = any(order.status != "cancelled" for order in orders)
64             if not has_non_cancelled_order:
65                 result.append(CustomerInfo(
66                     customer.customer_id,
67                     customer.name,
68                     customer.email
69                 ))
70 
71         return result
72 

