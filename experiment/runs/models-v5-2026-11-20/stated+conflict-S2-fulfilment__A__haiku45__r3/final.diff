 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.controllers.http import Response, not_found, conflict, bad_request, InvalidRequest, require_non_negative_int, require_str, require_positive_int
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 class FulfilmentController:
15     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
16                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
17         self._orders = orders
18         self._customers = customers
19         self._catalog = catalog
20         self._stock = stock
21 
22     def handle_packing_slip(self, order_id: str) -> Response:
23         order = self._orders.get(order_id)
24         if order is None:
25             return not_found("order")
26         if order.status == "cancelled":
27             return conflict(f"order {order_id} is cancelled")
28         customer = self._customers.get(order.customer_id)
29         customer_name = customer.name if customer else ""
30         lines = []
31         for item in order.items:
32             product = self._catalog.get(item.sku)
33             product_name = product.name if product else ""
34             lines.append({
35                 "sku": item.sku,
36                 "name": product_name,
37                 "quantity": item.quantity,
38             })
39         return Response(200, {
40             "order_id": order_id,
41             "customer_name": customer_name,
42             "lines": lines,
43         })
44 
45     def handle_low_stock(self, threshold: Any) -> Response:
46         try:
47             threshold = require_non_negative_int(threshold, "threshold")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         stock_levels = self._stock.all_levels()
51         products = []
52         for product in self._catalog.list_all():
53             if product.active and stock_levels.get(product.sku, 0) < threshold:
54                 products.append({
55                     "sku": product.sku,
56                     "name": product.name,
57                     "on_hand": stock_levels.get(product.sku, 0),
58                 })
59         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
60         return Response(200, {"products": products})
61 
62     def handle_restock(self, request: dict[str, Any]) -> Response:
63         try:
64             sku = require_str(request, "sku")
65             quantity = require_positive_int(request.get("quantity"), "quantity")
66         except InvalidRequest as exc:
67             return bad_request(exc)
68         product = self._catalog.get(sku)
69         if product is None:
70             return not_found("product")
71         current_on_hand = self._stock.get(sku)
72         new_on_hand = current_on_hand + quantity
73         self._stock.set(sku, new_on_hand)
74         return Response(200, {"sku": sku, "on_hand": new_on_hand})
75 
76     def handle_fulfilment_summary(self) -> Response:
77         open_orders = 0
78         units_to_pick = 0
79         for order in self._orders.list_all():
80             if order.status != "cancelled":
81                 open_orders += 1
82                 for item in order.items:
83                     units_to_pick += item.quantity
84         stock_levels = self._stock.all_levels()
85         low_stock_products = 0
86         for product in self._catalog.list_all():
87             if product.active and stock_levels.get(product.sku, 0) < 5:
88                 low_stock_products += 1
89         return Response(200, {
90             "open_orders": open_orders,
91             "units_to_pick": units_to_pick,
92             "low_stock_products": low_stock_products,
93         })
