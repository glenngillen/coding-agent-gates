 1 """Warehouse fulfilment: packing slips for orders that can still be packed."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import (LOW_STOCK_THRESHOLD, FulfilmentSummary, LowStockProduct,
 7                                       PackingSlip, PackingSlipLine)
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 class FulfilmentService:
15     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
16                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
17         self._orders = orders
18         self._customers = customers
19         self._catalog = catalog
20         self._stock = stock
21 
22     def summary(self) -> FulfilmentSummary:
23         """Dashboard counts: open orders, units across them, and low-stock products."""
24         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
25         return FulfilmentSummary(
26             open_orders=len(open_orders),
27             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
28             low_stock_products=len(self.low_stock(LOW_STOCK_THRESHOLD)),
29         )
30 
31     def restock(self, sku: str, quantity: int) -> int:
32         """Add ``quantity`` units to a product's stock; returns the new level."""
33         if self._catalog.get(sku) is None:
34             raise ProductNotFound(sku)
35         new_level = self._stock.get(sku) + quantity
36         self._stock.set(sku, new_level)
37         return new_level
38 
39     def low_stock(self, threshold: int) -> list[LowStockProduct]:
40         """Active products whose stock on hand is strictly below ``threshold``, lowest first."""
41         below = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
42                  for p in self._catalog.list_all()
43                  if p.active and self._stock.get(p.sku) < threshold]
44         return sorted(below, key=lambda entry: (entry.on_hand, entry.sku))
45 
46     def packing_slip(self, order_id: str) -> PackingSlip:
47         """Build the packing slip for an order; cancelled orders are not packed."""
48         order = self._orders.get(order_id)
49         if order is None:
50             raise OrderNotFound(order_id)
51         if order.status == "cancelled":
52             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
53         customer = self._customers.get(order.customer_id)
54         if customer is None:
55             raise CustomerNotFound(order.customer_id)
56         lines = []
57         for item in order.items:
58             product = self._catalog.get(item.sku)
59             if product is None:
60                 raise ProductNotFound(item.sku)
61             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
62         return PackingSlip(order.order_id, customer.name, tuple(lines))
