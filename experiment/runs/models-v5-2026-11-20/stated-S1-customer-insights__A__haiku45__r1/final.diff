    75     def get_top_customers(self, limit: int) -> list[tuple[str, str, int]]:
    76         """Return (customer_id, name, lifetime_value_cents) for top customers by lifetime value.
    77 
    78         Sorted by lifetime value (highest first), then by customer_id.
    79         Excludes customers with 0 lifetime value.
    80         """
    81         customers_with_value = []
    82         for customer in self._customers.list_all():
    83             orders = self._orders.list_for_customer(customer.customer_id)
    84             active_orders = [o for o in orders if o.status != "cancelled"]
    85             lifetime_value = sum(
    86                 self.summarize(o).total_cents for o in active_orders
    87             )
    88             if lifetime_value > 0:
    89                 customers_with_value.append((customer.customer_id, customer.name, lifetime_value))
    90 
    91         customers_with_value.sort(key=lambda x: (-x[2], x[0]))
    92         return customers_with_value[:limit]
    93 
    94     def get_customers_without_active_orders(self) -> list[tuple[str, str, str]]:
    95         """Return (customer_id, name, email) for customers with no active orders.
    96 
    97         In registration order.
    98         """
    99         result = []
   100         for customer in self._customers.list_all():
   101             orders = self._orders.list_for_customer(customer.customer_id)
   102             active_orders = [o for o in orders if o.status != "cancelled"]
   103             if not active_orders:
   104                 result.append((customer.customer_id, customer.name, customer.email))
   105         return result

