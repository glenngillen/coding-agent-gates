42 LOW_STOCK_LINE = 5
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def summary(self, low_stock_line: int = LOW_STOCK_LINE) -> FulfilmentSummary:
54         """Open (not cancelled) orders, units across them, and active products below the low-stock line."""
55         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
56         return FulfilmentSummary(
57             open_orders=len(open_orders),
58             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
59             low_stock_products=len(self.low_stock(low_stock_line)),
60         )
61 
62     def restock(self, sku: str, quantity: int) -> int:
63         """Add ``quantity`` units to a product's stock; returns the new level on hand."""
64         if self._catalog.get(sku) is None:
65             raise ProductNotFound(sku)
66         new_level = self._stock.get(sku) + quantity
67         self._stock.set(sku, new_level)
68         return new_level
69 
70     def low_stock(self, threshold: int) -> list[LowStockProduct]:
71         """Active products with stock on hand strictly below ``threshold``, lowest first, then by SKU."""
72         rows = [LowStockProduct(p, self._stock.get(p.sku))
73                 for p in self._catalog.list_all() if p.active]
74         rows = [row for row in rows if row.on_hand < threshold]
75         return sorted(rows, key=lambda row: (row.on_hand, row.product.sku))
76 
77     def packing_slip(self, order_id: str) -> PackingSlip:
78         """Packing slip for a placed order, with lines in the order's item order."""
79         order = self._orders.get(order_id)
80         if order is None:
81             raise OrderNotFound(order_id)
82         if order.status == "cancelled":
83             raise Conflict(f"order {order_id} is cancelled")
84         customer = self._customers.get(order.customer_id)
85         if customer is None:
86             raise CustomerNotFound(order.customer_id)
87         lines = []
88         for item in order.items:
89             product = self._catalog.get(item.sku)
90             if product is None:
91                 raise ProductNotFound(item.sku)
92             lines.append(PackingLine(item.sku, product.name, item.quantity))
93         return PackingSlip(order.order_id, customer.name, tuple(lines))
