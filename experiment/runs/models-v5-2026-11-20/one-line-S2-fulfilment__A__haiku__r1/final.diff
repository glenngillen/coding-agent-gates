src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             slip = self._service.packing_slip(order_id)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as exc:
23             return conflict(exc)
24         except CustomerNotFound:
25             return not_found("customer")
26         body: dict[str, Any] = {
27             "order_id": slip.order_id,
28             "customer_name": slip.customer_name,
29             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
30                       for line in slip.lines],
31         }
32         return Response(200, body)
33 
34     def handle_low_stock(self, threshold: Any) -> Response:
35         try:
36             limit = require_non_negative_int(threshold, "threshold")
37         except InvalidRequest as exc:
38             return bad_request(exc)
39         products = [{"sku": row.product.sku, "name": row.product.name, "on_hand": row.on_hand}
40                     for row in self._service.low_stock(limit)]
41         return Response(200, {"products": products})
42 
43     def handle_fulfilment_summary(self) -> Response:
44         summary = self._service.summary()
45         return Response(200, {"open_orders": summary.open_orders,
46                               "units_to_pick": summary.units_to_pick,
47                               "low_stock_products": summary.low_stock_products})
48 
49     def handle_restock(self, request: dict[str, Any]) -> Response:
50         try:
51             sku = require_str(request, "sku")
52             quantity = require_positive_int(request.get("quantity"), "quantity")
53         except InvalidRequest as exc:
54             return bad_request(exc)
55         try:
56             on_hand = self._service.restock(sku, quantity)
57         except ProductNotFound:
58             return not_found("product")
59         return Response(200, {"sku": sku, "on_hand": on_hand})
