  3 from __future__ import annotations
  4 
  5 from typing import Any
  6 
  7 from orders.application.errors import CustomerNotFound
  8 from orders.application.order_service import OrderService
  9 from orders.controllers.http import InvalidRequest, Response, bad_request, require_positive_int
 10 from orders.infrastructure.customers import InMemoryCustomerRepository
 11 from orders.infrastructure.repository import InMemoryOrderRepository
 12 
 13 
 14 class CustomerInsightsController:
 15     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository,
 16                  orders: InMemoryOrderRepository) -> None:
 17         self._service = service
 18         self._customers = customers
 19         self._orders = orders
 20 
 21     def handle_order_history(self, customer_id: str) -> Response:
 22         try:
 23             orders = self._service.list_for_customer(customer_id)
 24         except CustomerNotFound:
 25             return Response(404, {"error": "customer not found"})
 26 
 27         order_entries = []
 28         for order in reversed(orders):
 29             summary = self._service.summarize(order)
 30             order_entries.append({
 31                 "order_id": order.order_id,
 32                 "status": order.status,
 33                 "total_cents": summary.total_cents,
 34             })
 35 
 36         return Response(200, {
 37             "customer_id": customer_id,
 38             "orders": order_entries,
 39         })
 40 
 41     def handle_lifetime_value(self, customer_id: str) -> Response:
 42         try:
 43             orders = self._service.list_for_customer(customer_id)
 44         except CustomerNotFound:
 45             return Response(404, {"error": "customer not found"})
 46 
 47         order_count = 0
 48         lifetime_value_cents = 0
 49         for order in orders:
 50             if order.status != "cancelled":
 51                 order_count += 1
 52                 summary = self._service.summarize(order)
 53                 lifetime_value_cents += summary.total_cents
 54 
 55         return Response(200, {
 56             "customer_id": customer_id,
 57             "order_count": order_count,
 58             "lifetime_value_cents": lifetime_value_cents,
 59         })
 60 
 61     def handle_top_customers(self, limit: Any) -> Response:
 62         try:
 63             limit = require_positive_int(limit, "limit")
 64         except InvalidRequest as exc:
 65             return bad_request(exc)
 66 
 67         all_orders = self._orders.list_all()
 68         orders_by_customer = {}
 69         for order in all_orders:
 70             if order.customer_id not in orders_by_customer:
 71                 orders_by_customer[order.customer_id] = []
 72             orders_by_customer[order.customer_id].append(order)
 73 
 74         customer_values = []
 75         for customer in self._customers.list_all():
 76             lifetime_value = 0
 77             for order in orders_by_customer.get(customer.customer_id, []):
 78                 if order.status != "cancelled":
 79                     summary = self._service.summarize(order)
 80                     lifetime_value += summary.total_cents
 81 
 82             if lifetime_value > 0:
 83                 customer_values.append({
 84                     "customer_id": customer.customer_id,
 85                     "name": customer.name,
 86                     "lifetime_value_cents": lifetime_value,
 87                 })
 88 
 89         customer_values.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
 90         return Response(200, {
 91             "customers": customer_values[:limit]
 92         })
 93 
 94     def handle_customers_without_orders(self) -> Response:
 95         all_orders = self._orders.list_all()
 96         customers_with_active_orders = set()
 97         for order in all_orders:
 98             if order.status != "cancelled":
 99                 customers_with_active_orders.add(order.customer_id)
100 
101         customers_without_orders = []
102         for customer in self._customers.list_all():
103             if customer.customer_id not in customers_with_active_orders:
104                 customers_without_orders.append({
105                     "customer_id": customer.customer_id,
106                     "name": customer.name,
107                     "email": customer.email,
108                 })
109 
110         return Response(200, {
111             "customers": customers_without_orders
112         })
