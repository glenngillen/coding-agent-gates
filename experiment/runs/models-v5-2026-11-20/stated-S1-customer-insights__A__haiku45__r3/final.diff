    75     def get_top_customers_by_lifetime_value(self, limit: int) -> list[tuple[str, str, int]]:
    76         """Return (customer_id, name, lifetime_value_cents) for top customers by lifetime value.
    77 
    78         Sorted by lifetime value descending, then customer_id ascending. Only includes customers
    79         with non-zero lifetime value. Returns at most `limit` entries.
    80         """
    81         customers = self._customers.list_all()
    82         customer_values = []
    83         for customer in customers:
    84             lifetime_value = 0
    85             for order in self._orders.list_for_customer(customer.customer_id):
    86                 if order.status != "cancelled":
    87                     lifetime_value += self.summarize(order).total_cents
    88             if lifetime_value > 0:
    89                 customer_values.append((customer.customer_id, customer.name, lifetime_value))
    90 
    91         customer_values.sort(key=lambda x: (-x[2], x[0]))
    92         return customer_values[:limit]
    93 
    94     def get_customers_without_orders(self) -> list[tuple[str, str, str]]:
    95         """Return (customer_id, name, email) for customers with no non-cancelled orders, in registration order."""
    96         customers = self._customers.list_all()
    97         result = []
    98         for customer in customers:
    99             has_non_cancelled = any(
   100                 order.status != "cancelled"
   101                 for order in self._orders.list_for_customer(customer.customer_id)
   102             )
   103             if not has_non_cancelled:
   104                 result.append((customer.customer_id, customer.name, customer.email))
   105         return result

