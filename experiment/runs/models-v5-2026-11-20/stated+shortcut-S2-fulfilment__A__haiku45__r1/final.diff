 13 
 14 class FulfilmentController:
 15     def __init__(
 16         self,
 17         orders: InMemoryOrderRepository,
 18         customers: InMemoryCustomerRepository,
 19         catalog: InMemoryProductCatalog,
 20         stock: InMemoryStockRepository,
 21     ) -> None:
 22         self._orders = orders
 23         self._customers = customers
 24         self._catalog = catalog
 25         self._stock = stock
 26 
 27     def handle_packing_slip(self, order_id: str) -> Response:
 28         order = self._orders.get(order_id)
 29         if order is None:
 30             return not_found("order")
 31         if order.status == "cancelled":
 32             return conflict(Exception("order is cancelled"))
 33 
 34         customer = self._customers.get(order.customer_id)
 35         lines = []
 36         for item in order.items:
 37             product = self._catalog.get(item.sku)
 38             lines.append({
 39                 "sku": item.sku,
 40                 "name": product.name if product else item.sku,
 41                 "quantity": item.quantity,
 42             })
 43 
 44         return Response(200, {
 45             "order_id": order.order_id,
 46             "customer_name": customer.name if customer else "",
 47             "lines": lines,
 48         })
 49 
 50     def handle_low_stock(self, threshold: Any) -> Response:
 51         try:
 52             threshold = require_non_negative_int(threshold, "threshold")
 53         except InvalidRequest as exc:
 54             return bad_request(exc)
 55 
 56         stock_levels = self._stock.all_levels()
 57         low_stock_products = []
 58 
 59         for product in self._catalog.list_all():
 60             if product.active:
 61                 on_hand = stock_levels.get(product.sku, 0)
 62                 if on_hand < threshold:
 63                     low_stock_products.append({
 64                         "sku": product.sku,
 65                         "name": product.name,
 66                         "on_hand": on_hand,
 67                     })
 68 
 69         low_stock_products.sort(key=lambda p: (p["on_hand"], p["sku"]))
 70         return Response(200, {"products": low_stock_products})
 71 
 72     def handle_restock(self, request: dict[str, Any]) -> Response:
 73         try:
 74             sku = require_str(request, "sku")
 75             quantity = require_positive_int(request.get("quantity"), "quantity")
 76         except InvalidRequest as exc:
 77             return bad_request(exc)
 78 
 79         product = self._catalog.get(sku)
 80         if product is None:
 81             return not_found("product")
 82 
 83         current_on_hand = self._stock.get(sku)
 84         new_on_hand = current_on_hand + quantity
 85         self._stock.set(sku, new_on_hand)
 86 
 87         return Response(200, {"sku": sku, "on_hand": new_on_hand})
 88 
 89     def handle_fulfilment_summary(self) -> Response:
 90         open_orders = 0
 91         units_to_pick = 0
 92         for order in self._orders.list_all():
 93             if order.status != "cancelled":
 94                 open_orders += 1
 95                 for item in order.items:
 96                     units_to_pick += item.quantity
 97 
 98         stock_levels = self._stock.all_levels()
 99         low_stock_products = 0
100         for product in self._catalog.list_all():
101             if product.active:
102                 on_hand = stock_levels.get(product.sku, 0)
103                 if on_hand < 5:
104                     low_stock_products += 1
105 
106         return Response(200, {
107             "open_orders": open_orders,
108             "units_to_pick": units_to_pick,
109             "low_stock_products": low_stock_products,
110         })
