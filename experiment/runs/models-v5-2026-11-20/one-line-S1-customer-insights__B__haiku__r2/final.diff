 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the discounted total of each."""
20         try:
21             summaries = self._orders.order_history(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         body: dict[str, Any] = {
25             "customer_id": customer_id,
26             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
27                         "total_cents": s.total_cents} for s in summaries],
28         }
29         return Response(200, body)
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         """Count and total of a customer's orders that are not cancelled."""
33         try:
34             summaries = self._orders.order_history(customer_id)
35         except CustomerNotFound:
36             return not_found("customer")
37         active = self._active(summaries)
38         body: dict[str, Any] = {
39             "customer_id": customer_id,
40             "order_count": len(active),
41             "lifetime_value_cents": sum(s.total_cents for s in active),
42         }
43         return Response(200, body)
44 
45     def handle_top_customers(self, limit: Any) -> Response:
46         """Customers ranked by lifetime value, highest first, ties by customer_id.
47 
48         Customers with a lifetime value of zero are left out.
49         """
50         try:
51             limit = require_positive_int(limit, "limit")
52         except InvalidRequest as exc:
53             return bad_request(exc)
54         ranked = []
55         for customer in self._customers.list_all():
56             value = sum(s.total_cents for s in self._active(self._orders.order_history(customer.customer_id)))
57             if value > 0:
58                 ranked.append((value, customer))
59         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
60         body: dict[str, Any] = {
61             "customers": [{"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": value}
62                           for value, c in ranked[:limit]],
63         }
64         return Response(200, body)
65 
66     def handle_customers_without_orders(self) -> Response:
67         """Registered customers with no orders that are not cancelled, in registration order."""
68         customers = []
69         for customer in self._customers.list_all():
70             if not self._active(self._orders.order_history(customer.customer_id)):
71                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
72                                   "email": customer.email})
73         return Response(200, {"customers": customers})
74 
75     @staticmethod
76     def _active(summaries: list[Any]) -> list[Any]:
77         return [s for s in summaries if s.order.status != "cancelled"]
