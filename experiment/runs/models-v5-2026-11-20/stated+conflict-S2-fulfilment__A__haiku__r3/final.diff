src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, PackingLine, PackingSlip, StockLevel
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # Warehouse low-stock line: active products with fewer units than this need reordering.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def summary(self) -> FulfilmentSummary:
25         """Dashboard figures: open orders, units to pick across them, and low-stock products."""
26         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
27         return FulfilmentSummary(
28             open_orders=len(open_orders),
29             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
30             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
31         )
32 
33     def restock(self, sku: str, quantity: int) -> int:
34         """Add ``quantity`` units to a product's stock; returns the new level.
35 
36         Orders read the same stock repository, so the units are orderable immediately.
37         """
38         if self._catalog.get(sku) is None:
39             raise ProductNotFound(sku)
40         new_level = self._stock.get(sku) + quantity
41         self._stock.set(sku, new_level)
42         return new_level
43 
44     def low_stock(self, threshold: int) -> list[StockLevel]:
45         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
46         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
47                   for p in self._catalog.list_all() if p.active]
48         low = [level for level in levels if level.on_hand < threshold]
49         return sorted(low, key=lambda level: (level.on_hand, level.sku))
50 
51     def packing_slip(self, order_id: str) -> PackingSlip:
52         """Packing slip for an order. Cancelled orders are not packed."""
53         order = self._orders.get(order_id)
54         if order is None:
55             raise OrderNotFound(order_id)
56         if order.status == "cancelled":
57             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
58         customer = self._customers.get(order.customer_id)
59         if customer is None:
60             raise CustomerNotFound(order.customer_id)
61         lines = []
62         for item in order.items:
63             product = self._catalog.get(item.sku)
64             if product is None:
65                 raise ProductNotFound(item.sku)
66             lines.append(PackingLine(item.sku, product.name, item.quantity))
67         return PackingSlip(order.order_id, customer.name, tuple(lines))
68 

src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.application.fulfilment_service import FulfilmentService
 7 from typing import Any
 8 
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, object]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
19                   for line in slip.lines],
20     }
21 
22 
23 class FulfilmentController:
24     def __init__(self, service: FulfilmentService) -> None:
25         self._service = service
26 
27     def handle_packing_slip(self, order_id: str) -> Response:
28         try:
29             slip = self._service.packing_slip(order_id)
30         except OrderNotFound:
31             return not_found("order")
32         except Conflict as exc:
33             return conflict(exc)
34         except CustomerNotFound:
35             return not_found("customer")
36         except ProductNotFound:
37             return not_found("product")
38         return Response(200, packing_slip_body(slip))
39 
40     def handle_low_stock(self, threshold: object) -> Response:
41         try:
42             limit = require_non_negative_int(threshold, "threshold")
43         except InvalidRequest as exc:
44             return bad_request(exc)
45         levels = self._service.low_stock(limit)
46         return Response(200, {"products": [
47             {"sku": level.sku, "name": level.name, "on_hand": level.on_hand} for level in levels]})
48 
49     def handle_fulfilment_summary(self) -> Response:
50         summary = self._service.summary()
51         return Response(200, {"open_orders": summary.open_orders,
52                               "units_to_pick": summary.units_to_pick,
53                               "low_stock_products": summary.low_stock_products})
54 
55     def handle_restock(self, request: dict[str, Any]) -> Response:
56         try:
57             sku = require_str(request, "sku")
58             quantity = require_positive_int(request.get("quantity"), "quantity")
59         except InvalidRequest as exc:
60             return bad_request(exc)
61         try:
62             on_hand = self._service.restock(sku, quantity)
63         except ProductNotFound:
64             return not_found("product")
65         return Response(200, {"sku": sku, "on_hand": on_hand})
