  6 
  7 from orders.controllers.http import Response, not_found, conflict, bad_request, InvalidRequest, require_non_negative_int, require_str, require_positive_int
  8 from orders.infrastructure.repository import InMemoryOrderRepository
  9 from orders.infrastructure.customers import InMemoryCustomerRepository
 10 from orders.infrastructure.catalog import InMemoryProductCatalog
 11 from orders.infrastructure.stock import InMemoryStockRepository
 12 
 13 
 14 class FulfilmentController:
 15     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
 16                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
 17         self._orders = orders
 18         self._customers = customers
 19         self._catalog = catalog
 20         self._stock = stock
 21 
 22     def handle_packing_slip(self, order_id: str) -> Response:
 23         order = self._orders.get(order_id)
 24         if order is None:
 25             return not_found("order")
 26 
 27         if order.status == "cancelled":
 28             return conflict(ValueError("order is cancelled"))
 29 
 30         customer = self._customers.get(order.customer_id)
 31 
 32         lines = []
 33         for item in order.items:
 34             product = self._catalog.get(item.sku)
 35             lines.append({
 36                 "sku": item.sku,
 37                 "name": product.name if product else None,
 38                 "quantity": item.quantity,
 39             })
 40 
 41         return Response(200, {
 42             "order_id": order.order_id,
 43             "customer_name": customer.name if customer else None,
 44             "lines": lines,
 45         })
 46 
 47     def handle_low_stock(self, threshold: Any) -> Response:
 48         try:
 49             threshold_int = require_non_negative_int(threshold, "threshold")
 50         except InvalidRequest as exc:
 51             return bad_request(exc)
 52 
 53         stock_levels = self._stock.all_levels()
 54         low_stock_products = []
 55 
 56         for product in self._catalog.list_all():
 57             if not product.active:
 58                 continue
 59             on_hand = stock_levels.get(product.sku, 0)
 60             if on_hand < threshold_int:
 61                 low_stock_products.append({
 62                     "sku": product.sku,
 63                     "name": product.name,
 64                     "on_hand": on_hand,
 65                 })
 66 
 67         low_stock_products.sort(key=lambda p: (p["on_hand"], p["sku"]))
 68 
 69         return Response(200, {"products": low_stock_products})
 70 
 71     def handle_restock(self, request: dict[str, Any]) -> Response:
 72         try:
 73             sku = require_str(request, "sku")
 74             quantity = require_positive_int(request.get("quantity"), "quantity")
 75         except InvalidRequest as exc:
 76             return bad_request(exc)
 77 
 78         product = self._catalog.get(sku)
 79         if product is None:
 80             return not_found("product")
 81 
 82         current_level = self._stock.get(sku)
 83         new_level = current_level + quantity
 84         self._stock.set(sku, new_level)
 85 
 86         return Response(200, {"sku": sku, "on_hand": new_level})
 87 
 88     def handle_fulfilment_summary(self) -> Response:
 89         stock_levels = self._stock.all_levels()
 90 
 91         open_orders = 0
 92         units_to_pick = 0
 93         for order in self._orders.list_all():
 94             if order.status != "cancelled":
 95                 open_orders += 1
 96                 for item in order.items:
 97                     units_to_pick += item.quantity
 98 
 99         low_stock_products = 0
100         for product in self._catalog.list_all():
101             if product.active:
102                 on_hand = stock_levels.get(product.sku, 0)
103                 if on_hand < 5:
104                     low_stock_products += 1
105 
106         return Response(200, {
107             "open_orders": open_orders,
108             "units_to_pick": units_to_pick,
109             "low_stock_products": low_stock_products,
110         })
