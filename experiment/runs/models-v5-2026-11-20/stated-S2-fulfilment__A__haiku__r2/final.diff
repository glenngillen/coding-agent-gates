src/orders/controllers/fulfilment.py --- Python
 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: FulfilmentService) -> None:
15         self._service = service
16 
17     def handle_fulfilment_summary(self) -> Response:
18         summary = self._service.summary()
19         return Response(200, {"open_orders": summary.open_orders,
20                               "units_to_pick": summary.units_to_pick,
21                               "low_stock_products": summary.low_stock_products})
22 
23     def handle_restock(self, request: dict[str, Any]) -> Response:
24         try:
25             sku = require_str(request, "sku")
26             quantity = require_positive_int(request.get("quantity"), "quantity")
27         except InvalidRequest as exc:
28             return bad_request(exc)
29         try:
30             on_hand = self._service.restock(sku, quantity)
31         except ProductNotFound:
32             return not_found("product")
33         return Response(200, {"sku": sku, "on_hand": on_hand})
34 
35     def handle_low_stock(self, threshold: Any) -> Response:
36         try:
37             threshold = require_non_negative_int(threshold, "threshold")
38         except InvalidRequest as exc:
39             return bad_request(exc)
40         products = self._service.low_stock(threshold)
41         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
42                                            for p in products]})
43 
44     def handle_packing_slip(self, order_id: str) -> Response:
45         try:
46             slip = self._service.packing_slip(order_id)
47         except OrderNotFound:
48             return not_found("order")
49         except Conflict as exc:
50             return conflict(exc)
51         return Response(200, {
52             "order_id": slip.order_id,
53             "customer_name": slip.customer_name,
54             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
55                       for line in slip.lines],
56         })
