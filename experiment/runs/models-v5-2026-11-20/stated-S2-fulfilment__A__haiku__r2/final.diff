 1 """Warehouse fulfilment: packing slips for orders that still need shipping."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingLine, PackingSlip
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # Warehouse low-stock line: products with fewer units on hand than this are low stock.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def summary(self) -> FulfilmentSummary:
25         """Open (not cancelled) orders, units to pick across them, and the low-stock count."""
26         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
27         return FulfilmentSummary(
28             open_orders=len(open_orders),
29             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
30             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
31         )
32 
33     def restock(self, sku: str, quantity: int) -> int:
34         """Add ``quantity`` units to a product's stock and return the new level."""
35         if self._catalog.get(sku) is None:
36             raise ProductNotFound(sku)
37         new_level = self._stock.get(sku) + quantity
38         self._stock.set(sku, new_level)
39         return new_level
40 
41     def low_stock(self, threshold: int) -> list[LowStockProduct]:
42         """Active products whose stock on hand is strictly below ``threshold``, lowest first."""
43         low = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
44                for p in self._catalog.list_all()
45                if p.active and self._stock.get(p.sku) < threshold]
46         return sorted(low, key=lambda item: (item.on_hand, item.sku))
47 
48     def packing_slip(self, order_id: str) -> PackingSlip:
49         order = self._orders.get(order_id)
50         if order is None:
51             raise OrderNotFound(order_id)
52         if order.status == "cancelled":
53             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
54         customer = self._customers.get(order.customer_id)
55         if customer is None:
56             raise CustomerNotFound(order.customer_id)
57         lines = []
58         for item in order.items:
59             product = self._catalog.get(item.sku)
60             if product is None:
61                 raise ProductNotFound(item.sku)
62             lines.append(PackingLine(item.sku, product.name, item.quantity))
63         return PackingSlip(order.order_id, customer.name, tuple(lines))
