 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 from typing import Any
 7 
 8 from orders.application.errors import Conflict, OrderNotFound
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 from orders.infrastructure.stock import InMemoryStockRepository
13 
14 
15 @dataclass(frozen=True)
16 class PackingSlip:
17     order_id: str
18     customer_name: str
19     lines: list[dict[str, Any]]
20 
21 
22 class FulfilmentService:
23     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
24                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
25         self._orders = orders
26         self._customers = customers
27         self._catalog = catalog
28         self._stock = stock
29 
30     def get_packing_slip(self, order_id: str) -> PackingSlip:
31         order = self._orders.get(order_id)
32         if order is None:
33             raise OrderNotFound(order_id)
34         if order.status == "cancelled":
35             raise Conflict(f"order {order_id} is cancelled")
36         customer = self._customers.get(order.customer_id)
37         customer_name = customer.name if customer is not None else ""
38         lines = []
39         for item in order.items:
40             product = self._catalog.get(item.sku)
41             product_name = product.name if product is not None else ""
42             lines.append({"sku": item.sku, "name": product_name, "quantity": item.quantity})
43         return PackingSlip(order.order_id, customer_name, lines)
44 
45     def get_low_stock_products(self, threshold: int) -> list[dict[str, Any]]:
46         products = []
47         for product in self._catalog.list_all():
48             if product.active:
49                 stock_level = self._stock.get(product.sku)
50                 if stock_level < threshold:
51                     products.append({
52                         "sku": product.sku,
53                         "name": product.name,
54                         "on_hand": stock_level,
55                     })
56         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
57         return products
58 
59     def restock(self, sku: str, quantity: int) -> dict[str, Any]:
60         product = self._catalog.get(sku)
61         if product is None:
62             raise OrderNotFound(sku)
63         current_stock = self._stock.get(sku)
64         new_stock = current_stock + quantity
65         self._stock.set(sku, new_stock)
66         return {"sku": sku, "on_hand": new_stock}
67 
68     def get_fulfilment_summary(self) -> dict[str, Any]:
69         open_orders = 0
70         units_to_pick = 0
71         for order in self._orders.list_all():
72             if order.status != "cancelled":
73                 open_orders += 1
74                 for item in order.items:
75                     units_to_pick += item.quantity
76         low_stock_products = 0
77         for product in self._catalog.list_all():
78             if product.active:
79                 stock_level = self._stock.get(product.sku)
80                 if stock_level < 5:
81                     low_stock_products += 1
82         return {
83             "open_orders": open_orders,
84             "units_to_pick": units_to_pick,
85             "low_stock_products": low_stock_products,
86         }
