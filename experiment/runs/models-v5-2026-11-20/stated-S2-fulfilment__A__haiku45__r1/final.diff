 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_positive_int, require_str
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             slip = self._service.get_packing_slip(order_id)
19         except OrderNotFound:
20             return not_found("order")
21         except Conflict as exc:
22             return conflict(exc)
23         return Response(200, {
24             "order_id": slip.order_id,
25             "customer_name": slip.customer_name,
26             "lines": slip.lines,
27         })
28 
29     def handle_low_stock(self, threshold: Any) -> Response:
30         if type(threshold) is not int or isinstance(threshold, bool) or threshold < 0:
31             return bad_request(InvalidRequest("threshold must be a non-negative integer"))
32         products = self._service.get_low_stock_products(threshold)
33         return Response(200, {"products": products})
34 
35     def handle_restock(self, request: dict[str, Any]) -> Response:
36         try:
37             sku = require_str(request, "sku")
38             quantity = require_positive_int(request.get("quantity"), "quantity")
39         except InvalidRequest as exc:
40             return bad_request(exc)
41         try:
42             result = self._service.restock(sku, quantity)
43         except OrderNotFound:
44             return not_found("product")
45         return Response(200, result)
46 
47     def handle_fulfilment_summary(self) -> Response:
48         summary = self._service.get_fulfilment_summary()
49         return Response(200, summary)
