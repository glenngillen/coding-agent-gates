 7 from orders.application.order_service import OrderService
 8 from orders.controllers.http import InvalidRequest, Response, bad_request
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, customers: InMemoryCustomerRepository, order_service: OrderService) -> None:
14         self._customers = customers
15         self._order_service = order_service
16 
17     def handle_order_history(self, customer_id: str) -> Response:
18         if self._customers.get(customer_id) is None:
19             return Response(404, {"error": "customer not found"})
20 
21         orders = self._order_service.list_for_customer(customer_id)
22         orders_reversed = reversed(orders)
23 
24         order_entries = []
25         for order in orders_reversed:
26             summary = self._order_service.summarize(order)
27             order_entries.append({
28                 "order_id": order.order_id,
29                 "status": order.status,
30                 "total_cents": summary.total_cents,
31             })
32 
33         return Response(200, {
34             "customer_id": customer_id,
35             "orders": order_entries,
36         })
37 
38     def handle_lifetime_value(self, customer_id: str) -> Response:
39         if self._customers.get(customer_id) is None:
40             return Response(404, {"error": "customer not found"})
41 
42         orders = self._order_service.list_for_customer(customer_id)
43 
44         order_count = 0
45         lifetime_value_cents = 0
46         for order in orders:
47             if order.status != "cancelled":
48                 order_count += 1
49                 summary = self._order_service.summarize(order)
50                 lifetime_value_cents += summary.total_cents
51 
52         return Response(200, {
53             "customer_id": customer_id,
54             "order_count": order_count,
55             "lifetime_value_cents": lifetime_value_cents,
56         })
57 
58     def handle_top_customers(self, limit: Any) -> Response:
59         try:
60             if type(limit) is not int or isinstance(limit, bool) or limit < 1:
61                 raise InvalidRequest("limit must be a positive integer")
62         except InvalidRequest as exc:
63             return bad_request(exc)
64 
65         customers_list = []
66         for customer in self._customers.list_all():
67             orders = self._order_service.list_for_customer(customer.customer_id)
68             lifetime_value_cents = 0
69             for order in orders:
70                 if order.status != "cancelled":
71                     summary = self._order_service.summarize(order)
72                     lifetime_value_cents += summary.total_cents
73 
74             if lifetime_value_cents > 0:
75                 customers_list.append({
76                     "customer_id": customer.customer_id,
77                     "name": customer.name,
78                     "lifetime_value_cents": lifetime_value_cents,
79                 })
80 
81         customers_list.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
82         return Response(200, {"customers": customers_list[:limit]})
83 
84     def handle_customers_without_orders(self) -> Response:
85         customers_list = []
86         for customer in self._customers.list_all():
87             orders = self._order_service.list_for_customer(customer.customer_id)
88             has_non_cancelled_orders = any(order.status != "cancelled" for order in orders)
89 
90             if not has_non_cancelled_orders:
91                 customers_list.append({
92                     "customer_id": customer.customer_id,
93                     "name": customer.name,
94                     "email": customer.email,
95                 })
96 
97         return Response(200, {"customers": customers_list})
