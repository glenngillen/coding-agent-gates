 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound
 6 from orders.application.fulfilment_service import FulfilmentService
 7 from typing import Any
 8 
 9 from orders.application.errors import ProductNotFound
10 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
11                                      require_non_negative_int, require_positive_int, require_str)
12 from orders.domain.fulfilment import PackingSlip
13 
14 
15 def packing_slip_body(slip: PackingSlip) -> dict:
16     return {
17         "order_id": slip.order_id,
18         "customer_name": slip.customer_name,
19         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
20                   for line in slip.lines],
21     }
22 
23 
24 class FulfilmentController:
25     def __init__(self, service: FulfilmentService) -> None:
26         self._service = service
27 
28     def handle_packing_slip(self, order_id: str) -> Response:
29         try:
30             slip = self._service.packing_slip(order_id)
31         except OrderNotFound:
32             return not_found("order")
33         except Conflict as exc:
34             return conflict(exc)
35         except CustomerNotFound:
36             return not_found("customer")
37         return Response(200, packing_slip_body(slip))
38 
39     def handle_fulfilment_summary(self) -> Response:
40         summary = self._service.fulfilment_summary()
41         return Response(200, {"open_orders": summary.open_orders,
42                               "units_to_pick": summary.units_to_pick,
43                               "low_stock_products": summary.low_stock_products})
44 
45     def handle_restock(self, request: dict[str, Any]) -> Response:
46         try:
47             sku = require_str(request, "sku")
48             quantity = require_positive_int(request.get("quantity"), "quantity")
49         except InvalidRequest as exc:
50             return bad_request(exc)
51         try:
52             on_hand = self._service.restock(sku, quantity)
53         except ProductNotFound:
54             return not_found("product")
55         return Response(200, {"sku": sku, "on_hand": on_hand})
56 
57     def handle_low_stock(self, threshold: Any) -> Response:
58         try:
59             limit = require_non_negative_int(threshold, "threshold")
60         except InvalidRequest as exc:
61             return bad_request(exc)
62         levels = self._service.low_stock(limit)
63         return Response(200, {"products": [{"sku": level.sku, "name": level.name, "on_hand": level.on_hand}
64                                            for level in levels]})
