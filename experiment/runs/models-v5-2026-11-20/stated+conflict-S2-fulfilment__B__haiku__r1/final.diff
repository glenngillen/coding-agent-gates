 1 """Warehouse fulfilment: packing slips for orders that are still to be packed, and stock alerts."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.catalog_service import CatalogService
 6 from orders.application.errors import Conflict, CustomerNotFound
 7 from orders.application.order_service import OrderService
 8 from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 LOW_STOCK_THRESHOLD = 5
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, catalog_service: CatalogService) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._catalog_service = catalog_service
22 
23     def packing_slip(self, order_id: str) -> PackingSlip:
24         """Raises OrderNotFound, or Conflict if the order has been cancelled."""
25         order = self._orders.get_order(order_id)
26         if order.status == "cancelled":
27             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
28         customer = self._customers.get(order.customer_id)
29         if customer is None:
30             raise CustomerNotFound(order.customer_id)
31         lines = []
32         for item in order.items:
33             product = self._catalog.get(item.sku)
34             name = product.name if product is not None else item.sku
35             lines.append(PackingSlipLine(item.sku, name, item.quantity))
36         return PackingSlip(order.order_id, customer.name, tuple(lines))
37 
38     def restock(self, sku: str, quantity: int) -> int:
39         """Add stock for a product; the units are orderable immediately. Raises ProductNotFound."""
40         return self._catalog_service.restock(sku, quantity)
41 
42     def fulfilment_summary(self) -> FulfilmentSummary:
43         """Open (not cancelled) orders, units across them, and active products below the low-stock line."""
44         open_orders = self._orders.list_open()
45         units = sum(item.quantity for order in open_orders for item in order.items)
46         return FulfilmentSummary(
47             open_orders=len(open_orders),
48             units_to_pick=units,
49             low_stock_products=len(self.low_stock(LOW_STOCK_THRESHOLD)),
50         )
51 
52     def low_stock(self, threshold: int) -> list[StockLevel]:
53         """Active products with on-hand stock strictly below ``threshold``, lowest stock first, then SKU."""
54         levels = [StockLevel(p.sku, p.name, self._catalog_service.on_hand(p.sku))
55                   for p in self._catalog_service.list_active()]
56         return sorted((level for level in levels if level.on_hand < threshold),
57                       key=lambda level: (level.on_hand, level.sku))
