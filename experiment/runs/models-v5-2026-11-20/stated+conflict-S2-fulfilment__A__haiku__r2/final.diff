13 @dataclass(frozen=True)
14 class PackingSlipLine:
15     sku: str
16     name: str
17     quantity: int
18 
19 
20 @dataclass(frozen=True)
21 class PackingSlip:
22     order_id: str
23     customer_name: str
24     lines: tuple[PackingSlipLine, ...]
25 
26 
27 @dataclass(frozen=True)
28 class LowStockProduct:
29     sku: str
30     name: str
31     on_hand: int
32 
