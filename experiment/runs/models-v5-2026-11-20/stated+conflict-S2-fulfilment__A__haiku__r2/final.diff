41 # The warehouse's low-stock line: products with fewer units than this on hand are low.
42 LOW_STOCK_LINE = 5
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: OrderService, customers: CustomerService, catalog: CatalogService) -> None:
47         self._orders = orders
48         self._customers = customers
49         self._catalog = catalog
50 
51     def packing_slip(self, order_id: str) -> PackingSlip:
52         """Raises OrderNotFound for unknown orders and OrderCancelled for cancelled ones."""
53         order = self._orders.get_order(order_id)
54         if order.status == "cancelled":
55             raise OrderCancelled(f"order {order_id} is cancelled and cannot be packed")
56         customer = self._customers.get(order.customer_id)
57         lines = tuple(
58             PackingSlipLine(item.sku, self._catalog.get_product(item.sku).name, item.quantity)
59             for item in order.items
60         )
61         return PackingSlip(order.order_id, customer.name, lines)
62 
63     def low_stock(self, threshold: int) -> list[LowStockProduct]:
64         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
65         rows = [LowStockProduct(p.sku, p.name, self._catalog.on_hand(p.sku))
66                 for p in self._catalog.list_active()]
67         return sorted((r for r in rows if r.on_hand < threshold), key=lambda r: (r.on_hand, r.sku))
68 
69     def restock(self, sku: str, quantity: int) -> int:
70         """Raises ProductNotFound for unknown SKUs. Returns the new stock level."""
71         return self._catalog.restock(sku, quantity)
72 
73     def summary(self) -> FulfilmentSummary:
74         """Open (not cancelled) orders, units across them, and products below the low-stock line."""
75         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
76         units = sum(item.quantity for order in open_orders for item in order.items)
77         return FulfilmentSummary(
78             open_orders=len(open_orders),
79             units_to_pick=units,
80             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
81         )
