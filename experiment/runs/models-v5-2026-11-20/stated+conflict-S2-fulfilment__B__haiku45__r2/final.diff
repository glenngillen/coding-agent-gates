 1 """Fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.catalog_service import CatalogService
 8 from orders.application.errors import OrderNotFound, ProductNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import (Response, not_found, conflict, bad_request, InvalidRequest,
11                                      require_str, require_positive_int)
12 
13 
14 class FulfilmentController:
15     def __init__(self, service: OrderService, catalog_service: CatalogService) -> None:
16         self._service = service
17         self._catalog_service = catalog_service
18 
19     def handle_packing_slip(self, order_id: str) -> Response:
20         try:
21             order = self._service.get_order(order_id)
22         except OrderNotFound:
23             return not_found("order")
24 
25         if order.status == "cancelled":
26             return conflict(ValueError(f"order {order_id} is cancelled"))
27 
28         packing_slip = self._service.get_packing_slip(order_id)
29         return Response(200, packing_slip)
30 
31     def handle_low_stock(self, threshold: Any) -> Response:
32         if type(threshold) is not int or isinstance(threshold, bool) or threshold < 0:
33             return bad_request(InvalidRequest("threshold must be a non-negative integer"))
34         products = self._catalog_service.get_low_stock_products(threshold)
35         return Response(200, {"products": products})
36 
37     def handle_restock(self, request: dict[str, Any]) -> Response:
38         try:
39             sku = require_str(request, "sku")
40             quantity = require_positive_int(request.get("quantity"), "quantity")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         try:
44             result = self._catalog_service.restock(sku, quantity)
45         except ProductNotFound:
46             return not_found("product")
47         return Response(200, result)
48 
49     def handle_fulfilment_summary(self) -> Response:
50         orders_summary = self._service.get_open_orders_summary()
51         low_stock_count = self._catalog_service.count_low_stock_products(5)
52         return Response(200, {
53             "open_orders": orders_summary["open_orders"],
54             "units_to_pick": orders_summary["units_to_pick"],
55             "low_stock_products": low_stock_count,
56         })
