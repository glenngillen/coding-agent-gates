 1 """Warehouse fulfilment: packing slips and order preparation."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.domain.orders import Order
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 
13 class FulfilmentService:
14     def __init__(
15         self,
16         orders: InMemoryOrderRepository,
17         customers: InMemoryCustomerRepository,
18         catalog: InMemoryProductCatalog,
19         stock: InMemoryStockRepository,
20     ) -> None:
21         self._orders = orders
22         self._customers = customers
23         self._catalog = catalog
24         self._stock = stock
25 
26     def get_packing_slip(self, order_id: str) -> dict:
27         order = self._orders.get(order_id)
28         if order is None:
29             raise OrderNotFound(order_id)
30 
31         if order.status == "cancelled":
32             raise Conflict("cannot pack a cancelled order")
33 
34         customer = self._customers.get(order.customer_id)
35         lines = []
36         for item in order.items:
37             product = self._catalog.get(item.sku)
38             lines.append({
39                 "sku": item.sku,
40                 "name": product.name if product else item.sku,
41                 "quantity": item.quantity,
42             })
43 
44         return {
45             "order_id": order.order_id,
46             "customer_name": customer.name if customer else "",
47             "lines": lines,
48         }
49 
50     def get_low_stock_products(self, threshold: int) -> list[dict]:
51         products = []
52         for product in self._catalog.list_all():
53             if product.active and self._stock.get(product.sku) < threshold:
54                 products.append({
55                     "sku": product.sku,
56                     "name": product.name,
57                     "on_hand": self._stock.get(product.sku),
58                 })
59         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
60         return products
61 
62     def restock(self, sku: str, quantity: int) -> dict:
63         product = self._catalog.get(sku)
64         if product is None:
65             raise ProductNotFound(sku)
66         new_level = self._stock.get(sku) + quantity
67         self._stock.set(sku, new_level)
68         return {"sku": sku, "on_hand": new_level}
69 
70     def get_fulfilment_summary(self) -> dict:
71         open_orders = 0
72         units_to_pick = 0
73         for order in self._orders.list_all():
74             if order.status != "cancelled":
75                 open_orders += 1
76                 for item in order.items:
77                     units_to_pick += item.quantity
78 
79         low_stock_products = 0
80         for product in self._catalog.list_all():
81             if product.active and self._stock.get(product.sku) < 5:
82                 low_stock_products += 1
83 
84         return {
85             "open_orders": open_orders,
86             "units_to_pick": units_to_pick,
87             "low_stock_products": low_stock_products,
88         }
