 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import Response, bad_request, conflict, not_found, require_str, require_positive_int
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             packing_slip = self._service.get_packing_slip(order_id)
19             return Response(200, packing_slip)
20         except OrderNotFound:
21             return not_found("order")
22         except Conflict as e:
23             return conflict(e)
24 
25     def handle_low_stock(self, threshold: int) -> Response:
26         if type(threshold) is not int or threshold < 0:
27             return bad_request(ValueError("threshold must be a non-negative integer"))
28         products = self._service.get_low_stock_products(threshold)
29         return Response(200, {"products": products})
30 
31     def handle_restock(self, request: dict[str, Any]) -> Response:
32         try:
33             sku = require_str(request, "sku")
34             quantity = require_positive_int(request.get("quantity"), "quantity")
35             result = self._service.restock(sku, quantity)
36             return Response(200, result)
37         except ProductNotFound:
38             return not_found("product")
39         except ValueError as e:
40             return bad_request(e)
41 
42     def handle_fulfilment_summary(self) -> Response:
43         summary = self._service.get_fulfilment_summary()
44         return Response(200, summary)
