 1 """Customer insights endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, order_service: OrderService) -> None:
14         self._order_service = order_service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             summaries = self._order_service.get_order_history(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         order_entries = [
22             {
23                 "order_id": summary.order.order_id,
24                 "status": summary.order.status,
25                 "total_cents": summary.total_cents,
26             }
27             for summary in summaries
28         ]
29         return Response(200, {"customer_id": customer_id, "orders": order_entries})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             order_count, lifetime_value = self._order_service.get_customer_lifetime_value(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         return Response(200, {
37             "customer_id": customer_id,
38             "order_count": order_count,
39             "lifetime_value_cents": lifetime_value,
40         })
41 
42     def handle_top_customers(self, limit: Any) -> Response:
43         try:
44             if type(limit) is not int or isinstance(limit, bool) or limit < 1:
45                 raise InvalidRequest("limit must be a positive integer")
46             customers = self._order_service.get_top_customers(limit)
47             return Response(200, {"customers": customers})
48         except InvalidRequest as exc:
49             return bad_request(exc)
50 
51     def handle_customers_without_orders(self) -> Response:
52         customers = self._order_service.get_customers_without_orders()
53         return Response(200, {"customers": customers})
