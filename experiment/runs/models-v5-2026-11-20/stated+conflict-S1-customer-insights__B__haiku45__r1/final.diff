    75     def get_order_history(self, customer_id: str) -> list[OrderSummary]:
    76         """Get order history for a customer, newest first."""
    77         orders = self.list_for_customer(customer_id)
    78         return [self.summarize(order) for order in reversed(orders)]
    79 
    80     def get_customer_lifetime_value(self, customer_id: str) -> tuple[int, int]:
    81         """Get order count and lifetime value for a customer (excluding cancelled orders).
    82 
    83         Returns: (order_count, lifetime_value_cents)
    84         """
    85         orders = self.list_for_customer(customer_id)
    86         active_orders = [o for o in orders if o.status != "cancelled"]
    87         order_count = len(active_orders)
    88         lifetime_value = sum(self.summarize(order).total_cents for order in active_orders)
    89         return order_count, lifetime_value
    90 
    91     def get_top_customers(self, limit: int) -> list[dict]:
    92         """Get top customers by lifetime value (excluding 0 value), sorted by value then ID.
    93 
    94         Returns: List of dicts with customer_id, name, and lifetime_value_cents.
    95         """
    96         customers_data = []
    97         for customer in self._customers.list_all():
    98             _, lifetime_value = self.get_customer_lifetime_value(customer.customer_id)
    99             if lifetime_value > 0:
   100                 customers_data.append({
   101                     "customer_id": customer.customer_id,
   102                     "name": customer.name,
   103                     "lifetime_value_cents": lifetime_value,
   104                 })
   105         customers_data.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
   106         return customers_data[:limit]
   107 
   108     def get_customers_without_orders(self) -> list[dict]:
   109         """Get customers with no non-cancelled orders, in registration order.
   110 
   111         Returns: List of dicts with customer_id, name, and email.
   112         """
   113         customers_without_orders = []
   114         for customer in self._customers.list_all():
   115             orders = self._orders.list_for_customer(customer.customer_id)
   116             active_orders = [o for o in orders if o.status != "cancelled"]
   117             if not active_orders:
   118                 customers_without_orders.append({
   119                     "customer_id": customer.customer_id,
   120                     "name": customer.name,
   121                     "email": customer.email,
   122                 })
   123         return customers_without_orders

