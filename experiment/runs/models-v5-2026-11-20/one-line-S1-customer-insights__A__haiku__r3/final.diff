 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the totals the order summary reports."""
20         try:
21             history = self._history(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         return Response(200, {"customer_id": customer_id, "orders": history})
25 
26     def handle_lifetime_value(self, customer_id: str) -> Response:
27         """Count and total of a customer's orders that are not cancelled."""
28         try:
29             count, total = self._lifetime(customer_id)
30         except CustomerNotFound:
31             return not_found("customer")
32         return Response(200, {"customer_id": customer_id, "order_count": count,
33                               "lifetime_value_cents": total})
34 
35     def handle_top_customers(self, limit: Any) -> Response:
36         """Customers with the highest lifetime value, skipping those with none."""
37         try:
38             limit = require_positive_int(limit, "limit")
39         except InvalidRequest as exc:
40             return bad_request(exc)
41         ranked = []
42         for customer in self._customers.list_all():
43             _, total = self._lifetime(customer.customer_id)
44             if total > 0:
45                 ranked.append((total, customer))
46         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
47         return Response(200, {"customers": [
48             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
49             for total, c in ranked[:limit]
50         ]})
51 
52     def handle_customers_without_orders(self) -> Response:
53         """Registered customers with no orders that are not cancelled, in registration order."""
54         return Response(200, {"customers": [
55             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
56             for c in self._customers.list_all()
57             if self._lifetime(c.customer_id)[0] == 0
58         ]})
59 
60     def _lifetime(self, customer_id: str) -> tuple[int, int]:
61         active = [entry for entry in self._history(customer_id) if entry["status"] != "cancelled"]
62         return len(active), sum(entry["total_cents"] for entry in active)
63 
64     def _history(self, customer_id: str) -> list[dict[str, Any]]:
65         orders = self._orders.list_for_customer(customer_id)
66         # list_for_customer returns creation order; newest first is the reverse.
67         return [
68             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
69             for s in (self._orders.summarize(o) for o in reversed(orders))
70         ]
