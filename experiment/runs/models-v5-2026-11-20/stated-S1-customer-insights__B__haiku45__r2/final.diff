11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             orders = self._service.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         orders_data = []
22         for order in reversed(orders):
23             summary = self._service.summarize(order)
24             orders_data.append({
25                 "order_id": order.order_id,
26                 "status": order.status,
27                 "total_cents": summary.total_cents,
28             })
29         return Response(200, {"customer_id": customer_id, "orders": orders_data})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             orders = self._service.list_for_customer(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         order_count = 0
37         lifetime_value_cents = 0
38         for order in orders:
39             if order.status != "cancelled":
40                 order_count += 1
41                 summary = self._service.summarize(order)
42                 lifetime_value_cents += summary.total_cents
43         return Response(200, {
44             "customer_id": customer_id,
45             "order_count": order_count,
46             "lifetime_value_cents": lifetime_value_cents,
47         })
48 
49     def handle_top_customers(self, limit: Any) -> Response:
50         try:
51             limit_int = require_positive_int(limit, "limit")
52         except InvalidRequest as exc:
53             return bad_request(exc)
54 
55         customer_values = self._service.customer_lifetime_values()
56         filtered = [(cid, name, value) for cid, name, value in customer_values if value > 0]
57         sorted_customers = sorted(filtered, key=lambda x: (-x[2], x[0]))
58         top_customers = sorted_customers[:limit_int]
59 
60         return Response(200, {
61             "customers": [
62                 {
63                     "customer_id": cid,
64                     "name": name,
65                     "lifetime_value_cents": value,
66                 }
67                 for cid, name, value in top_customers
68             ]
69         })
70 
71     def handle_customers_without_orders(self) -> Response:
72         customers = self._service.customers_without_active_orders()
73         return Response(200, {
74             "customers": [
75                 {
76                     "customer_id": cid,
77                     "name": name,
78                     "email": email,
79                 }
80                 for cid, name, email in customers
81             ]
82         })
