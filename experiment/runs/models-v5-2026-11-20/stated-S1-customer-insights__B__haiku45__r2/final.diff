    75     def customer_lifetime_values(self) -> list[tuple[str, str, int]]:
    76         """Return (customer_id, name, lifetime_value_cents) for all customers.
    77 
    78         Lifetime value is the sum of non-cancelled order totals (including discounts).
    79         """
    80         result = []
    81         for customer in self._customers.list_all():
    82             lifetime_value = 0
    83             for order in self._orders.list_for_customer(customer.customer_id):
    84                 if order.status != "cancelled":
    85                     summary = self.summarize(order)
    86                     lifetime_value += summary.total_cents
    87             result.append((customer.customer_id, customer.name, lifetime_value))
    88         return result
    89 
    90     def customers_without_active_orders(self) -> list[tuple[str, str, str]]:
    91         """Return (customer_id, name, email) for customers with no non-cancelled orders.
    92 
    93         Returned in registration order.
    94         """
    95         result = []
    96         for customer in self._customers.list_all():
    97             has_active_order = any(
    98                 order.status != "cancelled"
    99                 for order in self._orders.list_for_customer(customer.customer_id)
   100             )
   101             if not has_active_order:
   102                 result.append((customer.customer_id, customer.name, customer.email))
   103         return result

