 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 from typing import Any
 7 
 8 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 9 from orders.domain.orders import Order
10 from orders.infrastructure.catalog import InMemoryProductCatalog
11 from orders.infrastructure.customers import InMemoryCustomerRepository
12 from orders.infrastructure.repository import InMemoryOrderRepository
13 from orders.infrastructure.stock import InMemoryStockRepository
14 
15 
16 @dataclass(frozen=True)
17 class PackingSlip:
18     order_id: str
19     customer_name: str
20     lines: list[dict[str, Any]]
21 
22 
23 class FulfilmentService:
24     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
25                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
26         self._orders = orders
27         self._customers = customers
28         self._catalog = catalog
29         self._stock = stock
30 
31     def get_packing_slip(self, order_id: str) -> PackingSlip:
32         order = self._orders.get(order_id)
33         if order is None:
34             raise OrderNotFound(order_id)
35         if order.status == "cancelled":
36             raise Conflict(f"order {order_id} is cancelled")
37         customer = self._customers.get(order.customer_id)
38         customer_name = customer.name if customer is not None else ""
39         lines = []
40         for item in order.items:
41             product = self._catalog.get(item.sku)
42             product_name = product.name if product is not None else ""
43             lines.append({
44                 "sku": item.sku,
45                 "name": product_name,
46                 "quantity": item.quantity,
47             })
48         return PackingSlip(order.order_id, customer_name, lines)
49 
50     def get_low_stock_products(self, threshold: int) -> list[dict[str, Any]]:
51         products = []
52         for product in self._catalog.list_all():
53             if product.active and self._stock.get(product.sku) < threshold:
54                 products.append({
55                     "sku": product.sku,
56                     "name": product.name,
57                     "on_hand": self._stock.get(product.sku),
58                 })
59         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
60         return products
61 
62     def restock(self, sku: str, quantity: int) -> dict[str, Any]:
63         product = self._catalog.get(sku)
64         if product is None:
65             raise ProductNotFound(sku)
66         new_level = self._stock.get(sku) + quantity
67         self._stock.set(sku, new_level)
68         return {"sku": sku, "on_hand": new_level}
69 
70     def get_fulfilment_summary(self) -> dict[str, Any]:
71         open_orders = sum(1 for order in self._orders.list_all() if order.status != "cancelled")
72         units_to_pick = sum(item.quantity for order in self._orders.list_all()
73                             if order.status != "cancelled" for item in order.items)
74         low_stock_products = sum(1 for product in self._catalog.list_all()
75                                  if product.active and self._stock.get(product.sku) < 5)
76         return {
77             "open_orders": open_orders,
78             "units_to_pick": units_to_pick,
79             "low_stock_products": low_stock_products,
80         }
