 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_non_negative_int, require_positive_int, require_str
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             slip = self._service.get_packing_slip(order_id)
19         except OrderNotFound:
20             return not_found("order")
21         except Conflict as exc:
22             return conflict(exc)
23         return Response(200, {
24             "order_id": slip.order_id,
25             "customer_name": slip.customer_name,
26             "lines": slip.lines,
27         })
28 
29     def handle_low_stock(self, threshold: Any) -> Response:
30         try:
31             threshold = require_non_negative_int(threshold, "threshold")
32         except InvalidRequest as exc:
33             return bad_request(exc)
34         products = self._service.get_low_stock_products(threshold)
35         return Response(200, {"products": products})
36 
37     def handle_restock(self, request: dict[str, Any]) -> Response:
38         try:
39             sku = require_str(request, "sku")
40             quantity = require_positive_int(request.get("quantity"), "quantity")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         try:
44             result = self._service.restock(sku, quantity)
45         except ProductNotFound:
46             return not_found("product")
47         return Response(200, result)
48 
49     def handle_fulfilment_summary(self) -> Response:
50         summary = self._service.get_fulfilment_summary()
51         return Response(200, summary)
