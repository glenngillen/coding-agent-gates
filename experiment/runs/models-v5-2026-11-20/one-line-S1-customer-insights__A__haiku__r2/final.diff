src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 from orders.domain.orders import Order
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
16         self._orders = orders
17         self._customers = customers
18 
19     def handle_order_history(self, customer_id: str) -> Response:
20         """A customer's orders, newest first, with the totals the order summary reports."""
21         try:
22             orders = self._orders.list_for_customer(customer_id)
23         except CustomerNotFound:
24             return not_found("customer")
25         # list_for_customer returns creation order; reverse it for newest first.
26         history: list[dict[str, Any]] = [
27             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
28             for s in (self._orders.summarize(o) for o in reversed(orders))
29         ]
30         return Response(200, {"customer_id": customer_id, "orders": history})
31 
32     def handle_lifetime_value(self, customer_id: str) -> Response:
33         """Count and total of a customer's orders, leaving out cancelled ones."""
34         try:
35             orders = self._orders.list_for_customer(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         count, total = self._lifetime_value(orders)
39         return Response(200, {"customer_id": customer_id, "order_count": count,
40                               "lifetime_value_cents": total})
41 
42     def handle_top_customers(self, limit: Any) -> Response:
43         """Customers ranked by lifetime value, highest first, ties broken by customer_id."""
44         try:
45             limit = require_positive_int(limit, "limit")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         ranked = []
49         for customer in self._customers.list_all():
50             _, total = self._lifetime_value(self._orders.list_for_customer(customer.customer_id))
51             if total > 0:
52                 ranked.append((total, customer))
53         ranked.sort(key=lambda entry: (-entry[0], entry[1].customer_id))
54         return Response(200, {"customers": [
55             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
56             for total, c in ranked[:limit]
57         ]})
58 
59     def handle_customers_without_orders(self) -> Response:
60         """Registered customers with no orders that are not cancelled, in registration order."""
61         customers = []
62         for customer in self._customers.list_all():
63             count, _ = self._lifetime_value(self._orders.list_for_customer(customer.customer_id))
64             if count == 0:
65                 customers.append({"customer_id": customer.customer_id, "name": customer.name,
66                                   "email": customer.email})
67         return Response(200, {"customers": customers})
68 
69     def _lifetime_value(self, orders: list[Order]) -> tuple[int, int]:
70         """(number of non-cancelled orders, sum of their totals including discounts)."""
71         totals = [self._orders.summarize(o).total_cents for o in orders if o.status != "cancelled"]
72         return len(totals), sum(totals)
