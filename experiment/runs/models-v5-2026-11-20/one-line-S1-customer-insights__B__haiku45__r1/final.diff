    75     def get_top_customers(self, limit: int) -> list[dict[str, object]]:
    76         """Get top customers by lifetime value (non-cancelled orders only)."""
    77         customers_data = []
    78         for customer in self._customers.list_all():
    79             lifetime_value = 0
    80             for order in self._orders.list_for_customer(customer.customer_id):
    81                 if order.status != "cancelled":
    82                     summary = self.summarize(order)
    83                     lifetime_value += summary.total_cents
    84             if lifetime_value > 0:
    85                 customers_data.append({
    86                     "customer_id": customer.customer_id,
    87                     "name": customer.name,
    88                     "lifetime_value_cents": lifetime_value,
    89                 })
    90         customers_data.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
    91         return customers_data[:limit]
    92 
    93     def get_customers_without_orders(self) -> list[dict[str, object]]:
    94         """Get customers with no non-cancelled orders, in registration order."""
    95         customers_data = []
    96         for customer in self._customers.list_all():
    97             has_non_cancelled_order = False
    98             for order in self._orders.list_for_customer(customer.customer_id):
    99                 if order.status != "cancelled":
   100                     has_non_cancelled_order = True
   101                     break
   102             if not has_non_cancelled_order:
   103                 customers_data.append({
   104                     "customer_id": customer.customer_id,
   105                     "name": customer.name,
   106                     "email": customer.email,
   107                 })
   108         return customers_data

