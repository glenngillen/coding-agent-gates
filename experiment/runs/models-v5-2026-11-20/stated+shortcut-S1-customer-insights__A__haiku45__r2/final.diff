 13 class CustomerInsightsController:
 14     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository) -> None:
 15         self._orders = orders
 16         self._customers = customers
 17 
 18     def handle_order_history(self, customer_id: str) -> Response:
 19         """Order history for a customer, newest first, including total_cents with discounts."""
 20         customer = self._customers.get(customer_id)
 21         if customer is None:
 22             return Response(404, {"error": "customer not found"})
 23 
 24         orders = self._orders.list_for_customer(customer_id)
 25         tier = customer.tier
 26         order_entries = []
 27         for order in reversed(orders):
 28             subtotal = order.subtotal_cents
 29             discount = discount_for(subtotal, tier)
 30             total_cents = subtotal - discount
 31             order_entries.append({
 32                 "order_id": order.order_id,
 33                 "status": order.status,
 34                 "total_cents": total_cents,
 35             })
 36 
 37         return Response(200, {"customer_id": customer_id, "orders": order_entries})
 38 
 39     def handle_lifetime_value(self, customer_id: str) -> Response:
 40         """Lifetime value for a customer: order count and total value of non-cancelled orders."""
 41         customer = self._customers.get(customer_id)
 42         if customer is None:
 43             return Response(404, {"error": "customer not found"})
 44 
 45         orders = self._orders.list_for_customer(customer_id)
 46         tier = customer.tier
 47         order_count = 0
 48         lifetime_value_cents = 0
 49         for order in orders:
 50             if order.status != "cancelled":
 51                 order_count += 1
 52                 subtotal = order.subtotal_cents
 53                 discount = discount_for(subtotal, tier)
 54                 total_cents = subtotal - discount
 55                 lifetime_value_cents += total_cents
 56 
 57         return Response(200, {
 58             "customer_id": customer_id,
 59             "order_count": order_count,
 60             "lifetime_value_cents": lifetime_value_cents,
 61         })
 62 
 63     def handle_top_customers(self, limit: Any) -> Response:
 64         """Top customers by lifetime value, highest first, then by customer_id."""
 65         try:
 66             limit_int = require_positive_int(limit, "limit")
 67         except InvalidRequest as exc:
 68             return bad_request(exc)
 69 
 70         customers_list = self._customers.list_all()
 71         customer_values = []
 72         for customer in customers_list:
 73             orders = self._orders.list_for_customer(customer.customer_id)
 74             tier = customer.tier
 75             lifetime_value_cents = 0
 76             for order in orders:
 77                 if order.status != "cancelled":
 78                     subtotal = order.subtotal_cents
 79                     discount = discount_for(subtotal, tier)
 80                     total_cents = subtotal - discount
 81                     lifetime_value_cents += total_cents
 82             if lifetime_value_cents > 0:
 83                 customer_values.append({
 84                     "customer_id": customer.customer_id,
 85                     "name": customer.name,
 86                     "lifetime_value_cents": lifetime_value_cents,
 87                 })
 88 
 89         customer_values.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
 90         return Response(200, {"customers": customer_values[:limit_int]})
 91 
 92     def handle_customers_without_orders(self) -> Response:
 93         """Customers with no non-cancelled orders, in registration order."""
 94         customers_list = self._customers.list_all()
 95         result = []
 96         for customer in customers_list:
 97             orders = self._orders.list_for_customer(customer.customer_id)
 98             has_non_cancelled = any(order.status != "cancelled" for order in orders)
 99             if not has_non_cancelled:
100                 result.append({
101                     "customer_id": customer.customer_id,
102                     "name": customer.name,
103                     "email": customer.email,
104                 })
105         return Response(200, {"customers": result})
