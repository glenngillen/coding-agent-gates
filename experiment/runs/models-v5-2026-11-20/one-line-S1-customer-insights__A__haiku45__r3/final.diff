  3 from __future__ import annotations
  4 
  5 from typing import Any
  6 
  7 from orders.application.customer_service import CustomerService
  8 from orders.application.errors import CustomerNotFound
  9 from orders.application.order_service import OrderService
 10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
 11 
 12 
 13 class CustomerInsightsController:
 14     def __init__(self, order_service: OrderService, customer_service: CustomerService) -> None:
 15         self._order_service = order_service
 16         self._customer_service = customer_service
 17 
 18     def handle_order_history(self, customer_id: str) -> Response:
 19         try:
 20             orders = self._order_service.list_for_customer(customer_id)
 21         except CustomerNotFound:
 22             return not_found("customer")
 23         order_entries = []
 24         for order in reversed(orders):
 25             summary = self._order_service.summarize(order)
 26             order_entries.append({
 27                 "order_id": order.order_id,
 28                 "status": order.status,
 29                 "total_cents": summary.total_cents,
 30             })
 31         return Response(200, {
 32             "customer_id": customer_id,
 33             "orders": order_entries,
 34         })
 35 
 36     def handle_lifetime_value(self, customer_id: str) -> Response:
 37         try:
 38             orders = self._order_service.list_for_customer(customer_id)
 39         except CustomerNotFound:
 40             return not_found("customer")
 41         order_count = 0
 42         lifetime_value_cents = 0
 43         for order in orders:
 44             if order.status != "cancelled":
 45                 summary = self._order_service.summarize(order)
 46                 order_count += 1
 47                 lifetime_value_cents += summary.total_cents
 48         return Response(200, {
 49             "customer_id": customer_id,
 50             "order_count": order_count,
 51             "lifetime_value_cents": lifetime_value_cents,
 52         })
 53 
 54     def handle_top_customers(self, limit: Any) -> Response:
 55         try:
 56             limit_int = require_positive_int(limit, "limit")
 57         except InvalidRequest as exc:
 58             return bad_request(exc)
 59         customers = self._customer_service.list_all()
 60         customer_values = []
 61         for customer in customers:
 62             try:
 63                 orders = self._order_service.list_for_customer(customer.customer_id)
 64             except CustomerNotFound:
 65                 continue
 66             lifetime_value_cents = 0
 67             for order in orders:
 68                 if order.status != "cancelled":
 69                     summary = self._order_service.summarize(order)
 70                     lifetime_value_cents += summary.total_cents
 71             if lifetime_value_cents > 0:
 72                 customer_values.append({
 73                     "customer_id": customer.customer_id,
 74                     "name": customer.name,
 75                     "lifetime_value_cents": lifetime_value_cents,
 76                 })
 77         customer_values.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
 78         return Response(200, {
 79             "customers": customer_values[:limit_int],
 80         })
 81 
 82     def handle_customers_without_orders(self) -> Response:
 83         customers = self._customer_service.list_all()
 84         result = []
 85         for customer in customers:
 86             try:
 87                 orders = self._order_service.list_for_customer(customer.customer_id)
 88             except CustomerNotFound:
 89                 continue
 90             has_active_order = any(order.status != "cancelled" for order in orders)
 91             if not has_active_order:
 92                 result.append({
 93                     "customer_id": customer.customer_id,
 94                     "name": customer.name,
 95                     "email": customer.email,
 96                 })
 97         return Response(200, {
 98             "customers": result,
 99         })
