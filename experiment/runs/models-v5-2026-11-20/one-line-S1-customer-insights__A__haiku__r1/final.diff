src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
15         self._orders = orders
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         """A customer's orders, newest first, with the same totals as the order summary."""
20         try:
21             orders = self._orders.list_for_customer(customer_id)
22         except CustomerNotFound:
23             return not_found("customer")
24         # list_for_customer returns creation order, so reverse it for newest first.
25         history = [{"order_id": order.order_id,
26                     "status": order.status,
27                     "total_cents": self._orders.summarize(order).total_cents}
28                    for order in reversed(orders)]
29         return Response(200, {"customer_id": customer_id, "orders": history})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         """Count and total of a customer's orders, excluding cancelled ones."""
33         try:
34             order_count, lifetime_value_cents = self._lifetime_value(customer_id)
35         except CustomerNotFound:
36             return not_found("customer")
37         return Response(200, {"customer_id": customer_id,
38                               "order_count": order_count,
39                               "lifetime_value_cents": lifetime_value_cents})
40 
41     def handle_top_customers(self, limit: Any) -> Response:
42         """Customers ranked by lifetime value, highest first, omitting those with none."""
43         try:
44             limit = require_positive_int(limit, "limit")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         ranked = []
48         for customer in self._customers.list_all():
49             _, value = self._lifetime_value(customer.customer_id)
50             if value > 0:
51                 ranked.append((value, customer))
52         ranked.sort(key=lambda entry: (-entry[0], entry[1].customer_id))
53         return Response(200, {"customers": [
54             {"customer_id": customer.customer_id,
55              "name": customer.name,
56              "lifetime_value_cents": value}
57             for value, customer in ranked[:limit]]})
58 
59     def handle_customers_without_orders(self) -> Response:
60         """Registered customers with no non-cancelled orders, in registration order."""
61         customers = [{"customer_id": customer.customer_id,
62                       "name": customer.name,
63                       "email": customer.email}
64                      for customer in self._customers.list_all()
65                      if self._lifetime_value(customer.customer_id)[0] == 0]
66         return Response(200, {"customers": customers})
67 
68     def _lifetime_value(self, customer_id: str) -> tuple[int, int]:
69         """(number of non-cancelled orders, sum of their totals). Raises CustomerNotFound."""
70         orders = self._orders.list_for_customer(customer_id)
71         active = [order for order in orders if order.status != "cancelled"]
72         return len(active), sum(self._orders.summarize(order).total_cents for order in active)
