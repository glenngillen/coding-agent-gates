41 
42 LOW_STOCK_LINE = 5
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def low_stock(self, threshold: int) -> list[StockLevel]:
54         """Active products with on-hand stock strictly below ``threshold``, lowest first, then by SKU."""
55         levels = [StockLevel(p, self._stock.get(p.sku)) for p in self._catalog.list_all() if p.active]
56         levels = [level for level in levels if level.on_hand < threshold]
57         return sorted(levels, key=lambda level: (level.on_hand, level.product.sku))
58 
59     def summary(self) -> FulfilmentSummary:
60         """Open (not cancelled) orders, units across them, and active products below the low-stock line."""
61         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
62         units = sum(item.quantity for o in open_orders for item in o.items)
63         return FulfilmentSummary(
64             open_orders=len(open_orders),
65             units_to_pick=units,
66             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
67         )
68 
69     def restock(self, sku: str, quantity: int) -> StockLevel:
70         """Add ``quantity`` units to ``sku``'s stock and return the new level."""
71         product = self._catalog.get(sku)
72         if product is None:
73             raise ProductNotFound(sku)
74         new_level = self._stock.get(sku) + quantity
75         self._stock.set(sku, new_level)
76         return StockLevel(product, new_level)
77 
78     def packing_slip(self, order_id: str) -> PackingSlip:
79         order = self._orders.get(order_id)
80         if order is None:
81             raise OrderNotFound(order_id)
82         if order.status == "cancelled":
83             raise Conflict(f"order {order_id} is cancelled")
84         customer = self._customers.get(order.customer_id)
85         if customer is None:
86             raise CustomerNotFound(order.customer_id)
87         lines = []
88         for item in order.items:
89             product = self._catalog.get(item.sku)
90             if product is None:
91                 raise ProductNotFound(item.sku)
92             lines.append(SlipLine(item.sku, product.name, item.quantity))
93         return PackingSlip(order.order_id, customer.name, tuple(lines))
