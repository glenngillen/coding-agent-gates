29 @dataclass(frozen=True)
30 class StockLevel:
31     product: Product
32     on_hand: int
33 
34 
35 @dataclass(frozen=True)
36 class FulfilmentSummary:
37     open_orders: int
38     units_to_pick: int
39     low_stock_products: int
