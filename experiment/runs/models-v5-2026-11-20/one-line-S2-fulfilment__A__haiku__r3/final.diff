 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment import FulfilmentService, PackingSlip
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 def packing_slip_body(slip: PackingSlip) -> dict:
14     return {
15         "order_id": slip.order_id,
16         "customer_name": slip.customer_name,
17         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
18                   for line in slip.lines],
19     }
20 
21 
22 class FulfilmentController:
23     def __init__(self, service: FulfilmentService) -> None:
24         self._service = service
25 
26     def handle_packing_slip(self, order_id: str) -> Response:
27         try:
28             slip = self._service.packing_slip(order_id)
29         except OrderNotFound:
30             return not_found("order")
31         except Conflict as exc:
32             return conflict(exc)
33         except CustomerNotFound:
34             return not_found("customer")
35         except ProductNotFound:
36             return not_found("product")
37         return Response(200, packing_slip_body(slip))
38 
39     def handle_low_stock(self, threshold: object) -> Response:
40         try:
41             limit = require_non_negative_int(threshold, "threshold")
42         except InvalidRequest as exc:
43             return bad_request(exc)
44         levels = self._service.low_stock(limit)
45         return Response(200, {"products": [
46             {"sku": level.product.sku, "name": level.product.name, "on_hand": level.on_hand}
47             for level in levels]})
48 
49     def handle_fulfilment_summary(self) -> Response:
50         summary = self._service.summary()
51         return Response(200, {"open_orders": summary.open_orders,
52                               "units_to_pick": summary.units_to_pick,
53                               "low_stock_products": summary.low_stock_products})
54 
55     def handle_restock(self, request: dict[str, Any]) -> Response:
56         try:
57             sku = require_str(request, "sku")
58             quantity = require_positive_int(request.get("quantity"), "quantity")
59         except InvalidRequest as exc:
60             return bad_request(exc)
61         try:
62             level = self._service.restock(sku, quantity)
63         except ProductNotFound:
64             return not_found("product")
65         return Response(200, {"sku": level.product.sku, "on_hand": level.on_hand})
