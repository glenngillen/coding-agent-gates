src/orders/application/insights_service.py --- Python
 1 """Customer insights for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.order_service import OrderService
 6 from orders.domain.customers import Customer
 7 from orders.domain.orders import OrderSummary
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 
10 
11 class InsightsService:
12     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository) -> None:
13         self._orders = orders
14         self._customers = customers
15 
16     def order_history(self, customer_id: str) -> list[OrderSummary]:
17         """Every order for the customer, newest first, priced as the order summary reports them.
18 
19         Raises ``CustomerNotFound`` for an unknown customer.
20         """
21         orders = self._orders.list_for_customer(customer_id)  # creation order, oldest first
22         return [self._orders.summarize(order) for order in reversed(orders)]
23 
24     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
25         """``(order_count, lifetime_value_cents)`` over the customer's non-cancelled orders.
26 
27         Totals are priced as the order summary reports them. Raises ``CustomerNotFound``
28         for an unknown customer.
29         """
30         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
31         return len(active), sum(s.total_cents for s in active)
32 
33     def customers_without_orders(self) -> list[Customer]:
34         """Registered customers with no orders that are not cancelled, in registration order."""
35         return [c for c in self._customers.list_all()
36                 if self.lifetime_value(c.customer_id)[0] == 0]
37 
38     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
39         """Up to ``limit`` customers with a non-zero lifetime value, highest first.
40 
41         Ties are ordered by ``customer_id``.
42         """
43         ranked = []
44         for customer in self._customers.list_all():
45             _, value = self.lifetime_value(customer.customer_id)
46             if value > 0:
47                 ranked.append((customer, value))
48         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
49         return ranked[:limit]
50 

src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.insights_service import InsightsService
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
 8 
 9 
10 class CustomerInsightsController:
11     def __init__(self, service: InsightsService) -> None:
12         self._service = service
13 
14     def handle_order_history(self, customer_id: str) -> Response:
15         try:
16             summaries = self._service.order_history(customer_id)
17         except CustomerNotFound:
18             return not_found("customer")
19         return Response(200, {
20             "customer_id": customer_id,
21             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
22                         "total_cents": s.total_cents} for s in summaries],
23         })
24 
25     def handle_lifetime_value(self, customer_id: str) -> Response:
26         try:
27             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
28         except CustomerNotFound:
29             return not_found("customer")
30         return Response(200, {"customer_id": customer_id, "order_count": order_count,
31                               "lifetime_value_cents": lifetime_value_cents})
32 
33     def handle_customers_without_orders(self) -> Response:
34         return Response(200, {"customers": [
35             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
36             for c in self._service.customers_without_orders()]})
37 
38     def handle_top_customers(self, limit: object) -> Response:
39         try:
40             limit = require_positive_int(limit, "limit")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         ranked = self._service.top_customers(limit)
44         return Response(200, {"customers": [
45             {"customer_id": customer.customer_id, "name": customer.name,
46              "lifetime_value_cents": value} for customer, value in ranked]})
47 

