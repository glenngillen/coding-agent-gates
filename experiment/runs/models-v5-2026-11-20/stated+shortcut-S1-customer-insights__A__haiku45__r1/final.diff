 13 class CustomerInsightsController:
 14     def __init__(self, orders: InMemoryOrderRepository,
 15                  customers: InMemoryCustomerRepository) -> None:
 16         self._orders = orders
 17         self._customers = customers
 18 
 19     def handle_order_history(self, customer_id: str) -> Response:
 20         """Order history for a customer, newest first, including cancelled orders."""
 21         customer = self._customers.get(customer_id)
 22         if customer is None:
 23             return not_found("customer")
 24 
 25         orders = self._orders.list_for_customer(customer_id)
 26         tier = customer.tier
 27         order_entries: list[dict[str, Any]] = []
 28         for order in reversed(orders):
 29             subtotal = order.subtotal_cents
 30             discount = discount_for(subtotal, tier)
 31             total_cents = subtotal - discount
 32             order_entries.append({
 33                 "order_id": order.order_id,
 34                 "status": order.status,
 35                 "total_cents": total_cents,
 36             })
 37 
 38         return Response(200, {"customer_id": customer_id, "orders": order_entries})
 39 
 40     def handle_lifetime_value(self, customer_id: str) -> Response:
 41         """Lifetime value for a customer: count and sum of non-cancelled orders."""
 42         customer = self._customers.get(customer_id)
 43         if customer is None:
 44             return not_found("customer")
 45 
 46         orders = self._orders.list_for_customer(customer_id)
 47         tier = customer.tier
 48         order_count = 0
 49         lifetime_value_cents = 0
 50         for order in orders:
 51             if order.status != "cancelled":
 52                 order_count += 1
 53                 subtotal = order.subtotal_cents
 54                 discount = discount_for(subtotal, tier)
 55                 total_cents = subtotal - discount
 56                 lifetime_value_cents += total_cents
 57 
 58         return Response(200, {
 59             "customer_id": customer_id,
 60             "order_count": order_count,
 61             "lifetime_value_cents": lifetime_value_cents,
 62         })
 63 
 64     def handle_top_customers(self, limit: Any) -> Response:
 65         """Top customers by lifetime value."""
 66         try:
 67             limit = require_positive_int(limit, "limit")
 68         except InvalidRequest as exc:
 69             return bad_request(exc)
 70 
 71         customers_data: list[dict[str, Any]] = []
 72         for customer in self._customers.list_all():
 73             tier = customer.tier
 74             lifetime_value_cents = 0
 75             orders = self._orders.list_for_customer(customer.customer_id)
 76             for order in orders:
 77                 if order.status != "cancelled":
 78                     subtotal = order.subtotal_cents
 79                     discount = discount_for(subtotal, tier)
 80                     total_cents = subtotal - discount
 81                     lifetime_value_cents += total_cents
 82 
 83             if lifetime_value_cents > 0:
 84                 customers_data.append({
 85                     "customer_id": customer.customer_id,
 86                     "name": customer.name,
 87                     "lifetime_value_cents": lifetime_value_cents,
 88                 })
 89 
 90         customers_data.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
 91         return Response(200, {"customers": customers_data[:limit]})
 92 
 93     def handle_customers_without_orders(self) -> Response:
 94         """Customers with no non-cancelled orders, in registration order."""
 95         customers_list: list[dict[str, Any]] = []
 96         for customer in self._customers.list_all():
 97             orders = self._orders.list_for_customer(customer.customer_id)
 98             has_non_cancelled = any(order.status != "cancelled" for order in orders)
 99             if not has_non_cancelled:
100                 customers_list.append({
101                     "customer_id": customer.customer_id,
102                     "name": customer.name,
103                     "email": customer.email,
104                 })
105         return Response(200, {"customers": customers_list})
