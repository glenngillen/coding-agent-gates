187 def test_top_customers_sorted_by_customer_id_on_tie(shop):
188     # Create two customers with same lifetime value
189     order(shop, "c1", ("LAMP", 2))
190     order(shop, "c2", ("LAMP", 2))
191     # Both get same value from orders (c1 is standard: 10800, c2 is gold: 10200)
192     # Let's add more orders to make them equal
193     # Actually, they have different tiers so they'll get different values
194     # Let me create two more customers with same value instead
