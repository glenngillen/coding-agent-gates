 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             orders = self._service.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         order_entries = [
22             {
23                 "order_id": order.order_id,
24                 "status": order.status,
25                 "total_cents": self._service.summarize(order).total_cents,
26             }
27             for order in reversed(orders)
28         ]
29         return Response(200, {"customer_id": customer_id, "orders": order_entries})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             orders = self._service.list_for_customer(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         active_orders = [o for o in orders if o.status != "cancelled"]
37         lifetime_value = sum(self._service.summarize(o).total_cents for o in active_orders)
38         return Response(200, {
39             "customer_id": customer_id,
40             "order_count": len(active_orders),
41             "lifetime_value_cents": lifetime_value,
42         })
43 
44     def handle_top_customers(self, limit: Any) -> Response:
45         try:
46             limit_int = require_positive_int(limit, "limit")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         customer_tuples = self._service.get_top_customers(limit_int)
50         customers = [
51             {
52                 "customer_id": customer_id,
53                 "name": name,
54                 "lifetime_value_cents": lifetime_value,
55             }
56             for customer_id, name, lifetime_value in customer_tuples
57         ]
58         return Response(200, {"customers": customers})
59 
60     def handle_customers_without_orders(self) -> Response:
61         customer_tuples = self._service.get_customers_without_orders()
62         customers = [
63             {
64                 "customer_id": customer_id,
65                 "name": name,
66                 "email": email,
67             }
68             for customer_id, name, email in customer_tuples
69         ]
70         return Response(200, {"customers": customers})
