   75     def get_top_customers(self, limit: int) -> list[tuple[str, str, int]]:
   76         """Return top customers by lifetime value: (customer_id, name, lifetime_value_cents)."""
   77         customers = self._customers.list_all()
   78         customer_values = []
   79         for customer in customers:
   80             orders = self._orders.list_for_customer(customer.customer_id)
   81             active_orders = [o for o in orders if o.status != "cancelled"]
   82             lifetime_value = sum(self.summarize(o).total_cents for o in active_orders)
   83             if lifetime_value > 0:
   84                 customer_values.append((customer.customer_id, customer.name, lifetime_value))
   85         customer_values.sort(key=lambda c: (-c[2], c[0]))
   86         return customer_values[:limit]
   87 
   88     def get_customers_without_orders(self) -> list[tuple[str, str, str]]:
   89         """Return registered customers with no non-cancelled orders: (customer_id, name, email)."""
   90         customers = self._customers.list_all()
   91         result = []
   92         for customer in customers:
   93             orders = self._orders.list_for_customer(customer.customer_id)
   94             active_orders = [o for o in orders if o.status != "cancelled"]
   95             if not active_orders:
   96                 result.append((customer.customer_id, customer.name, customer.email))
   97         return result

