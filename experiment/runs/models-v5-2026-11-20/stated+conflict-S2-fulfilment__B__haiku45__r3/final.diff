src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints for warehouse operations."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import Response, not_found, conflict, bad_request, InvalidRequest, require_str, require_positive_int
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             packing_slip = self._service.get_packing_slip(order_id)
19         except OrderNotFound:
20             return not_found("order")
21         except Conflict as exc:
22             return conflict(exc)
23         return Response(200, packing_slip)
24 
25     def handle_low_stock(self, threshold: Any) -> Response:
26         if type(threshold) is not int or isinstance(threshold, bool) or threshold < 0:
27             return bad_request(InvalidRequest("threshold must be a non-negative integer"))
28         return Response(200, self._service.get_low_stock_products(threshold))
29 
30     def handle_restock(self, request: dict[str, Any]) -> Response:
31         try:
32             sku = require_str(request, "sku")
33             quantity = require_positive_int(request.get("quantity"), "quantity")
34         except InvalidRequest as exc:
35             return bad_request(exc)
36         try:
37             result = self._service.restock_product(sku, quantity)
38         except ProductNotFound:
39             return not_found("product")
40         return Response(200, result)
41 
42     def handle_fulfilment_summary(self) -> Response:
43         summary = self._service.get_fulfilment_summary()
44         return Response(200, summary)
