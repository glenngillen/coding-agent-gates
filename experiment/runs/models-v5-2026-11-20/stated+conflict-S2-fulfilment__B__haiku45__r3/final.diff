 1 """Fulfilment operations for warehouse packing."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.infrastructure.catalog import InMemoryProductCatalog
 7 from orders.infrastructure.customers import InMemoryCustomerRepository
 8 from orders.infrastructure.repository import InMemoryOrderRepository
 9 from orders.infrastructure.stock import InMemoryStockRepository
10 
11 
12 class FulfilmentService:
13     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
14                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
15         self._orders = orders
16         self._customers = customers
17         self._catalog = catalog
18         self._stock = stock
19 
20     def get_packing_slip(self, order_id: str) -> dict:
21         order = self._orders.get(order_id)
22         if order is None:
23             raise OrderNotFound(order_id)
24         if order.status == "cancelled":
25             raise Conflict(f"order {order_id} is cancelled")
26         customer = self._customers.get(order.customer_id)
27         customer_name = customer.name if customer is not None else "Unknown"
28         lines = []
29         for item in order.items:
30             product = self._catalog.get(item.sku)
31             product_name = product.name if product is not None else item.sku
32             lines.append({
33                 "sku": item.sku,
34                 "name": product_name,
35                 "quantity": item.quantity,
36             })
37         return {
38             "order_id": order.order_id,
39             "customer_name": customer_name,
40             "lines": lines,
41         }
42 
43     def get_low_stock_products(self, threshold: int) -> dict:
44         products = []
45         for product in self._catalog.list_all():
46             if product.active and self._stock.get(product.sku) < threshold:
47                 products.append({
48                     "sku": product.sku,
49                     "name": product.name,
50                     "on_hand": self._stock.get(product.sku),
51                 })
52         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
53         return {"products": products}
54 
55     def restock_product(self, sku: str, quantity: int) -> dict:
56         product = self._catalog.get(sku)
57         if product is None:
58             raise ProductNotFound(sku)
59         new_level = self._stock.get(sku) + quantity
60         self._stock.set(sku, new_level)
61         return {"sku": sku, "on_hand": new_level}
62 
63     def get_fulfilment_summary(self) -> dict:
64         open_orders = 0
65         units_to_pick = 0
66         for order in self._orders.list_all():
67             if order.status != "cancelled":
68                 open_orders += 1
69                 units_to_pick += sum(item.quantity for item in order.items)
70         low_stock_products = sum(
71             1 for product in self._catalog.list_all()
72             if product.active and self._stock.get(product.sku) < 5
73         )
74         return {
75             "open_orders": open_orders,
76             "units_to_pick": units_to_pick,
77             "low_stock_products": low_stock_products,
78         }
