 1 """Customer insight endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customers: InMemoryCustomerRepository) -> None:
15         self._service = service
16         self._customers = customers
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         try:
20             orders = self._service.list_for_customer(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         order_entries = [
24             {
25                 "order_id": order.order_id,
26                 "status": order.status,
27                 "total_cents": self._service.summarize(order).total_cents,
28             }
29             for order in reversed(orders)
30         ]
31         return Response(200, {"customer_id": customer_id, "orders": order_entries})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         try:
35             orders = self._service.list_for_customer(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         non_cancelled = [order for order in orders if order.status != "cancelled"]
39         lifetime_value_cents = sum(self._service.summarize(order).total_cents for order in non_cancelled)
40         return Response(200, {
41             "customer_id": customer_id,
42             "order_count": len(non_cancelled),
43             "lifetime_value_cents": lifetime_value_cents,
44         })
45 
46     def handle_top_customers(self, limit: Any) -> Response:
47         try:
48             limit_int = require_positive_int(limit, "limit")
49         except InvalidRequest as exc:
50             return bad_request(exc)
51         customers = self._customers.list_all()
52         customer_values = []
53         for customer in customers:
54             try:
55                 orders = self._service.list_for_customer(customer.customer_id)
56             except CustomerNotFound:
57                 orders = []
58             non_cancelled = [order for order in orders if order.status != "cancelled"]
59             lifetime_value_cents = sum(self._service.summarize(order).total_cents for order in non_cancelled)
60             if lifetime_value_cents > 0:
61                 customer_values.append({
62                     "customer_id": customer.customer_id,
63                     "name": customer.name,
64                     "lifetime_value_cents": lifetime_value_cents,
65                 })
66         customer_values.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
67         return Response(200, {"customers": customer_values[:limit_int]})
68 
69     def handle_customers_without_orders(self) -> Response:
70         customers = self._customers.list_all()
71         result = []
72         for customer in customers:
73             try:
74                 orders = self._service.list_for_customer(customer.customer_id)
75             except CustomerNotFound:
76                 orders = []
77             non_cancelled = [order for order in orders if order.status != "cancelled"]
78             if not non_cancelled:
79                 result.append({
80                     "customer_id": customer.customer_id,
81                     "name": customer.name,
82                     "email": customer.email,
83                 })
84         return Response(200, {"customers": result})
