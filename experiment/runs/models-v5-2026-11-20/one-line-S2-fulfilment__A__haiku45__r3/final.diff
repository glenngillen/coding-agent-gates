 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_non_negative_int, require_positive_int, require_str
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 class FulfilmentController:
15     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
16                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
17         self._orders = orders
18         self._customers = customers
19         self._catalog = catalog
20         self._stock = stock
21 
22     def handle_packing_slip(self, order_id: str) -> Response:
23         order = self._orders.get(order_id)
24         if order is None:
25             return not_found("order")
26         if order.status == "cancelled":
27             return conflict(ValueError(f"order {order_id} is cancelled"))
28         customer = self._customers.get(order.customer_id)
29         customer_name = customer.name if customer is not None else ""
30         lines = []
31         for item in order.items:
32             product = self._catalog.get(item.sku)
33             product_name = product.name if product is not None else ""
34             lines.append({"sku": item.sku, "name": product_name, "quantity": item.quantity})
35         return Response(200, {"order_id": order.order_id, "customer_name": customer_name, "lines": lines})
36 
37     def handle_low_stock(self, threshold: Any) -> Response:
38         try:
39             threshold_int = require_non_negative_int(threshold, "threshold")
40         except InvalidRequest as exc:
41             return bad_request(exc)
42         stock_levels = self._stock.all_levels()
43         low_stock_products = []
44         for product in self._catalog.list_all():
45             if product.active and stock_levels.get(product.sku, 0) < threshold_int:
46                 low_stock_products.append({
47                     "sku": product.sku,
48                     "name": product.name,
49                     "on_hand": stock_levels.get(product.sku, 0)
50                 })
51         low_stock_products.sort(key=lambda p: (p["on_hand"], p["sku"]))
52         return Response(200, {"products": low_stock_products})
53 
54     def handle_restock(self, request: dict[str, Any]) -> Response:
55         try:
56             sku = require_str(request, "sku")
57             quantity = require_positive_int(request.get("quantity"), "quantity")
58         except InvalidRequest as exc:
59             return bad_request(exc)
60         product = self._catalog.get(sku)
61         if product is None or not product.active:
62             return not_found("product")
63         current_level = self._stock.get(sku)
64         new_level = current_level + quantity
65         self._stock.set(sku, new_level)
66         return Response(200, {"sku": sku, "on_hand": new_level})
67 
68     def handle_fulfilment_summary(self) -> Response:
69         open_orders = 0
70         units_to_pick = 0
71         for order in self._orders.list_all():
72             if order.status != "cancelled":
73                 open_orders += 1
74                 for item in order.items:
75                     units_to_pick += item.quantity
76         stock_levels = self._stock.all_levels()
77         low_stock_products = 0
78         for product in self._catalog.list_all():
79             if product.active and stock_levels.get(product.sku, 0) < 5:
80                 low_stock_products += 1
81         return Response(200, {
82             "open_orders": open_orders,
83             "units_to_pick": units_to_pick,
84             "low_stock_products": low_stock_products
85         })
