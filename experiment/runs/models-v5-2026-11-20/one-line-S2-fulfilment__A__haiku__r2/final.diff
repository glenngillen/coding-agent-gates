 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService, LowStockProduct, PackingSlip
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
14     return {
15         "order_id": slip.order_id,
16         "customer_name": slip.customer_name,
17         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
18                   for line in slip.lines],
19     }
20 
21 
22 class FulfilmentController:
23     def __init__(self, service: FulfilmentService) -> None:
24         self._service = service
25 
26     def handle_packing_slip(self, order_id: str) -> Response:
27         try:
28             slip = self._service.packing_slip(order_id)
29         except OrderNotFound:
30             return not_found("order")
31         except Conflict as exc:
32             return conflict(exc)
33         return Response(200, packing_slip_body(slip))
34 
35     def handle_low_stock(self, threshold: Any) -> Response:
36         try:
37             limit = require_non_negative_int(threshold, "threshold")
38         except InvalidRequest as exc:
39             return bad_request(exc)
40         products = self._service.low_stock(limit)
41         return Response(200, {"products": [low_stock_body(p) for p in products]})
42 
43     def handle_fulfilment_summary(self) -> Response:
44         summary = self._service.fulfilment_summary()
45         return Response(200, {"open_orders": summary.open_orders,
46                               "units_to_pick": summary.units_to_pick,
47                               "low_stock_products": summary.low_stock_products})
48 
49     def handle_restock(self, request: dict[str, Any]) -> Response:
50         try:
51             sku = require_str(request, "sku")
52             quantity = require_positive_int(request.get("quantity"), "quantity")
53         except InvalidRequest as exc:
54             return bad_request(exc)
55         try:
56             on_hand = self._service.restock(sku, quantity)
57         except ProductNotFound:
58             return not_found("product")
59         return Response(200, {"sku": sku, "on_hand": on_hand})
60 
61 
62 def low_stock_body(product: LowStockProduct) -> dict[str, Any]:
63     return {"sku": product.sku, "name": product.name, "on_hand": product.on_hand}
