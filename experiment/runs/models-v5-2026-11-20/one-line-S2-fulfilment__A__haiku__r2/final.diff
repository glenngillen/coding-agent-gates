45 class FulfilmentService:
46     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
47                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
48         self._orders = orders
49         self._customers = customers
50         self._catalog = catalog
51         self._stock = stock
52 
53     def low_stock(self, threshold: int) -> list[LowStockProduct]:
54         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
55         products = [
56             LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
57             for p in self._catalog.list_all()
58             if p.active and self._stock.get(p.sku) < threshold
59         ]
60         return sorted(products, key=lambda p: (p.on_hand, p.sku))
61 
62     def fulfilment_summary(self) -> FulfilmentSummary:
63         """Dashboard figures: open orders, units to pick across them, and low-stock products."""
64         open_orders = [o for o in self._orders.all_orders() if o.status != "cancelled"]
65         return FulfilmentSummary(
66             open_orders=len(open_orders),
67             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
68             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
69         )
70 
71     def restock(self, sku: str, quantity: int) -> int:
72         """Add ``quantity`` units to a product's stock and return the new level.
73 
74         Raises ``ProductNotFound`` if the SKU is not in the catalogue. The stock repository is
75         shared with order placement, so the added units are orderable straight away.
76         """
77         if self._catalog.get(sku) is None:
78             raise ProductNotFound(sku)
79         new_level = self._stock.get(sku) + quantity
80         self._stock.set(sku, new_level)
81         return new_level
82 
83     def packing_slip(self, order_id: str) -> PackingSlip:
84         """Packing slip for an order, with lines in the order's item order.
85 
86         Raises ``OrderNotFound`` for unknown orders and ``Conflict`` for cancelled ones.
87         """
88         order = self._orders.get_order(order_id)
89         if order.status == "cancelled":
90             raise Conflict(f"order {order_id} is cancelled")
91         customer = self._customers.get(order.customer_id)
92         lines = tuple(
93             PackingSlipLine(item.sku, self._catalog.get(item.sku).name, item.quantity)
94             for item in order.items
95         )
96         return PackingSlip(order.order_id, customer.name if customer is not None else None, lines)
