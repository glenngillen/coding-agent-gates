109 def test_fulfilment_summary_counts_open_orders_units_and_low_stock(shop):
110     # Fixture stock: BOOK 50, LAMP 5, PEN 100. Nothing is low yet (LAMP is not below 5).
111     assert shop.fulfilment.handle_fulfilment_summary().body == {
112         "open_orders": 0, "units_to_pick": 0, "low_stock_products": 0}
113     order(shop, "c1", ("BOOK", 2), ("PEN", 3))          # 5 units
114     cancelled = order(shop, "c2", ("LAMP", 1)).body["order_id"]  # LAMP drops to 4 (low)
115     shop.orders.handle_cancel(cancelled)                 # excluded, and restores LAMP to 5
116     order(shop, "c2", ("PEN", 4))                        # 4 units
117     assert shop.fulfilment.handle_fulfilment_summary().body == {
118         "open_orders": 2, "units_to_pick": 9, "low_stock_products": 0}
119     order(shop, "c1", ("LAMP", 4))                       # LAMP drops to 1 (low)
120     assert shop.fulfilment.handle_fulfilment_summary().body == {
121         "open_orders": 3, "units_to_pick": 13, "low_stock_products": 1}
