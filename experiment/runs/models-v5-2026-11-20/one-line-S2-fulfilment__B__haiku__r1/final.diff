14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 @dataclass(frozen=True)
29 class LowStockProduct:
30     sku: str
31     name: str
32     on_hand: int
33 
34 
35 LOW_STOCK_LINE = 5  # units on hand below which a product counts as low stock
36 
37 
38 class FulfilmentService:
39     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
40                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
41         self._orders = orders
42         self._customers = customers
43         self._catalog = catalog
44         self._stock = stock
45 
46     def low_stock(self, threshold: int) -> list[LowStockProduct]:
47         """Active products whose stock on hand is strictly below ``threshold``, lowest first."""
48         products = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
49                     for p in self._catalog.list_all() if p.active]
50         return sorted((p for p in products if p.on_hand < threshold),
51                       key=lambda p: (p.on_hand, p.sku))
52 
53     def fulfilment_summary(self) -> tuple[int, int, int]:
54         """``(open_orders, units_to_pick, low_stock_products)`` for the warehouse dashboard."""
55         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
56         units = sum(item.quantity for order in open_orders for item in order.items)
57         return len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE))
58 
59     def restock(self, sku: str, quantity: int) -> int:
60         """Add ``quantity`` units to a product's stock and return the new level."""
61         if self._catalog.get(sku) is None:
62             raise ProductNotFound(sku)
63         on_hand = self._stock.get(sku) + quantity
64         self._stock.set(sku, on_hand)
65         return on_hand
66 
67     def packing_slip(self, order_id: str) -> PackingSlip:
68         order = self._orders.get(order_id)
69         if order is None:
70             raise OrderNotFound(order_id)
71         if order.status == "cancelled":
72             raise Conflict(f"order {order_id} is cancelled")
73         customer = self._customers.get(order.customer_id)
74         if customer is None:
75             raise CustomerNotFound(order.customer_id)
76         lines = []
77         for item in order.items:
78             product = self._catalog.get(item.sku)
79             if product is None:
80                 raise ProductNotFound(item.sku)
81             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
82         return PackingSlip(order.order_id, customer.name, tuple(lines))
