.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries (with discounts applied) for every order of a customer, newest first."""
.. 70         if self._customers.get(customer_id) is None:
.. 71             raise CustomerNotFound(customer_id)
.. 72         return [self.summarize(o) for o in reversed(self._orders.list_for_customer(customer_id))]
.. 73 
.. 74     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 75         """``(order_count, lifetime_value_cents)`` over a customer's orders that are not cancelled."""
.. 76         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 77         return len(active), sum(s.total_cents for s in active)
.. 78 
.. 79     def customers_without_orders(self) -> list[Customer]:
.. 80         """Registered customers with no orders that are not cancelled, in registration order."""
.. 81         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
.. 82 
.. 83     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 84         """Customers with a non-zero lifetime value, highest first (ties by customer_id), at most ``limit``."""
.. 85         ranked = []
.. 86         for customer in self._customers.list_all():
.. 87             _, value = self.lifetime_value(customer.customer_id)
.. 88             if value > 0:
.. 89                 ranked.append((customer, value))
.. 90         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 91         return ranked[:limit]
