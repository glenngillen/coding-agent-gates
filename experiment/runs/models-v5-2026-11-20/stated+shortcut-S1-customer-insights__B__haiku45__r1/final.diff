 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_insights_service import CustomerInsightsService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: CustomerInsightsService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """Get order history for a customer, newest orders first."""
18         try:
19             customer_id, orders = self._service.get_order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22 
23         return Response(200, {"customer_id": customer_id, "orders": orders})
24 
25     def handle_lifetime_value(self, customer_id: str) -> Response:
26         """Get lifetime value for a customer."""
27         try:
28             customer_id, order_count, lifetime_value_cents = self._service.get_lifetime_value(customer_id)
29         except CustomerNotFound:
30             return not_found("customer")
31 
32         return Response(200, {
33             "customer_id": customer_id,
34             "order_count": order_count,
35             "lifetime_value_cents": lifetime_value_cents,
36         })
37 
38     def handle_top_customers(self, limit: Any) -> Response:
39         """Get top customers by lifetime value."""
40         try:
41             limit = require_positive_int(limit, "limit")
42         except InvalidRequest as exc:
43             return bad_request(exc)
44 
45         customers = self._service.get_top_customers(limit)
46         return Response(200, {"customers": customers})
47 
48     def handle_customers_without_orders(self) -> Response:
49         """Get all customers with no non-cancelled orders."""
50         customers = self._service.get_customers_without_orders()
51         return Response(200, {"customers": customers})
