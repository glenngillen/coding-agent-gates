..  76     def lifetime_value(self, customer_id: str) -> CustomerLifetimeValue:
..  77         """Number of non-cancelled orders and the sum of their totals (discounts applied)."""
..  78         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
..  79         return CustomerLifetimeValue(customer_id, len(active), sum(s.total_cents for s in active))
