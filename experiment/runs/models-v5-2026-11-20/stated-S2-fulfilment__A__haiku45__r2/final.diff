 1 """Fulfillment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.application.catalog_service import CatalogService
10 from orders.application.customer_service import CustomerService
11 from orders.controllers.http import Response, not_found, conflict, bad_request, InvalidRequest, require_non_negative_int, require_str, require_positive_int
12 
13 
14 class FulfilmentController:
15     def __init__(self, order_service: OrderService, customer_service: CustomerService,
16                  catalog_service: CatalogService) -> None:
17         self._order_service = order_service
18         self._customer_service = customer_service
19         self._catalog_service = catalog_service
20 
21     def handle_packing_slip(self, order_id: str) -> Response:
22         try:
23             order = self._order_service.get_order(order_id)
24         except OrderNotFound:
25             return not_found("order")
26 
27         if order.status == "cancelled":
28             return conflict(Conflict(f"order {order_id} is cancelled"))
29 
30         customer = self._customer_service.get(order.customer_id)
31 
32         lines = []
33         for item in order.items:
34             product = self._catalog_service.get_product(item.sku)
35             lines.append({
36                 "sku": item.sku,
37                 "name": product.name,
38                 "quantity": item.quantity,
39             })
40 
41         return Response(200, {
42             "order_id": order.order_id,
43             "customer_name": customer.name,
44             "lines": lines,
45         })
46 
47     def handle_low_stock(self, threshold: Any) -> Response:
48         try:
49             threshold = require_non_negative_int(threshold, "threshold")
50         except InvalidRequest as exc:
51             return bad_request(exc)
52 
53         products = self._catalog_service.list_active()
54         low_stock = []
55         for product in products:
56             on_hand = self._catalog_service.on_hand(product.sku)
57             if on_hand < threshold:
58                 low_stock.append({
59                     "sku": product.sku,
60                     "name": product.name,
61                     "on_hand": on_hand,
62                 })
63 
64         low_stock.sort(key=lambda p: (p["on_hand"], p["sku"]))
65 
66         return Response(200, {"products": low_stock})
67 
68     def handle_restock(self, request: dict[str, Any]) -> Response:
69         try:
70             sku = require_str(request, "sku")
71             quantity = require_positive_int(request.get("quantity"), "quantity")
72         except InvalidRequest as exc:
73             return bad_request(exc)
74 
75         try:
76             new_level = self._catalog_service.restock(sku, quantity)
77         except ProductNotFound:
78             return not_found("product")
79 
80         return Response(200, {"sku": sku, "on_hand": new_level})
81 
82     def handle_fulfilment_summary(self) -> Response:
83         orders = self._order_service.list_all_orders()
84         open_orders = sum(1 for order in orders if order.status != "cancelled")
85         units_to_pick = sum(item.quantity for order in orders if order.status != "cancelled"
86                             for item in order.items)
87 
88         products = self._catalog_service.list_active()
89         low_stock_products = sum(1 for product in products
90                                  if self._catalog_service.on_hand(product.sku) < 5)
91 
92         return Response(200, {
93             "open_orders": open_orders,
94             "units_to_pick": units_to_pick,
95             "low_stock_products": low_stock_products,
96         })
