11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             summaries = self._service.order_history(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         orders: list[dict[str, Any]] = [
22             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
23             for s in summaries
24         ]
25         return Response(200, {"customer_id": customer_id, "orders": orders})
26 
27     def handle_lifetime_value(self, customer_id: str) -> Response:
28         try:
29             order_count, total_cents = self._service.lifetime_value(customer_id)
30         except CustomerNotFound:
31             return not_found("customer")
32         return Response(200, {"customer_id": customer_id, "order_count": order_count,
33                               "lifetime_value_cents": total_cents})
34 
35     def handle_customers_without_orders(self) -> Response:
36         customers = self._service.customers_without_orders()
37         return Response(200, {"customers": [
38             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers
39         ]})
40 
41     def handle_top_customers(self, limit: Any) -> Response:
42         try:
43             require_positive_int(limit, "limit")
44         except InvalidRequest as exc:
45             return bad_request(exc)
46         ranked = self._service.top_customers(limit)
47         return Response(200, {"customers": [
48             {"customer_id": c.customer_id, "name": c.name, "lifetime_value_cents": total}
49             for c, total in ranked
50         ]})
