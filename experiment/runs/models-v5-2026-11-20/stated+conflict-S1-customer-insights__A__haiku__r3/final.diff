.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries for every order of a customer, newest first, cancelled ones included."""
.. 70         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 71 
.. 72     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 73         """Return ``(order_count, total_cents)`` over a customer's orders that are not cancelled."""
.. 74         live = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 75         return len(live), sum(s.total_cents for s in live)
.. 76 
.. 77     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 78         """Customers with a non-zero lifetime value, highest first, ties by customer_id."""
.. 79         ranked = []
.. 80         for customer in self._customers.list_all():
.. 81             _, total = self.lifetime_value(customer.customer_id)
.. 82             if total > 0:
.. 83                 ranked.append((customer, total))
.. 84         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 85         return ranked[:limit]
.. 86 
.. 87     def customers_without_orders(self) -> list[Customer]:
.. 88         """Registered customers with no orders that are not cancelled, in registration order."""
.. 89         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
