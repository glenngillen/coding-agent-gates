 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import OrderNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_positive_int, require_str)
11 
12 
13 class FulfilmentController:
14     def __init__(self, service: OrderService) -> None:
15         self._service = service
16 
17     def handle_packing_slip(self, order_id: str) -> Response:
18         try:
19             order = self._service.get_order(order_id)
20         except OrderNotFound:
21             return not_found("order")
22 
23         if order.status == "cancelled":
24             return conflict(ValueError(f"order {order_id} is cancelled"))
25 
26         customer = self._service._customers.get(order.customer_id)
27         lines = []
28         for item in order.items:
29             product = self._service._catalog.get(item.sku)
30             lines.append({
31                 "sku": item.sku,
32                 "name": product.name,
33                 "quantity": item.quantity,
34             })
35 
36         return Response(200, {
37             "order_id": order.order_id,
38             "customer_name": customer.name,
39             "lines": lines,
40         })
41 
42     def handle_low_stock(self, threshold: Any) -> Response:
43         if type(threshold) is not int or isinstance(threshold, bool) or threshold < 0:
44             return bad_request(ValueError("threshold must be a non-negative integer"))
45 
46         stock_levels = self._service._stock.all_levels()
47         products_below_threshold = []
48 
49         for sku, on_hand in stock_levels.items():
50             if on_hand < threshold:
51                 product = self._service._catalog.get(sku)
52                 if product and product.active:
53                     products_below_threshold.append({
54                         "sku": sku,
55                         "name": product.name,
56                         "on_hand": on_hand,
57                     })
58 
59         products_below_threshold.sort(key=lambda p: (p["on_hand"], p["sku"]))
60 
61         return Response(200, {"products": products_below_threshold})
62 
63     def handle_restock(self, request: dict[str, Any]) -> Response:
64         try:
65             sku = require_str(request, "sku")
66             quantity = require_positive_int(request.get("quantity"), "quantity")
67         except InvalidRequest as exc:
68             return bad_request(exc)
69 
70         product = self._service._catalog.get(sku)
71         if product is None:
72             return not_found("product")
73 
74         current_on_hand = self._service._stock.get(sku)
75         new_on_hand = current_on_hand + quantity
76         self._service._stock.set(sku, new_on_hand)
77 
78         return Response(200, {"sku": sku, "on_hand": new_on_hand})
79 
80     def handle_fulfilment_summary(self) -> Response:
81         orders = self._service._orders.list_all()
82 
83         open_orders = sum(1 for order in orders if order.status != "cancelled")
84         units_to_pick = sum(item.quantity for order in orders if order.status != "cancelled"
85                             for item in order.items)
86 
87         stock_levels = self._service._stock.all_levels()
88         low_stock_products = sum(1 for sku, on_hand in stock_levels.items()
89                                  if on_hand < 5 and self._service._catalog.get(sku)
90                                  and self._service._catalog.get(sku).active)
91 
92         return Response(200, {
93             "open_orders": open_orders,
94             "units_to_pick": units_to_pick,
95             "low_stock_products": low_stock_products,
96         })
