 1 """Fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_non_negative_int, require_positive_int, require_str
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             slip = self._service.get_packing_slip(order_id)
19         except OrderNotFound:
20             return not_found("order")
21         except Conflict as exc:
22             return conflict(exc)
23 
24         return Response(200, {
25             "order_id": slip.order_id,
26             "customer_name": slip.customer_name,
27             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
28                       for line in slip.lines],
29         })
30 
31     def handle_low_stock(self, threshold: Any) -> Response:
32         try:
33             threshold_int = require_non_negative_int(threshold, "threshold")
34         except InvalidRequest as exc:
35             return bad_request(exc)
36 
37         products = self._service.get_low_stock_products(threshold_int)
38         return Response(200, {
39             "products": [{"sku": sku, "name": name, "on_hand": on_hand}
40                          for sku, name, on_hand in products],
41         })
42 
43     def handle_restock(self, request: dict[str, Any]) -> Response:
44         try:
45             sku = require_str(request, "sku")
46             quantity = require_positive_int(request.get("quantity"), "quantity")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49 
50         try:
51             new_stock = self._service.restock(sku, quantity)
52         except ProductNotFound:
53             return not_found("product")
54 
55         return Response(200, {"sku": sku, "on_hand": new_stock})
56 
57     def handle_fulfilment_summary(self) -> Response:
58         open_orders, units_to_pick, low_stock_products = self._service.get_fulfilment_summary()
59         return Response(200, {
60             "open_orders": open_orders,
61             "units_to_pick": units_to_pick,
62             "low_stock_products": low_stock_products,
63         })
