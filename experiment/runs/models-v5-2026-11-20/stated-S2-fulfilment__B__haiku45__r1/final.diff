 1 """Packing slip generation."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 @dataclass(frozen=True)
15 class PackingSlipLine:
16     sku: str
17     name: str
18     quantity: int
19 
20 
21 @dataclass(frozen=True)
22 class PackingSlip:
23     order_id: str
24     customer_name: str
25     lines: tuple[PackingSlipLine, ...]
26 
27 
28 class FulfilmentService:
29     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
30                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
31         self._orders = orders
32         self._customers = customers
33         self._catalog = catalog
34         self._stock = stock
35 
36     def get_packing_slip(self, order_id: str) -> PackingSlip:
37         order = self._orders.get(order_id)
38         if order is None:
39             raise OrderNotFound(order_id)
40         if order.status == "cancelled":
41             raise Conflict(f"order {order_id} is cancelled")
42 
43         customer = self._customers.get(order.customer_id)
44         customer_name = customer.name if customer is not None else ""
45 
46         lines = []
47         for item in order.items:
48             product = self._catalog.get(item.sku)
49             product_name = product.name if product is not None else ""
50             lines.append(PackingSlipLine(item.sku, product_name, item.quantity))
51 
52         return PackingSlip(order.order_id, customer_name, tuple(lines))
53 
54     def get_low_stock_products(self, threshold: int) -> list[tuple[str, str, int]]:
55         low_stock = []
56         stock_levels = self._stock.all_levels()
57         for product in self._catalog.list_all():
58             if product.active and stock_levels.get(product.sku, 0) < threshold:
59                 low_stock.append((product.sku, product.name, stock_levels.get(product.sku, 0)))
60         low_stock.sort(key=lambda x: (x[2], x[0]))
61         return low_stock
62 
63     def restock(self, sku: str, quantity: int) -> int:
64         product = self._catalog.get(sku)
65         if product is None:
66             raise ProductNotFound(sku)
67         current_stock = self._stock.get(sku)
68         new_stock = current_stock + quantity
69         self._stock.set(sku, new_stock)
70         return new_stock
71 
72     def get_fulfilment_summary(self) -> tuple[int, int, int]:
73         open_orders = 0
74         units_to_pick = 0
75         stock_levels = self._stock.all_levels()
76 
77         for order in self._orders.list_all():
78             if order.status != "cancelled":
79                 open_orders += 1
80                 for item in order.items:
81                     units_to_pick += item.quantity
82 
83         low_stock_products = 0
84         for product in self._catalog.list_all():
85             if product.active and stock_levels.get(product.sku, 0) < 5:
86                 low_stock_products += 1
87 
88         return open_orders, units_to_pick, low_stock_products
