src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 from orders.domain.orders import Order
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
16         self._orders = orders
17         self._customers = customers
18 
19     def handle_order_history(self, customer_id: str) -> Response:
20         """A customer's orders, newest first, with the totals the order summary reports."""
21         try:
22             orders = self._orders.list_for_customer(customer_id)
23         except CustomerNotFound:
24             return not_found("customer")
25         history = [
26             {"order_id": order.order_id,
27              "status": order.status,
28              "total_cents": self._orders.summarize(order).total_cents}
29             for order in reversed(orders)  # list_for_customer is creation order
30         ]
31         return Response(200, {"customer_id": customer_id, "orders": history})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         """Count and total of a customer's orders, excluding cancelled ones."""
35         try:
36             orders = self._orders.list_for_customer(customer_id)
37         except CustomerNotFound:
38             return not_found("customer")
39         active = self._active_orders(orders)
40         return Response(200, {
41             "customer_id": customer_id,
42             "order_count": len(active),
43             "lifetime_value_cents": self._lifetime_value_cents(active),
44         })
45 
46     def handle_top_customers(self, limit: Any) -> Response:
47         """Customers ranked by lifetime value, highest first, ties broken by customer_id."""
48         try:
49             limit = require_positive_int(limit, "limit")
50         except InvalidRequest as exc:
51             return bad_request(exc)
52         ranked = []
53         for customer in self._customers.list_all():
54             value = self._lifetime_value_cents(self._active_orders(
55                 self._orders.list_for_customer(customer.customer_id)))
56             if value > 0:
57                 ranked.append((value, customer))
58         ranked.sort(key=lambda pair: (-pair[0], pair[1].customer_id))
59         return Response(200, {"customers": [
60             {"customer_id": customer.customer_id, "name": customer.name, "lifetime_value_cents": value}
61             for value, customer in ranked[:limit]
62         ]})
63 
64     def handle_customers_without_orders(self) -> Response:
65         """Registered customers with no orders other than cancelled ones, in registration order."""
66         customers = [
67             {"customer_id": customer.customer_id, "name": customer.name, "email": customer.email}
68             for customer in self._customers.list_all()
69             if not self._active_orders(self._orders.list_for_customer(customer.customer_id))
70         ]
71         return Response(200, {"customers": customers})
72 
73     @staticmethod
74     def _active_orders(orders: list[Order]) -> list[Order]:
75         return [order for order in orders if order.status != "cancelled"]
76 
77     def _lifetime_value_cents(self, orders: list[Order]) -> int:
78         return sum(self._orders.summarize(order).total_cents for order in orders)
79 

