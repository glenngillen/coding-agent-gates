35     def handle_lifetime_value(self, customer_id: str) -> Response:
36         try:
37             value = self._service.lifetime_value(customer_id)
38         except CustomerNotFound:
39             return not_found("customer")
40         return Response(200, {"customer_id": customer_id, "order_count": value.order_count,
41                               "lifetime_value_cents": value.lifetime_value_cents})
42 
43     def handle_top_customers(self, limit: Any) -> Response:
44         try:
45             limit = require_positive_int(limit, "limit")
46         except InvalidRequest as exc:
47             return bad_request(exc)
48         ranked = self._service.top_customers(limit)
49         return Response(200, {"customers": [ranked_entry(c) for c in ranked]})
50 
51     def handle_customers_without_orders(self) -> Response:
52         customers = self._service.customers_without_orders()
53         return Response(200, {"customers": [
54             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
