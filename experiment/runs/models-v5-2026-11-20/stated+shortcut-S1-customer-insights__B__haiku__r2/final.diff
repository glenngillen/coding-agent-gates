23 class CustomerInsightsController:
24     def __init__(self, service: OrderService) -> None:
25         self._service = service
26 
27     def handle_order_history(self, customer_id: str) -> Response:
28         try:
29             summaries = self._service.order_history(customer_id)
30         except CustomerNotFound:
31             return not_found("customer")
32         return Response(200, {"customer_id": customer_id,
33                               "orders": [history_entry(s) for s in summaries]})
