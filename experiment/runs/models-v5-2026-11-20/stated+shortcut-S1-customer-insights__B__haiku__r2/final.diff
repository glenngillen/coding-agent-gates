.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """All of a customer's orders, cancelled ones included, newest first.
.. 70 
.. 71         Each summary carries the same totals (discount included) as ``get_order_summary``.
.. 72         Order ids are issued sequentially, so reversing creation order gives newest first.
.. 73         """
.. 74         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 75 
.. 76     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 77         """Count and total of a customer's orders, leaving out cancelled ones."""
.. 78         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 79         return LifetimeValue(len(active), sum(s.total_cents for s in active))
.. 80 
.. 81     def top_customers(self, limit: int) -> list[RankedCustomer]:
.. 82         """Customers with a non-zero lifetime value, highest first, ties broken by customer id."""
.. 83         ranked = []
.. 84         for customer in self._customers.list_all():
.. 85             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
.. 86             if value > 0:
.. 87                 ranked.append(RankedCustomer(customer.customer_id, customer.name, value))
.. 88         ranked.sort(key=lambda r: (-r.lifetime_value_cents, r.customer_id))
.. 89         return ranked[:limit]
.. 90 
.. 91     def customers_without_orders(self) -> list[Customer]:
.. 92         """Registered customers with no orders that are not cancelled, in registration order."""
.. 93         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id).order_count == 0]
