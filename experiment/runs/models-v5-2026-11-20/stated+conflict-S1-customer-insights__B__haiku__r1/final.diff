 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
10                                      require_positive_int)
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, orders: OrderService) -> None:
15         self._orders = orders
16 
17     def handle_order_history(self, customer_id: str) -> Response:
18         """A customer's orders, newest first, with the totals the order summary reports."""
19         try:
20             summaries = self._orders.list_summaries_for_customer(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         history: list[dict[str, Any]] = [
24             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
25             for s in summaries
26         ]
27         return Response(200, {"customer_id": customer_id, "orders": history})
28 
29     def handle_lifetime_value(self, customer_id: str) -> Response:
30         """Number of non-cancelled orders and their combined total, as in the order history."""
31         try:
32             order_count, lifetime_value_cents = self._orders.lifetime_value(customer_id)
33         except CustomerNotFound:
34             return not_found("customer")
35         return Response(200, {"customer_id": customer_id, "order_count": order_count,
36                               "lifetime_value_cents": lifetime_value_cents})
37 
38     def handle_customers_without_orders(self) -> Response:
39         """Registered customers with no orders that are not cancelled, in registration order."""
40         customers = [{"customer_id": c.customer_id, "name": c.name, "email": c.email}
41                      for c in self._orders.customers_without_active_orders()]
42         return Response(200, {"customers": customers})
43 
44     def handle_top_customers(self, limit: Any) -> Response:
45         """Leaderboard of customers by lifetime value, highest first."""
46         try:
47             limit = require_positive_int(limit, "limit")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         customers = [{"customer_id": customer.customer_id, "name": customer.name,
51                       "lifetime_value_cents": value}
52                      for customer, value in self._orders.top_customers(limit)]
53         return Response(200, {"customers": customers})
