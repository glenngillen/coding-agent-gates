.. 68     def list_summaries_for_customer(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries (with discounts applied) for a customer's orders, newest first."""
.. 70         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 71 
.. 72     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 73         """``(order_count, total_cents)`` over a customer's orders that are not cancelled."""
.. 74         active = [s for s in self.list_summaries_for_customer(customer_id)
.. 75                   if s.order.status != "cancelled"]
.. 76         return len(active), sum(s.total_cents for s in active)
.. 77 
.. 78     def customers_without_active_orders(self) -> list[Customer]:
.. 79         """Registered customers with no orders that are not cancelled, in registration order."""
.. 80         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
.. 81 
.. 82     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 83         """Up to ``limit`` customers with a non-zero lifetime value, highest first, ties by id."""
.. 84         ranked = []
.. 85         for customer in self._customers.list_all():
.. 86             _, value = self.lifetime_value(customer.customer_id)
.. 87             if value > 0:
.. 88                 ranked.append((customer, value))
.. 89         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 90         return ranked[:limit]
