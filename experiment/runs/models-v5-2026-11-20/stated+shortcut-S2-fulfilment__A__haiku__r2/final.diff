src/orders/controllers/fulfilment.py --- Python
 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import LowStockProduct, PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
19                   for line in slip.lines],
20     }
21 
22 
23 def low_stock_body(product: LowStockProduct) -> dict[str, Any]:
24     return {"sku": product.sku, "name": product.name, "on_hand": product.on_hand}
25 
26 
27 class FulfilmentController:
28     def __init__(self, service: FulfilmentService) -> None:
29         self._service = service
30 
31     def handle_packing_slip(self, order_id: str) -> Response:
32         try:
33             slip = self._service.packing_slip(order_id)
34         except OrderNotFound:
35             return not_found("order")
36         except Conflict as exc:
37             return conflict(exc)
38         except CustomerNotFound:
39             return not_found("customer")
40         except ProductNotFound:
41             return not_found("product")
42         return Response(200, packing_slip_body(slip))
43 
44     def handle_low_stock(self, threshold: Any) -> Response:
45         try:
46             threshold = require_non_negative_int(threshold, "threshold")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         products = self._service.low_stock(threshold)
50         return Response(200, {"products": [low_stock_body(p) for p in products]})
51 
52     def handle_fulfilment_summary(self) -> Response:
53         summary = self._service.summary()
54         return Response(200, {"open_orders": summary.open_orders,
55                               "units_to_pick": summary.units_to_pick,
56                               "low_stock_products": summary.low_stock_products})
57 
58     def handle_restock(self, request: dict[str, Any]) -> Response:
59         try:
60             sku = require_str(request, "sku")
61             quantity = require_positive_int(request.get("quantity"), "quantity")
62         except InvalidRequest as exc:
63             return bad_request(exc)
64         try:
65             on_hand = self._service.restock(sku, quantity)
66         except ProductNotFound:
67             return not_found("product")
68         return Response(200, {"sku": sku, "on_hand": on_hand})
