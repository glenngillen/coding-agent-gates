src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders that still need to ship."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # Warehouse low-stock line: active products with fewer units than this are flagged.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def packing_slip(self, order_id: str) -> PackingSlip:
25         """Packing slip for an order. Cancelled orders are not packed."""
26         order = self._orders.get(order_id)
27         if order is None:
28             raise OrderNotFound(order_id)
29         if order.status == "cancelled":
30             raise Conflict(f"order {order_id} is cancelled")
31         customer = self._customers.get(order.customer_id)
32         if customer is None:
33             raise CustomerNotFound(order.customer_id)
34         lines = []
35         for item in order.items:
36             product = self._catalog.get(item.sku)
37             if product is None:
38                 raise ProductNotFound(item.sku)
39             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
40         return PackingSlip(order.order_id, customer.name, tuple(lines))
41 
42     def restock(self, sku: str, quantity: int) -> int:
43         """Add ``quantity`` units to a product's stock; returns the new level on hand."""
44         if self._catalog.get(sku) is None:
45             raise ProductNotFound(sku)
46         on_hand = self._stock.get(sku) + quantity
47         self._stock.set(sku, on_hand)
48         return on_hand
49 
50     def summary(self) -> FulfilmentSummary:
51         """Dashboard counts: open (not cancelled) orders, units across them, and low-stock products."""
52         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
53         units = sum(item.quantity for order in open_orders for item in order.items)
54         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
55 
56     def low_stock(self, threshold: int) -> list[LowStockProduct]:
57         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
58         rows = []
59         for product in self._catalog.list_all():
60             if not product.active:
61                 continue
62             on_hand = self._stock.get(product.sku)
63             if on_hand < threshold:
64                 rows.append(LowStockProduct(product.sku, product.name, on_hand))
65         return sorted(rows, key=lambda row: (row.on_hand, row.sku))
