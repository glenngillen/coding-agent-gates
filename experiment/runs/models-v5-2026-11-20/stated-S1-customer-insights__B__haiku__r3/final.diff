src/orders/application/insights_service.py --- Python
 1 """Customer insights for the account team, built on order summaries."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.order_service import OrderService
 9 from orders.domain.customers import Customer
10 from orders.domain.orders import OrderSummary
11 
12 
13 @dataclass(frozen=True)
14 class LifetimeValue:
15     customer_id: str
16     order_count: int
17     lifetime_value_cents: int
18 
19 
20 @dataclass(frozen=True)
21 class TopCustomer:
22     customer_id: str
23     name: str
24     lifetime_value_cents: int
25 
26 
27 class CustomerInsightsService:
28     def __init__(self, orders: OrderService, customers: CustomerService) -> None:
29         self._orders = orders
30         self._customers = customers
31 
32     def order_history(self, customer_id: str) -> list[OrderSummary]:
33         """Every order for the customer, newest first, with the same totals as the order summary.
34 
35         Raises ``CustomerNotFound`` if the customer does not exist.
36         """
37         orders = self._orders.list_for_customer(customer_id)  # creation order, oldest first
38         return [self._orders.summarize(order) for order in reversed(orders)]
39 
40     def lifetime_value(self, customer_id: str) -> LifetimeValue:
41         """Count and total of the customer's orders that are not cancelled.
42 
43         Raises ``CustomerNotFound`` if the customer does not exist.
44         """
45         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
46         return LifetimeValue(customer_id, len(active), sum(s.total_cents for s in active))
47 
48     def top_customers(self, limit: int) -> list[TopCustomer]:
49         """Customers with a non-zero lifetime value, highest first (ties by customer id), at most ``limit``."""
50         ranked = []
51         for customer in self._customers.list_all():
52             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
53             if value > 0:
54                 ranked.append(TopCustomer(customer.customer_id, customer.name, value))
55         ranked.sort(key=lambda c: (-c.lifetime_value_cents, c.customer_id))
56         return ranked[:limit]
57 
58     def customers_without_orders(self) -> list[Customer]:
59         """Registered customers with no orders that are not cancelled, in registration order."""
60         return [c for c in self._customers.list_all()
61                 if self.lifetime_value(c.customer_id).order_count == 0]
