 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import CustomerNotFound
 6 from orders.application.insights_service import CustomerInsightsService
 7 from typing import Any
 8 
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: CustomerInsightsService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             summaries = self._service.order_history(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         orders = [{"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
22                   for s in summaries]
23         return Response(200, {"customer_id": customer_id, "orders": orders})
24 
25     def handle_lifetime_value(self, customer_id: str) -> Response:
26         try:
27             value = self._service.lifetime_value(customer_id)
28         except CustomerNotFound:
29             return not_found("customer")
30         return Response(200, {"customer_id": value.customer_id, "order_count": value.order_count,
31                               "lifetime_value_cents": value.lifetime_value_cents})
32 
33     def handle_top_customers(self, limit: Any) -> Response:
34         try:
35             limit = require_positive_int(limit, "limit")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         top = self._service.top_customers(limit)
39         return Response(200, {"customers": [{"customer_id": c.customer_id, "name": c.name,
40                                              "lifetime_value_cents": c.lifetime_value_cents}
41                                             for c in top]})
42 
43     def handle_customers_without_orders(self) -> Response:
44         customers = self._service.customers_without_orders()
45         return Response(200, {"customers": [{"customer_id": c.customer_id, "name": c.name,
46                                              "email": c.email}
47                                             for c in customers]})
