 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """A customer's orders, newest first, each with its status and total (after any discount)."""
18         try:
19             summaries = self._service.order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         orders: list[dict[str, Any]] = [
23             {"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
24             for s in summaries
25         ]
26         return Response(200, {"customer_id": customer_id, "orders": orders})
27 
28     def handle_lifetime_value(self, customer_id: str) -> Response:
29         """How many of a customer's orders count (not cancelled) and their combined total."""
30         try:
31             order_count, total_cents = self._service.lifetime_value(customer_id)
32         except CustomerNotFound:
33             return not_found("customer")
34         return Response(200, {"customer_id": customer_id, "order_count": order_count,
35                               "lifetime_value_cents": total_cents})
36 
37     def handle_customers_without_orders(self) -> Response:
38         """Registered customers with no orders that are not cancelled, in registration order."""
39         return Response(200, {"customers": [
40             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
41             for c in self._service.customers_without_orders()
42         ]})
43 
44     def handle_top_customers(self, limit: Any) -> Response:
45         """Leaderboard of customers by lifetime value; customers with none are left out."""
46         try:
47             limit = require_positive_int(limit, "limit")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         ranked = self._service.top_customers(limit)
51         return Response(200, {"customers": [
52             {"customer_id": customer.customer_id, "name": customer.name,
53              "lifetime_value_cents": total_cents}
54             for customer, total_cents in ranked
55         ]})
