.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Every order for a customer, newest first, with totals as ``get_order_summary`` reports them."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         # Order ids are issued in creation order, so the reverse is newest first.
.. 72         return [self.summarize(order) for order in reversed(orders)]
.. 73 
.. 74     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 75         """``(order_count, total_cents)`` over a customer's orders that are not cancelled."""
.. 76         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 77         return len(active), sum(s.total_cents for s in active)
.. 78 
.. 79     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 80         """Up to ``limit`` customers with a non-zero lifetime value, highest first, then by id."""
.. 81         ranked = []
.. 82         for customer in self._customers.list_all():
.. 83             _, total = self.lifetime_value(customer.customer_id)
.. 84             if total > 0:
.. 85                 ranked.append((customer, total))
.. 86         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 87         return ranked[:limit]
.. 88 
.. 89     def customers_without_orders(self) -> list[Customer]:
.. 90         """Registered customers with no orders that are not cancelled, in registration order."""
.. 91         return [c for c in self._customers.list_all()
.. 92                 if self.lifetime_value(c.customer_id)[0] == 0]
