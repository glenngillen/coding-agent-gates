16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             orders = self._service.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return Response(404, {"error": "customer not found"})
21         order_entries = []
22         for order in reversed(orders):
23             summary = self._service.summarize(order)
24             order_entries.append({
25                 "order_id": order.order_id,
26                 "status": order.status,
27                 "total_cents": summary.total_cents,
28             })
29         return Response(200, {"customer_id": customer_id, "orders": order_entries})
