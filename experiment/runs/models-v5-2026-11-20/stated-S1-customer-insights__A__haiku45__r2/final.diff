31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             orders = self._service.list_for_customer(customer_id)
34         except CustomerNotFound:
35             return Response(404, {"error": "customer not found"})
36         order_count = 0
37         lifetime_value_cents = 0
38         for order in orders:
39             if order.status != "cancelled":
40                 summary = self._service.summarize(order)
41                 order_count += 1
42                 lifetime_value_cents += summary.total_cents
43         return Response(200, {
44             "customer_id": customer_id,
45             "order_count": order_count,
46             "lifetime_value_cents": lifetime_value_cents,
47         })
