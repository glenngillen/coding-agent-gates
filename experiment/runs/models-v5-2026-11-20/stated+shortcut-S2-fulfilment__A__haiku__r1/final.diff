 1 """Warehouse fulfilment: packing slips for orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.catalog import StockLevel
 7 from orders.domain.orders import FulfilmentSummary, PackingLine, PackingSlip
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def summary(self) -> FulfilmentSummary:
25         """Open (not cancelled) orders, units across them, and low-stock active products."""
26         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
27         units = sum(item.quantity for order in open_orders for item in order.items)
28         return FulfilmentSummary(len(open_orders), units, len(self.low_stock(LOW_STOCK_LINE)))
29 
30     def restock(self, sku: str, quantity: int) -> int:
31         """Add ``quantity`` units to a product's stock and return the new level."""
32         if self._catalog.get(sku) is None:
33             raise ProductNotFound(sku)
34         new_level = self._stock.get(sku) + quantity
35         self._stock.set(sku, new_level)
36         return new_level
37 
38     def low_stock(self, threshold: int) -> list[StockLevel]:
39         """Active products with on-hand stock strictly below ``threshold``.
40 
41         Lowest stock first, then by SKU.
42         """
43         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
44                   for p in self._catalog.list_all() if p.active]
45         low = [level for level in levels if level.on_hand < threshold]
46         return sorted(low, key=lambda level: (level.on_hand, level.sku))
47 
48     def packing_slip(self, order_id: str) -> PackingSlip:
49         """Packing slip for a placed order, lines in the order's item order.
50 
51         Cancelled orders are not packed.
52         """
53         order = self._orders.get(order_id)
54         if order is None:
55             raise OrderNotFound(order_id)
56         if order.status == "cancelled":
57             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
58         customer = self._customers.get(order.customer_id)
59         if customer is None:
60             raise CustomerNotFound(order.customer_id)
61         lines = []
62         for item in order.items:
63             product = self._catalog.get(item.sku)
64             if product is None:
65                 raise ProductNotFound(item.sku)
66             lines.append(PackingLine(item.sku, product.name, item.quantity))
67         return PackingSlip(order.order_id, customer.name, tuple(lines))
