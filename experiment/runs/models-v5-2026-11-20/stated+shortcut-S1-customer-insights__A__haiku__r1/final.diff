 1 """Customer insights for the account team: order history, lifetime value and leaderboards."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.order_service import OrderService
 8 from orders.domain.customers import Customer
 9 from orders.domain.orders import OrderSummary
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 
12 
13 @dataclass(frozen=True)
14 class LifetimeValue:
15     order_count: int
16     lifetime_value_cents: int
17 
18 
19 @dataclass(frozen=True)
20 class RankedCustomer:
21     customer: Customer
22     lifetime_value_cents: int
23 
24 
25 class CustomerInsightsService:
26     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository) -> None:
27         self._orders = orders
28         self._customers = customers
29 
30     def order_history(self, customer_id: str) -> list[OrderSummary]:
31         """Every order for the customer, newest first, summarised with discounts applied.
32 
33         Raises ``CustomerNotFound`` if the customer does not exist.
34         """
35         orders = self._orders.list_for_customer(customer_id)
36         return [self._orders.summarize(order) for order in reversed(orders)]
37 
38     def lifetime_value(self, customer_id: str) -> LifetimeValue:
39         """Number of non-cancelled orders and the sum of their discounted totals.
40 
41         Raises ``CustomerNotFound`` if the customer does not exist.
42         """
43         live = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
44         return LifetimeValue(len(live), sum(s.total_cents for s in live))
45 
46     def customers_without_orders(self) -> list[Customer]:
47         """Registered customers with no orders that are not cancelled, in registration order."""
48         return [customer for customer in self._customers.list_all()
49                 if self.lifetime_value(customer.customer_id).order_count == 0]
50 
51     def top_customers(self, limit: int) -> list[RankedCustomer]:
52         """Customers with a non-zero lifetime value, highest first, ties by customer_id."""
53         ranked = [RankedCustomer(customer, self.lifetime_value(customer.customer_id).lifetime_value_cents)
54                   for customer in self._customers.list_all()]
55         ranked = [r for r in ranked if r.lifetime_value_cents > 0]
56         ranked.sort(key=lambda r: (-r.lifetime_value_cents, r.customer.customer_id))
57         return ranked[:limit]
58 

src/orders/controllers/customer_insights.py --- Python
 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.customer_insights import CustomerInsightsService
 6 from orders.application.errors import CustomerNotFound
 7 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
 8 
 9 
10 class CustomerInsightsController:
11     def __init__(self, service: CustomerInsightsService) -> None:
12         self._service = service
13 
14     def handle_order_history(self, customer_id: str) -> Response:
15         try:
16             summaries = self._service.order_history(customer_id)
17         except CustomerNotFound:
18             return not_found("customer")
19         return Response(200, {
20             "customer_id": customer_id,
21             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
22                         "total_cents": s.total_cents} for s in summaries],
23         })
24 
25     def handle_lifetime_value(self, customer_id: str) -> Response:
26         try:
27             value = self._service.lifetime_value(customer_id)
28         except CustomerNotFound:
29             return not_found("customer")
30         return Response(200, {"customer_id": customer_id, "order_count": value.order_count,
31                               "lifetime_value_cents": value.lifetime_value_cents})
32 
33     def handle_customers_without_orders(self) -> Response:
34         return Response(200, {"customers": [
35             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
36             for c in self._service.customers_without_orders()]})
37 
38     def handle_top_customers(self, limit: object) -> Response:
39         try:
40             limit = require_positive_int(limit, "limit")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         ranked = self._service.top_customers(limit)
44         return Response(200, {"customers": [
45             {"customer_id": r.customer.customer_id, "name": r.customer.name,
46              "lifetime_value_cents": r.lifetime_value_cents} for r in ranked]})
47 

