 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # Warehouse low-stock line: active products below this many units are low stock.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def packing_slip(self, order_id: str) -> PackingSlip:
25         """Packing slip for an order. Cancelled orders are not packed."""
26         order = self._orders.get_order(order_id)  # raises OrderNotFound
27         if order.status == "cancelled":
28             raise Conflict(f"order {order_id} is cancelled")
29         customer = self._customers.get(order.customer_id)
30         if customer is None:
31             raise CustomerNotFound(order.customer_id)
32         lines = []
33         for item in order.items:
34             product = self._catalog.get(item.sku)
35             if product is None:
36                 raise ProductNotFound(item.sku)
37             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
38         return PackingSlip(order.order_id, customer.name, tuple(lines))
39 
40     def fulfilment_summary(self) -> FulfilmentSummary:
41         """Dashboard figures: open orders, units to pick, and products at or below the low-stock line."""
42         open_orders = self._orders.open_orders()
43         units = sum(item.quantity for order in open_orders for item in order.items)
44         low_stock = self.low_stock(LOW_STOCK_LINE)
45         return FulfilmentSummary(len(open_orders), units, len(low_stock))
46 
47     def restock(self, sku: str, quantity: int) -> int:
48         """Add ``quantity`` units to a product's stock. Returns the new level."""
49         if self._catalog.get(sku) is None:
50             raise ProductNotFound(sku)
51         new_level = self._stock.get(sku) + quantity
52         self._stock.set(sku, new_level)
53         return new_level
54 
55     def low_stock(self, threshold: int) -> list[LowStockProduct]:
56         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
57         rows = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
58                 for p in self._catalog.list_all() if p.active]
59         rows = [row for row in rows if row.on_hand < threshold]
60         return sorted(rows, key=lambda row: (row.on_hand, row.sku))
