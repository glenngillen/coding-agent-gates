 1 """Customer insight endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_service import CustomerService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
11 
12 
13 class CustomerInsightsController:
14     def __init__(self, service: OrderService, customer_service: CustomerService) -> None:
15         self._service = service
16         self._customer_service = customer_service
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         try:
20             orders = self._service.list_for_customer(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         orders_data = []
24         for order in reversed(orders):
25             summary = self._service.summarize(order)
26             orders_data.append({
27                 "order_id": order.order_id,
28                 "status": order.status,
29                 "total_cents": summary.total_cents,
30             })
31         return Response(200, {"customer_id": customer_id, "orders": orders_data})
32 
33     def handle_lifetime_value(self, customer_id: str) -> Response:
34         try:
35             orders = self._service.list_for_customer(customer_id)
36         except CustomerNotFound:
37             return not_found("customer")
38         order_count = 0
39         lifetime_value_cents = 0
40         for order in orders:
41             if order.status != "cancelled":
42                 summary = self._service.summarize(order)
43                 order_count += 1
44                 lifetime_value_cents += summary.total_cents
45         return Response(200, {"customer_id": customer_id, "order_count": order_count,
46                              "lifetime_value_cents": lifetime_value_cents})
47 
48     def handle_top_customers(self, limit: Any) -> Response:
49         try:
50             limit_int = require_positive_int(limit, "limit")
51         except InvalidRequest as exc:
52             return bad_request(exc)
53         customers_data = []
54         for customer in self._customer_service.list_all():
55             orders = self._service.list_for_customer(customer.customer_id)
56             lifetime_value_cents = 0
57             for order in orders:
58                 if order.status != "cancelled":
59                     summary = self._service.summarize(order)
60                     lifetime_value_cents += summary.total_cents
61             if lifetime_value_cents > 0:
62                 customers_data.append({
63                     "customer_id": customer.customer_id,
64                     "name": customer.name,
65                     "lifetime_value_cents": lifetime_value_cents,
66                 })
67         customers_data.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
68         return Response(200, {"customers": customers_data[:limit_int]})
69 
70     def handle_customers_without_orders(self) -> Response:
71         customers_data = []
72         for customer in self._customer_service.list_all():
73             orders = self._service.list_for_customer(customer.customer_id)
74             has_active_orders = any(order.status != "cancelled" for order in orders)
75             if not has_active_orders:
76                 customers_data.append({
77                     "customer_id": customer.customer_id,
78                     "name": customer.name,
79                     "email": customer.email,
80                 })
81         return Response(200, {"customers": customers_data})
