 1 """Fulfillment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.catalog_service import CatalogService
 8 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 9 from orders.application.order_service import OrderService
10 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_non_negative_int, require_positive_int, require_str
11 
12 
13 class FulfilmentController:
14     def __init__(self, order_service: OrderService, catalog_service: CatalogService) -> None:
15         self._order_service = order_service
16         self._catalog_service = catalog_service
17 
18     def handle_packing_slip(self, order_id: str) -> Response:
19         try:
20             packing_slip = self._order_service.get_packing_slip(order_id)
21         except OrderNotFound:
22             return not_found("order")
23         except Conflict as exc:
24             return conflict(exc)
25         return Response(200, packing_slip)
26 
27     def handle_low_stock(self, threshold: Any) -> Response:
28         try:
29             threshold_int = require_non_negative_int(threshold, "threshold")
30         except InvalidRequest as exc:
31             return bad_request(exc)
32         low_stock = self._catalog_service.get_low_stock(threshold_int)
33         products = [{"sku": p.sku, "name": p.name, "on_hand": stock} for p, stock in low_stock]
34         return Response(200, {"products": products})
35 
36     def handle_restock(self, request: dict[str, Any]) -> Response:
37         try:
38             sku = require_str(request, "sku")
39             quantity = require_positive_int(request.get("quantity"), "quantity")
40         except InvalidRequest as exc:
41             return bad_request(exc)
42         try:
43             new_stock = self._catalog_service.restock(sku, quantity)
44         except ProductNotFound:
45             return not_found("product")
46         return Response(200, {"sku": sku, "on_hand": new_stock})
47 
48     def handle_fulfilment_summary(self) -> Response:
49         summary = self._order_service.get_fulfilment_summary()
50         low_stock = self._catalog_service.get_low_stock(5)
51         summary["low_stock_products"] = len(low_stock)
52         return Response(200, summary)
