   88     def get_fulfilment_summary(self) -> dict:
   89         all_orders = self._orders.list_all()
   90         open_orders = [o for o in all_orders if o.status != "cancelled"]
   91         units_to_pick = sum(item.quantity for order in open_orders for item in order.items)
   92         return {"open_orders": len(open_orders), "units_to_pick": units_to_pick}

