 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             summaries = self._service.order_history(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         body: dict[str, Any] = {
22             "customer_id": customer_id,
23             "orders": [{"order_id": s.order.order_id, "status": s.order.status,
24                         "total_cents": s.total_cents} for s in summaries],
25         }
26         return Response(200, body)
27 
28     def handle_lifetime_value(self, customer_id: str) -> Response:
29         try:
30             order_count, lifetime_value_cents = self._service.lifetime_value(customer_id)
31         except CustomerNotFound:
32             return not_found("customer")
33         return Response(200, {"customer_id": customer_id, "order_count": order_count,
34                               "lifetime_value_cents": lifetime_value_cents})
35 
36     def handle_customers_without_orders(self) -> Response:
37         customers = self._service.customers_without_orders()
38         return Response(200, {"customers": [
39             {"customer_id": c.customer_id, "name": c.name, "email": c.email}
40             for c in customers]})
41 
42     def handle_top_customers(self, limit: Any) -> Response:
43         try:
44             limit = require_positive_int(limit, "limit")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         ranked = self._service.top_customers(limit)
48         return Response(200, {"customers": [
49             {"customer_id": customer.customer_id, "name": customer.name,
50              "lifetime_value_cents": value}
51             for customer, value in ranked]})
