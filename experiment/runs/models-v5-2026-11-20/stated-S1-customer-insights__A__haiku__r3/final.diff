.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Every order for a customer, newest first, priced as ``get_order_summary`` prices them."""
.. 70         orders = self.list_for_customer(customer_id)
.. 71         return [self.summarize(order) for order in reversed(orders)]
.. 72 
.. 73     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 74         """Count and total of a customer's orders, leaving out cancelled ones."""
.. 75         live = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return LifetimeValue(len(live), sum(s.total_cents for s in live))
.. 77 
.. 78     def customers_without_orders(self) -> list[Customer]:
.. 79         """Registered customers with no orders other than cancelled ones, in registration order."""
.. 80         return [c for c in self._customers.list_all()
.. 81                 if self.lifetime_value(c.customer_id).order_count == 0]
.. 82 
.. 83     def top_customers(self, limit: int) -> list[RankedCustomer]:
.. 84         """Customers with a non-zero lifetime value, highest first (ties by customer_id), at most ``limit``."""
.. 85         ranked = []
.. 86         for customer in self._customers.list_all():
.. 87             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
.. 88             if value > 0:
.. 89                 ranked.append(RankedCustomer(customer.customer_id, customer.name, value))
.. 90         ranked.sort(key=lambda r: (-r.lifetime_value_cents, r.customer_id))
.. 91         return ranked[:limit]
