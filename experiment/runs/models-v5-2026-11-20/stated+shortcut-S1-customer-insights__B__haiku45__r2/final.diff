    79     def get_lifetime_value(self, customer_id: str) -> tuple[int, int]:
    80         """Return (order_count, lifetime_value_cents) for non-cancelled orders."""
    81         orders = self.list_for_customer(customer_id)
    82         active_orders = [o for o in orders if o.status != "cancelled"]
    83         total = sum(self.summarize(order).total_cents for order in active_orders)
    84         return (len(active_orders), total)
    85 
    86     def get_top_customers(self, limit: int) -> list[dict[str, str | int]]:
    87         """Return top customers by lifetime value (highest first, then by customer_id)."""
    88         customers_data = []
    89         for customer in self._customers.list_all():
    90             _, lifetime_value = self.get_lifetime_value(customer.customer_id)
    91             if lifetime_value > 0:
    92                 customers_data.append({
    93                     "customer_id": customer.customer_id,
    94                     "name": customer.name,
    95                     "lifetime_value_cents": lifetime_value,
    96                 })
    97         customers_data.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
    98         return customers_data[:limit]
