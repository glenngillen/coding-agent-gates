.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries of every order a customer has placed, newest first, including cancelled ones."""
.. 70         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 71 
.. 72     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 73         """Count and total of a customer's orders that are not cancelled, using order-history totals."""
.. 74         live = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 75         return LifetimeValue(len(live), sum(s.total_cents for s in live))
.. 76 
.. 77     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 78         """Customers with a non-zero lifetime value, highest first (ties by id), at most ``limit``."""
.. 79         ranked = []
.. 80         for customer in self._customers.list_all():
.. 81             value = self.lifetime_value(customer.customer_id).lifetime_value_cents
.. 82             if value > 0:
.. 83                 ranked.append((customer, value))
.. 84         ranked.sort(key=lambda row: (-row[1], row[0].customer_id))
.. 85         return ranked[:limit]
.. 86 
.. 87     def customers_without_orders(self) -> list[Customer]:
.. 88         """Registered customers with no orders that are not cancelled, in registration order."""
