 1 """Fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_non_negative_int, require_positive_int, require_str
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             packing_slip = self._service.get_packing_slip(order_id)
19         except OrderNotFound:
20             return not_found("order")
21         except Conflict as exc:
22             return conflict(exc)
23         return Response(200, packing_slip)
24 
25     def handle_low_stock(self, threshold: Any) -> Response:
26         try:
27             threshold = require_non_negative_int(threshold, "threshold")
28         except InvalidRequest as exc:
29             return bad_request(exc)
30         return Response(200, self._service.get_low_stock(threshold))
31 
32     def handle_restock(self, request: dict[str, Any]) -> Response:
33         try:
34             sku = require_str(request, "sku")
35             quantity = require_positive_int(request.get("quantity"), "quantity")
36         except InvalidRequest as exc:
37             return bad_request(exc)
38         try:
39             result = self._service.restock(sku, quantity)
40         except ProductNotFound:
41             return not_found("product")
42         return Response(200, result)
43 
44     def handle_fulfilment_summary(self) -> Response:
45         summary = self._service.get_fulfilment_summary()
46         return Response(200, summary)
47 

