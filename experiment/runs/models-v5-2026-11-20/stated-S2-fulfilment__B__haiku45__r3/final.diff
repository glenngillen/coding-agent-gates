 1 """Packing slip generation and fulfilment operations."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.catalog_service import CatalogService
 8 from orders.application.customer_service import CustomerService
 9 from orders.application.errors import Conflict, ProductNotFound
10 from orders.application.order_service import OrderService
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 
13 
14 class FulfilmentService:
15     def __init__(self, order_service: OrderService, customer_service: CustomerService,
16                  catalog_service: CatalogService, orders: InMemoryOrderRepository) -> None:
17         self._order_service = order_service
18         self._customer_service = customer_service
19         self._catalog_service = catalog_service
20         self._orders = orders
21 
22     def get_packing_slip(self, order_id: str) -> dict[str, Any]:
23         order = self._order_service.get_order(order_id)
24         if order.status == "cancelled":
25             raise Conflict("order is cancelled")
26 
27         customer = self._customer_service.get(order.customer_id)
28 
29         lines = []
30         for item in order.items:
31             product = self._catalog_service.get_product(item.sku)
32             lines.append({
33                 "sku": item.sku,
34                 "name": product.name,
35                 "quantity": item.quantity,
36             })
37 
38         return {
39             "order_id": order.order_id,
40             "customer_name": customer.name,
41             "lines": lines,
42         }
43 
44     def get_low_stock(self, threshold: int) -> dict[str, Any]:
45         products = self._catalog_service.list_active()
46         low_stock = []
47         for product in products:
48             on_hand = self._catalog_service.on_hand(product.sku)
49             if on_hand < threshold:
50                 low_stock.append({
51                     "sku": product.sku,
52                     "name": product.name,
53                     "on_hand": on_hand,
54                 })
55         low_stock.sort(key=lambda p: (p["on_hand"], p["sku"]))
56         return {"products": low_stock}
57 
58     def restock(self, sku: str, quantity: int) -> dict[str, Any]:
59         new_stock = self._catalog_service.restock(sku, quantity)
60         return {"sku": sku, "on_hand": new_stock}
61 
62     def get_fulfilment_summary(self) -> dict[str, Any]:
63         open_orders = 0
64         units_to_pick = 0
65         for order in self._orders.list_all():
66             if order.status != "cancelled":
67                 open_orders += 1
68                 for item in order.items:
69                     units_to_pick += item.quantity
70 
71         low_stock_products = 0
72         for product in self._catalog_service.list_active():
73             on_hand = self._catalog_service.on_hand(product.sku)
74             if on_hand < 5:
75                 low_stock_products += 1
76 
77         return {
78             "open_orders": open_orders,
79             "units_to_pick": units_to_pick,
80             "low_stock_products": low_stock_products,
81         }
82 

