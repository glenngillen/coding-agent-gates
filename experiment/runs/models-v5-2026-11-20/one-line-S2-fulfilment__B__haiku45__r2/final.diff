 1 """Warehouse fulfilment and packing slip generation."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 6 from orders.infrastructure.catalog import InMemoryProductCatalog
 7 from orders.infrastructure.customers import InMemoryCustomerRepository
 8 from orders.infrastructure.repository import InMemoryOrderRepository
 9 from orders.infrastructure.stock import InMemoryStockRepository
10 
11 
12 class FulfilmentService:
13     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
14                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
15         self._orders = orders
16         self._customers = customers
17         self._catalog = catalog
18         self._stock = stock
19 
20     def get_packing_slip(self, order_id: str) -> dict:
21         order = self._orders.get(order_id)
22         if order is None:
23             raise OrderNotFound(order_id)
24         if order.status == "cancelled":
25             raise Conflict(f"order {order_id} is cancelled")
26         customer = self._customers.get(order.customer_id)
27         customer_name = customer.name if customer is not None else ""
28         lines = [
29             {
30                 "sku": item.sku,
31                 "name": self._catalog.get(item.sku).name if self._catalog.get(item.sku) else "",
32                 "quantity": item.quantity
33             }
34             for item in order.items
35         ]
36         return {
37             "order_id": order.order_id,
38             "customer_name": customer_name,
39             "lines": lines
40         }
41 
42     def get_low_stock(self, threshold: int) -> list[dict]:
43         products = [
44             {
45                 "sku": p.sku,
46                 "name": p.name,
47                 "on_hand": self._stock.get(p.sku)
48             }
49             for p in self._catalog.list_all()
50             if p.active and self._stock.get(p.sku) < threshold
51         ]
52         return sorted(products, key=lambda p: (p["on_hand"], p["sku"]))
53 
54     def restock(self, sku: str, quantity: int) -> dict:
55         product = self._catalog.get(sku)
56         if product is None or not product.active:
57             raise ProductNotFound(sku)
58         new_level = self._stock.get(sku) + quantity
59         self._stock.set(sku, new_level)
60         return {"sku": sku, "on_hand": new_level}
61 
62     def get_fulfilment_summary(self) -> dict:
63         open_orders = 0
64         units_to_pick = 0
65         for order in self._orders.list_all():
66             if order.status != "cancelled":
67                 open_orders += 1
68                 units_to_pick += sum(item.quantity for item in order.items)
69         low_stock_products = sum(
70             1 for p in self._catalog.list_all()
71             if p.active and self._stock.get(p.sku) < 5
72         )
73         return {
74             "open_orders": open_orders,
75             "units_to_pick": units_to_pick,
76             "low_stock_products": low_stock_products
77         }
