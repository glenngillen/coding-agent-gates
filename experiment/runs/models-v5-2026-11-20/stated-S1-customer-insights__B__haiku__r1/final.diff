24 class CustomerInsightsController:
25     def __init__(self, service: OrderService) -> None:
26         self._service = service
27 
28     def handle_order_history(self, customer_id: str) -> Response:
29         try:
30             summaries = self._service.order_history(customer_id)
31         except CustomerNotFound:
32             return not_found("customer")
33         return Response(200, {"customer_id": customer_id,
34                               "orders": [history_entry(s) for s in summaries]})
35 
36     def handle_lifetime_value(self, customer_id: str) -> Response:
37         try:
38             value = self._service.lifetime_value(customer_id)
39         except CustomerNotFound:
40             return not_found("customer")
41         return Response(200, {"customer_id": customer_id, "order_count": value.order_count,
42                               "lifetime_value_cents": value.total_cents})
43 
44     def handle_top_customers(self, limit: Any) -> Response:
45         try:
46             limit = require_positive_int(limit, "limit")
47         except InvalidRequest as exc:
48             return bad_request(exc)
49         ranked = self._service.top_customers(limit)
50         return Response(200, {"customers": [leaderboard_entry(r) for r in ranked]})
51 
52     def handle_customers_without_orders(self) -> Response:
53         customers = self._service.customers_without_orders()
54         return Response(200, {"customers": [{"customer_id": c.customer_id, "name": c.name,
55                                              "email": c.email} for c in customers]})
