.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Summaries (with totals) of all of a customer's orders, newest first, cancelled included."""
.. 70         return [self.summarize(order) for order in reversed(self.list_for_customer(customer_id))]
.. 71 
.. 72     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 73         """Count and total of a customer's orders that are not cancelled."""
.. 74         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 75         return LifetimeValue(len(active), sum(s.total_cents for s in active))
.. 76 
.. 77     def customers_without_orders(self) -> list[Customer]:
.. 78         """Registered customers with no orders that are not cancelled, in registration order."""
.. 79         return [c for c in self._customers.list_all()
.. 80                 if self.lifetime_value(c.customer_id).order_count == 0]
.. 81 
.. 82     def top_customers(self, limit: int) -> list[RankedCustomer]:
.. 83         """Customers with a non-zero lifetime value, highest first (ties by customer_id), at most ``limit``."""
.. 84         ranked = [RankedCustomer(c, self.lifetime_value(c.customer_id).total_cents)
.. 85                   for c in self._customers.list_all()]
.. 86         ranked = [r for r in ranked if r.lifetime_value_cents > 0]
.. 87         ranked.sort(key=lambda r: (-r.lifetime_value_cents, r.customer.customer_id))
.. 88         return ranked[:limit]
