 1 """Customer insight endpoints for the account team."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             orders = self._service.list_for_customer(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21 
22         order_entries = []
23         for order in reversed(orders):
24             summary = self._service.summarize(order)
25             order_entries.append({
26                 "order_id": order.order_id,
27                 "status": order.status,
28                 "total_cents": summary.total_cents,
29             })
30 
31         return Response(200, {
32             "customer_id": customer_id,
33             "orders": order_entries,
34         })
35 
36     def handle_lifetime_value(self, customer_id: str) -> Response:
37         try:
38             orders = self._service.list_for_customer(customer_id)
39         except CustomerNotFound:
40             return not_found("customer")
41 
42         order_count = 0
43         lifetime_value_cents = 0
44         for order in orders:
45             if order.status != "cancelled":
46                 summary = self._service.summarize(order)
47                 order_count += 1
48                 lifetime_value_cents += summary.total_cents
49 
50         return Response(200, {
51             "customer_id": customer_id,
52             "order_count": order_count,
53             "lifetime_value_cents": lifetime_value_cents,
54         })
55 
56     def handle_top_customers(self, limit: Any) -> Response:
57         try:
58             limit = require_positive_int(limit, "limit")
59         except InvalidRequest as exc:
60             return bad_request(exc)
61 
62         customers = self._service.get_top_customers(limit)
63         return Response(200, {"customers": customers})
64 
65     def handle_customers_without_orders(self) -> Response:
66         customers = self._service.get_customers_without_orders()
67         return Response(200, {"customers": customers})
