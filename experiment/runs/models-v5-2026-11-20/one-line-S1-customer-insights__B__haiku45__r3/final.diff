    75     def get_top_customers(self, limit: int) -> list[dict[str, str | int]]:
    76         """Get top customers by lifetime value (non-cancelled orders only), sorted by value then id."""
    77         customer_values = []
    78         for customer in self._customers.list_all():
    79             orders = self._orders.list_for_customer(customer.customer_id)
    80             lifetime_value_cents = 0
    81             for order in orders:
    82                 if order.status != "cancelled":
    83                     summary = self.summarize(order)
    84                     lifetime_value_cents += summary.total_cents
    85 
    86             if lifetime_value_cents > 0:
    87                 customer_values.append({
    88                     "customer_id": customer.customer_id,
    89                     "name": customer.name,
    90                     "lifetime_value_cents": lifetime_value_cents,
    91                 })
    92 
    93         customer_values.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
    94         return customer_values[:limit]
    95 
    96     def get_customers_without_orders(self) -> list[dict[str, str]]:
    97         """Get customers with no non-cancelled orders, in registration order."""
    98         result = []
    99         for customer in self._customers.list_all():
   100             orders = self._orders.list_for_customer(customer.customer_id)
   101             has_non_cancelled = any(order.status != "cancelled" for order in orders)
   102             if not has_non_cancelled:
   103                 result.append({
   104                     "customer_id": customer.customer_id,
   105                     "name": customer.name,
   106                     "email": customer.email,
   107                 })
   108         return result

