src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for placed orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 
 8 LOW_STOCK_LINE = 5  # the warehouse's low-stock threshold, in units on hand
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 from orders.infrastructure.stock import InMemoryStockRepository
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def fulfilment_summary(self) -> FulfilmentSummary:
24         """Open (not cancelled) orders, units to pick across them, and low-stock products."""
25         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
26         return FulfilmentSummary(
27             open_orders=len(open_orders),
28             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
29             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
30         )
31 
32     def restock(self, sku: str, quantity: int) -> int:
33         """Add ``quantity`` units to a known product's stock and return the new level.
34 
35         Stock is shared with order placement, so restocked units are orderable immediately.
36         """
37         if self._catalog.get(sku) is None:
38             raise ProductNotFound(sku)
39         new_level = self._stock.get(sku) + quantity
40         self._stock.set(sku, new_level)
41         return new_level
42 
43     def low_stock(self, threshold: int) -> list[LowStockProduct]:
44         """Active products whose on-hand stock is strictly below ``threshold``.
45 
46         Sorted by on-hand quantity (lowest first), then by SKU.
47         """
48         low = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
49                for p in self._catalog.list_all() if p.active]
50         low = [p for p in low if p.on_hand < threshold]
51         return sorted(low, key=lambda p: (p.on_hand, p.sku))
52 
53     def packing_slip(self, order_id: str) -> PackingSlip:
54         """Build the packing slip for an order that is still to be fulfilled.
55 
56         Raises ``OrderNotFound`` for an unknown order and ``Conflict`` for a cancelled one.
57         """
58         order = self._orders.get(order_id)
59         if order is None:
60             raise OrderNotFound(order_id)
61         if order.status == "cancelled":
62             raise Conflict(f"order {order_id} is cancelled")
63         customer = self._customers.get(order.customer_id)
64         if customer is None:
65             raise CustomerNotFound(order.customer_id)
66         lines = []
67         for item in order.items:
68             product = self._catalog.get(item.sku)
69             if product is None:
70                 raise ProductNotFound(item.sku)
71             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
72         return PackingSlip(order.order_id, customer.name, tuple(lines))
73 

src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict[str, Any]:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
19                   for line in slip.lines],
20     }
21 
22 
23 class FulfilmentController:
24     def __init__(self, service: FulfilmentService) -> None:
25         self._service = service
26 
27     def handle_restock(self, request: dict[str, Any]) -> Response:
28         try:
29             sku = require_str(request, "sku")
30             quantity = require_positive_int(request.get("quantity"), "quantity")
31         except InvalidRequest as exc:
32             return bad_request(exc)
33         try:
34             on_hand = self._service.restock(sku, quantity)
35         except ProductNotFound:
36             return not_found("product")
37         return Response(200, {"sku": sku, "on_hand": on_hand})
38 
39     def handle_fulfilment_summary(self) -> Response:
40         summary = self._service.fulfilment_summary()
41         return Response(200, {"open_orders": summary.open_orders,
42                               "units_to_pick": summary.units_to_pick,
43                               "low_stock_products": summary.low_stock_products})
44 
45     def handle_low_stock(self, threshold: Any) -> Response:
46         try:
47             threshold = require_non_negative_int(threshold, "threshold")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50         products = self._service.low_stock(threshold)
51         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
52                                            for p in products]})
53 
54     def handle_packing_slip(self, order_id: str) -> Response:
55         try:
56             slip = self._service.packing_slip(order_id)
57         except OrderNotFound:
58             return not_found("order")
59         except Conflict as exc:
60             return conflict(exc)
61         except CustomerNotFound:
62             return not_found("customer")
63         except ProductNotFound:
64             return not_found("product")
65         return Response(200, packing_slip_body(slip))
66 

