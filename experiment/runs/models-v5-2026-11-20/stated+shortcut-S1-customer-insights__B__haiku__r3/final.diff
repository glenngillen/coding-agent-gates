.. 68     def order_history(self, customer_id: str) -> list[OrderSummary]:
.. 69         """Every order for a customer (cancelled ones included), newest first, with totals as in ``summarize``."""
.. 70         if self._customers.get(customer_id) is None:
.. 71             raise CustomerNotFound(customer_id)
.. 72         # list_for_customer is creation order; reverse it for newest first.
.. 73         return [self.summarize(o) for o in reversed(self._orders.list_for_customer(customer_id))]
.. 74 
.. 75     def lifetime_value(self, customer_id: str) -> tuple[int, int]:
.. 76         """``(order_count, lifetime_value_cents)`` over a customer's non-cancelled orders."""
.. 77         counted = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 78         return len(counted), sum(s.total_cents for s in counted)
.. 79 
.. 80     def top_customers(self, limit: int) -> list[tuple[Customer, int]]:
.. 81         """Up to ``limit`` customers with a positive lifetime value, highest first, ties broken by id."""
.. 82         ranked = []
.. 83         for customer in self._customers.list_all():
.. 84             _, value = self.lifetime_value(customer.customer_id)
.. 85             if value > 0:
.. 86                 ranked.append((customer, value))
.. 87         ranked.sort(key=lambda pair: (-pair[1], pair[0].customer_id))
.. 88         return ranked[:limit]
.. 89 
.. 90     def customers_without_orders(self) -> list[Customer]:
.. 91         """Registered customers with no orders that are not cancelled, in registration order."""
.. 92         return [c for c in self._customers.list_all() if self.lifetime_value(c.customer_id)[0] == 0]
