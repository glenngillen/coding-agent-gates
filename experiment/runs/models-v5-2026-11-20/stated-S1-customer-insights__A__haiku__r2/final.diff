.. 73     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 74         """Count and total of a customer's orders that are not cancelled, discounts applied."""
.. 75         counted = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return LifetimeValue(len(counted), sum(s.total_cents for s in counted))
.. 77 
.. 78     def top_customers(self, limit: int) -> list[tuple[Customer, LifetimeValue]]:
.. 79         """Customers with a non-zero lifetime value, highest first (ties by customer_id)."""
.. 80         ranked = []
.. 81         for customer in self._customers.list_all():
.. 82             value = self.lifetime_value(customer.customer_id)
.. 83             if value.lifetime_value_cents > 0:
.. 84                 ranked.append((customer, value))
.. 85         ranked.sort(key=lambda pair: (-pair[1].lifetime_value_cents, pair[0].customer_id))
.. 86         return ranked[:limit]
