19 class CustomerInsightsController:
20     def __init__(self, service: OrderService) -> None:
21         self._service = service
22 
23     def handle_order_history(self, customer_id: str) -> Response:
24         try:
25             summaries = self._service.order_history(customer_id)
26         except CustomerNotFound:
27             return not_found("customer")
28         return Response(200, {"customer_id": customer_id,
29                               "orders": [history_entry(s) for s in summaries]})
30 
31     def handle_lifetime_value(self, customer_id: str) -> Response:
32         try:
33             value = self._service.lifetime_value(customer_id)
34         except CustomerNotFound:
35             return not_found("customer")
36         return Response(200, {"customer_id": customer_id, "order_count": value.order_count,
37                               "lifetime_value_cents": value.lifetime_value_cents})
38 
39     def handle_top_customers(self, limit: Any) -> Response:
40         try:
41             limit = require_positive_int(limit, "limit")
42         except InvalidRequest as exc:
43             return bad_request(exc)
44         ranked = self._service.top_customers(limit)
45         return Response(200, {"customers": [
46             {"customer_id": customer.customer_id, "name": customer.name,
47              "lifetime_value_cents": value.lifetime_value_cents}
48             for customer, value in ranked]})
49 
50     def handle_customers_without_orders(self) -> Response:
51         customers = self._service.customers_without_orders()
52         return Response(200, {"customers": [
53             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
