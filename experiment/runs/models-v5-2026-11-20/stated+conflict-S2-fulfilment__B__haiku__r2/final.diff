 88     order(shop, "c1", ("BOOK", 2), ("PEN", 1))   # open: 3 units
 89     order(shop, "c2", ("PEN", 3))                # open: 3 units
 90     cancelled = order(shop, "c2", ("BOOK", 7)).body["order_id"]
 91     shop.orders.handle_cancel(cancelled)         # cancelled: excluded, stock restored
 92     order(shop, "c1", ("LAMP", 1))               # open: 1 unit; LAMP drops to 4, under the line
 93     shop.catalog.handle_add_product({"sku": "CUP", "name": "Cup", "unit_price_cents": 800, "on_hand": 4})
