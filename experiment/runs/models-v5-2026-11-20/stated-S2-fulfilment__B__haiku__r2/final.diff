 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 from orders.domain.fulfilment import PackingSlip
12 
13 
14 def packing_slip_body(slip: PackingSlip) -> dict:
15     return {
16         "order_id": slip.order_id,
17         "customer_name": slip.customer_name,
18         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
19                   for line in slip.lines],
20     }
21 
22 
23 class FulfilmentController:
24     def __init__(self, service: FulfilmentService) -> None:
25         self._service = service
26 
27     def handle_packing_slip(self, order_id: str) -> Response:
28         try:
29             slip = self._service.packing_slip(order_id)
30         except OrderNotFound:
31             return not_found("order")
32         except CustomerNotFound:
33             return not_found("customer")
34         except Conflict as exc:
35             return conflict(exc)
36         return Response(200, packing_slip_body(slip))
37 
38     def handle_low_stock(self, threshold: Any) -> Response:
39         try:
40             threshold = require_non_negative_int(threshold, "threshold")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         products = self._service.low_stock(threshold)
44         return Response(200, {"products": [
45             {"sku": p.sku, "name": p.name, "on_hand": p.on_hand} for p in products]})
46 
47     def handle_restock(self, request: dict[str, Any]) -> Response:
48         try:
49             sku = require_str(request, "sku")
50             quantity = require_positive_int(request.get("quantity"), "quantity")
51         except InvalidRequest as exc:
52             return bad_request(exc)
53         try:
54             on_hand = self._service.restock(sku, quantity)
55         except ProductNotFound:
56             return not_found("product")
57         return Response(200, {"sku": sku, "on_hand": on_hand})
58 
59     def handle_fulfilment_summary(self) -> Response:
60         summary = self._service.summary()
61         return Response(200, {"open_orders": summary.open_orders,
62                               "units_to_pick": summary.units_to_pick,
63                               "low_stock_products": summary.low_stock_products})
