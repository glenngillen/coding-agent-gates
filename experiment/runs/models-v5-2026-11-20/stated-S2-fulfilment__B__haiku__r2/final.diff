 1 """Warehouse fulfilment: packing slips for orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.domain.fulfilment import (FulfilmentSummary, LowStockProduct, PackingSlip,
 8                                       PackingSlipLine)
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 # The warehouse's low-stock line: products with fewer units on hand than this are low stock.
14 LOW_STOCK_LINE = 5
15 
16 
17 class FulfilmentService:
18     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
19                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
20         self._orders = orders
21         self._customers = customers
22         self._catalog = catalog
23         self._stock = stock
24 
25     def low_stock(self, threshold: int) -> list[LowStockProduct]:
26         """Active products with on-hand stock strictly below ``threshold``, lowest stock first."""
27         rows = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
28                 for p in self._catalog.list_all() if p.active]
29         rows = [row for row in rows if row.on_hand < threshold]
30         return sorted(rows, key=lambda row: (row.on_hand, row.sku))
31 
32     def summary(self) -> FulfilmentSummary:
33         """Dashboard figures: open (not cancelled) orders, units across them, and low-stock products."""
34         open_orders = self._orders.list_open()
35         units = sum(item.quantity for order in open_orders for item in order.items)
36         return FulfilmentSummary(
37             open_orders=len(open_orders),
38             units_to_pick=units,
39             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
40         )
41 
42     def restock(self, sku: str, quantity: int) -> int:
43         """Add ``quantity`` units to a product's stock; returns the new on-hand level.
44 
45         Stock is shared with the order service, so restocked units are orderable immediately.
46         Raises ProductNotFound for unknown SKUs.
47         """
48         if self._catalog.get(sku) is None:
49             raise ProductNotFound(sku)
50         new_level = self._stock.get(sku) + quantity
51         self._stock.set(sku, new_level)
52         return new_level
53 
54     def packing_slip(self, order_id: str) -> PackingSlip:
55         """Raises OrderNotFound for unknown orders and Conflict for cancelled ones."""
56         order = self._orders.get_order(order_id)
57         if order.status == "cancelled":
58             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
59         customer = self._customers.get(order.customer_id)
60         if customer is None:
61             raise CustomerNotFound(order.customer_id)
62         lines = tuple(
63             PackingSlipLine(item.sku, self._catalog.get(item.sku).name, item.quantity)
64             for item in order.items
65         )
66         return PackingSlip(order.order_id, customer.name, lines)
