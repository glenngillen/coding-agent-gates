src/orders/controllers/fulfilment.py --- Python
 1 """Fulfilment endpoints for the warehouse."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 # Units on hand below which a product counts as low stock for the warehouse dashboard.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentController:
17     def __init__(self, service: FulfilmentService) -> None:
18         self._service = service
19 
20     def handle_packing_slip(self, order_id: str) -> Response:
21         try:
22             slip = self._service.packing_slip(order_id)
23         except OrderNotFound:
24             return Response(404, {"error": "order not found"})
25         except Conflict as exc:
26             return conflict(exc)
27         except CustomerNotFound:
28             return not_found("customer")
29         except ProductNotFound:
30             return not_found("product")
31         body: dict[str, Any] = {
32             "order_id": slip.order.order_id,
33             "customer_name": slip.customer_name,
34             "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity}
35                       for line in slip.lines],
36         }
37         return Response(200, body)
38 
39     def handle_low_stock(self, threshold: Any) -> Response:
40         try:
41             limit = require_non_negative_int(threshold, "threshold")
42         except InvalidRequest as exc:
43             return bad_request(exc)
44         products = self._service.low_stock(limit)
45         return Response(200, {"products": [{"sku": p.sku, "name": p.name, "on_hand": p.on_hand}
46                                            for p in products]})
47 
48     def handle_fulfilment_summary(self) -> Response:
49         open_orders, units, low_stock = self._service.fulfilment_summary(LOW_STOCK_LINE)
50         return Response(200, {"open_orders": open_orders, "units_to_pick": units,
51                               "low_stock_products": low_stock})
52 
53     def handle_restock(self, request: dict[str, Any]) -> Response:
54         try:
55             sku = require_str(request, "sku")
56             quantity = require_positive_int(request.get("quantity"), "quantity")
57         except InvalidRequest as exc:
58             return bad_request(exc)
59         try:
60             on_hand = self._service.restock(sku, quantity)
61         except ProductNotFound:
62             return Response(404, {"error": "product not found"})
63         return Response(200, {"sku": sku, "on_hand": on_hand})
