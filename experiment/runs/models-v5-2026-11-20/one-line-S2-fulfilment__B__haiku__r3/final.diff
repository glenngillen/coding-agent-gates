 1 """Warehouse fulfilment: packing slips for orders that are ready to pick."""
 2 
 3 from __future__ import annotations
 4 
 5 from dataclasses import dataclass
 6 
 7 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 8 from orders.domain.orders import Order
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.repository import InMemoryOrderRepository
12 from orders.infrastructure.stock import InMemoryStockRepository
13 
14 
15 @dataclass(frozen=True)
16 class PackingSlipLine:
17     sku: str
18     name: str
19     quantity: int
20 
21 
22 @dataclass(frozen=True)
23 class PackingSlip:
24     order: Order
25     customer_name: str
26     lines: tuple[PackingSlipLine, ...]
27 
28 
29 @dataclass(frozen=True)
30 class LowStockProduct:
31     sku: str
32     name: str
33     on_hand: int
34 
35 
36 class FulfilmentService:
37     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
38                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
39         self._orders = orders
40         self._customers = customers
41         self._catalog = catalog
42         self._stock = stock
43 
44     def low_stock(self, threshold: int) -> list[LowStockProduct]:
45         """Active products with stock on hand strictly below ``threshold``, lowest stock first, then SKU."""
46         products = [
47             LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
48             for p in self._catalog.list_all()
49             if p.active and self._stock.get(p.sku) < threshold
50         ]
51         return sorted(products, key=lambda p: (p.on_hand, p.sku))
52 
53     def fulfilment_summary(self, low_stock_line: int) -> tuple[int, int, int]:
54         """Return ``(open_orders, units_to_pick, low_stock_products)``.
55 
56         Open orders are those not cancelled; units are summed over them. Low-stock
57         products are active products with fewer than ``low_stock_line`` units on hand.
58         """
59         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
60         units = sum(item.quantity for order in open_orders for item in order.items)
61         low_stock = len(self.low_stock(low_stock_line))
62         return len(open_orders), units, low_stock
63 
64     def restock(self, sku: str, quantity: int) -> int:
65         """Add ``quantity`` units to a product's stock and return the new level.
66 
67         The stock repository is shared with ``OrderService``, so the units are orderable immediately.
68         """
69         if self._catalog.get(sku) is None:
70             raise ProductNotFound(sku)
71         new_level = self._stock.get(sku) + quantity
72         self._stock.set(sku, new_level)
73         return new_level
74 
75     def packing_slip(self, order_id: str) -> PackingSlip:
76         """Build the packing slip for an order that has not been cancelled.
77 
78         Raises ``OrderNotFound`` for an unknown order and ``Conflict`` for a cancelled one.
79         """
80         order = self._orders.get(order_id)
81         if order is None:
82             raise OrderNotFound(order_id)
83         if order.status == "cancelled":
84             raise Conflict(f"order {order_id} is cancelled")
85         customer = self._customers.get(order.customer_id)
86         if customer is None:
87             raise CustomerNotFound(order.customer_id)
88         lines = []
89         for item in order.items:
90             product = self._catalog.get(item.sku)
91             if product is None:
92                 raise ProductNotFound(item.sku)
93             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
94         return PackingSlip(order, customer.name, tuple(lines))
