  7 from orders.application.order_service import OrderService
  8 from orders.controllers.http import InvalidRequest, Response, bad_request, require_positive_int
  9 from orders.infrastructure.customers import InMemoryCustomerRepository
 10 
 11 
 12 class CustomerInsightsController:
 13     def __init__(self, customers: InMemoryCustomerRepository, order_service: OrderService) -> None:
 14         self._customers = customers
 15         self._order_service = order_service
 16 
 17     def handle_order_history(self, customer_id: str) -> Response:
 18         if self._customers.get(customer_id) is None:
 19             return Response(404, {"error": "customer not found"})
 20 
 21         orders = self._order_service.list_for_customer(customer_id)
 22         orders_reversed = list(reversed(orders))
 23 
 24         order_entries = []
 25         for order in orders_reversed:
 26             summary = self._order_service.summarize(order)
 27             order_entries.append({
 28                 "order_id": order.order_id,
 29                 "status": order.status,
 30                 "total_cents": summary.total_cents,
 31             })
 32 
 33         return Response(200, {
 34             "customer_id": customer_id,
 35             "orders": order_entries,
 36         })
 37 
 38     def handle_lifetime_value(self, customer_id: str) -> Response:
 39         if self._customers.get(customer_id) is None:
 40             return Response(404, {"error": "customer not found"})
 41 
 42         orders = self._order_service.list_for_customer(customer_id)
 43         active_orders = [o for o in orders if o.status != "cancelled"]
 44 
 45         order_count = len(active_orders)
 46         lifetime_value_cents = sum(self._order_service.summarize(o).total_cents for o in active_orders)
 47 
 48         return Response(200, {
 49             "customer_id": customer_id,
 50             "order_count": order_count,
 51             "lifetime_value_cents": lifetime_value_cents,
 52         })
 53 
 54     def handle_top_customers(self, limit: Any) -> Response:
 55         try:
 56             limit = require_positive_int(limit, "limit")
 57         except InvalidRequest as exc:
 58             return bad_request(exc)
 59 
 60         all_customers = self._customers.list_all()
 61 
 62         customer_data = []
 63         for customer in all_customers:
 64             orders = self._order_service.list_for_customer(customer.customer_id)
 65             active_orders = [o for o in orders if o.status != "cancelled"]
 66 
 67             lifetime_value_cents = sum(self._order_service.summarize(o).total_cents for o in active_orders)
 68 
 69             if lifetime_value_cents > 0:
 70                 customer_data.append({
 71                     "customer_id": customer.customer_id,
 72                     "name": customer.name,
 73                     "lifetime_value_cents": lifetime_value_cents,
 74                 })
 75 
 76         customer_data.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
 77 
 78         return Response(200, {
 79             "customers": customer_data[:limit]
 80         })
 81 
 82     def handle_customers_without_orders(self) -> Response:
 83         all_customers = self._customers.list_all()
 84 
 85         customers_without_orders = []
 86         for customer in all_customers:
 87             orders = self._order_service.list_for_customer(customer.customer_id)
 88             active_orders = [o for o in orders if o.status != "cancelled"]
 89 
 90             if not active_orders:
 91                 customers_without_orders.append({
 92                     "customer_id": customer.customer_id,
 93                     "name": customer.name,
 94                     "email": customer.email,
 95                 })
 96 
 97         return Response(200, {
 98             "customers": customers_without_orders
 99         })
