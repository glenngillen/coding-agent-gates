 1 """Packing slip generation for warehouse fulfilment."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 class FulfilmentService:
15     def __init__(
16         self,
17         orders: InMemoryOrderRepository,
18         customers: InMemoryCustomerRepository,
19         catalog: InMemoryProductCatalog,
20         stock: InMemoryStockRepository,
21     ) -> None:
22         self._orders = orders
23         self._customers = customers
24         self._catalog = catalog
25         self._stock = stock
26 
27     def get_packing_slip(self, order_id: str) -> dict[str, Any]:
28         order = self._orders.get(order_id)
29         if order is None:
30             raise OrderNotFound(order_id)
31         if order.status == "cancelled":
32             raise Conflict("order is cancelled")
33         customer = self._customers.get(order.customer_id)
34         lines: list[dict[str, Any]] = []
35         for item in order.items:
36             product = self._catalog.get(item.sku)
37             lines.append({
38                 "sku": item.sku,
39                 "name": product.name if product else None,
40                 "quantity": item.quantity,
41             })
42         return {
43             "order_id": order.order_id,
44             "customer_name": customer.name if customer else None,
45             "lines": lines,
46         }
47 
48     def get_low_stock(self, threshold: int) -> dict[str, Any]:
49         products: list[dict[str, Any]] = []
50         for product in self._catalog.list_all():
51             if product.active:
52                 on_hand = self._stock.get(product.sku)
53                 if on_hand < threshold:
54                     products.append({
55                         "sku": product.sku,
56                         "name": product.name,
57                         "on_hand": on_hand,
58                     })
59         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
60         return {"products": products}
61 
62     def restock(self, sku: str, quantity: int) -> dict[str, Any]:
63         product = self._catalog.get(sku)
64         if product is None:
65             raise ProductNotFound(sku)
66         new_level = self._stock.get(sku) + quantity
67         self._stock.set(sku, new_level)
68         return {"sku": sku, "on_hand": new_level}
69 
70     def get_fulfilment_summary(self) -> dict[str, Any]:
71         open_orders = 0
72         units_to_pick = 0
73         for order in self._orders.list_all():
74             if order.status != "cancelled":
75                 open_orders += 1
76                 for item in order.items:
77                     units_to_pick += item.quantity
78         low_stock_products = 0
79         for product in self._catalog.list_all():
80             if product.active and self._stock.get(product.sku) < 5:
81                 low_stock_products += 1
82         return {
83             "open_orders": open_orders,
84             "units_to_pick": units_to_pick,
85             "low_stock_products": low_stock_products,
86         }
