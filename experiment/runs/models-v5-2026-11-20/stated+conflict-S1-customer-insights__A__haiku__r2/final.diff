.. 73     def lifetime_value(self, customer_id: str) -> LifetimeValue:
.. 74         """Count and total of a customer's orders that are not cancelled."""
.. 75         active = [s for s in self.order_history(customer_id) if s.order.status != "cancelled"]
.. 76         return LifetimeValue(customer_id, len(active), sum(s.total_cents for s in active))
