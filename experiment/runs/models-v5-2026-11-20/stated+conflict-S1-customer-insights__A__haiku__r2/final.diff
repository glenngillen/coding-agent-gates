 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: OrderService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         """A customer's orders, newest first, with the same totals as the order summary."""
18         try:
19             summaries = self._service.order_history(customer_id)
20         except CustomerNotFound:
21             return not_found("customer")
22         orders = [{"order_id": s.order.order_id, "status": s.order.status, "total_cents": s.total_cents}
23                   for s in summaries]
24         return Response(200, {"customer_id": customer_id, "orders": orders})
25 
26     def handle_lifetime_value(self, customer_id: str) -> Response:
27         """Number of non-cancelled orders and the sum of their totals."""
28         try:
29             value = self._service.lifetime_value(customer_id)
30         except CustomerNotFound:
31             return not_found("customer")
32         return Response(200, {"customer_id": value.customer_id, "order_count": value.order_count,
33                               "lifetime_value_cents": value.lifetime_value_cents})
34 
35     def handle_customers_without_orders(self) -> Response:
36         """Registered customers with no orders other than cancelled ones, in registration order."""
37         customers = self._service.customers_without_orders()
38         return Response(200, {"customers": [
39             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
40 
41     def handle_top_customers(self, limit: Any) -> Response:
42         """Leaderboard of customers by lifetime value, at most ``limit`` entries."""
43         try:
44             count = require_positive_int(limit, "limit")
45         except InvalidRequest as exc:
46             return bad_request(exc)
47         ranked = self._service.top_customers(count)
48         return Response(200, {"customers": [
49             {"customer_id": customer.customer_id, "name": customer.name,
50              "lifetime_value_cents": value.lifetime_value_cents}
51             for customer, value in ranked]})
