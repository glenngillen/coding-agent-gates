.. 83     def top_customers(self, limit: int) -> list[tuple[Customer, LifetimeValue]]:
.. 84         """Customers with a non-zero lifetime value, highest first (ties by customer id)."""
.. 85         ranked = []
.. 86         for customer in self._customers.list_all():
.. 87             value = self.lifetime_value(customer.customer_id)
.. 88             if value.lifetime_value_cents > 0:
.. 89                 ranked.append((customer, value))
.. 90         ranked.sort(key=lambda entry: (-entry[1].lifetime_value_cents, entry[0].customer_id))
.. 91         return ranked[:limit]
