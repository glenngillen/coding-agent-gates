  7 from orders.application.errors import CustomerNotFound
  8 from orders.application.order_service import OrderService
  9 from orders.infrastructure.customers import InMemoryCustomerRepository
 10 from orders.infrastructure.repository import InMemoryOrderRepository
 11 
 12 
 13 class CustomerInsightsService:
 14     def __init__(self, customers: InMemoryCustomerRepository, orders: InMemoryOrderRepository,
 15                  order_service: OrderService) -> None:
 16         self._customers = customers
 17         self._orders = orders
 18         self._order_service = order_service
 19 
 20     def get_order_history(self, customer_id: str) -> dict[str, Any]:
 21         if self._customers.get(customer_id) is None:
 22             raise CustomerNotFound(customer_id)
 23 
 24         orders = self._orders.list_for_customer(customer_id)
 25         order_entries = []
 26         for order in reversed(orders):
 27             summary = self._order_service.summarize(order)
 28             order_entries.append({
 29                 "order_id": order.order_id,
 30                 "status": order.status,
 31                 "total_cents": summary.total_cents,
 32             })
 33 
 34         return {
 35             "customer_id": customer_id,
 36             "orders": order_entries,
 37         }
 38 
 39     def get_lifetime_value(self, customer_id: str) -> dict[str, Any]:
 40         if self._customers.get(customer_id) is None:
 41             raise CustomerNotFound(customer_id)
 42 
 43         orders = self._orders.list_for_customer(customer_id)
 44         order_count = 0
 45         lifetime_value_cents = 0
 46         for order in orders:
 47             if order.status != "cancelled":
 48                 summary = self._order_service.summarize(order)
 49                 order_count += 1
 50                 lifetime_value_cents += summary.total_cents
 51 
 52         return {
 53             "customer_id": customer_id,
 54             "order_count": order_count,
 55             "lifetime_value_cents": lifetime_value_cents,
 56         }
 57 
 58     def get_top_customers(self, limit: int) -> dict[str, Any]:
 59         customers_data = []
 60         for customer in self._customers.list_all():
 61             orders = self._orders.list_for_customer(customer.customer_id)
 62             lifetime_value_cents = 0
 63             for order in orders:
 64                 if order.status != "cancelled":
 65                     summary = self._order_service.summarize(order)
 66                     lifetime_value_cents += summary.total_cents
 67 
 68             if lifetime_value_cents > 0:
 69                 customers_data.append({
 70                     "customer_id": customer.customer_id,
 71                     "name": customer.name,
 72                     "lifetime_value_cents": lifetime_value_cents,
 73                 })
 74 
 75         customers_data.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
 76         return {
 77             "customers": customers_data[:limit],
 78         }
 79 
 80     def get_customers_without_orders(self) -> dict[str, Any]:
 81         customers_data = []
 82         for customer in self._customers.list_all():
 83             orders = self._orders.list_for_customer(customer.customer_id)
 84             has_active_order = False
 85             for order in orders:
 86                 if order.status != "cancelled":
 87                     has_active_order = True
 88                     break
 89 
 90             if not has_active_order:
 91                 customers_data.append({
 92                     "customer_id": customer.customer_id,
 93                     "name": customer.name,
 94                     "email": customer.email,
 95                 })
 96 
 97         return {
 98             "customers": customers_data,
 99         }
