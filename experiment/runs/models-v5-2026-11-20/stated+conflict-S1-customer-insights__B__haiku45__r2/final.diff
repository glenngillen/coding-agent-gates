 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.customer_insights_service import CustomerInsightsService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: CustomerInsightsService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             body = self._service.get_order_history(customer_id)
19         except CustomerNotFound:
20             return not_found("customer")
21         return Response(200, body)
22 
23     def handle_lifetime_value(self, customer_id: str) -> Response:
24         try:
25             body = self._service.get_lifetime_value(customer_id)
26         except CustomerNotFound:
27             return not_found("customer")
28         return Response(200, body)
29 
30     def handle_top_customers(self, request: dict[str, Any]) -> Response:
31         try:
32             limit = require_positive_int(request.get("limit"), "limit")
33         except InvalidRequest as exc:
34             return bad_request(exc)
35         body = self._service.get_top_customers(limit)
36         return Response(200, body)
37 
38     def handle_customers_without_orders(self) -> Response:
39         body = self._service.get_customers_without_orders()
40         return Response(200, body)
