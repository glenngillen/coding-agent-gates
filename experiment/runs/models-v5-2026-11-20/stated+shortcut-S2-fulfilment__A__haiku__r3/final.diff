src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders that can be packed."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 # Warehouse low-stock line: products with fewer units than this on hand are low.
13 LOW_STOCK_LINE = 5
14 
15 
16 class FulfilmentService:
17     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
18                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
19         self._orders = orders
20         self._customers = customers
21         self._catalog = catalog
22         self._stock = stock
23 
24     def restock(self, sku: str, quantity: int) -> StockLevel:
25         """Add ``quantity`` units to a known product's stock; they are orderable immediately."""
26         product = self._catalog.get(sku)
27         if product is None:
28             raise ProductNotFound(sku)
29         on_hand = self._stock.get(sku) + quantity
30         self._stock.set(sku, on_hand)
31         return StockLevel(product.sku, product.name, on_hand)
32 
33     def low_stock(self, threshold: int) -> list[StockLevel]:
34         """Active products with on-hand stock strictly below ``threshold``, lowest first."""
35         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
36                   for p in self._catalog.list_all() if p.active]
37         return sorted((level for level in levels if level.on_hand < threshold),
38                       key=lambda level: (level.on_hand, level.sku))
39 
40     def summary(self) -> FulfilmentSummary:
41         """Open (not cancelled) orders, units across them, and products at the low-stock line."""
42         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
43         return FulfilmentSummary(
44             open_orders=len(open_orders),
45             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
46             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
47         )
48 
49     def packing_slip(self, order_id: str) -> PackingSlip:
50         """Packing slip for an order; cancelled orders are not packed."""
51         order = self._orders.get(order_id)
52         if order is None:
53             raise OrderNotFound(order_id)
54         if order.status == "cancelled":
55             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
56         customer = self._customers.get(order.customer_id)
57         if customer is None:
58             raise CustomerNotFound(order.customer_id)
59         lines = []
60         for item in order.items:
61             product = self._catalog.get(item.sku)
62             if product is None:
63                 raise ProductNotFound(item.sku)
64             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
65         return PackingSlip(order.order_id, customer.name, tuple(lines))
