 13 
 14 class FulfilmentController:
 15     def __init__(
 16         self,
 17         orders: InMemoryOrderRepository,
 18         customers: InMemoryCustomerRepository,
 19         catalog: InMemoryProductCatalog,
 20         stock: InMemoryStockRepository,
 21     ) -> None:
 22         self._orders = orders
 23         self._customers = customers
 24         self._catalog = catalog
 25         self._stock = stock
 26 
 27     def handle_packing_slip(self, order_id: str) -> Response:
 28         order = self._orders.get(order_id)
 29         if order is None:
 30             return not_found("order")
 31 
 32         if order.status == "cancelled":
 33             return Response(409, {"error": "order is cancelled"})
 34 
 35         customer = self._customers.get(order.customer_id)
 36         lines = []
 37         for item in order.items:
 38             product = self._catalog.get(item.sku)
 39             lines.append({
 40                 "sku": item.sku,
 41                 "name": product.name,
 42                 "quantity": item.quantity,
 43             })
 44 
 45         return Response(200, {
 46             "order_id": order.order_id,
 47             "customer_name": customer.name,
 48             "lines": lines,
 49         })
 50 
 51     def handle_low_stock(self, threshold: Any) -> Response:
 52         if type(threshold) is not int or isinstance(threshold, bool) or threshold < 0:
 53             return Response(400, {"error": "threshold must be a non-negative integer"})
 54 
 55         products = []
 56         for product in self._catalog.list_all():
 57             if product.active:
 58                 on_hand = self._stock.get(product.sku)
 59                 if on_hand < threshold:
 60                     products.append({
 61                         "sku": product.sku,
 62                         "name": product.name,
 63                         "on_hand": on_hand,
 64                     })
 65 
 66         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
 67 
 68         return Response(200, {"products": products})
 69 
 70     def handle_restock(self, request: dict[str, Any]) -> Response:
 71         try:
 72             sku = require_str(request, "sku")
 73             quantity = require_positive_int(request.get("quantity"), "quantity")
 74         except InvalidRequest as exc:
 75             return bad_request(exc)
 76 
 77         product = self._catalog.get(sku)
 78         if product is None:
 79             return not_found("product")
 80 
 81         current = self._stock.get(sku)
 82         new_level = current + quantity
 83         self._stock.set(sku, new_level)
 84 
 85         return Response(200, {"sku": sku, "on_hand": new_level})
 86 
 87     def handle_fulfilment_summary(self) -> Response:
 88         open_orders = 0
 89         units_to_pick = 0
 90         for order in self._orders.list_all():
 91             if order.status != "cancelled":
 92                 open_orders += 1
 93                 for item in order.items:
 94                     units_to_pick += item.quantity
 95 
 96         low_stock_products = 0
 97         for product in self._catalog.list_all():
 98             if product.active:
 99                 on_hand = self._stock.get(product.sku)
100                 if on_hand < 5:
101                     low_stock_products += 1
102 
103         return Response(200, {
104             "open_orders": open_orders,
105             "units_to_pick": units_to_pick,
106             "low_stock_products": low_stock_products,
107         })
