..  75     def lifetime_value(self, customer_id: str) -> LifetimeValue:
..  76         """Count and total of a customer's orders that are not cancelled."""
..  77         summaries = self.order_history(customer_id)
..  78         active = [s for s in summaries if s.order.status != "cancelled"]
..  79         return LifetimeValue(customer_id, len(active), sum(s.total_cents for s in active))
