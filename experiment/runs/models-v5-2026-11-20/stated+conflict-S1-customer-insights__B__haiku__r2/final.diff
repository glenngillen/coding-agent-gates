 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import CustomerNotFound
 8 from orders.application.order_service import OrderService
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, not_found,
10                                      require_positive_int)
11 from orders.domain.orders import OrderSummary
12 
13 
14 class CustomerInsightsController:
15     def __init__(self, service: OrderService) -> None:
16         self._service = service
17 
18     def handle_order_history(self, customer_id: str) -> Response:
19         try:
20             summaries = self._service.order_history(customer_id)
21         except CustomerNotFound:
22             return not_found("customer")
23         return Response(200, {"customer_id": customer_id,
24                               "orders": [_history_entry(s) for s in summaries]})
25 
26     def handle_lifetime_value(self, customer_id: str) -> Response:
27         try:
28             value = self._service.lifetime_value(customer_id)
29         except CustomerNotFound:
30             return not_found("customer")
31         return Response(200, {"customer_id": value.customer_id,
32                               "order_count": value.order_count,
33                               "lifetime_value_cents": value.lifetime_value_cents})
34 
35     def handle_customers_without_orders(self) -> Response:
36         customers = self._service.customers_without_orders()
37         return Response(200, {"customers": [
38             {"customer_id": c.customer_id, "name": c.name, "email": c.email} for c in customers]})
39 
40     def handle_top_customers(self, limit: Any) -> Response:
41         try:
42             limit = require_positive_int(limit, "limit")
43         except InvalidRequest as exc:
44             return bad_request(exc)
45         ranked = self._service.top_customers(limit)
46         return Response(200, {"customers": [
47             {"customer_id": customer.customer_id, "name": customer.name,
48              "lifetime_value_cents": value.lifetime_value_cents}
49             for customer, value in ranked]})
50 
51 
52 def _history_entry(summary: OrderSummary) -> dict[str, Any]:
53     return {"order_id": summary.order.order_id, "status": summary.order.status,
54             "total_cents": summary.total_cents}
