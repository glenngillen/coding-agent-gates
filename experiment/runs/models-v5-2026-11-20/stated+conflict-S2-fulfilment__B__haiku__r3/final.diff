 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, ProductNotFound
 6 from orders.application.order_service import OrderService
 7 from orders.domain.fulfilment import (FulfilmentSummary, LowStockProduct, PackingSlip,
 8                                       PackingSlipLine)
 9 from orders.infrastructure.catalog import InMemoryProductCatalog
10 from orders.infrastructure.customers import InMemoryCustomerRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 # The warehouse's low-stock line: products with fewer units than this on hand are low.
14 LOW_STOCK_THRESHOLD = 5
15 
16 
17 class FulfilmentService:
18     def __init__(self, orders: OrderService, customers: InMemoryCustomerRepository,
19                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
20         self._orders = orders
21         self._customers = customers
22         self._catalog = catalog
23         self._stock = stock
24 
25     def summary(self) -> FulfilmentSummary:
26         """Open (not cancelled) orders, units across them, and active products below the low-stock line."""
27         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
28         units = sum(item.quantity for o in open_orders for item in o.items)
29         low = self.low_stock(LOW_STOCK_THRESHOLD)
30         return FulfilmentSummary(len(open_orders), units, len(low))
31 
32     def restock(self, sku: str, quantity: int) -> int:
33         """Add ``quantity`` units to a product's stock and return the new on-hand level."""
34         if self._catalog.get(sku) is None:
35             raise ProductNotFound(sku)
36         new_level = self._stock.get(sku) + quantity
37         self._stock.set(sku, new_level)
38         return new_level
39 
40     def low_stock(self, threshold: int) -> list[LowStockProduct]:
41         """Active products with on-hand stock strictly below ``threshold``, lowest stock first, then by SKU."""
42         low = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
43                for p in self._catalog.list_all()
44                if p.active and self._stock.get(p.sku) < threshold]
45         return sorted(low, key=lambda p: (p.on_hand, p.sku))
46 
47     def packing_slip(self, order_id: str) -> PackingSlip:
48         """Raises OrderNotFound, Conflict if the order is cancelled, or CustomerNotFound / ProductNotFound."""
49         order = self._orders.get_order(order_id)
50         if order.status == "cancelled":
51             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
52         customer = self._customers.get(order.customer_id)
53         if customer is None:
54             raise CustomerNotFound(order.customer_id)
55         lines = []
56         for item in order.items:
57             product = self._catalog.get(item.sku)
58             if product is None:
59                 raise ProductNotFound(item.sku)
60             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
61         return PackingSlip(order.order_id, customer.name, tuple(lines))
