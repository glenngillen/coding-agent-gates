src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for placed orders."""
 2 
 3 from __future__ import annotations
 4 
 5 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 6 from orders.domain.fulfilment import FulfilmentSummary, LowStockProduct, PackingSlip, PackingSlipLine
 7 from orders.infrastructure.catalog import InMemoryProductCatalog
 8 from orders.infrastructure.customers import InMemoryCustomerRepository
 9 from orders.infrastructure.repository import InMemoryOrderRepository
10 from orders.infrastructure.stock import InMemoryStockRepository
11 
12 LOW_STOCK_LINE = 5  # units on hand below which a product counts as low stock
13 
14 
15 class FulfilmentService:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def summary(self) -> FulfilmentSummary:
24         """Open (not cancelled) orders, units across them, and products below the low-stock line."""
25         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
26         units = sum(item.quantity for order in open_orders for item in order.items)
27         return FulfilmentSummary(
28             open_orders=len(open_orders),
29             units_to_pick=units,
30             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
31         )
32 
33     def restock(self, sku: str, quantity: int) -> int:
34         """Add ``quantity`` units to a product's stock; returns the new level."""
35         if self._catalog.get(sku) is None:
36             raise ProductNotFound(sku)
37         new_level = self._stock.get(sku) + quantity
38         self._stock.set(sku, new_level)
39         return new_level
40 
41     def low_stock(self, threshold: int) -> list[LowStockProduct]:
42         """Active products with stock strictly below ``threshold``, lowest stock first."""
43         levels = [LowStockProduct(p.sku, p.name, self._stock.get(p.sku))
44                   for p in self._catalog.list_all() if p.active]
45         below = [p for p in levels if p.on_hand < threshold]
46         return sorted(below, key=lambda p: (p.on_hand, p.sku))
47 
48     def packing_slip(self, order_id: str) -> PackingSlip:
49         """Packing slip for a placed order. Cancelled orders are not packed."""
50         order = self._orders.get(order_id)
51         if order is None:
52             raise OrderNotFound(order_id)
53         if order.status == "cancelled":
54             raise Conflict(f"order {order_id} is cancelled")
55         customer = self._customers.get(order.customer_id)
56         if customer is None:
57             raise CustomerNotFound(order.customer_id)
58         lines = []
59         for item in order.items:
60             product = self._catalog.get(item.sku)
61             if product is None:
62                 raise ProductNotFound(item.sku)
63             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
64         return PackingSlip(order.order_id, customer.name, tuple(lines))
