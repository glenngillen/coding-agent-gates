 1 """Fulfillment operations for warehouse packing and shipping."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.infrastructure.catalog import InMemoryProductCatalog
 9 from orders.infrastructure.customers import InMemoryCustomerRepository
10 from orders.infrastructure.repository import InMemoryOrderRepository
11 from orders.infrastructure.stock import InMemoryStockRepository
12 
13 
14 class FulfilmentService:
15     def __init__(
16         self,
17         orders: InMemoryOrderRepository,
18         customers: InMemoryCustomerRepository,
19         catalog: InMemoryProductCatalog,
20         stock: InMemoryStockRepository,
21     ) -> None:
22         self._orders = orders
23         self._customers = customers
24         self._catalog = catalog
25         self._stock = stock
26 
27     def get_packing_slip(self, order_id: str) -> dict[str, Any]:
28         order = self._orders.get(order_id)
29         if order is None:
30             raise OrderNotFound(order_id)
31         if order.status == "cancelled":
32             raise Conflict("cannot pack a cancelled order")
33         customer = self._customers.get(order.customer_id)
34         lines = []
35         for item in order.items:
36             product = self._catalog.get(item.sku)
37             lines.append({
38                 "sku": item.sku,
39                 "name": product.name if product else item.sku,
40                 "quantity": item.quantity,
41             })
42         return {
43             "order_id": order.order_id,
44             "customer_name": customer.name if customer else "",
45             "lines": lines,
46         }
47 
48     def get_low_stock_products(self, threshold: int) -> dict[str, Any]:
49         products = []
50         for product in self._catalog.list_all():
51             if product.active and self._stock.get(product.sku) < threshold:
52                 products.append({
53                     "sku": product.sku,
54                     "name": product.name,
55                     "on_hand": self._stock.get(product.sku),
56                 })
57         products.sort(key=lambda p: (p["on_hand"], p["sku"]))
58         return {"products": products}
59 
60     def restock(self, sku: str, quantity: int) -> dict[str, Any]:
61         if self._catalog.get(sku) is None:
62             raise ProductNotFound(sku)
63         new_level = self._stock.get(sku) + quantity
64         self._stock.set(sku, new_level)
65         return {"sku": sku, "on_hand": new_level}
66 
67     def get_fulfilment_summary(self) -> dict[str, Any]:
68         open_orders = 0
69         units_to_pick = 0
70         for order in self._orders.list_all():
71             if order.status != "cancelled":
72                 open_orders += 1
73                 for item in order.items:
74                     units_to_pick += item.quantity
75         low_stock_products = 0
76         for product in self._catalog.list_all():
77             if product.active and self._stock.get(product.sku) < 5:
78                 low_stock_products += 1
79         return {
80             "open_orders": open_orders,
81             "units_to_pick": units_to_pick,
82             "low_stock_products": low_stock_products,
83         }
84 

src/orders/controllers/fulfilment.py --- Python
 1 """Fulfillment endpoints for warehouse operations."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, conflict, not_found, require_positive_int, require_str, require_non_negative_int
10 
11 
12 class FulfilmentController:
13     def __init__(self, service: FulfilmentService) -> None:
14         self._service = service
15 
16     def handle_packing_slip(self, order_id: str) -> Response:
17         try:
18             return Response(200, self._service.get_packing_slip(order_id))
19         except OrderNotFound:
20             return not_found("order")
21         except Conflict as exc:
22             return conflict(exc)
23 
24     def handle_low_stock(self, request: dict[str, Any]) -> Response:
25         try:
26             threshold = require_non_negative_int(request.get("threshold"), "threshold")
27         except InvalidRequest as exc:
28             return bad_request(exc)
29         return Response(200, self._service.get_low_stock_products(threshold))
30 
31     def handle_restock(self, request: dict[str, Any]) -> Response:
32         try:
33             sku = require_str(request, "sku")
34             quantity = require_positive_int(request.get("quantity"), "quantity")
35         except InvalidRequest as exc:
36             return bad_request(exc)
37         try:
38             return Response(200, self._service.restock(sku, quantity))
39         except ProductNotFound:
40             return not_found("product")
41 
42     def handle_fulfilment_summary(self) -> Response:
43         return Response(200, self._service.get_fulfilment_summary())
