15 class FulfilmentController:
16     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
17                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
18         self._orders = orders
19         self._customers = customers
20         self._catalog = catalog
21         self._stock = stock
22 
23     def handle_packing_slip(self, order_id: str) -> Response:
24         order = self._orders.get(order_id)
25         if order is None:
26             return not_found("order")
27         if order.status == "cancelled":
28             return conflict(ValueError(f"order {order_id} is cancelled"))
29         customer = self._customers.get(order.customer_id)
30         customer_name = customer.name if customer is not None else ""
31         lines = [
32             {
33                 "sku": item.sku,
34                 "name": self._catalog.get(item.sku).name if self._catalog.get(item.sku) is not None else "",
35                 "quantity": item.quantity,
36             }
37             for item in order.items
38         ]
39         return Response(200, {
40             "order_id": order.order_id,
41             "customer_name": customer_name,
42             "lines": lines,
43         })
44 
45     def handle_low_stock(self, threshold: Any) -> Response:
46         try:
47             threshold_int = require_non_negative_int(threshold, "threshold")
48         except InvalidRequest as exc:
49             return bad_request(exc)
50 
51         low_stock_products = []
52         for product in self._catalog.list_all():
53             if product.active and self._stock.get(product.sku) < threshold_int:
54                 low_stock_products.append({
55                     "sku": product.sku,
56                     "name": product.name,
57                     "on_hand": self._stock.get(product.sku),
58                 })
59 
60         low_stock_products.sort(key=lambda p: (p["on_hand"], p["sku"]))
61         return Response(200, {"products": low_stock_products})
62 
63     def handle_restock(self, request: dict[str, Any]) -> Response:
64         try:
65             sku = require_str(request, "sku")
66             quantity = require_positive_int(request.get("quantity"), "quantity")
67         except InvalidRequest as exc:
68             return bad_request(exc)
69 
70         product = self._catalog.get(sku)
71         if product is None:
72             return not_found("product")
73 
74         new_level = self._stock.get(sku) + quantity
75         self._stock.set(sku, new_level)
76         return Response(200, {"sku": sku, "on_hand": new_level})
77 
78     def handle_fulfilment_summary(self) -> Response:
79         open_orders = 0
80         units_to_pick = 0
81         for order in self._orders.list_all():
82             if order.status != "cancelled":
83                 open_orders += 1
84                 for item in order.items:
85                     units_to_pick += item.quantity
86 
87         low_stock_products = 0
88         for product in self._catalog.list_all():
89             if product.active and self._stock.get(product.sku) < 5:
90                 low_stock_products += 1
91 
92         return Response(200, {
93             "open_orders": open_orders,
94             "units_to_pick": units_to_pick,
95             "low_stock_products": low_stock_products,
96         })
