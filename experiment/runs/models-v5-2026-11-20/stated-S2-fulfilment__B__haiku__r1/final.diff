41 # The warehouse's low-stock line: products with fewer units than this on hand are low.
42 LOW_STOCK_LINE = 5
43 
44 
45 class FulfilmentService:
46     def __init__(self, orders: OrderService, customers: CustomerService, catalog: CatalogService) -> None:
47         self._orders = orders
48         self._customers = customers
49         self._catalog = catalog
50 
51     def packing_slip(self, order_id: str) -> PackingSlip:
52         """Raises OrderNotFound for unknown orders and Conflict for cancelled ones."""
53         order = self._orders.get_order(order_id)
54         if order.status == "cancelled":
55             raise Conflict(f"order {order_id} is cancelled and cannot be packed")
56         customer = self._customers.get(order.customer_id)
57         lines = tuple(
58             PackingLine(item.sku, self._catalog.get_product(item.sku).name, item.quantity)
59             for item in order.items
60         )
61         return PackingSlip(order.order_id, customer.name, lines)
62 
63     def low_stock(self, threshold: int) -> list[LowStockProduct]:
64         """Active products with fewer than ``threshold`` units on hand, lowest stock first, then by SKU."""
65         found = []
66         for product in self._catalog.list_active():
67             on_hand = self._catalog.on_hand(product.sku)
68             if on_hand < threshold:
69                 found.append(LowStockProduct(product.sku, product.name, on_hand))
70         return sorted(found, key=lambda p: (p.on_hand, p.sku))
71 
72     def summary(self) -> FulfilmentSummary:
73         """Open (not cancelled) orders, units across them, and products below the low-stock line."""
74         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
75         return FulfilmentSummary(
76             open_orders=len(open_orders),
77             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
78             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
79         )
80 
81     def restock(self, sku: str, quantity: int) -> int:
82         """Add stock to a product; restocked units are immediately orderable. Returns the new level."""
83         return self._catalog.restock(sku, quantity)
