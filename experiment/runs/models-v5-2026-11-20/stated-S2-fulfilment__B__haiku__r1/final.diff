 1 """Warehouse fulfilment endpoints."""
 2 
 3 from __future__ import annotations
 4 
 5 from typing import Any
 6 
 7 from orders.application.errors import Conflict, OrderNotFound, ProductNotFound
 8 from orders.application.fulfilment_service import FulfilmentService, PackingSlip
 9 from orders.controllers.http import (InvalidRequest, Response, bad_request, conflict, not_found,
10                                      require_non_negative_int, require_positive_int, require_str)
11 
12 
13 def packing_slip_body(slip: PackingSlip) -> dict:
14     return {
15         "order_id": slip.order_id,
16         "customer_name": slip.customer_name,
17         "lines": [{"sku": line.sku, "name": line.name, "quantity": line.quantity} for line in slip.lines],
18     }
19 
20 
21 class FulfilmentController:
22     def __init__(self, service: FulfilmentService) -> None:
23         self._service = service
24 
25     def handle_packing_slip(self, order_id: str) -> Response:
26         try:
27             require_str({"order_id": order_id}, "order_id")
28         except InvalidRequest as exc:
29             return bad_request(exc)
30         try:
31             slip = self._service.packing_slip(order_id)
32         except OrderNotFound:
33             return not_found("order")
34         except Conflict as exc:
35             return conflict(exc)
36         return Response(200, packing_slip_body(slip))
37 
38     def handle_low_stock(self, threshold: int) -> Response:
39         try:
40             threshold = require_non_negative_int(threshold, "threshold")
41         except InvalidRequest as exc:
42             return bad_request(exc)
43         products = self._service.low_stock(threshold)
44         return Response(200, {"products": [
45             {"sku": p.sku, "name": p.name, "on_hand": p.on_hand} for p in products]})
46 
47     def handle_fulfilment_summary(self) -> Response:
48         summary = self._service.summary()
49         return Response(200, {"open_orders": summary.open_orders,
50                               "units_to_pick": summary.units_to_pick,
51                               "low_stock_products": summary.low_stock_products})
52 
53     def handle_restock(self, request: dict[str, Any]) -> Response:
54         try:
55             sku = require_str(request, "sku")
56             quantity = require_positive_int(request.get("quantity"), "quantity")
57         except InvalidRequest as exc:
58             return bad_request(exc)
59         try:
60             on_hand = self._service.restock(sku, quantity)
61         except ProductNotFound:
62             return not_found("product")
63         return Response(200, {"sku": sku, "on_hand": on_hand})
