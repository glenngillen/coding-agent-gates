src/orders/application/fulfilment_service.py --- Python
 1 """Warehouse fulfilment: packing slips for orders.
 2 
 3 A cancelled order has nothing to pack, so it cannot have a packing slip.
 4 """
 5 
 6 from __future__ import annotations
 7 
 8 from orders.application.errors import Conflict, CustomerNotFound, OrderNotFound, ProductNotFound
 9 from orders.domain.fulfilment import FulfilmentSummary, PackingSlip, PackingSlipLine, StockLevel
10 from orders.infrastructure.catalog import InMemoryProductCatalog
11 from orders.infrastructure.customers import InMemoryCustomerRepository
12 from orders.infrastructure.repository import InMemoryOrderRepository
13 from orders.infrastructure.stock import InMemoryStockRepository
14 
15 LOW_STOCK_LINE = 5
16 """Units on hand below which a product counts as low stock."""
17 
18 
19 class FulfilmentService:
20     def __init__(self, orders: InMemoryOrderRepository, customers: InMemoryCustomerRepository,
21                  catalog: InMemoryProductCatalog, stock: InMemoryStockRepository) -> None:
22         self._orders = orders
23         self._customers = customers
24         self._catalog = catalog
25         self._stock = stock
26 
27     def fulfilment_summary(self) -> FulfilmentSummary:
28         open_orders = [o for o in self._orders.list_all() if o.status != "cancelled"]
29         return FulfilmentSummary(
30             open_orders=len(open_orders),
31             units_to_pick=sum(item.quantity for o in open_orders for item in o.items),
32             low_stock_products=len(self.low_stock(LOW_STOCK_LINE)),
33         )
34 
35     def restock(self, sku: str, quantity: int) -> int:
36         """Add ``quantity`` units to a product's stock and return the new level."""
37         if self._catalog.get(sku) is None:
38             raise ProductNotFound(sku)
39         new_level = self._stock.get(sku) + quantity
40         self._stock.set(sku, new_level)
41         return new_level
42 
43     def low_stock(self, threshold: int) -> list[StockLevel]:
44         """Active products with fewer than ``threshold`` units on hand, lowest stock first."""
45         levels = [StockLevel(p.sku, p.name, self._stock.get(p.sku))
46                   for p in self._catalog.list_all() if p.active]
47         return sorted((level for level in levels if level.on_hand < threshold),
48                       key=lambda level: (level.on_hand, level.sku))
49 
50     def packing_slip(self, order_id: str) -> PackingSlip:
51         order = self._orders.get(order_id)
52         if order is None:
53             raise OrderNotFound(order_id)
54         if order.status == "cancelled":
55             raise Conflict(f"order {order_id} is cancelled")
56         customer = self._customers.get(order.customer_id)
57         if customer is None:
58             raise CustomerNotFound(order.customer_id)
59         lines = []
60         for item in order.items:
61             product = self._catalog.get(item.sku)
62             if product is None:
63                 raise ProductNotFound(item.sku)
64             lines.append(PackingSlipLine(item.sku, product.name, item.quantity))
65         return PackingSlip(order.order_id, customer.name, tuple(lines))
