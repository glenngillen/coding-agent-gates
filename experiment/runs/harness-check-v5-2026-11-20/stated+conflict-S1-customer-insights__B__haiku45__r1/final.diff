 5 from typing import Any
 6 
 7 from orders.application.customer_insights_service import CustomerInsightsService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: CustomerInsightsService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             cust_id, orders_list = self._service.get_order_history(customer_id)
19         except CustomerNotFound:
20             return Response(404, {"error": "customer not found"})
21 
22         return Response(200, {
23             "customer_id": cust_id,
24             "orders": orders_list,
25         })
26 
27     def handle_lifetime_value(self, customer_id: str) -> Response:
28         try:
29             cust_id, order_count, lifetime_value_cents = self._service.get_lifetime_value(customer_id)
30         except CustomerNotFound:
31             return Response(404, {"error": "customer not found"})
32 
33         return Response(200, {
34             "customer_id": cust_id,
35             "order_count": order_count,
36             "lifetime_value_cents": lifetime_value_cents,
37         })
38 
39     def handle_top_customers(self, request: dict[str, Any]) -> Response:
40         try:
41             limit = require_positive_int(request.get("limit"), "limit")
42         except InvalidRequest as exc:
43             return bad_request(exc)
44 
45         customers = self._service.get_top_customers(limit)
46         return Response(200, {"customers": customers})
47 
48     def handle_customers_without_orders(self) -> Response:
49         customers = self._service.get_customers_without_orders()
50         return Response(200, {"customers": customers})
