  1 """Customer insights for the account team."""
  2 
  3 from __future__ import annotations
  4 
  5 from orders.application.errors import CustomerNotFound
  6 from orders.application.pricing import discount_for
  7 from orders.infrastructure.customers import InMemoryCustomerRepository
  8 from orders.infrastructure.repository import InMemoryOrderRepository
  9 
 10 
 11 class CustomerInsightsService:
 12     def __init__(self, customers: InMemoryCustomerRepository, orders: InMemoryOrderRepository) -> None:
 13         self._customers = customers
 14         self._orders = orders
 15 
 16     def get_order_history(self, customer_id: str) -> tuple[str, list[dict]]:
 17         """Return order history for a customer with newest orders first."""
 18         customer = self._customers.get(customer_id)
 19         if customer is None:
 20             raise CustomerNotFound(customer_id)
 21 
 22         customer_orders = self._orders.list_for_customer(customer_id)
 23         tier = customer.tier
 24 
 25         orders_list = []
 26         for order in reversed(customer_orders):
 27             subtotal = order.subtotal_cents
 28             discount = discount_for(subtotal, tier)
 29             total_cents = subtotal - discount
 30             orders_list.append({
 31                 "order_id": order.order_id,
 32                 "status": order.status,
 33                 "total_cents": total_cents,
 34             })
 35 
 36         return customer_id, orders_list
 37 
 38     def get_lifetime_value(self, customer_id: str) -> tuple[str, int, int]:
 39         """Return lifetime value: order count and total cents for non-cancelled orders."""
 40         customer = self._customers.get(customer_id)
 41         if customer is None:
 42             raise CustomerNotFound(customer_id)
 43 
 44         customer_orders = self._orders.list_for_customer(customer_id)
 45         tier = customer.tier
 46 
 47         order_count = 0
 48         lifetime_value_cents = 0
 49         for order in customer_orders:
 50             if order.status != "cancelled":
 51                 order_count += 1
 52                 subtotal = order.subtotal_cents
 53                 discount = discount_for(subtotal, tier)
 54                 total_cents = subtotal - discount
 55                 lifetime_value_cents += total_cents
 56 
 57         return customer_id, order_count, lifetime_value_cents
 58 
 59     def get_top_customers(self, limit: int) -> list[dict]:
 60         """Return top customers by lifetime value, highest first, then by customer_id."""
 61         all_customers = self._customers.list_all()
 62         customers_with_value = []
 63 
 64         for customer in all_customers:
 65             customer_orders = self._orders.list_for_customer(customer.customer_id)
 66             tier = customer.tier
 67 
 68             lifetime_value_cents = 0
 69             for order in customer_orders:
 70                 if order.status != "cancelled":
 71                     subtotal = order.subtotal_cents
 72                     discount = discount_for(subtotal, tier)
 73                     total_cents = subtotal - discount
 74                     lifetime_value_cents += total_cents
 75 
 76             if lifetime_value_cents > 0:
 77                 customers_with_value.append({
 78                     "customer_id": customer.customer_id,
 79                     "name": customer.name,
 80                     "lifetime_value_cents": lifetime_value_cents,
 81                 })
 82 
 83         customers_with_value.sort(key=lambda c: (-c["lifetime_value_cents"], c["customer_id"]))
 84         return customers_with_value[:limit]
 85 
 86     def get_customers_without_orders(self) -> list[dict]:
 87         """Return customers with no non-cancelled orders, in registration order."""
 88         all_customers = self._customers.list_all()
 89         customers_without_orders = []
 90 
 91         for customer in all_customers:
 92             customer_orders = self._orders.list_for_customer(customer.customer_id)
 93             has_non_cancelled_order = any(order.status != "cancelled" for order in customer_orders)
 94 
 95             if not has_non_cancelled_order:
 96                 customers_without_orders.append({
 97                     "customer_id": customer.customer_id,
 98                     "name": customer.name,
 99                     "email": customer.email,
100                 })
101 
102         return customers_without_orders
