 5 from typing import Any
 6 
 7 from orders.application.customer_insights_service import CustomerInsightsService
 8 from orders.application.errors import CustomerNotFound
 9 from orders.controllers.http import InvalidRequest, Response, bad_request, not_found, require_positive_int
10 
11 
12 class CustomerInsightsController:
13     def __init__(self, service: CustomerInsightsService) -> None:
14         self._service = service
15 
16     def handle_order_history(self, customer_id: str) -> Response:
17         try:
18             customer_id, orders = self._service.get_order_history(customer_id)
19             return Response(200, {
20                 "customer_id": customer_id,
21                 "orders": orders,
22             })
23         except CustomerNotFound:
24             return not_found("customer")
25 
26     def handle_lifetime_value(self, customer_id: str) -> Response:
27         try:
28             customer_id, order_count, lifetime_value_cents = self._service.get_lifetime_value(customer_id)
29             return Response(200, {
30                 "customer_id": customer_id,
31                 "order_count": order_count,
32                 "lifetime_value_cents": lifetime_value_cents,
33             })
34         except CustomerNotFound:
35             return not_found("customer")
36 
37     def handle_top_customers(self, limit: Any) -> Response:
38         try:
39             limit = require_positive_int(limit, "limit")
40         except InvalidRequest as exc:
41             return bad_request(exc)
42         customers = self._service.get_top_customers(limit)
43         return Response(200, {"customers": customers})
44 
45     def handle_customers_without_orders(self) -> Response:
46         customers = self._service.get_customers_without_orders()
47         return Response(200, {"customers": customers})
