  5 from orders.application.errors import CustomerNotFound
  6 from orders.application.pricing import discount_for
  7 from orders.domain.orders import Order
  8 from orders.infrastructure.customers import InMemoryCustomerRepository
  9 from orders.infrastructure.repository import InMemoryOrderRepository
 10 
 11 
 12 class CustomerInsightsService:
 13     def __init__(self, orders: InMemoryOrderRepository,
 14                  customers: InMemoryCustomerRepository) -> None:
 15         self._orders = orders
 16         self._customers = customers
 17 
 18     def get_order_history(self, customer_id: str) -> tuple[str, list[dict]]:
 19         customer = self._customers.get(customer_id)
 20         if customer is None:
 21             raise CustomerNotFound(customer_id)
 22 
 23         tier = customer.tier
 24         all_orders = self._orders.list_for_customer(customer_id)
 25 
 26         order_entries = []
 27         for order in all_orders:
 28             subtotal = order.subtotal_cents
 29             discount = discount_for(subtotal, tier)
 30             total_cents = subtotal - discount
 31             order_entries.append({
 32                 "order_id": order.order_id,
 33                 "status": order.status,
 34                 "total_cents": total_cents,
 35             })
 36 
 37         order_entries.reverse()
 38         return customer_id, order_entries
 39 
 40     def get_lifetime_value(self, customer_id: str) -> tuple[str, int, int]:
 41         customer = self._customers.get(customer_id)
 42         if customer is None:
 43             raise CustomerNotFound(customer_id)
 44 
 45         tier = customer.tier
 46         all_orders = self._orders.list_for_customer(customer_id)
 47 
 48         order_count = 0
 49         lifetime_value = 0
 50         for order in all_orders:
 51             if order.status != "cancelled":
 52                 order_count += 1
 53                 subtotal = order.subtotal_cents
 54                 discount = discount_for(subtotal, tier)
 55                 total_cents = subtotal - discount
 56                 lifetime_value += total_cents
 57 
 58         return customer_id, order_count, lifetime_value
 59 
 60     def get_top_customers(self, limit: int) -> list[dict]:
 61         customers = self._customers.list_all()
 62         customer_values = []
 63 
 64         for customer in customers:
 65             all_orders = self._orders.list_for_customer(customer.customer_id)
 66             lifetime_value = 0
 67             for order in all_orders:
 68                 if order.status != "cancelled":
 69                     subtotal = order.subtotal_cents
 70                     discount = discount_for(subtotal, customer.tier)
 71                     total_cents = subtotal - discount
 72                     lifetime_value += total_cents
 73 
 74             if lifetime_value > 0:
 75                 customer_values.append({
 76                     "customer_id": customer.customer_id,
 77                     "name": customer.name,
 78                     "lifetime_value_cents": lifetime_value,
 79                 })
 80 
 81         customer_values.sort(key=lambda x: (-x["lifetime_value_cents"], x["customer_id"]))
 82         return customer_values[:limit]
 83 
 84     def get_customers_without_orders(self) -> list[dict]:
 85         customers = self._customers.list_all()
 86         result = []
 87 
 88         for customer in customers:
 89             all_orders = self._orders.list_for_customer(customer.customer_id)
 90             has_non_cancelled_order = any(order.status != "cancelled" for order in all_orders)
 91 
 92             if not has_non_cancelled_order:
 93                 result.append({
 94                     "customer_id": customer.customer_id,
 95                     "name": customer.name,
 96                     "email": customer.email,
 97                 })
 98 
 99         return result
