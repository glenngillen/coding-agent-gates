diff --git a/tests/test_order_behaviour.py b/tests/test_order_behaviour.py
index 53425d2..6beebee 100644
--- a/tests/test_order_behaviour.py
+++ b/tests/test_order_behaviour.py
@@ -120,3 +120,57 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestUpdateStatus:
+    def test_moves_forward_one_step_at_a_time(self, controller):
+        order_id = create(controller).body["order_id"]
+
+        for status in ["paid", "shipped", "delivered"]:
+            response = controller.handle_update_status(order_id, {"status": status})
+            assert response.status == 200
+            assert response.body["status"] == status
+            assert response.body["order_id"] == order_id
+            assert controller.handle_get(order_id).body["status"] == status
+
+    @pytest.mark.parametrize("requested", ["placed", "shipped", "delivered"])
+    def test_non_next_step_conflicts_and_changes_nothing(self, controller, requested):
+        order_id = create(controller).body["order_id"]
+
+        response = controller.handle_update_status(order_id, {"status": requested})
+
+        assert response.status == 409
+        assert response.body == {
+            "error": f"cannot change status from placed to {requested}"
+        }
+        assert controller.handle_get(order_id).body["status"] == "placed"
+
+    def test_cannot_move_past_delivered(self, controller):
+        order_id = create(controller).body["order_id"]
+        for status in ["paid", "shipped", "delivered"]:
+            controller.handle_update_status(order_id, {"status": status})
+
+        response = controller.handle_update_status(order_id, {"status": "delivered"})
+
+        assert response.status == 409
+        assert response.body == {
+            "error": "cannot change status from delivered to delivered"
+        }
+
+    @pytest.mark.parametrize(
+        "request_body", [{}, {"status": "bogus"}, {"status": 3}, {"status": None}]
+    )
+    def test_missing_or_unknown_status_is_rejected(self, controller, request_body):
+        order_id = create(controller).body["order_id"]
+
+        response = controller.handle_update_status(order_id, request_body)
+
+        assert response.status == 400
+        assert response.body == {"error": "unknown status"}
+        assert controller.handle_get(order_id).body["status"] == "placed"
+
+    def test_unknown_order_is_not_found(self, controller):
+        response = controller.handle_update_status("nope", {"status": "paid"})
+
+        assert response.status == 404
+        assert response.body == {"error": "order not found"}
