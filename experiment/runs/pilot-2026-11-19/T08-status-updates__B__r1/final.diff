+    def update_status(self, order_id: str, requested: object) -> Order:
+        if not isinstance(requested, str) or requested not in STATUS_FLOW:
+            raise UnknownStatus(str(requested))
+        order = self.get_order(order_id)
+        current_index = STATUS_FLOW.index(order.status)
+        if STATUS_FLOW.index(requested) != current_index + 1:
+            raise InvalidStatusChange(order.status, requested)
+        updated = replace(order, status=requested)
+        self._repository.add(updated)
+        return updated
+
