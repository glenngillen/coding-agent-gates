index 9d246c6..e0eaf7a 100644
--- a/src/orders/application/order_service.py
+++ b/src/orders/application/order_service.py
@@ -58,5 +58,22 @@ class OrderService:
             total_cents=subtotal - discount,
         )
 
+    def get_order_summaries(
+        self, order_ids: Iterable[str]
+    ) -> tuple[list[OrderSummary], list[str]]:
+        """Summaries for existing ids and the ids that don't exist.
+
+        Both keep request order; a repeated id is handled once, at its first
+        position.
+        """
+        summaries: list[OrderSummary] = []
+        missing: list[str] = []
+        for order_id in dict.fromkeys(order_ids):
+            try:
+                summaries.append(self.get_order_summary(order_id))
+            except OrderNotFound:
+                missing.append(order_id)
+        return summaries, missing
+
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
diff --git a/src/orders/controllers/orders.py b/src/orders/controllers/orders.py
index 0cbf354..3ad013b 100644
--- a/src/orders/controllers/orders.py
+++ b/src/orders/controllers/orders.py
@@ -86,6 +86,21 @@ class OrderController:
             return Response(404, {"error": "order not found"})
         return Response(200, _summary_body(summary))
 
+    def handle_get_many(self, order_ids: Any) -> Response:
+        if (
+            not isinstance(order_ids, list)
+            or not 1 <= len(order_ids) <= 100
+            or not all(isinstance(i, str) for i in order_ids)
+        ):
+            return Response(
+                400, {"error": "order_ids must be a list of 1 to 100 strings"}
+            )
+        summaries, missing = self._service.get_order_summaries(order_ids)
+        return Response(
+            200,
+            {"orders": [_summary_body(s) for s in summaries], "missing": missing},
+        )
+
     def handle_list_for_customer(self, customer_id: str) -> Response:
         orders = self._service.list_for_customer(customer_id)
         return Response(200, {"orders": [_order_body(o) for o in orders]})
diff --git a/tests/test_order_behaviour.py b/tests/test_order_behaviour.py
index 53425d2..69ef936 100644
--- a/tests/test_order_behaviour.py
