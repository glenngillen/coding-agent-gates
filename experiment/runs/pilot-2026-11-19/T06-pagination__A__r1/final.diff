             return Response(404, {"error": "order not found"})
         return Response(200, _summary_body(summary))
 
-    def handle_list_for_customer(self, customer_id: str) -> Response:
-        orders = self._service.list_for_customer(customer_id)
-        return Response(200, {"orders": [_order_body(o) for o in orders]})
+    def handle_list_for_customer(
+        self, customer_id: str, limit: int | None = None, offset: int = 0
+    ) -> Response:
+        if limit is None:
+            orders = self._service.list_for_customer(customer_id)
+            return Response(200, {"orders": [_order_body(o) for o in orders]})
+        if (
+            type(limit) is not int
+            or not 1 <= limit <= 50
+            or type(offset) is not int
+            or offset < 0
+        ):
+            return Response(400, {"error": "invalid pagination"})
+        page, next_offset = self._service.list_page_for_customer(
+            customer_id, limit, offset
+        )
+        return Response(
+            200,
+            {"orders": [_order_body(o) for o in page], "next_offset": next_offset},
+        )
diff --git a/tests/test_order_behaviour.py b/tests/test_order_behaviour.py
index 53425d2..8a4c1c1 100644
--- a/tests/test_order_behaviour.py
+++ b/tests/test_order_behaviour.py
@@ -120,3 +120,48 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestListPagination:
+    def _seed(self, controller, n=5):
+        for _ in range(n):
+            create(controller)
+        create(controller, customer_id="other")
+
+    def test_pages_in_creation_order(self, controller):
+        self._seed(controller)
+        r = controller.handle_list_for_customer("cust-1", limit=2)
+        assert r.status == 200
+        assert [o["order_id"] for o in r.body["orders"]] == ["ord-0001", "ord-0002"]
+        assert r.body["next_offset"] == 2
+        r = controller.handle_list_for_customer("cust-1", limit=2, offset=4)
+        assert [o["order_id"] for o in r.body["orders"]] == ["ord-0005"]
+        assert r.body["next_offset"] is None
+
+    def test_exact_last_page_has_no_next(self, controller):
+        self._seed(controller)
+        r = controller.handle_list_for_customer("cust-1", limit=5)
+        assert len(r.body["orders"]) == 5
+        assert r.body["next_offset"] is None
+
+    def test_offset_past_end_is_empty(self, controller):
+        self._seed(controller)
+        r = controller.handle_list_for_customer("cust-1", limit=5, offset=10)
+        assert r.status == 200
+        assert r.body == {"orders": [], "next_offset": None}
+
+    @pytest.mark.parametrize(
+        ("limit", "offset"),
+        [(0, 0), (51, 0), (-1, 0), (True, 0), ("2", 0), (2.0, 0), (2, -1), (2, "0"), (2, True)],
+    )
+    def test_invalid_pagination(self, controller, limit, offset):
+        r = controller.handle_list_for_customer("cust-1", limit=limit, offset=offset)
+        assert r.status == 400
+        assert r.body == {"error": "invalid pagination"}
+
+    def test_without_limit_unchanged(self, controller):
+        self._seed(controller, 3)
+        r = controller.handle_list_for_customer("cust-1")
+        assert r.status == 200
+        assert len(r.body["orders"]) == 3
+        assert "next_offset" not in r.body
