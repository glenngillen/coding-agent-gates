diff --git a/src/orders/infrastructure/audit_log.py b/src/orders/infrastructure/audit_log.py
new file mode 100644
index 0000000..66b59a2
--- /dev/null
+++ b/src/orders/infrastructure/audit_log.py
@@ -0,0 +1,16 @@
+"""In-memory audit log storage. Assigns sequence numbers starting at 1."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+class InMemoryAuditLog:
+    def __init__(self) -> None:
+        self._events: list[dict[str, Any]] = []
+
+    def append(self, event: str, **fields: Any) -> None:
+        self._events.append({"sequence": len(self._events) + 1, "event": event, **fields})
+
+    def events(self) -> list[dict[str, Any]]:
+        return [dict(e) for e in self._events]
