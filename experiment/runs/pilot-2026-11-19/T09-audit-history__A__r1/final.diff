diff --git a/tests/test_audit_log.py b/tests/test_audit_log.py
new file mode 100644
index 0000000..72edcbb
--- /dev/null
+++ b/tests/test_audit_log.py
@@ -0,0 +1,41 @@
+from orders.wiring import build_app
+
+
+def create(app, items=None):
+    items = items or [{"sku": "BOOK", "quantity": 2, "unit_price_cents": 1500}]
+    return app.handle_create({"customer_id": "cust-1", "items": items})
+
+
+def test_empty_log():
+    r = build_app().handle_audit_log()
+    assert (r.status, r.body) == (200, {"events": []})
+
+
+def test_events_in_order_with_sequence():
+    app = build_app()
+    oid = create(app).body["order_id"]
+    app.handle_get(oid)
+    assert app.handle_audit_log().body["events"] == [
+        {"sequence": 1, "event": "order_placed", "order_id": oid,
+         "customer_id": "cust-1", "total_cents": 3000},
+        {"sequence": 2, "event": "order_viewed", "order_id": oid},
+    ]
+
+
+def test_total_is_after_discount():
+    app = build_app()
+    create(app, [{"sku": "TV", "quantity": 1, "unit_price_cents": 20000}])
+    assert app.handle_audit_log().body["events"][0]["total_cents"] == 18000
+
+
+def test_failures_record_nothing():
+    app = build_app()
+    assert app.handle_create({"customer_id": "", "items": []}).status == 400
+    assert app.handle_get("nope").status == 404
+    assert app.handle_audit_log().body["events"] == []
+
+
+def test_log_is_per_app():
+    a, b = build_app(), build_app()
+    create(a)
+    assert b.handle_audit_log().body["events"] == []
