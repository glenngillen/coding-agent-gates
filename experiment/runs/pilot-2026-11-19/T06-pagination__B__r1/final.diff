 DISCOUNT_RATE_PERCENT = 10
 
 
+MAX_PAGE_SIZE = 50
+
+
 class OrderNotFound(LookupError):
     """No order exists with the requested id."""
 
 
+class InvalidPagination(ValueError):
+    """Requested page limit or offset is outside the allowed range."""
+
+
 def discount_for(subtotal_cents: int) -> int:
     """Subtotals of $100.00 or more get 10% off, rounded down to the cent."""
     if subtotal_cents < DISCOUNT_THRESHOLD_CENTS:
@@ -60,3 +67,14 @@ class OrderService:
 
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
+
+    def list_page_for_customer(
+        self, customer_id: str, limit: int, offset: int
+    ) -> tuple[list[Order], int | None]:
+        """Return one page in creation order and the next page's offset."""
+        if not 1 <= limit <= MAX_PAGE_SIZE or offset < 0:
+            raise InvalidPagination((limit, offset))
+        orders = self._repository.list_for_customer(customer_id)
+        page = orders[offset : offset + limit]
+        next_offset = offset + limit if offset + limit < len(orders) else None
+        return page, next_offset
