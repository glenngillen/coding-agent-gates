@@ -120,3 +120,45 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestQuote:
+    def test_quote_matches_summary_of_placed_order(self, controller):
+        for price, qty in [(9_999, 1), (10_000, 1), (5_000, 3), (10_005, 1)]:
+            items = [{"sku": "X", "quantity": qty, "unit_price_cents": price}]
+            quote = controller.handle_quote({"customer_id": "c", "items": items})
+            order_id = create(controller, items=items).body["order_id"]
+            summary = controller.handle_get(order_id).body
+
+            assert quote.status == 200
+            assert quote.body == {
+                k: summary[k] for k in ("subtotal_cents", "discount_cents", "total_cents")
+            }
+
+    def test_quote_does_not_create_an_order_or_consume_an_id(self, controller):
+        first = create(controller).body["order_id"]
+        controller.handle_quote(
+            {"customer_id": "cust-1", "items": [{"sku": "A", "quantity": 1, "unit_price_cents": 5}]}
+        )
+        second = create(controller).body["order_id"]
+        fresh = build_app()
+        ids = [create(fresh).body["order_id"], create(fresh).body["order_id"]]
+
+        assert [first, second] == ids
+        assert len(controller.handle_list_for_customer("cust-1").body["orders"]) == 2
+
+    @pytest.mark.parametrize(
+        "request_body",
+        [
+            {},
+            {"customer_id": "", "items": [{"sku": "A", "quantity": 1, "unit_price_cents": 1}]},
+            {"customer_id": "cust-1", "items": []},
+            {"customer_id": "cust-1", "items": [{"sku": "A", "quantity": 0, "unit_price_cents": 1}]},
+            {"customer_id": "cust-1", "items": "not-a-list"},
+        ],
+    )
+    def test_invalid_quote_matches_create_error(self, controller, request_body):
+        quote = controller.handle_quote(request_body)
+
+        assert quote.status == 400
+        assert quote.body == controller.handle_create(request_body).body
