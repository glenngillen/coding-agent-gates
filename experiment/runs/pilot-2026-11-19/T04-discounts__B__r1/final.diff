diff --git a/tests/test_order_behaviour.py b/tests/test_order_behaviour.py
index 53425d2..da4e038 100644
--- a/tests/test_order_behaviour.py
+++ b/tests/test_order_behaviour.py
@@ -120,3 +120,55 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestQuote:
+    @pytest.mark.parametrize(
+        ("unit_price_cents", "quantity"),
+        [(9_999, 1), (10_000, 1), (5_000, 3), (10_005, 1)],
+    )
+    def test_quote_matches_the_placed_order_price(
+        self, controller, unit_price_cents, quantity
+    ):
+        items = [{"sku": "X", "quantity": quantity, "unit_price_cents": unit_price_cents}]
+        request = {"customer_id": "cust-1", "items": items}
+
+        quote = controller.handle_quote(request)
+        order_id = controller.handle_create(request).body["order_id"]
+        summary = controller.handle_get(order_id).body
+
+        assert quote.status == 200
+        assert quote.body == {
+            "subtotal_cents": summary["subtotal_cents"],
+            "discount_cents": summary["discount_cents"],
+            "total_cents": summary["total_cents"],
+        }
+
+    def test_quote_does_not_create_an_order_or_consume_an_id(self, controller):
+        request = {
+            "customer_id": "cust-1",
+            "items": [{"sku": "A", "quantity": 1, "unit_price_cents": 100}],
+        }
+        baseline = build_app().handle_create(request).body["order_id"]
+
+        controller.handle_quote(request)
+        controller.handle_quote(request)
+
+        assert controller.handle_list_for_customer("cust-1").body["orders"] == []
+        assert controller.handle_create(request).body["order_id"] == baseline
+
+    @pytest.mark.parametrize(
+        "request_body",
+        [
+            {},
+            {"customer_id": "", "items": [{"sku": "A", "quantity": 1, "unit_price_cents": 1}]},
+            {"customer_id": "cust-1", "items": []},
+            {"customer_id": "cust-1", "items": [{"sku": "A", "quantity": 0, "unit_price_cents": 1}]},
+        ],
+    )
+    def test_invalid_quote_matches_create_error(self, controller, request_body):
+        quote = controller.handle_quote(request_body)
+        created = build_app().handle_create(request_body)
+
+        assert quote.status == 400
+        assert quote == created
