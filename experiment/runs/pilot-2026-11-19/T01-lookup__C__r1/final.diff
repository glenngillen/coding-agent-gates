+    def get_order_summary_for_customer(
+        self, customer_id: str, order_id: str
+    ) -> OrderSummary:
+        """Summary of an order, only if it belongs to ``customer_id``.
+
+        A missing order and another customer's order both raise OrderNotFound.
+        """
+        order = self.get_order(order_id)
+        if order.customer_id != customer_id:
+            raise OrderNotFound(order_id)
+        return self.get_order_summary(order_id)
+
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
diff --git a/src/orders/controllers/orders.py b/src/orders/controllers/orders.py
index 0cbf354..038f602 100644
--- a/src/orders/controllers/orders.py
+++ b/src/orders/controllers/orders.py
@@ -86,6 +86,13 @@ class OrderController:
             return Response(404, {"error": "order not found"})
         return Response(200, _summary_body(summary))
 
+    def handle_get_for_customer(self, customer_id: str, order_id: str) -> Response:
+        try:
+            summary = self._service.get_order_summary_for_customer(customer_id, order_id)
+        except OrderNotFound:
+            return Response(404, {"error": "order not found"})
+        return Response(200, _summary_body(summary))
+
     def handle_list_for_customer(self, customer_id: str) -> Response:
         orders = self._service.list_for_customer(customer_id)
         return Response(200, {"orders": [_order_body(o) for o in orders]})
