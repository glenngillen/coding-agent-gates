+class TestGetForCustomer:
+    def test_owner_gets_the_same_body_as_handle_get(self, controller):
+        order_id = create(controller, customer_id="cust-1").body["order_id"]
+
+        response = controller.handle_get_for_customer("cust-1", order_id)
+
+        assert response.status == 200
+        assert response.body == controller.handle_get(order_id).body
+
+    def test_other_customers_order_and_missing_order_are_indistinguishable(
+        self, controller
+    ):
+        order_id = create(controller, customer_id="cust-1").body["order_id"]
+
+        other = controller.handle_get_for_customer("cust-2", order_id)
+        missing = controller.handle_get_for_customer("cust-1", "does-not-exist")
+
+        assert other == missing
+        assert other.status == 404
+        assert other.body == {"error": "order not found"}
+
+
 class TestDiscount:
     """Business policy: subtotals of $100.00 or more get 10% off (rounded down)."""
 
