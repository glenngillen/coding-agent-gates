diff --git a/src/orders/application/order_service.py b/src/orders/application/order_service.py
index 9d246c6..c5bf98d 100644
--- a/src/orders/application/order_service.py
+++ b/src/orders/application/order_service.py
@@ -60,3 +60,12 @@ class OrderService:
 
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
+
+    def list_page_for_customer(
+        self, customer_id: str, limit: int, offset: int
+    ) -> tuple[list[Order], int | None]:
+        """Return one page of orders in creation order and the next offset."""
+        orders = self._repository.list_for_customer(customer_id)
+        page = orders[offset : offset + limit]
+        next_offset = offset + limit if offset + limit < len(orders) else None
+        return page, next_offset
