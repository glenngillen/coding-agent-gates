             return Response(404, {"error": "order not found"})
         return Response(200, _summary_body(summary))
 
-    def handle_list_for_customer(self, customer_id: str) -> Response:
-        orders = self._service.list_for_customer(customer_id)
-        return Response(200, {"orders": [_order_body(o) for o in orders]})
+    def handle_list_for_customer(
+        self, customer_id: str, limit: int | None = None, offset: int = 0
+    ) -> Response:
+        if limit is None:
+            orders = self._service.list_for_customer(customer_id)
+            return Response(200, {"orders": [_order_body(o) for o in orders]})
+        if (
+            type(limit) is not int
+            or not 1 <= limit <= 50
+            or type(offset) is not int
+            or offset < 0
+        ):
+            return Response(400, {"error": "invalid pagination"})
+        orders, next_offset = self._service.list_page_for_customer(
+            customer_id, limit, offset
+        )
+        return Response(
+            200,
+            {"orders": [_order_body(o) for o in orders], "next_offset": next_offset},
+        )
diff --git a/tests/test_order_behaviour.py b/tests/test_order_behaviour.py
index 53425d2..1e5e41c 100644
--- a/tests/test_order_behaviour.py
+++ b/tests/test_order_behaviour.py
@@ -120,3 +120,48 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestListPagination:
+    def make(self, controller, n=5):
+        return [create(controller).body["order_id"] for _ in range(n)]
+
+    def test_pages_walk_through_all_orders(self, controller):
+        ids = self.make(controller)
+
+        first = controller.handle_list_for_customer("cust-1", limit=2)
+        assert first.status == 200
+        assert [o["order_id"] for o in first.body["orders"]] == ids[:2]
+        assert first.body["next_offset"] == 2
+
+        second = controller.handle_list_for_customer("cust-1", limit=2, offset=2)
+        assert [o["order_id"] for o in second.body["orders"]] == ids[2:4]
+        assert second.body["next_offset"] == 4
+
+        last = controller.handle_list_for_customer("cust-1", limit=2, offset=4)
+        assert [o["order_id"] for o in last.body["orders"]] == ids[4:]
+        assert last.body["next_offset"] is None
+
+    def test_exact_fit_has_no_next_offset(self, controller):
+        self.make(controller, 2)
+        body = controller.handle_list_for_customer("cust-1", limit=2).body
+        assert len(body["orders"]) == 2
+        assert body["next_offset"] is None
+
+    def test_offset_past_end_is_empty(self, controller):
+        self.make(controller, 2)
+        body = controller.handle_list_for_customer("cust-1", limit=5, offset=10).body
+        assert body == {"orders": [], "next_offset": None}
+
+    @pytest.mark.parametrize(
+        ("limit", "offset"),
+        [(0, 0), (51, 0), (-1, 0), (1.5, 0), ("2", 0), (True, 0), (2, -1), (2, "0"), (2, 1.0)],
+    )
+    def test_invalid_pagination_is_rejected(self, controller, limit, offset):
+        response = controller.handle_list_for_customer("cust-1", limit=limit, offset=offset)
+        assert response.status == 400
+        assert response.body == {"error": "invalid pagination"}
+
+    def test_limit_bounds_are_accepted(self, controller):
+        assert controller.handle_list_for_customer("cust-1", limit=1).status == 200
+        assert controller.handle_list_for_customer("cust-1", limit=50).status == 200
