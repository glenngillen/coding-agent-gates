+class TestAuditLog:
+    def test_empty_log(self, controller):
+        response = controller.handle_audit_log()
+
+        assert response.status == 200
+        assert response.body == {"events": []}
+
+    def test_records_placed_and_viewed_events_in_order(self, controller):
+        items = [{"sku": "X", "quantity": 1, "unit_price_cents": 10_000}]
+        order_id = create(controller, items=items).body["order_id"]
+        controller.handle_get(order_id)
+
+        assert controller.handle_audit_log().body["events"] == [
+            {
+                "sequence": 1,
+                "event": "order_placed",
+                "order_id": order_id,
+                "customer_id": "cust-1",
+                "total_cents": 9_000,
+            },
+            {"sequence": 2, "event": "order_viewed", "order_id": order_id},
+        ]
+
+    def test_failed_requests_record_nothing(self, controller):
+        controller.handle_create({})
+        controller.handle_get("does-not-exist")
+
+        assert controller.handle_audit_log().body == {"events": []}
+
+    def test_log_is_per_application_instance(self, controller):
+        create(controller)
+
+        assert build_app().handle_audit_log().body == {"events": []}
