+class TestQuote:
+    @pytest.mark.parametrize(
+        ("unit_price_cents", "quantity", "discount", "total"),
+        [(9_999, 1, 0, 9_999), (10_000, 1, 1_000, 9_000), (10_005, 1, 1_000, 9_005)],
+    )
+    def test_quote_matches_order_pricing(
+        self, controller, unit_price_cents, quantity, discount, total
+    ):
+        items = [{"sku": "X", "quantity": quantity, "unit_price_cents": unit_price_cents}]
+        response = controller.handle_quote({"customer_id": "cust-1", "items": items})
+
+        assert response.status == 200
+        assert response.body == {
+            "subtotal_cents": unit_price_cents * quantity,
+            "discount_cents": discount,
+            "total_cents": total,
+        }
+        placed = controller.handle_get(create(controller, items=items).body["order_id"]).body
+        assert {k: placed[k] for k in response.body} == response.body
+
+    def test_quote_creates_no_order_and_consumes_no_id(self, controller):
+        before = create(controller).body["order_id"]
+        controller.handle_quote(
+            {"customer_id": "cust-1", "items": [{"sku": "A", "quantity": 1, "unit_price_cents": 5}]}
+        )
+        after = create(controller).body["order_id"]
+
+        assert len(controller.handle_list_for_customer("cust-1").body["orders"]) == 2
+        fresh = build_app()
+        first = create(fresh).body["order_id"]
+        second = create(fresh).body["order_id"]
+        assert (before, after) == (first, second)
+
+    @pytest.mark.parametrize(
+        "request_body",
+        [
+            {},
+            {"customer_id": "", "items": [{"sku": "A", "quantity": 1, "unit_price_cents": 1}]},
+            {"customer_id": "cust-1", "items": []},
+            {"customer_id": "cust-1", "items": [{"sku": "A", "quantity": 0, "unit_price_cents": 1}]},
+        ],
+    )
+    def test_invalid_quote_matches_create_error(self, controller, request_body):
+        response = controller.handle_quote(request_body)
+
+        assert response.status == 400
+        assert response.body == controller.handle_create(request_body).body
+
