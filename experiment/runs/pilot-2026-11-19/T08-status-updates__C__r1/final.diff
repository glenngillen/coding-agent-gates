@@ -58,5 +73,17 @@ class OrderService:
             total_cents=subtotal - discount,
         )
 
+    def update_status(self, order_id: str, new_status: object) -> Order:
+        """Advance an order exactly one step along STATUS_FLOW."""
+        if not isinstance(new_status, str) or new_status not in STATUS_FLOW:
+            raise UnknownStatus(new_status)
+        order = self.get_order(order_id)
+        position = STATUS_FLOW.index(order.status)
+        if position + 1 >= len(STATUS_FLOW) or STATUS_FLOW[position + 1] != new_status:
+            raise InvalidStatusChange(order.status, new_status)
+        updated = replace(order, status=new_status)
+        self._repository.add(updated)
+        return updated
+
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
