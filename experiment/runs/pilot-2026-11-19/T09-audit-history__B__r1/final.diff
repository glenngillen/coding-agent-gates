--- a/tests/test_order_behaviour.py
+++ b/tests/test_order_behaviour.py
@@ -120,3 +120,36 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestAuditLog:
+    def test_empty_log(self, controller):
+        response = controller.handle_audit_log()
+        assert response.status == 200
+        assert response.body == {"events": []}
+
+    def test_records_placements_and_views_in_order(self, controller):
+        items = [{"sku": "X", "quantity": 1, "unit_price_cents": 10_000}]
+        order_id = create(controller, items=items).body["order_id"]
+        controller.handle_get(order_id)
+
+        assert controller.handle_audit_log().body["events"] == [
+            {
+                "sequence": 1,
+                "event": "order_placed",
+                "order_id": order_id,
+                "customer_id": "cust-1",
+                "total_cents": 9_000,
+            },
+            {"sequence": 2, "event": "order_viewed", "order_id": order_id},
+        ]
+
+    def test_failed_requests_record_nothing(self, controller):
+        controller.handle_create({})
+        controller.handle_get("missing")
+
+        assert controller.handle_audit_log().body == {"events": []}
+
+    def test_log_is_per_app_instance(self, controller):
+        create(controller)
+        assert build_app().handle_audit_log().body == {"events": []}
