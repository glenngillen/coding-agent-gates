+class TestOrderLimits:
+    @staticmethod
+    def item(quantity=1, price=1):
+        return {"sku": "A", "quantity": quantity, "unit_price_cents": price}
+
+    @pytest.mark.parametrize(
+        ("items", "message"),
+        [
+            ([{"sku": "A", "quantity": 1, "unit_price_cents": 1}] * 21, "too many line items"),
+            ([{"sku": "A", "quantity": 101, "unit_price_cents": 1}], "quantity exceeds limit"),
+            ([{"sku": "A", "quantity": 100, "unit_price_cents": 10_001}], "order total exceeds limit"),
+            # checked in order: count before quantity before total
+            ([{"sku": "A", "quantity": 101, "unit_price_cents": 10_000}] * 21, "too many line items"),
+            ([{"sku": "A", "quantity": 101, "unit_price_cents": 10_000}], "quantity exceeds limit"),
+        ],
+    )
+    def test_breaking_a_limit_returns_422_and_creates_nothing(
+        self, controller, items, message
+    ):
+        response = create(controller, items=items)
+
+        assert response.status == 422
+        assert response.body == {"error": message}
+        assert controller.handle_list_for_customer("cust-1").body["orders"] == []
+
+    def test_orders_exactly_at_the_limits_are_created(self, controller):
+        items = [self.item(quantity=100, price=500)] * 20  # subtotal 1,000,000
+        assert create(controller, items=items).status == 201
+
+    def test_wrong_shape_is_still_400(self, controller):
+        items = [self.item()] * 21 + [{"sku": "A", "quantity": "x", "unit_price_cents": 1}]
+        assert create(controller, items=items).status == 400
+
+
