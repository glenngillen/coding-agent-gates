@@ -60,3 +60,16 @@ class OrderService:
 
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
+
+    def customer_totals(self, customer_id: str) -> CustomerTotals:
+        """Sum each order's own discount; no discount on the combined subtotal."""
+        orders = self._repository.list_for_customer(customer_id)
+        subtotal = sum(o.subtotal_cents for o in orders)
+        discount = sum(discount_for(o.subtotal_cents) for o in orders)
+        return CustomerTotals(
+            customer_id=customer_id,
+            order_count=len(orders),
+            subtotal_cents=subtotal,
+            discount_cents=discount,
+            total_cents=subtotal - discount,
+        )
