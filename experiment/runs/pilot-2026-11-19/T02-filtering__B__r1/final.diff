         assert [o["order_id"] for o in response.body["orders"]] == [first, second]
 
+    def test_sku_filter_returns_matching_orders_in_creation_order(self, controller):
+        def item(sku):
+            return {"sku": sku, "quantity": 1, "unit_price_cents": 100}
+
+        first = create(controller, items=[item("A"), item("B")]).body["order_id"]
+        create(controller, items=[item("C")])
+        create(controller, customer_id="cust-2", items=[item("B")])
+        third = create(controller, items=[item("B")]).body["order_id"]
+
+        response = controller.handle_list_for_customer("cust-1", sku="B")
+
+        assert response.status == 200
+        assert [o["order_id"] for o in response.body["orders"]] == [first, third]
+        assert response.body["orders"][0]["items"][0]["sku"] == "A"
+
+    def test_sku_filter_is_exact_and_unknown_sku_gives_empty_list(self, controller):
+        create(controller)
+
+        assert controller.handle_list_for_customer("cust-1", sku="BOO").body == {"orders": []}
+        assert controller.handle_list_for_customer("cust-1", sku="nope").status == 200
+
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
