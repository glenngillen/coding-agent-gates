@@ -120,3 +120,35 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestGetMany:
+    def test_returns_orders_and_missing_in_order_deduplicated(self, controller):
+        a = create(controller).body["order_id"]
+        b = create(controller).body["order_id"]
+
+        response = controller.handle_get_many([b, "nope", a, b, "nope", "zip"])
+
+        assert response.status == 200
+        assert response.body["orders"] == [
+            controller.handle_get(b).body,
+            controller.handle_get(a).body,
+        ]
+        assert response.body["missing"] == ["nope", "zip"]
+
+    @pytest.mark.parametrize(
+        "bad", [[], "abc", None, ["a", 1], [f"id{i}" for i in range(101)], ("a",)]
+    )
+    def test_invalid_input_is_rejected(self, controller, bad):
+        response = controller.handle_get_many(bad)
+
+        assert response.status == 400
+        assert response.body == {
+            "error": "order_ids must be a list of 1 to 100 strings"
+        }
+
+    def test_100_ids_allowed(self, controller):
+        response = controller.handle_get_many([f"id{i}" for i in range(100)])
+
+        assert response.status == 200
+        assert len(response.body["missing"]) == 100
