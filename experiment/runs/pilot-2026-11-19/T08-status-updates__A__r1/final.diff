 DISCOUNT_THRESHOLD_CENTS = 10_000
 DISCOUNT_RATE_PERCENT = 10
+STATUS_FLOW = ("placed", "paid", "shipped", "delivered")
 
 
 class OrderNotFound(LookupError):
     """No order exists with the requested id."""
 
 
+class UnknownStatus(ValueError):
+    """The requested status is not a known order status."""
+
+
+class InvalidStatusChange(ValueError):
+    """The requested status is not the next step from the current one."""
+
+    def __init__(self, current: str, requested: str) -> None:
+        super().__init__(f"cannot change status from {current} to {requested}")
+        self.current = current
+        self.requested = requested
+
+
 def discount_for(subtotal_cents: int) -> int:
