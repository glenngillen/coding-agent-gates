         )
 
+    def update_status(self, order_id: str, new_status: str) -> Order:
+        """Move an order forward exactly one step in STATUS_FLOW."""
+        order = self.get_order(order_id)
+        if new_status not in STATUS_FLOW:
+            raise UnknownStatus(new_status)
+        index = STATUS_FLOW.index(order.status)
+        if index + 1 >= len(STATUS_FLOW) or STATUS_FLOW[index + 1] != new_status:
+            raise InvalidStatusChange(order.status, new_status)
+        updated = replace(order, status=new_status)
+        self._repository.add(updated)
+        return updated
+
     def list_for_customer(self, customer_id: str) -> list[Order]:
         return self._repository.list_for_customer(customer_id)
