diff --git a/tests/test_order_behaviour.py b/tests/test_order_behaviour.py
index 53425d2..cb08e08 100644
--- a/tests/test_order_behaviour.py
+++ b/tests/test_order_behaviour.py
@@ -120,3 +120,34 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+    def test_sku_filter_returns_only_matching_orders_in_creation_order(
+        self, controller
+    ):
+        line = lambda sku: {"sku": sku, "quantity": 1, "unit_price_cents": 100}
+        first = create(controller, items=[line("A"), line("B")]).body["order_id"]
+        create(controller, items=[line("C")])
+        create(controller, customer_id="cust-2", items=[line("B")])
+        third = create(controller, items=[line("B")]).body["order_id"]
+
+        response = controller.handle_list_for_customer("cust-1", sku="B")
+
+        assert response.status == 200
+        assert [o["order_id"] for o in response.body["orders"]] == [first, third]
+        assert response.body["orders"][0]["items"][0]["sku"] == "A"
+
+    def test_sku_filter_requires_exact_match(self, controller):
+        create(controller)
+
+        assert controller.handle_list_for_customer("cust-1", sku="BOO") == (
+            controller.handle_list_for_customer("cust-1", sku="nope")
+        )
+        assert controller.handle_list_for_customer("cust-1", sku="nope").body == {
+            "orders": []
+        }
+
+    def test_omitting_sku_returns_all_orders(self, controller):
+        create(controller)
+        create(controller, items=[{"sku": "Z", "quantity": 1, "unit_price_cents": 1}])
+
+        assert len(controller.handle_list_for_customer("cust-1").body["orders"]) == 2
