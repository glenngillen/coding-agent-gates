@@ -120,3 +120,30 @@ class TestListForCustomer:
 
     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestGetMany:
+    ERR = {"error": "order_ids must be a list of 1 to 100 strings"}
+
+    @pytest.mark.parametrize(
+        "bad", ["a", None, [], [1], ["a", 2], ["a"] * 101, ("a",)]
+    )
+    def test_invalid_input_is_400(self, controller, bad):
+        response = controller.handle_get_many(bad)
+        assert response.status == 400
+        assert response.body == self.ERR
+
+    def test_hundred_ids_allowed(self, controller):
+        ids = [f"x{i}" for i in range(100)]
+        assert controller.handle_get_many(ids).status == 200
+
+    def test_orders_and_missing_in_order_deduplicated(self, controller):
+        a = create(controller).body["order_id"]
+        b = create(controller).body["order_id"]
+        response = controller.handle_get_many([b, "nope", a, b, "nope", "zzz"])
+        assert response.status == 200
+        assert response.body["orders"] == [
+            controller.handle_get(b).body,
+            controller.handle_get(a).body,
+        ]
+        assert response.body["missing"] == ["nope", "zzz"]
