     def test_customer_without_orders_gets_an_empty_list(self, controller):
         assert controller.handle_list_for_customer("nobody").body == {"orders": []}
+
+
+class TestCustomerTotals:
+    def test_no_orders_gives_zeros(self, controller):
+        response = controller.handle_customer_totals("nobody")
+
+        assert response.status == 200
+        assert response.body == {
+            "customer_id": "nobody",
+            "order_count": 0,
+            "subtotal_cents": 0,
+            "discount_cents": 0,
+            "total_cents": 0,
+        }
+
+    def test_discounts_are_per_order_not_on_the_combined_subtotal(self, controller):
+        # Two 6000 orders combined would qualify, but each alone does not.
+        create(controller, items=[{"sku": "A", "quantity": 1, "unit_price_cents": 6000}])
+        create(controller, items=[{"sku": "A", "quantity": 1, "unit_price_cents": 6000}])
+        # Qualifies on its own: 12000 -> 1200 off.
+        create(controller, items=[{"sku": "B", "quantity": 2, "unit_price_cents": 6000}])
+        create(controller, customer_id="cust-2")
+
+        response = controller.handle_customer_totals("cust-1")
+
+        assert response.status == 200
+        assert response.body == {
+            "customer_id": "cust-1",
+            "order_count": 3,
+            "subtotal_cents": 24000,
+            "discount_cents": 1200,
+            "total_cents": 22800,
+        }
