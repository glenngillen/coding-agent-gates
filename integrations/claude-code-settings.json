{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/integrations/claude_stop_hook.py",
              "--max-repairs",
              "3"
            ],
            "timeout": 180,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/integrations/claude_stop_hook.py"
            ],
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
